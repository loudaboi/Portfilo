---
import SiteHead from "../components/SiteHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      title="Subscribe | Portfilo"
      description="Subscribe to Portfilo’s free business and technology newsletter. Business and tech in 7 minutes, three times a week."
    />
  </head>
  <body class="subscribe-page">
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <SiteHeader current="subscribe" />

    <main id="main-content" tabindex="-1">
      <section class="subscribe-panel" aria-labelledby="subscribe-title">
        <div class="subscribe-panel__message">
          <h1 id="subscribe-title">Get ahead in business and tech in 7 minutes.</h1>
          <p>
            The latest news on companies, startups, products, markets, AI, and technology.
            Three times a week, straight to your inbox.
          </p>
        </div>

        <div class="subscribe-panel__form">
          <NewsletterSignup
            id="subscribe-page-newsletter"
            variant="hero"
            showCopy={false}
            buttonLabel="SUBSCRIBE"
          />
        </div>
      </section>
    </main>

    <SiteFooter showAcquisition={false} />

    <style>
      @font-face {
        font-family: "Instrument Sans";
        font-style: normal;
        font-display: swap;
        font-weight: 400 700;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/instrument-sans:vf@5.3.0/latin-wght-normal.woff2") format("woff2-variations");
      }

      :global(:root) {
        --paper: #f8f6f1;
        --ink: #171614;
        --muted: #68645e;
        --line: #d4cfc6;
        --line-strong: #aaa39a;
        --accent: #0050a4;
        --correction: #b42318;
        --content-max: 84rem;
        --page-max: 84rem;
        --shell-gutter: clamp(1.25rem, 2.6vw, 2rem);
        --gutter: var(--shell-gutter);
        --sans: "Instrument Sans", "Helvetica Neue", Arial, sans-serif;
      }

      :global(*) { box-sizing: border-box; }

      :global(html) {
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
        font-synthesis: none;
      }

      :global(body.subscribe-page) {
        margin: 0;
        min-width: 0;
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        background: var(--paper);
      }

      :global(body.subscribe-page a:focus-visible) {
        outline: 3px solid var(--accent);
        outline-offset: 4px;
      }

      :global(body.subscribe-page main:focus) { outline: none; }

      .skip-link {
        position: fixed;
        z-index: 50;
        top: 0.75rem;
        left: 0.75rem;
        padding: 0.7rem 0.85rem;
        background: var(--ink);
        color: var(--paper);
        font: 550 0.75rem/1 var(--sans);
        text-decoration: none;
        transform: translateY(-200%);
      }

      .skip-link:focus { transform: translateY(0); }

      main {
        width: 100%;
        flex: 1 0 auto;
        display: flex;
        align-items: center;
        padding: clamp(3.5rem, 7vw, 7rem) var(--shell-gutter) clamp(4rem, 8vw, 8rem);
      }

      .subscribe-panel {
        width: min(100%, var(--content-max));
        margin-inline: auto;
        padding: clamp(2rem, 3.3vw, 3.25rem) 0 clamp(2.4rem, 4vw, 4rem);
        display: grid;
        grid-template-columns: minmax(0, 1.45fr) minmax(19rem, 0.78fr);
        gap: clamp(3rem, 7vw, 7rem);
        align-items: start;
        border-top: 3px solid var(--accent);
        border-bottom: 1px solid var(--line);
      }

      .subscribe-panel__message {
        max-width: 47rem;
      }

      .subscribe-panel__message h1 {
        max-width: 14ch;
        margin: 0;
        font: 650 clamp(3rem, 4.8vw, 4.75rem) / 0.96 var(--sans);
        letter-spacing: -0.057em;
        text-wrap: balance;
      }

      .subscribe-panel__message p {
        max-width: 40rem;
        margin: clamp(1.4rem, 2.2vw, 2rem) 0 0;
        color: var(--muted);
        font: 430 clamp(1rem, 1.15vw, 1.12rem) / 1.55 var(--sans);
      }

      .subscribe-panel__form {
        min-width: 0;
        padding-top: clamp(4rem, 7vw, 6.75rem);
      }

      .subscribe-panel__form :global(.newsletter-signup__row) {
        width: 100%;
        max-width: none;
      }

      .subscribe-panel__form :global(.newsletter-signup input),
      .subscribe-panel__form :global(.newsletter-signup button) {
        min-height: 3rem;
      }

      .subscribe-panel__form :global(.newsletter-signup button) {
        font-weight: 650;
      }

      .subscribe-panel__form :global(.newsletter-signup__note),
      .subscribe-panel__form :global(.newsletter-signup__status) {
        font-size: 0.72rem;
      }

      @media (max-width: 70rem) {
        .subscribe-panel {
          grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
          gap: clamp(2.5rem, 5vw, 4.5rem);
        }

        .subscribe-panel__message h1 {
          font-size: clamp(2.8rem, 5vw, 4rem);
        }

        .subscribe-panel__form {
          padding-top: clamp(3rem, 5vw, 4.5rem);
        }
      }

      @media (max-width: 52rem) {
        main {
          align-items: flex-start;
          padding-top: clamp(3rem, 8vw, 4.5rem);
          padding-bottom: clamp(4rem, 9vw, 6rem);
        }

        .subscribe-panel {
          grid-template-columns: 1fr;
          gap: clamp(2.75rem, 7vw, 4rem);
        }

        .subscribe-panel__message {
          max-width: 42rem;
        }

        .subscribe-panel__message h1 {
          max-width: 13ch;
          font-size: clamp(2.7rem, 8vw, 4rem);
        }

        .subscribe-panel__form {
          width: min(100%, 42rem);
          padding-top: 0;
        }
      }

      @media (max-width: 32rem) {
        main {
          padding-top: 2.5rem;
          padding-bottom: 4rem;
        }

        .subscribe-panel {
          padding-top: 1.75rem;
          padding-bottom: 2.5rem;
          gap: 2.5rem;
        }

        .subscribe-panel__message h1 {
          max-width: none;
          font-size: clamp(2.45rem, 11.5vw, 3.35rem);
          line-height: 0.98;
        }

        .subscribe-panel__message p {
          margin-top: 1.25rem;
          font-size: 1rem;
        }

        .subscribe-panel__form :global(.newsletter-signup__row) {
          grid-template-columns: 1fr;
          gap: 0.6rem;
        }

        .subscribe-panel__form :global(.newsletter-signup input) {
          border-right: 1px solid var(--line-strong);
        }

        .subscribe-panel__form :global(.newsletter-signup input),
        .subscribe-panel__form :global(.newsletter-signup button) {
          width: 100%;
          min-height: 3rem;
        }
      }

      @media (max-width: 23rem) {
        :global(:root) { --shell-gutter: 1rem; }
      }
    </style>
  </body>
</html>
