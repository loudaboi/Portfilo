---
const topics = ["Business", "Technology", "Startups", "AI", "Building"] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Subscribe to Portfilo Brief for new reporting and clear explanations on business, technology, startups, AI, and building in the Philippines."
    />
    <meta name="theme-color" content="#f4f0e8" />
    <title>Subscribe | Portfilo</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Portfilo home">
        <span class="wordmark__inner">
          <span class="wordmark__port">Port</span><span class="wordmark__fi">fi</span><span class="wordmark__lo">lo</span>
        </span>
      </a>
      <p class="site-header__strapline">
        Practical intelligence for ambitious Filipinos
      </p>
      <p class="site-header__section">Subscribe</p>
    </header>

    <main id="main-content" tabindex="-1">
      <section class="subscribe-hero" aria-labelledby="subscribe-title">
        <p class="subscribe-kicker">Portfilo Brief / Email</p>

        <h1 id="subscribe-title">Portfilo Brief, by email.</h1>

        <p class="subscribe-intro">
          Get new reporting and clear explanations on business, technology, startups,
          AI, and building in the Philippines.
        </p>

        <div class="subscribe-index" aria-label="Portfilo Brief coverage">
          <p>What it covers</p>
          <ul>
            {topics.map((topic) => <li>{topic}</li>)}
          </ul>
        </div>
      </section>

      <section class="signup-section" aria-labelledby="signup-title">
        <div class="signup-section__label">
          <p>01 / Subscribe</p>
          <p>Email signup</p>
        </div>

        <div class="signup-section__copy">
          <h2 id="signup-title">Join Portfilo Brief.</h2>
          <p>
            Enter your email to subscribe. You can unsubscribe at any time.
          </p>
        </div>

        <div class="signup-panel" aria-label="Portfilo Brief signup form">
          <script
            is:inline
            async
            src="https://subscribe-forms.beehiiv.com/v3/loader.js"
            data-beehiiv-form="a3c313d1-b9d1-4d54-bced-d5ae16360141"
          ></script>
          <noscript>
            <p class="signup-noscript">
              JavaScript is required to load the Portfilo Brief signup form.
            </p>
          </noscript>
        </div>
      </section>

      <section class="brief-section" aria-labelledby="brief-title">
        <div class="brief-section__inner">
          <p class="brief-section__index">02 / What to expect</p>

          <div class="brief-section__statement">
            <h2 id="brief-title">The useful part of Portfilo, sent to you.</h2>
            <p>
              Portfilo Brief is the email edition of the publication. It will point
              readers to new reporting and explanations without promising a fixed
              publishing schedule before one has been established.
            </p>
          </div>

          <dl class="brief-section__rules">
            <div>
              <dt>Coverage</dt>
              <dd>Business, technology, startups, AI, and building.</dd>
            </div>
            <div>
              <dt>Context</dt>
              <dd>Philippine relevance when it materially changes the answer.</dd>
            </div>
            <div>
              <dt>Standard</dt>
              <dd>Claims stay within what the reporting and evidence support.</dd>
            </div>
          </dl>
        </div>
      </section>

      <section class="privacy-note" aria-labelledby="privacy-title">
        <p>03 / Your email</p>
        <div>
          <h2 id="privacy-title">Signup infrastructure stays simple.</h2>
          <p>
            Portfilo uses beehiiv to manage newsletter subscriptions, delivery, and
            unsubscribe requests. Portfilo does not need a separate newsletter account
            system for this signup.
          </p>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="site-footer__brand" aria-label="Portfilo">
        <span class="site-footer__port">Port</span><span class="site-footer__fi">fi</span><span class="site-footer__lo">lo</span>
      </div>
      <p>Practical intelligence for ambitious Filipinos</p>
      <a href="/">Back to home</a>
    </footer>

    <style>
      @font-face {
        font-family: "Instrument Sans";
        font-style: normal;
        font-display: swap;
        font-weight: 400 700;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/instrument-sans:vf@5.3.0/latin-wght-normal.woff2")
          format("woff2-variations");
      }

      @font-face {
        font-family: "Source Serif 4";
        font-style: normal;
        font-display: swap;
        font-weight: 200 900;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/source-serif-4:vf@5.3.0/latin-wght-normal.woff2")
          format("woff2-variations");
      }

      @font-face {
        font-family: "IBM Plex Mono";
        font-style: normal;
        font-display: swap;
        font-weight: 400;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/ibm-plex-mono@5.3.0/latin-400-normal.woff2")
          format("woff2");
      }

      :global(:root) {
        --paper: #f4f0e8;
        --ink: #171614;
        --muted: #69655e;
        --line: #cbc5bb;
        --accent: #0050a4;
        --accent-on-ink: #8fc7ff;
        --correction: #b42318;
        --page-max: 100rem;
        --gutter: clamp(1.25rem, 3.3vw, 3.75rem);
        --grid-gap: clamp(0.8rem, 1.6vw, 1.5rem);
        --sans: "Instrument Sans", "Helvetica Neue", Arial, sans-serif;
        --serif: "Source Serif 4", Georgia, serif;
        --mono: "IBM Plex Mono", "Courier New", monospace;
      }

      :global(*) {
        box-sizing: border-box;
      }

      :global(html) {
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
        font-synthesis: none;
      }

      :global(body) {
        margin: 0;
        min-width: 0;
        background: var(--paper);
      }

      :global(a) {
        color: inherit;
      }

      :global(a:focus-visible) {
        outline: 3px solid var(--accent);
        outline-offset: 4px;
      }

      :global(#main-content:focus) {
        outline: none;
      }

      .skip-link {
        position: fixed;
        z-index: 20;
        top: 0.75rem;
        left: 0.75rem;
        padding: 0.65rem 0.8rem;
        background: var(--ink);
        color: var(--paper);
        font: 400 0.75rem/1 var(--mono);
        text-decoration: none;
        transform: translateY(-200%);
      }

      .skip-link:focus {
        transform: translateY(0);
      }

      .site-header,
      .subscribe-hero,
      .signup-section,
      .brief-section__inner,
      .privacy-note,
      .site-footer {
        width: min(100%, var(--page-max));
        margin-inline: auto;
      }

      .site-header {
        padding: 1.05rem var(--gutter) 0.95rem;
        display: grid;
        grid-template-columns: 3fr 6fr 3fr;
        gap: var(--grid-gap);
        align-items: end;
        border-bottom: 1px solid var(--ink);
      }

      .wordmark {
        width: fit-content;
        display: inline-block;
        text-decoration: none;
      }

      .wordmark__inner {
        display: inline-block;
        white-space: nowrap;
        font: 700 clamp(1.75rem, 2.2vw, 2.3rem) / 0.9 var(--sans);
        letter-spacing: -0.085em;
        transform: skewX(-12deg);
        transform-origin: left center;
      }

      .wordmark__port,
      .wordmark__fi,
      .wordmark__lo,
      .site-footer__port,
      .site-footer__fi,
      .site-footer__lo {
        display: inline-block;
      }

      .wordmark__port,
      .site-footer__port {
        color: var(--ink);
      }

      .wordmark__fi,
      .site-footer__fi {
        color: var(--accent);
      }

      .wordmark__lo,
      .site-footer__lo {
        color: var(--correction);
      }

      .site-header__strapline,
      .site-header__section {
        margin: 0;
        color: var(--muted);
        font: 400 0.68rem/1.35 var(--mono);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .site-header__strapline {
        text-align: center;
      }

      .site-header__section {
        color: var(--ink);
        text-align: right;
      }

      .subscribe-hero {
        padding: clamp(4rem, 7vw, 7.5rem) var(--gutter)
          clamp(4.5rem, 8vw, 8rem);
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: var(--grid-gap);
        row-gap: clamp(2rem, 4vw, 4rem);
      }

      .subscribe-kicker {
        grid-column: 1 / 4;
        margin: 0.55rem 0 0;
        color: var(--accent);
        font: 400 0.67rem/1.4 var(--mono);
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }

      .subscribe-hero h1 {
        grid-column: 3 / 13;
        max-width: 11ch;
        margin: 0;
        font: 500 clamp(4rem, 8vw, 8.3rem) / 0.88 var(--sans);
        letter-spacing: -0.072em;
        text-wrap: balance;
      }

      .subscribe-intro {
        grid-column: 5 / 11;
        max-width: 42rem;
        margin: 0;
        font: 400 clamp(1.3rem, 1.75vw, 1.72rem) / 1.5 var(--serif);
      }

      .subscribe-index {
        grid-column: 1 / 13;
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
        padding-top: 0.8rem;
        border-top: 1px solid var(--ink);
      }

      .subscribe-index > p {
        grid-column: 1 / 4;
        margin: 0;
        color: var(--muted);
        font: 400 0.64rem/1.4 var(--mono);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .subscribe-index ul {
        grid-column: 5 / 13;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem 1.35rem;
        list-style: none;
        font: 500 clamp(1rem, 1.25vw, 1.18rem) / 1.25 var(--sans);
      }

      .subscribe-index li::before {
        content: "■";
        margin-right: 0.55rem;
        color: var(--accent);
        font-size: 0.46em;
        vertical-align: 0.16em;
      }

      .signup-section {
        padding: 0 var(--gutter) clamp(5rem, 9vw, 9rem);
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: var(--grid-gap);
        row-gap: clamp(2.25rem, 4vw, 4rem);
      }

      .signup-section__label {
        grid-column: 1 / 4;
        padding-top: 0.75rem;
        border-top: 1px solid var(--ink);
        font: 400 0.64rem/1.5 var(--mono);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .signup-section__label p {
        margin: 0 0 0.4rem;
      }

      .signup-section__label p:last-child {
        color: var(--muted);
      }

      .signup-section__copy {
        grid-column: 5 / 11;
      }

      .signup-section__copy h2 {
        max-width: 12ch;
        margin: 0;
        font: 500 clamp(3rem, 5.6vw, 5.8rem) / 0.92 var(--sans);
        letter-spacing: -0.06em;
        text-wrap: balance;
      }

      .signup-section__copy p {
        max-width: 39rem;
        margin: clamp(1.6rem, 2.7vw, 2.5rem) 0 0;
        color: var(--muted);
        font: 400 clamp(1.08rem, 1.35vw, 1.28rem) / 1.6 var(--serif);
      }

      .signup-panel {
        grid-column: 5 / 11;
        min-width: 0;
        padding: clamp(1.05rem, 1.8vw, 1.5rem) 0 0;
        border-top: 3px solid var(--accent);
        background: transparent;
        overflow: visible;
      }

      .signup-panel :global(iframe) {
        display: block;
        width: 100% !important;
        max-width: 100% !important;
        border: 0;
      }

      .signup-noscript {
        margin: 0;
        color: var(--muted);
        font: 400 0.9rem/1.5 var(--serif);
      }

      .brief-section {
        width: 100%;
        background: var(--ink);
        color: var(--paper);
      }

      .brief-section__inner {
        padding: clamp(4.5rem, 8vw, 8rem) var(--gutter);
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
      }

      .brief-section__index {
        grid-column: 1 / 3;
        margin: 0;
        color: var(--accent-on-ink);
        font: 400 0.64rem/1.4 var(--mono);
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }

      .brief-section__statement {
        grid-column: 4 / 10;
      }

      .brief-section__statement h2 {
        max-width: 14ch;
        margin: 0;
        font: 500 clamp(3rem, 5.4vw, 5.6rem) / 0.94 var(--sans);
        letter-spacing: -0.06em;
        text-wrap: balance;
      }

      .brief-section__statement p {
        max-width: 42rem;
        margin: clamp(2rem, 3vw, 3rem) 0 0;
        color: #d7d2c9;
        font: 400 clamp(1.12rem, 1.4vw, 1.36rem) / 1.62 var(--serif);
      }

      .brief-section__rules {
        grid-column: 10 / 13;
        margin: 0;
        align-self: end;
        border-top: 1px solid #55524d;
        font: 400 0.67rem/1.55 var(--mono);
      }

      .brief-section__rules > div {
        padding: 0.8rem 0;
        border-bottom: 1px solid #55524d;
      }

      .brief-section__rules dt {
        margin-bottom: 0.3rem;
        color: var(--accent-on-ink);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .brief-section__rules dd {
        margin: 0;
        color: #d7d2c9;
      }

      .privacy-note {
        padding: clamp(4.5rem, 8vw, 8rem) var(--gutter);
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
        border-bottom: 1px solid var(--ink);
      }

      .privacy-note > p {
        grid-column: 1 / 4;
        margin: 0;
        color: var(--accent);
        font: 400 0.64rem/1.4 var(--mono);
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }

      .privacy-note > div {
        grid-column: 5 / 11;
      }

      .privacy-note h2 {
        max-width: 13ch;
        margin: 0;
        font: 500 clamp(2.8rem, 5vw, 5.1rem) / 0.95 var(--sans);
        letter-spacing: -0.058em;
        text-wrap: balance;
      }

      .privacy-note div > p {
        max-width: 42rem;
        margin: clamp(1.8rem, 3vw, 2.7rem) 0 0;
        font: 400 clamp(1.1rem, 1.35vw, 1.3rem) / 1.62 var(--serif);
      }

      .site-footer {
        padding: 1.2rem var(--gutter) 1.4rem;
        display: grid;
        grid-template-columns: 3fr 6fr 3fr;
        gap: var(--grid-gap);
        align-items: end;
        font: 400 0.64rem/1.45 var(--mono);
      }

      .site-footer__brand {
        width: fit-content;
        white-space: nowrap;
        font: 700 1.55rem/0.9 var(--sans);
        letter-spacing: -0.085em;
        transform: skewX(-12deg);
        transform-origin: left center;
      }

      .site-footer p {
        margin: 0;
        color: var(--muted);
        text-align: center;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .site-footer a {
        justify-self: end;
        text-decoration-color: var(--accent);
        text-decoration-thickness: 0.1em;
        text-underline-offset: 0.18em;
      }

      .site-footer a:hover {
        color: var(--accent);
      }

      @media (max-width: 64rem) {
        .subscribe-hero h1 {
          grid-column: 2 / 13;
        }

        .subscribe-intro {
          grid-column: 4 / 11;
        }

        .signup-section__copy,
        .signup-panel {
          grid-column: 4 / 11;
        }

        .brief-section__statement {
          grid-column: 3 / 10;
        }

        .brief-section__rules {
          grid-column: 10 / 13;
        }

        .privacy-note > div {
          grid-column: 4 / 11;
        }
      }

      @media (max-width: 50rem) {
        .site-header {
          grid-template-columns: 1fr auto;
          align-items: center;
          padding-top: 0.9rem;
        }

        .site-header__strapline {
          grid-column: 1 / -1;
          grid-row: 2;
          max-width: 32rem;
          padding-top: 0.55rem;
          text-align: left;
        }

        .site-header__section {
          grid-column: 2;
          grid-row: 1;
        }

        .subscribe-hero {
          display: block;
          padding-top: 3.6rem;
          padding-bottom: 4.5rem;
        }

        .subscribe-kicker {
          margin: 0 0 1.35rem;
        }

        .subscribe-hero h1 {
          max-width: none;
          font-size: clamp(3.35rem, 14vw, 5.3rem);
          line-height: 0.91;
          text-wrap: pretty;
        }

        .subscribe-intro {
          max-width: 36rem;
          margin-top: 2rem;
          font-size: 1.26rem;
        }

        .subscribe-index {
          display: block;
          margin-top: 3rem;
        }

        .subscribe-index > p {
          margin-bottom: 1rem;
        }

        .subscribe-index ul {
          gap: 0.7rem 1rem;
        }

        .signup-section {
          display: block;
          padding-bottom: 4.5rem;
        }

        .signup-section__label {
          margin-bottom: 2.5rem;
        }

        .signup-section__copy h2 {
          font-size: clamp(2.8rem, 12vw, 4.5rem);
        }

        .signup-section__copy p {
          font-size: 1.08rem;
        }

        .signup-panel {
          width: 100%;
          margin-top: 2.5rem;
          padding-top: 1rem;
        }

        .brief-section__inner {
          display: block;
          padding-top: 4.5rem;
          padding-bottom: 4.5rem;
        }

        .brief-section__index {
          margin-bottom: 2rem;
        }

        .brief-section__statement h2 {
          max-width: none;
          font-size: clamp(2.8rem, 11.5vw, 4.5rem);
          text-wrap: pretty;
        }

        .brief-section__statement p {
          font-size: 1.13rem;
        }

        .brief-section__rules {
          margin-top: 3rem;
        }

        .privacy-note {
          display: block;
          padding-top: 4.5rem;
          padding-bottom: 4.5rem;
        }

        .privacy-note > p {
          margin-bottom: 2rem;
        }

        .privacy-note h2 {
          max-width: none;
          font-size: clamp(2.7rem, 11vw, 4.3rem);
        }

        .privacy-note div > p {
          font-size: 1.1rem;
        }

        .site-footer {
          grid-template-columns: 1fr auto;
          align-items: center;
          gap: 0.8rem 1rem;
        }

        .site-footer p {
          grid-column: 1 / -1;
          grid-row: 2;
          text-align: left;
        }
      }

      @media (max-width: 28rem) {
        .wordmark__inner {
          font-size: 1.68rem;
        }

        .site-header__section {
          font-size: 0.61rem;
        }

        .subscribe-hero h1 {
          font-size: clamp(3rem, 15vw, 4.15rem);
        }

        .subscribe-intro {
          font-size: 1.18rem;
        }

        .subscribe-index ul {
          display: grid;
          grid-template-columns: 1fr 1fr;
        }

        .site-footer {
          grid-template-columns: 1fr;
        }

        .site-footer a {
          justify-self: start;
        }

        .site-footer p {
          grid-column: 1;
          grid-row: auto;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        :global(*) {
          scroll-behavior: auto !important;
        }
      }
    </style>
  </body>
</html>
