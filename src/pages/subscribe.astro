---
import SiteHead from "../components/SiteHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      title="Subscribe | Portfilo"
      description="Subscribe to Portfilo’s free business and technology newsletter. Business and tech in 7 minutes, three times a week."
    />
  </head>
  <body class="subscribe-page">
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <SiteHeader current="subscribe" />

    <main id="main-content" tabindex="-1">
      <section class="subscribe-stage" aria-labelledby="subscribe-message">
        <img
          class="subscribe-stage__image"
          src="/images/subscribe-16x9.png"
          alt=""
          width="1672"
          height="941"
          loading="eager"
          decoding="async"
          aria-hidden="true"
        />
        <div class="subscribe-stage__shade" aria-hidden="true"></div>

        <div class="subscribe-stage__content">
          <div class="subscribe-message">
            <img
              class="subscribe-message__wordmark"
              src="/brand/portfilo-wordmark-light.svg"
              alt="Portfilo"
            />
            <h1 id="subscribe-message">
              <span>Some changes look small,</span>
              <span>until they reshape everything.</span>
              <span>We look closer.</span>
            </h1>
          </div>

          <div class="subscribe-form-block">
            <p class="subscribe-form-block__label">GET THE NEWSLETTER</p>
            <p class="subscribe-form-block__copy">
              Business and tech in 7 minutes, three times a week.
            </p>
            <NewsletterSignup
              id="subscribe-page-newsletter"
              variant="hero"
              showCopy={false}
              buttonLabel="SUBSCRIBE FREE"
            />
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />

    <style>
      @font-face {
        font-family: "Instrument Sans";
        font-style: normal;
        font-display: swap;
        font-weight: 400 700;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/instrument-sans:vf@5.3.0/latin-wght-normal.woff2") format("woff2-variations");
      }

      :global(:root) {
        --paper: #f8f6f1;
        --ink: #171614;
        --muted: #68645e;
        --line: #d4cfc6;
        --line-strong: #aaa39a;
        --accent: #0050a4;
        --correction: #b42318;
        --content-max: 84rem;
        --page-max: 84rem;
        --shell-gutter: clamp(1.25rem, 2.6vw, 2rem);
        --gutter: var(--shell-gutter);
        --sans: "Instrument Sans", "Helvetica Neue", Arial, sans-serif;
      }

      :global(*) { box-sizing: border-box; }

      :global(html) {
        background: var(--ink);
        color: var(--ink);
        font-family: var(--sans);
        font-synthesis: none;
      }

      :global(body.subscribe-page) {
        margin: 0;
        min-width: 0;
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        background: var(--ink);
      }

      :global(body.subscribe-page .site-header) {
        width: min(calc(100% - (2 * var(--shell-gutter))), var(--content-max));
        padding-inline: 0;
        background: var(--paper);
        color: var(--ink);
      }

      :global(body.subscribe-page a:focus-visible) {
        outline: 3px solid var(--accent);
        outline-offset: 4px;
      }
      :global(body.subscribe-page main:focus) { outline: none; }

      .skip-link {
        position: fixed;
        z-index: 50;
        top: 0.75rem;
        left: 0.75rem;
        padding: 0.7rem 0.85rem;
        background: var(--paper);
        color: var(--ink);
        font: 550 0.75rem/1 var(--sans);
        text-decoration: none;
        transform: translateY(-200%);
      }

      .skip-link:focus { transform: translateY(0); }

      main {
        flex: 1 1 auto;
        min-height: 0;
        width: 100%;
        display: grid;
        place-items: center;
        padding: clamp(1rem, 2vw, 1.5rem) var(--shell-gutter);
        background: var(--ink);
      }

      .subscribe-stage {
        position: relative;
        isolation: isolate;
        width: min(
          100%,
          var(--content-max),
          calc((100svh - 11.5rem) * 16 / 9)
        );
        aspect-ratio: 16 / 9;
        overflow: hidden;
        color: #fff;
      }

      .subscribe-stage__image,
      .subscribe-stage__shade {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
      }

      .subscribe-stage__image {
        z-index: -2;
        display: block;
        object-fit: cover;
      }

      .subscribe-stage__shade {
        z-index: -1;
        background: rgba(0, 0, 0, 0.46);
      }

      .subscribe-stage__content {
        width: 100%;
        height: 100%;
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(19rem, 0.72fr);
        gap: clamp(2.5rem, 6vw, 6.5rem);
        align-items: center;
        padding: clamp(2.25rem, 5vw, 5.25rem);
      }

      .subscribe-message,
      .subscribe-form-block {
        min-width: 0;
      }

      .subscribe-message__wordmark {
        display: block;
        width: clamp(8.5rem, 12vw, 11rem);
        height: auto;
      }

      .subscribe-message h1 {
        max-width: 15ch;
        margin: clamp(1.4rem, 2.5vw, 2.2rem) 0 0;
        color: #fff;
        font: 650 clamp(2.25rem, 3.6vw, 4rem) / 0.98 var(--sans);
        letter-spacing: -0.045em;
      }

      .subscribe-message h1 span {
        display: block;
      }

      .subscribe-form-block {
        align-self: center;
      }

      .subscribe-form-block__label,
      .subscribe-form-block__copy {
        margin: 0;
      }

      .subscribe-form-block__label {
        color: #fff;
        font: 650 0.72rem/1 var(--sans);
        letter-spacing: 0.08em;
      }

      .subscribe-form-block__copy {
        max-width: 27rem;
        margin-top: 0.8rem;
        color: rgba(255, 255, 255, 0.82);
        font: 460 clamp(1rem, 1.15vw, 1.12rem) / 1.45 var(--sans);
      }

      .subscribe-form-block :global(.newsletter-signup) {
        margin-top: 1.35rem;
      }

      .subscribe-form-block :global(.newsletter-signup__row) {
        grid-template-columns: 1fr;
        gap: 0.55rem;
        max-width: none;
      }

      .subscribe-form-block :global(.newsletter-signup input) {
        border: 1px solid rgba(255, 255, 255, 0.5);
        background: rgba(0, 0, 0, 0.2);
        color: #fff;
      }

      .subscribe-form-block :global(.newsletter-signup input::placeholder) {
        color: rgba(255, 255, 255, 0.68);
      }

      .subscribe-form-block :global(.newsletter-signup button) {
        width: 100%;
        border-color: var(--paper);
        background: var(--paper);
        color: var(--ink);
      }

      .subscribe-form-block :global(.newsletter-signup button:hover) {
        filter: none;
        background: rgba(248, 246, 241, 0.9);
      }

      .subscribe-form-block :global(.newsletter-signup input:focus-visible),
      .subscribe-form-block :global(.newsletter-signup button:focus-visible) {
        outline-color: #fff;
      }

      .subscribe-form-block :global(.newsletter-signup__note),
      .subscribe-form-block :global(.newsletter-signup__status) {
        color: rgba(255, 255, 255, 0.68);
      }

      .subscribe-form-block :global(.newsletter-signup__status[data-state="success"]) {
        color: #fff;
      }

      .subscribe-form-block :global(.newsletter-signup__status[data-state="error"]) {
        color: #ffe1dc;
      }

      @media (max-width: 56rem) {
        main {
          display: block;
          padding-block: 1rem;
        }

        .subscribe-stage {
          width: 100%;
          min-height: clamp(38rem, 100svh, 46rem);
          aspect-ratio: auto;
        }

        .subscribe-stage__image {
          object-position: 44% center;
        }

        .subscribe-stage__content {
          grid-template-columns: 1fr;
          align-content: center;
          gap: clamp(3rem, 9vw, 5rem);
          padding: clamp(2rem, 7vw, 3.75rem);
        }

        .subscribe-message h1 {
          max-width: 14ch;
          font-size: clamp(2.35rem, 8vw, 3.6rem);
        }

        .subscribe-form-block {
          max-width: 34rem;
        }
      }

      @media (max-width: 32rem) {
        .subscribe-stage__content {
          padding-inline: clamp(1.35rem, 6vw, 2rem);
        }

        .subscribe-message__wordmark {
          width: 8.5rem;
        }

        .subscribe-message h1 {
          font-size: clamp(2.1rem, 10vw, 3rem);
        }
      }

      @media (max-width: 23rem) {
        :global(:root) { --shell-gutter: 1rem; }
      }
    </style>
  </body>
</html>
