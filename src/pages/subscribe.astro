---
import SiteHead from "../components/SiteHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      title="Subscribe | Portfilo"
      description="Subscribe to Portfilo’s free business and technology newsletter. Business and tech in 7 minutes, three times a week."
    />
  </head>
  <body class="subscribe-page">
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <SiteHeader current="subscribe" />

    <main id="main-content" tabindex="-1">
      <section class="subscribe-campaign" aria-labelledby="subscribe-message">
        <div class="subscribe-campaign__visual">
          <img
            class="subscribe-campaign__image"
            src="/images/subscribe-16x9.png"
            alt=""
            width="1672"
            height="941"
            loading="eager"
            decoding="async"
            aria-hidden="true"
          />
          <div class="subscribe-campaign__shade" aria-hidden="true"></div>

          <div class="subscribe-message">
            <img
              class="subscribe-message__wordmark"
              src="/brand/portfilo-wordmark-light.svg"
              alt="Portfilo"
            />
            <h1 id="subscribe-message">
              <span>Some changes look small,</span>
              <span>until they reshape everything.</span>
              <span>We look closer.</span>
            </h1>
          </div>
        </div>

        <div class="subscribe-interface">
          <p class="subscribe-interface__title">GET THE NEWSLETTER</p>
          <div class="subscribe-interface__form">
            <NewsletterSignup
              id="subscribe-page-newsletter"
              variant="hero"
              showCopy={false}
              buttonLabel="SUBSCRIBE FREE"
            />
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />

    <style>
      @font-face {
        font-family: "Instrument Sans";
        font-style: normal;
        font-display: swap;
        font-weight: 400 700;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/instrument-sans:vf@5.3.0/latin-wght-normal.woff2") format("woff2-variations");
      }

      :global(:root) {
        --paper: #f8f6f1;
        --ink: #171614;
        --muted: #68645e;
        --line: #d4cfc6;
        --line-strong: #aaa39a;
        --accent: #0050a4;
        --correction: #b42318;
        --content-max: 84rem;
        --page-max: 84rem;
        --shell-gutter: clamp(1.25rem, 2.6vw, 2rem);
        --gutter: var(--shell-gutter);
        --sans: "Instrument Sans", "Helvetica Neue", Arial, sans-serif;
      }

      :global(*) { box-sizing: border-box; }

      :global(html) {
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
        font-synthesis: none;
      }

      :global(body.subscribe-page) {
        margin: 0;
        min-width: 0;
        min-height: 100svh;
        background: var(--paper);
      }

      :global(body.subscribe-page a:focus-visible) {
        outline: 3px solid var(--accent);
        outline-offset: 4px;
      }

      :global(body.subscribe-page main:focus) { outline: none; }

      .skip-link {
        position: fixed;
        z-index: 50;
        top: 0.75rem;
        left: 0.75rem;
        padding: 0.7rem 0.85rem;
        background: var(--paper);
        color: var(--ink);
        font: 550 0.75rem/1 var(--sans);
        text-decoration: none;
        transform: translateY(-200%);
      }

      .skip-link:focus { transform: translateY(0); }

      main {
        width: 100%;
        padding: clamp(2.5rem, 4.8vw, 5rem) var(--shell-gutter) clamp(3.5rem, 6vw, 6rem);
        background: var(--paper);
      }

      .subscribe-campaign {
        width: min(100%, var(--content-max));
        margin-inline: auto;
      }

      .subscribe-campaign__visual {
        position: relative;
        isolation: isolate;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        color: #fff;
      }

      .subscribe-campaign__image,
      .subscribe-campaign__shade {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
      }

      .subscribe-campaign__image {
        z-index: -2;
        display: block;
        object-fit: cover;
      }

      .subscribe-campaign__shade {
        z-index: -1;
        background: rgba(0, 0, 0, 0.28);
      }

      .subscribe-message {
        position: absolute;
        left: clamp(2.5rem, 6vw, 5.75rem);
        bottom: clamp(2.75rem, 6vw, 5.75rem);
        width: min(54rem, calc(100% - clamp(5rem, 12vw, 11.5rem)));
      }

      .subscribe-message__wordmark {
        display: block;
        width: clamp(10.5rem, 14vw, 13.5rem);
        height: auto;
      }

      .subscribe-message h1 {
        margin: clamp(1.8rem, 2.8vw, 2.8rem) 0 0;
        color: #fff;
        font: 590 clamp(2rem, 3.35vw, 3.45rem) / 0.98 var(--sans);
        letter-spacing: -0.052em;
      }

      .subscribe-message h1 span {
        display: block;
        white-space: nowrap;
      }

      .subscribe-interface {
        min-height: 7.75rem;
        padding: clamp(1.35rem, 2.4vw, 2rem) clamp(1.5rem, 3vw, 2.75rem);
        display: grid;
        grid-template-columns: minmax(12rem, 0.7fr) minmax(26rem, 1.3fr);
        gap: clamp(2rem, 5vw, 5rem);
        align-items: start;
        background: var(--ink);
        color: #fff;
      }

      .subscribe-interface__title {
        margin: 0.15rem 0 0;
        color: rgba(255, 255, 255, 0.82);
        font: 650 0.72rem/1.2 var(--sans);
        letter-spacing: 0.085em;
        text-transform: uppercase;
      }

      .subscribe-interface__form {
        width: 100%;
        max-width: 41rem;
        justify-self: end;
      }

      .subscribe-interface__form :global(.newsletter-signup__row) {
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 0;
        max-width: none;
      }

      .subscribe-interface__form :global(.newsletter-signup input) {
        border: 1px solid rgba(255, 255, 255, 0.42);
        border-right: 0;
        background: transparent;
        color: #fff;
      }

      .subscribe-interface__form :global(.newsletter-signup input::placeholder) {
        color: rgba(255, 255, 255, 0.58);
      }

      .subscribe-interface__form :global(.newsletter-signup button) {
        border-color: var(--accent);
        background: var(--accent);
        color: #fff;
      }

      .subscribe-interface__form :global(.newsletter-signup button:hover) {
        filter: brightness(0.95);
      }

      .subscribe-interface__form :global(.newsletter-signup input:focus-visible),
      .subscribe-interface__form :global(.newsletter-signup button:focus-visible) {
        outline-color: #fff;
      }

      .subscribe-interface__form :global(.newsletter-signup__note),
      .subscribe-interface__form :global(.newsletter-signup__status) {
        color: rgba(255, 255, 255, 0.58);
      }

      .subscribe-interface__form :global(.newsletter-signup__status[data-state="success"]) {
        color: #fff;
      }

      .subscribe-interface__form :global(.newsletter-signup__status[data-state="error"]) {
        color: #ffd8d3;
      }

      @media (max-width: 62rem) {
        .subscribe-message h1 {
          font-size: clamp(1.75rem, 3.8vw, 2.75rem);
        }

        .subscribe-interface {
          grid-template-columns: minmax(10rem, 0.55fr) minmax(22rem, 1.45fr);
          gap: clamp(1.5rem, 3.5vw, 3rem);
        }
      }

      @media (max-width: 48rem) {
        main {
          padding-top: 1.5rem;
          padding-bottom: 3.5rem;
        }

        .subscribe-message {
          left: clamp(1.5rem, 6vw, 2.5rem);
          bottom: clamp(1.6rem, 6vw, 2.6rem);
          width: calc(100% - clamp(3rem, 12vw, 5rem));
        }

        .subscribe-message__wordmark {
          width: clamp(8.5rem, 28vw, 11rem);
        }

        .subscribe-message h1 {
          margin-top: clamp(1.25rem, 4vw, 1.8rem);
          font-size: clamp(1.45rem, 5.3vw, 2.15rem);
        }

        .subscribe-message h1 span {
          white-space: normal;
        }

        .subscribe-interface {
          min-height: 0;
          grid-template-columns: 1fr;
          gap: 1.15rem;
          padding: 1.35rem;
        }

        .subscribe-interface__form {
          max-width: none;
          justify-self: stretch;
        }
      }

      @media (max-width: 32rem) {
        .subscribe-campaign__visual {
          aspect-ratio: 4 / 5;
        }

        .subscribe-campaign__image {
          object-position: 42% center;
        }

        .subscribe-message h1 {
          max-width: 16ch;
          font-size: clamp(1.7rem, 7.5vw, 2.25rem);
        }

        .subscribe-interface__form :global(.newsletter-signup__row) {
          grid-template-columns: 1fr;
          gap: 0.55rem;
        }

        .subscribe-interface__form :global(.newsletter-signup input) {
          border-right: 1px solid rgba(255, 255, 255, 0.42);
        }

        .subscribe-interface__form :global(.newsletter-signup button) {
          width: 100%;
        }
      }

      @media (max-width: 23rem) {
        :global(:root) { --shell-gutter: 1rem; }
      }
    </style>
  </body>
</html>
