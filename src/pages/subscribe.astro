---
const topics = ["Business", "Technology", "Startups", "AI", "Building"] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Subscribe to Portfilo Brief for new Portfilo stories, sent by email."
    />
    <meta name="theme-color" content="#f4f0e8" />
    <title>Subscribe | Portfilo</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Portfilo home">
        <span class="wordmark__inner">
          <span class="wordmark__port">Port</span><span class="wordmark__fi">fi</span><span class="wordmark__lo">lo</span>
        </span>
      </a>
      <p class="site-header__strapline">
        Business and tech, from the Philippines.
      </p>
      <p class="site-header__section">Subscribe</p>
    </header>

    <main id="main-content" tabindex="-1">
      <section class="subscribe-hero" aria-labelledby="subscribe-title">
        <p class="subscribe-kicker">Portfilo Brief / Email</p>

        <h1 id="subscribe-title">Portfilo Brief, in your inbox.</h1>

        <p class="subscribe-intro">
          New Portfilo stories, sent by email. No fixed schedule yet.
        </p>

        <div class="subscribe-index" aria-label="Portfilo Brief coverage">
          <p>What it covers</p>
          <ul>
            {topics.map((topic) => <li>{topic}</li>)}
          </ul>
        </div>
      </section>

      <section class="signup-section" aria-labelledby="signup-title">
        <div class="signup-section__label">
          <p>01 / Subscribe</p>
          <p>Email signup</p>
        </div>

        <div class="signup-section__main">
          <div class="signup-section__copy">
            <h2 id="signup-title">Get Portfilo Brief.</h2>
            <p>
              Enter your email. We’ll send a confirmation link before the
              subscription is active.
            </p>
          </div>

          <form
            class="subscribe-form"
            id="subscribe-form"
            action="/api/subscribe"
            method="post"
            novalidate
          >
            <div class="subscribe-form__field">
              <label for="subscribe-email">Email address</label>
              <div class="subscribe-form__row">
                <input
                  id="subscribe-email"
                  name="email"
                  type="email"
                  inputmode="email"
                  autocomplete="email"
                  maxlength="320"
                  placeholder="you@example.com"
                  required
                  aria-describedby="subscribe-hint subscribe-status"
                />
                <button type="submit">
                  <span data-submit-label>Subscribe</span>
                  <span aria-hidden="true">↗</span>
                </button>
              </div>
              <p class="subscribe-form__hint" id="subscribe-hint">
                No fixed schedule yet. Unsubscribe any time.
              </p>
              <p
                class="subscribe-form__status"
                id="subscribe-status"
                role="status"
                aria-live="polite"
              ></p>
            </div>

            <div class="subscribe-form__honeypot" aria-hidden="true">
              <label for="subscribe-company">Company</label>
              <input
                id="subscribe-company"
                name="company"
                type="text"
                tabindex="-1"
                autocomplete="off"
              />
            </div>
          </form>
        </div>
      </section>

      <section class="brief-section" aria-labelledby="brief-title">
        <div class="brief-section__inner">
          <p class="brief-section__index">02 / What to expect</p>

          <div class="brief-section__statement">
            <h2 id="brief-title">New stories, without another feed to check.</h2>
            <p>
              We have not set a fixed schedule yet. When there is something new to
              send, Portfilo Brief will bring it to your inbox.
            </p>
          </div>

          <dl class="brief-section__rules">
            <div>
              <dt>Coverage</dt>
              <dd>Business, tech, startups, AI, and building.</dd>
            </div>
            <div>
              <dt>Perspective</dt>
              <dd>From the Philippines. Not limited to Philippine subjects.</dd>
            </div>
            <div>
              <dt>Frequency</dt>
              <dd>No fixed schedule yet.</dd>
            </div>
          </dl>
        </div>
      </section>

      <section class="privacy-note" aria-labelledby="privacy-title">
        <p>03 / Your email</p>
        <div>
          <h2 id="privacy-title">Unsubscribe whenever you want.</h2>
          <p>
            beehiiv handles subscription delivery and unsubscribe requests. Every
            Portfilo Brief email includes an unsubscribe link.
          </p>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="site-footer__brand" aria-label="Portfilo">
        <span class="site-footer__port">Port</span><span class="site-footer__fi">fi</span><span class="site-footer__lo">lo</span>
      </div>
      <p>Portfilo / Philippines</p>
      <a href="/">Back to home</a>
    </footer>

    <script is:inline>
      const subscribeForm = document.querySelector("#subscribe-form");
      const emailInput = document.querySelector("#subscribe-email");
      const statusMessage = document.querySelector("#subscribe-status");
      const submitButton = subscribeForm?.querySelector('button[type="submit"]');
      const submitLabel = subscribeForm?.querySelector("[data-submit-label]");

      function setStatus(message, state = "") {
        if (!statusMessage) return;
        statusMessage.textContent = message;
        statusMessage.dataset.state = state;
      }

      function setSubmitting(isSubmitting) {
        if (!submitButton || !submitLabel) return;
        submitButton.disabled = isSubmitting;
        submitButton.setAttribute("aria-busy", String(isSubmitting));
        submitLabel.textContent = isSubmitting ? "Submitting…" : "Subscribe";
      }

      subscribeForm?.addEventListener("submit", async (event) => {
        event.preventDefault();

        if (!(emailInput instanceof HTMLInputElement)) return;

        emailInput.removeAttribute("aria-invalid");
        setStatus("");

        if (!emailInput.value.trim() || !emailInput.checkValidity()) {
          emailInput.setAttribute("aria-invalid", "true");
          setStatus("Enter a valid email address.", "error");
          emailInput.focus();
          return;
        }

        const formData = new FormData(subscribeForm);
        const payload = {
          email: String(formData.get("email") || "").trim(),
          company: String(formData.get("company") || "").trim(),
        };

        setSubmitting(true);

        try {
          const response = await fetch("/api/subscribe", {
            method: "POST",
            headers: {
              Accept: "application/json",
              "Content-Type": "application/json",
            },
            body: JSON.stringify(payload),
          });

          const result = await response.json().catch(() => null);

          if (!response.ok || !result?.ok) {
            throw new Error(
              result?.message || "We could not submit your email. Please try again.",
            );
          }

          subscribeForm.reset();
          setStatus(
            "Check your inbox. Confirm your email to finish subscribing to Portfilo Brief.",
            "success",
          );
        } catch (error) {
          setStatus(
            error instanceof Error
              ? error.message
              : "We could not submit your email. Please try again.",
            "error",
          );
        } finally {
          setSubmitting(false);
        }
      });
    </script>

    <style>
      @font-face {
        font-family: "Instrument Sans";
        font-style: normal;
        font-display: swap;
        font-weight: 400 700;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/instrument-sans:vf@5.3.0/latin-wght-normal.woff2")
          format("woff2-variations");
      }

      @font-face {
        font-family: "Source Serif 4";
        font-style: normal;
        font-display: swap;
        font-weight: 200 900;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/source-serif-4:vf@5.3.0/latin-wght-normal.woff2")
          format("woff2-variations");
      }

      @font-face {
        font-family: "IBM Plex Mono";
        font-style: normal;
        font-display: swap;
        font-weight: 400;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/ibm-plex-mono@5.3.0/latin-400-normal.woff2")
          format("woff2");
      }

      :global(:root) {
        --paper: #f4f0e8;
        --ink: #171614;
        --muted: #69655e;
        --line: #cbc5bb;
        --accent: #0050a4;
        --accent-on-ink: #8fc7ff;
        --correction: #b42318;
        --page-max: 100rem;
        --gutter: clamp(1.25rem, 3.3vw, 3.75rem);
        --grid-gap: clamp(0.8rem, 1.6vw, 1.5rem);
        --sans: "Instrument Sans", "Helvetica Neue", Arial, sans-serif;
        --serif: "Source Serif 4", Georgia, serif;
        --mono: "IBM Plex Mono", "Courier New", monospace;
      }

      :global(*) {
        box-sizing: border-box;
      }

      :global(html) {
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
        font-synthesis: none;
      }

      :global(body) {
        margin: 0;
        min-width: 0;
        background: var(--paper);
      }

      :global(a) {
        color: inherit;
      }

      :global(a:focus-visible),
      .subscribe-form input:focus-visible,
      .subscribe-form button:focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 4px;
      }

      :global(#main-content:focus) {
        outline: none;
      }

      .skip-link {
        position: fixed;
        z-index: 20;
        top: 0.75rem;
        left: 0.75rem;
        padding: 0.65rem 0.8rem;
        background: var(--ink);
        color: var(--paper);
        font: 400 0.75rem/1 var(--mono);
        text-decoration: none;
        transform: translateY(-200%);
      }

      .skip-link:focus {
        transform: translateY(0);
      }

      .site-header,
      .subscribe-hero,
      .signup-section,
      .brief-section__inner,
      .privacy-note,
      .site-footer {
        width: min(100%, var(--page-max));
        margin-inline: auto;
      }

      .site-header {
        padding: 1.05rem var(--gutter) 0.95rem;
        display: grid;
        grid-template-columns: 3fr 6fr 3fr;
        gap: var(--grid-gap);
        align-items: end;
        border-bottom: 1px solid var(--ink);
      }

      .wordmark {
        width: fit-content;
        display: inline-block;
        text-decoration: none;
      }

      .wordmark__inner {
        display: inline-block;
        white-space: nowrap;
        font: 700 clamp(1.75rem, 2.2vw, 2.3rem) / 0.9 var(--sans);
        letter-spacing: -0.085em;
        transform: skewX(-12deg);
        transform-origin: left center;
      }

      .wordmark__port,
      .wordmark__fi,
      .wordmark__lo,
      .site-footer__port,
      .site-footer__fi,
      .site-footer__lo {
        display: inline-block;
      }

      .wordmark__port,
      .site-footer__port {
        color: var(--ink);
      }

      .wordmark__fi,
      .site-footer__fi {
        color: var(--accent);
      }

      .wordmark__lo,
      .site-footer__lo {
        color: var(--correction);
      }

      .site-header__strapline,
      .site-header__section {
        margin: 0;
        color: var(--muted);
        font: 400 0.68rem/1.35 var(--mono);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .site-header__strapline {
        text-align: center;
      }

      .site-header__section {
        color: var(--ink);
        text-align: right;
      }

      .subscribe-hero {
        padding: clamp(4rem, 7vw, 7.5rem) var(--gutter)
          clamp(4.5rem, 8vw, 8rem);
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: var(--grid-gap);
        row-gap: clamp(2rem, 4vw, 4rem);
      }

      .subscribe-kicker {
        grid-column: 1 / 4;
        margin: 0.55rem 0 0;
        color: var(--accent);
        font: 400 0.67rem/1.4 var(--mono);
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }

      .subscribe-hero h1 {
        grid-column: 3 / 13;
        max-width: 11ch;
        margin: 0;
        font: 500 clamp(4rem, 8vw, 8.3rem) / 0.88 var(--sans);
        letter-spacing: -0.072em;
        text-wrap: balance;
      }

      .subscribe-intro {
        grid-column: 5 / 11;
        max-width: 42rem;
        margin: 0;
        font: 400 clamp(1.3rem, 1.75vw, 1.72rem) / 1.5 var(--serif);
      }

      .subscribe-index {
        grid-column: 1 / 13;
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
        padding-top: 0.8rem;
        border-top: 1px solid var(--ink);
      }

      .subscribe-index > p {
        grid-column: 1 / 4;
        margin: 0;
        color: var(--muted);
        font: 400 0.64rem/1.4 var(--mono);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .subscribe-index ul {
        grid-column: 5 / 13;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem 1.35rem;
        list-style: none;
        font: 500 clamp(1rem, 1.25vw, 1.18rem) / 1.25 var(--sans);
      }

      .subscribe-index li::before {
        content: "■";
        margin-right: 0.55rem;
        color: var(--accent);
        font-size: 0.46em;
        vertical-align: 0.16em;
      }

      .signup-section {
        padding: 0 var(--gutter) clamp(5.5rem, 9vw, 9rem);
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: var(--grid-gap);
      }

      .signup-section__label {
        grid-column: 1 / 4;
        padding-top: 0.75rem;
        border-top: 1px solid var(--ink);
        font: 400 0.64rem/1.5 var(--mono);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .signup-section__label p {
        margin: 0 0 0.4rem;
      }

      .signup-section__label p:last-child {
        color: var(--muted);
      }

      .signup-section__main {
        grid-column: 5 / 13;
        min-width: 0;
      }

      .signup-section__copy h2 {
        max-width: 12ch;
        margin: 0;
        font: 500 clamp(3rem, 5.6vw, 5.8rem) / 0.92 var(--sans);
        letter-spacing: -0.06em;
        text-wrap: balance;
      }

      .signup-section__copy p {
        max-width: 39rem;
        margin: clamp(1.6rem, 2.7vw, 2.5rem) 0 0;
        color: var(--muted);
        font: 400 clamp(1.08rem, 1.35vw, 1.28rem) / 1.6 var(--serif);
      }

      .subscribe-form {
        position: relative;
        margin-top: clamp(2.75rem, 5vw, 4.75rem);
        padding-top: clamp(1.15rem, 1.8vw, 1.5rem);
        border-top: 3px solid var(--accent);
      }

      .subscribe-form__field > label {
        display: block;
        margin-bottom: 0.75rem;
        font: 400 0.65rem/1.4 var(--mono);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .subscribe-form__row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        border-bottom: 1px solid var(--ink);
      }

      .subscribe-form input[type="email"] {
        min-width: 0;
        height: clamp(4.15rem, 5.2vw, 5.15rem);
        padding: 0 clamp(1rem, 1.8vw, 1.5rem) 0 0;
        border: 0;
        border-radius: 0;
        background: transparent;
        color: var(--ink);
        font: 500 clamp(1.5rem, 2.4vw, 2.35rem) / 1 var(--sans);
        letter-spacing: -0.035em;
        appearance: none;
      }

      .subscribe-form input[type="email"]::placeholder {
        color: #8a857c;
        opacity: 1;
      }

      .subscribe-form input[type="email"]:focus-visible {
        position: relative;
        z-index: 1;
        outline-offset: -1px;
      }

      .subscribe-form input[aria-invalid="true"] {
        box-shadow: inset 0 -3px 0 var(--correction);
      }

      .subscribe-form button {
        min-width: clamp(9.5rem, 13vw, 12.5rem);
        min-height: clamp(4.15rem, 5.2vw, 5.15rem);
        padding: 0 clamp(1.1rem, 2vw, 1.65rem);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        border: 0;
        border-radius: 0;
        background: var(--accent);
        color: white;
        font: 600 clamp(1rem, 1.2vw, 1.14rem) / 1 var(--sans);
        cursor: pointer;
      }

      .subscribe-form button span:last-child {
        font-size: 1.25em;
      }

      .subscribe-form button:hover {
        background: var(--ink);
      }

      .subscribe-form button:disabled {
        cursor: wait;
        opacity: 0.62;
      }

      .subscribe-form__hint,
      .subscribe-form__status {
        max-width: 42rem;
        font: 400 0.67rem/1.55 var(--mono);
      }

      .subscribe-form__hint {
        margin: 0.8rem 0 0;
        color: var(--muted);
      }

      .subscribe-form__status {
        min-height: 1.1em;
        margin: 1rem 0 0;
      }

      .subscribe-form__status:empty {
        margin-top: 0;
      }

      .subscribe-form__status[data-state="success"] {
        color: var(--accent);
      }

      .subscribe-form__status[data-state="error"] {
        color: var(--correction);
      }

      .subscribe-form__honeypot {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }

      .brief-section {
        width: 100%;
        background: var(--ink);
        color: var(--paper);
      }

      .brief-section__inner {
        padding: clamp(4.5rem, 8vw, 8rem) var(--gutter);
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
      }

      .brief-section__index {
        grid-column: 1 / 3;
        margin: 0;
        color: var(--accent-on-ink);
        font: 400 0.64rem/1.4 var(--mono);
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }

      .brief-section__statement {
        grid-column: 4 / 10;
      }

      .brief-section__statement h2 {
        max-width: 14ch;
        margin: 0;
        font: 500 clamp(3rem, 5.4vw, 5.6rem) / 0.94 var(--sans);
        letter-spacing: -0.06em;
        text-wrap: balance;
      }

      .brief-section__statement p {
        max-width: 42rem;
        margin: clamp(2rem, 3vw, 3rem) 0 0;
        color: #d7d2c9;
        font: 400 clamp(1.12rem, 1.4vw, 1.36rem) / 1.62 var(--serif);
      }

      .brief-section__rules {
        grid-column: 10 / 13;
        margin: 0;
        align-self: end;
        border-top: 1px solid #55524d;
        font: 400 0.67rem/1.55 var(--mono);
      }

      .brief-section__rules > div {
        padding: 0.8rem 0;
        border-bottom: 1px solid #55524d;
      }

      .brief-section__rules dt {
        margin-bottom: 0.3rem;
        color: var(--accent-on-ink);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .brief-section__rules dd {
        margin: 0;
        color: #d7d2c9;
      }

      .privacy-note {
        padding: clamp(4.5rem, 8vw, 8rem) var(--gutter);
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
        border-bottom: 1px solid var(--ink);
      }

      .privacy-note > p {
        grid-column: 1 / 4;
        margin: 0;
        color: var(--accent);
        font: 400 0.64rem/1.4 var(--mono);
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }

      .privacy-note > div {
        grid-column: 5 / 11;
      }

      .privacy-note h2 {
        max-width: 13ch;
        margin: 0;
        font: 500 clamp(2.8rem, 5vw, 5.1rem) / 0.95 var(--sans);
        letter-spacing: -0.058em;
        text-wrap: balance;
      }

      .privacy-note div > p {
        max-width: 42rem;
        margin: clamp(1.8rem, 3vw, 2.7rem) 0 0;
        font: 400 clamp(1.1rem, 1.35vw, 1.3rem) / 1.62 var(--serif);
      }

      .site-footer {
        padding: 1.2rem var(--gutter) 1.4rem;
        display: grid;
        grid-template-columns: 3fr 6fr 3fr;
        gap: var(--grid-gap);
        align-items: end;
        font: 400 0.64rem/1.45 var(--mono);
      }

      .site-footer__brand {
        width: fit-content;
        white-space: nowrap;
        font: 700 1.55rem/0.9 var(--sans);
        letter-spacing: -0.085em;
        transform: skewX(-12deg);
        transform-origin: left center;
      }

      .site-footer p {
        margin: 0;
        color: var(--muted);
        text-align: center;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .site-footer a {
        justify-self: end;
        text-decoration-color: var(--accent);
        text-decoration-thickness: 0.1em;
        text-underline-offset: 0.18em;
      }

      .site-footer a:hover {
        color: var(--accent);
      }

      @media (max-width: 64rem) {
        .subscribe-hero h1 {
          grid-column: 2 / 13;
        }

        .subscribe-intro {
          grid-column: 4 / 11;
        }

        .signup-section__main {
          grid-column: 4 / 13;
        }

        .brief-section__statement {
          grid-column: 3 / 10;
        }

        .brief-section__rules {
          grid-column: 10 / 13;
        }

        .privacy-note > div {
          grid-column: 4 / 11;
        }
      }

      @media (max-width: 50rem) {
        .site-header {
          grid-template-columns: 1fr auto;
          align-items: center;
          padding-top: 0.9rem;
        }

        .site-header__strapline {
          grid-column: 1 / -1;
          grid-row: 2;
          max-width: 32rem;
          padding-top: 0.55rem;
          text-align: left;
        }

        .site-header__section {
          grid-column: 2;
          grid-row: 1;
        }

        .subscribe-hero {
          display: block;
          padding-top: 3.6rem;
          padding-bottom: 4.5rem;
        }

        .subscribe-kicker {
          margin: 0 0 1.35rem;
        }

        .subscribe-hero h1 {
          max-width: none;
          font-size: clamp(3.35rem, 14vw, 5.3rem);
          line-height: 0.91;
          text-wrap: pretty;
        }

        .subscribe-intro {
          max-width: 36rem;
          margin-top: 2rem;
          font-size: 1.26rem;
        }

        .subscribe-index {
          display: block;
          margin-top: 3rem;
        }

        .subscribe-index > p {
          margin-bottom: 1rem;
        }

        .subscribe-index ul {
          gap: 0.7rem 1rem;
        }

        .signup-section {
          display: block;
          padding-bottom: 5rem;
        }

        .signup-section__label {
          max-width: 24rem;
          margin-bottom: 2.5rem;
        }

        .signup-section__copy h2 {
          max-width: none;
