---
import SiteHead from "../components/SiteHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      title="Subscribe | Portfilo"
      description="Subscribe to Portfilo’s free business and technology newsletter. The latest news in a 7-minute read, three times a week."
    />
  </head>
  <body class="subscribe-page">
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <SiteHeader current="subscribe" />

    <main id="main-content" tabindex="-1">
      <section class="subscribe-band" aria-labelledby="subscribe-title">
        <div class="subscribe-band__inner">
          <div class="subscribe-band__copy">
            <h1 id="subscribe-title">Business and tech, three times a week.</h1>
            <p>
              The latest news on companies, startups, products, markets, AI, and technology in a
              7-minute read.
            </p>
          </div>

          <div class="subscribe-band__form">
            <NewsletterSignup
              id="subscribe-page-newsletter"
              variant="hero"
              showCopy={false}
              buttonLabel="Subscribe free"
            />
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />

    <style>
      @font-face {
        font-family: "Instrument Sans";
        font-style: normal;
        font-display: swap;
        font-weight: 400 700;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/instrument-sans:vf@5.3.0/latin-wght-normal.woff2") format("woff2-variations");
      }

      :global(:root) {
        --paper: #f8f6f1;
        --ink: #171614;
        --muted: #68645e;
        --line: #d4cfc6;
        --line-strong: #aaa39a;
        --accent: #0050a4;
        --correction: #b42318;
        --content-max: 84rem;
        --shell-gutter: clamp(1.25rem, 2.6vw, 2rem);
        --sans: "Instrument Sans", "Helvetica Neue", Arial, sans-serif;
      }

      :global(*) { box-sizing: border-box; }

      :global(html) {
        background: var(--ink);
        color: var(--ink);
        font-family: var(--sans);
        font-synthesis: none;
      }

      :global(body.subscribe-page) {
        margin: 0;
        min-width: 0;
        background: var(--paper);
      }

      :global(body.subscribe-page a) { color: inherit; }
      :global(body.subscribe-page a:focus-visible) {
        outline: 3px solid var(--accent);
        outline-offset: 4px;
      }
      :global(body.subscribe-page main:focus) { outline: none; }

      .skip-link {
        position: fixed;
        z-index: 50;
        top: 0.75rem;
        left: 0.75rem;
        padding: 0.7rem 0.85rem;
        background: var(--ink);
        color: var(--paper);
        font: 550 0.75rem/1 var(--sans);
        text-decoration: none;
        transform: translateY(-200%);
      }

      .skip-link:focus { transform: translateY(0); }

      .subscribe-band {
        width: 100%;
        background: var(--accent);
        color: #fff;
      }

      .subscribe-band__inner {
        width: min(calc(100% - (2 * var(--shell-gutter))), var(--content-max));
        margin-inline: auto;
        padding: clamp(4.5rem, 8vw, 7rem) 0;
        display: grid;
        grid-template-columns: minmax(0, 52rem) minmax(19rem, 1fr);
        gap: clamp(2rem, 2.7vw, 2.5rem);
        align-items: center;
      }

      .subscribe-band__copy h1 {
        max-width: 16ch;
        margin: 0;
        color: #fff;
        font: 680 clamp(3rem, 4.6vw, 4.8rem) / 0.96 var(--sans);
        letter-spacing: -0.05em;
        text-wrap: balance;
      }

      .subscribe-band__copy p {
        max-width: 45rem;
        margin: 1rem 0 0;
        color: rgba(255, 255, 255, 0.8);
        font: 440 clamp(1rem, 1.2vw, 1.15rem) / 1.5 var(--sans);
      }

      .subscribe-band__form {
        width: 100%;
        max-width: none;
        min-width: 0;
        justify-self: stretch;
      }

      .subscribe-band__form :global(.newsletter-signup__row) {
        grid-template-columns: 1fr;
        gap: 0.55rem;
        max-width: none;
      }

      .subscribe-band__form :global(.newsletter-signup input) {
        border: 1px solid rgba(255, 255, 255, 0.42);
        background: rgba(255, 255, 255, 0.08);
        color: #fff;
      }

      .subscribe-band__form :global(.newsletter-signup input::placeholder) {
        color: rgba(255, 255, 255, 0.68);
      }

      .subscribe-band__form :global(.newsletter-signup button) {
        width: 100%;
        border-color: var(--paper);
        background: var(--paper);
        color: var(--accent);
      }

      .subscribe-band__form :global(.newsletter-signup button:hover) {
        filter: none;
        background: rgba(248, 246, 241, 0.9);
      }

      .subscribe-band__form :global(.newsletter-signup input:focus-visible),
      .subscribe-band__form :global(.newsletter-signup button:focus-visible) {
        outline-color: #fff;
      }

      .subscribe-band__form :global(.newsletter-signup__note),
      .subscribe-band__form :global(.newsletter-signup__status) {
        color: rgba(255, 255, 255, 0.72);
      }

      .subscribe-band__form :global(.newsletter-signup__status[data-state="success"]) {
        color: #fff;
      }

      .subscribe-band__form :global(.newsletter-signup__status[data-state="error"]) {
        color: #ffe1dc;
      }

      @media (max-width: 56rem) {
        .subscribe-band__inner {
          grid-template-columns: 1fr;
          gap: 2.25rem;
          padding-block: clamp(3.5rem, 8vw, 5rem);
        }

        .subscribe-band__copy h1 { max-width: 14ch; }
        .subscribe-band__form { max-width: 36rem; }
      }

      @media (max-width: 23rem) {
        :global(:root) { --shell-gutter: 1rem; }
      }
    </style>
  </body>
</html>
