---
import SiteHead from "../components/SiteHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      title="Subscribe | Portfilo"
      description="Subscribe to Portfilo’s free business and technology newsletter. Business and tech in 7 minutes, three times a week."
    />
  </head>
  <body class="subscribe-page">
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <SiteHeader current="subscribe" />

    <main id="main-content" tabindex="-1">
      <section class="subscribe-campaign" aria-labelledby="subscribe-message">
        <div class="subscribe-campaign__visual">
          <img
            class="subscribe-campaign__image"
            src="/images/subscribe-16x9.png"
            alt=""
            width="1672"
            height="941"
            loading="eager"
            decoding="async"
            aria-hidden="true"
          />
          <div class="subscribe-campaign__shade" aria-hidden="true"></div>

          <div class="subscribe-form-block">
            <NewsletterSignup
              id="subscribe-page-newsletter"
              variant="hero"
              showCopy={false}
              buttonLabel="SUBSCRIBE"
            />
          </div>

          <div class="subscribe-message">
            <img
              class="subscribe-message__wordmark"
              src="/brand/portfilo-wordmark-light.svg"
              alt="Portfilo"
            />
            <h1 id="subscribe-message">
              <span>Some changes look small,</span>
              <span>until they reshape everything.</span>
              <span>We look closer.</span>
            </h1>
          </div>
        </div>
      </section>
    </main>

    <style>
      @font-face {
        font-family: "Instrument Sans";
        font-style: normal;
        font-display: swap;
        font-weight: 400 700;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/instrument-sans:vf@5.3.0/latin-wght-normal.woff2") format("woff2-variations");
      }

      :global(:root) {
        --paper: #f8f6f1;
        --ink: #171614;
        --muted: #68645e;
        --line: #d4cfc6;
        --line-strong: #aaa39a;
        --accent: #0050a4;
        --correction: #b42318;
        --content-max: 84rem;
        --page-max: 84rem;
        --shell-gutter: clamp(1.25rem, 2.6vw, 2rem);
        --gutter: var(--shell-gutter);
        --sans: "Instrument Sans", "Helvetica Neue", Arial, sans-serif;
      }

      :global(*) { box-sizing: border-box; }

      :global(html) {
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
        font-synthesis: none;
      }

      :global(body.subscribe-page) {
        margin: 0;
        min-width: 0;
        min-height: 100svh;
        background: var(--paper);
      }

      :global(body.subscribe-page a:focus-visible) {
        outline: 3px solid var(--accent);
        outline-offset: 4px;
      }

      :global(body.subscribe-page main:focus) { outline: none; }

      .skip-link {
        position: fixed;
        z-index: 50;
        top: 0.75rem;
        left: 0.75rem;
        padding: 0.7rem 0.85rem;
        background: var(--paper);
        color: var(--ink);
        font: 550 0.75rem/1 var(--sans);
        text-decoration: none;
        transform: translateY(-200%);
      }

      .skip-link:focus { transform: translateY(0); }

      main {
        width: 100%;
        padding: clamp(2.5rem, 4.8vw, 5rem) var(--shell-gutter) clamp(3.5rem, 6vw, 6rem);
        background: var(--paper);
      }

      .subscribe-campaign {
        width: min(100%, var(--content-max));
        margin-inline: auto;
      }

      .subscribe-campaign__visual {
        --campaign-inset: clamp(2.5rem, 5vw, 4.75rem);
        position: relative;
        isolation: isolate;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        color: #fff;
      }

      .subscribe-campaign__image,
      .subscribe-campaign__shade {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
      }

      .subscribe-campaign__image {
        z-index: -2;
        display: block;
        object-fit: cover;
      }

      .subscribe-campaign__shade {
        z-index: -1;
        background: rgba(0, 0, 0, 0.25);
      }

      .subscribe-form-block {
        position: absolute;
        right: var(--campaign-inset);
        bottom: var(--campaign-inset);
        width: clamp(21.5rem, 25.5vw, 24.5rem);
      }

      .subscribe-form-block :global(.newsletter-signup__row) {
        grid-template-columns: minmax(0, 1fr) 8.5rem;
        gap: 0;
        max-width: none;
      }

      .subscribe-form-block :global(.newsletter-signup input) {
        border: 1px solid rgba(255, 255, 255, 0.52);
        border-right: 0;
        background: rgba(0, 0, 0, 0.22);
        color: #fff;
      }

      .subscribe-form-block :global(.newsletter-signup input::placeholder) {
        color: rgba(255, 255, 255, 0.7);
      }

      .subscribe-form-block :global(.newsletter-signup button) {
        display: grid;
        place-items: center;
        width: 8.5rem;
        min-width: 8.5rem;
        padding-inline: 0;
        border-color: var(--paper);
        background: var(--paper);
        color: var(--ink);
        font-weight: 650;
        text-align: center;
      }

      .subscribe-form-block :global(.newsletter-signup button:hover) {
        filter: none;
        background: rgba(248, 246, 241, 0.9);
      }

      .subscribe-form-block :global(.newsletter-signup input:focus-visible),
      .subscribe-form-block :global(.newsletter-signup button:focus-visible) {
        outline-color: #fff;
      }

      .subscribe-form-block :global(.newsletter-signup__note) {
        display: none;
      }

      .subscribe-form-block :global(.newsletter-signup__status) {
        color: rgba(255, 255, 255, 0.72);
      }

      .subscribe-form-block :global(.newsletter-signup__status:empty) {
        display: none;
      }

      .subscribe-form-block :global(.newsletter-signup__status:not(:empty)) {
        margin-top: 0.5rem;
      }

      .subscribe-form-block :global(.newsletter-signup__status[data-state="success"]) {
        color: #fff;
      }

      .subscribe-form-block :global(.newsletter-signup__status[data-state="error"]) {
        color: #ffd8d3;
      }

      .subscribe-message {
        position: absolute;
        top: var(--campaign-inset);
        left: var(--campaign-inset);
        width: min(54rem, calc(100% - (2 * var(--campaign-inset))));
      }

      .subscribe-message__wordmark {
        display: block;
        width: clamp(13rem, 18vw, 17rem);
        height: auto;
        transform: translate(-0.4rem, -0.4rem);
      }

      .subscribe-message h1 {
        margin: clamp(2.5rem, 3.2vw, 3.25rem) 0 0;
        color: #fff;
        font: 590 clamp(1.55rem, 2.15vw, 2.25rem) / 1.03 var(--sans);
        letter-spacing: -0.045em;
      }

      .subscribe-message h1 span {
        display: block;
        white-space: nowrap;
      }

      @media (min-width: 32.01rem) {
        .subscribe-form-block :global(.newsletter-signup input),
        .subscribe-form-block :global(.newsletter-signup button) {
          height: 2.75rem;
          min-height: 2.75rem;
        }
      }

      @media (max-width: 62rem) {
        .subscribe-campaign__visual {
          --campaign-inset: clamp(2rem, 4vw, 3rem);
        }

        .subscribe-form-block {
          width: clamp(20rem, 30vw, 22rem);
        }

        .subscribe-message__wordmark {
          width: clamp(11.5rem, 20vw, 13.5rem);
        }

        .subscribe-message h1 {
          font-size: clamp(1.45rem, 2.9vw, 2rem);
        }
      }

      @media (max-width: 48rem) {
        main {
          padding-top: 1.5rem;
          padding-bottom: 3.5rem;
        }

        .subscribe-campaign__visual {
          --campaign-inset: clamp(1.25rem, 4vw, 1.75rem);
        }

        .subscribe-form-block {
          width: min(21rem, calc(100% - (2 * var(--campaign-inset))));
        }

        .subscribe-message {
          width: calc(100% - (2 * var(--campaign-inset)));
        }

        .subscribe-message__wordmark {
          width: clamp(10rem, 30vw, 12rem);
        }

        .subscribe-message h1 {
          margin-top: clamp(1.6rem, 4.5vw, 2rem);
          font-size: clamp(1.2rem, 4.3vw, 1.7rem);
        }
      }

      @media (max-width: 32rem) {
        .subscribe-campaign__visual {
          --campaign-inset: 1rem;
        }

        .subscribe-campaign__image {
          object-position: 42% center;
        }

        .subscribe-form-block {
          left: var(--campaign-inset);
          width: auto;
        }

        .subscribe-form-block :global(.newsletter-signup input),
        .subscribe-form-block :global(.newsletter-signup button) {
          min-height: 2.7rem;
          font-size: 0.72rem;
        }

        .subscribe-form-block :global(.newsletter-signup button) {
          padding-inline: 0;
        }

        .subscribe-message {
          width: calc(100% - (2 * var(--campaign-inset)));
        }

        .subscribe-message__wordmark {
          width: clamp(7rem, 30vw, 8.5rem);
        }

        .subscribe-message h1 {
          max-width: none;
          margin-top: 1rem;
          font-size: clamp(0.95rem, 4vw, 1.2rem);
          line-height: 1.03;
        }

        .subscribe-message h1 span {
          white-space: nowrap;
        }
      }

      @media (max-width: 23rem) {
        :global(:root) { --shell-gutter: 1rem; }
      }
    </style>
  </body>
</html>
