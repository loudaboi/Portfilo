---
import SiteHead from "../components/SiteHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      title="Subscribe | Portfilo"
      description="Subscribe to Portfilo’s free business and technology newsletter. Business and tech in 7 minutes, three times a week."
    />
  </head>
  <body class="subscribe-page">
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <SiteHeader current="subscribe" />

    <main id="main-content" tabindex="-1">
      <section class="subscribe-stage" aria-labelledby="subscribe-message">
        <img
          class="subscribe-stage__image"
          src="/images/subscribe-16x9.png"
          alt=""
          width="1672"
          height="941"
          loading="eager"
          decoding="async"
          aria-hidden="true"
        />
        <div class="subscribe-stage__shade" aria-hidden="true"></div>

        <div class="subscribe-stage__content">
          <div class="subscribe-message">
            <img
              class="subscribe-message__wordmark"
              src="/brand/portfilo-wordmark-light.svg"
              alt="Portfilo"
            />
            <h1 id="subscribe-message">
              <span>Some changes look small,</span>
              <span>until they reshape everything.</span>
              <span>We look closer.</span>
            </h1>
          </div>

          <div class="subscribe-form-block">
            <p class="subscribe-form-block__title">GET THE NEWSLETTER</p>
            <NewsletterSignup
              id="subscribe-page-newsletter"
              variant="hero"
              showCopy={false}
              buttonLabel="SUBSCRIBE FREE"
            />
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />

    <style>
      @font-face {
        font-family: "Instrument Sans";
        font-style: normal;
        font-display: swap;
        font-weight: 400 700;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/instrument-sans:vf@5.3.0/latin-wght-normal.woff2") format("woff2-variations");
      }

      :global(:root) {
        --paper: #f8f6f1;
        --ink: #171614;
        --muted: #68645e;
        --line: #d4cfc6;
        --line-strong: #aaa39a;
        --accent: #0050a4;
        --correction: #b42318;
        --content-max: 84rem;
        --page-max: 84rem;
        --shell-gutter: clamp(1.25rem, 2.6vw, 2rem);
        --gutter: var(--shell-gutter);
        --sans: "Instrument Sans", "Helvetica Neue", Arial, sans-serif;
      }

      :global(*) { box-sizing: border-box; }

      :global(html) {
        background: var(--ink);
        color: var(--ink);
        font-family: var(--sans);
        font-synthesis: none;
      }

      :global(body.subscribe-page) {
        margin: 0;
        min-width: 0;
        min-height: 100svh;
        background: var(--paper);
      }

      :global(body.subscribe-page .site-header) {
        width: min(calc(100% - (2 * var(--shell-gutter))), var(--content-max));
        padding-inline: 0;
        background: var(--paper);
        color: var(--ink);
      }

      :global(body.subscribe-page a:focus-visible) {
        outline: 3px solid var(--accent);
        outline-offset: 4px;
      }

      :global(body.subscribe-page main:focus) { outline: none; }

      .skip-link {
        position: fixed;
        z-index: 50;
        top: 0.75rem;
        left: 0.75rem;
        padding: 0.7rem 0.85rem;
        background: var(--paper);
        color: var(--ink);
        font: 550 0.75rem/1 var(--sans);
        text-decoration: none;
        transform: translateY(-200%);
      }

      .skip-link:focus { transform: translateY(0); }

      main {
        width: 100%;
        padding: clamp(2.25rem, 4vw, 4rem) var(--shell-gutter);
        background: var(--paper);
      }

      .subscribe-stage {
        position: relative;
        isolation: isolate;
        width: min(100%, var(--content-max));
        margin-inline: auto;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        color: #fff;
      }

      .subscribe-stage__image,
      .subscribe-stage__shade {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
      }

      .subscribe-stage__image {
        z-index: -2;
        display: block;
        object-fit: cover;
      }

      .subscribe-stage__shade {
        z-index: -1;
        background: rgba(0, 0, 0, 0.4);
      }

      .subscribe-stage__content {
        width: 100%;
        height: 100%;
        display: grid;
        grid-template-columns: minmax(0, 1.06fr) minmax(22rem, 0.94fr);
        gap: clamp(2rem, 3vw, 3.25rem);
        align-content: center;
        align-items: start;
        padding: clamp(2.75rem, 5vw, 5rem);
      }

      .subscribe-message,
      .subscribe-form-block {
        min-width: 0;
      }

      .subscribe-message__wordmark {
        display: block;
        width: clamp(11.5rem, 16vw, 15rem);
        height: auto;
      }

      .subscribe-message h1,
      .subscribe-form-block__title {
        color: #fff;
        font: 650 clamp(1.55rem, 1.9vw, 2rem) / 1.08 var(--sans);
        letter-spacing: -0.035em;
      }

      .subscribe-message h1 {
        margin: clamp(2.25rem, 2.7vw, 2.75rem) 0 0;
      }

      .subscribe-message h1 span {
        display: block;
        white-space: nowrap;
      }

      .subscribe-form-block {
        width: 100%;
        max-width: 30rem;
        justify-self: start;
      }

      .subscribe-form-block__title {
        margin: 0;
        max-width: none;
        white-space: nowrap;
      }

      .subscribe-form-block :global(.newsletter-signup) {
        margin-top: clamp(2.25rem, 2.7vw, 2.75rem);
      }

      .subscribe-form-block :global(.newsletter-signup__row) {
        grid-template-columns: 1fr;
        gap: 0.55rem;
        max-width: none;
      }

      .subscribe-form-block :global(.newsletter-signup input) {
        border: 1px solid rgba(255, 255, 255, 0.52);
        background: rgba(0, 0, 0, 0.22);
        color: #fff;
      }

      .subscribe-form-block :global(.newsletter-signup input::placeholder) {
        color: rgba(255, 255, 255, 0.7);
      }

      .subscribe-form-block :global(.newsletter-signup button) {
        width: 100%;
        border-color: var(--paper);
        background: var(--paper);
        color: var(--ink);
      }

      .subscribe-form-block :global(.newsletter-signup button:hover) {
        filter: none;
        background: rgba(248, 246, 241, 0.9);
      }

      .subscribe-form-block :global(.newsletter-signup input:focus-visible),
      .subscribe-form-block :global(.newsletter-signup button:focus-visible) {
        outline-color: #fff;
      }

      .subscribe-form-block :global(.newsletter-signup__note),
      .subscribe-form-block :global(.newsletter-signup__status) {
        color: rgba(255, 255, 255, 0.7);
      }

      .subscribe-form-block :global(.newsletter-signup__status[data-state="success"]) {
        color: #fff;
      }

      .subscribe-form-block :global(.newsletter-signup__status[data-state="error"]) {
        color: #ffe1dc;
      }

      @media (min-width: 44.01rem) {
        :global(body.subscribe-page) {
          height: 100svh;
          display: flex;
          flex-direction: column;
          overflow: hidden;
        }

        :global(body.subscribe-page .site-header),
        :global(body.subscribe-page .site-footer) {
          flex: 0 0 auto;
        }

        main {
          flex: 1 1 auto;
          min-height: 0;
          display: grid;
          place-items: center;
          padding-block: clamp(0.75rem, 1.5vh, 1.1rem);
        }

        .subscribe-stage {
          width: min(100%, var(--content-max), calc(177.7778svh - 16.8889rem));
        }
      }

      @media (max-width: 56rem) {
        .subscribe-stage__content {
          grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.9fr);
          gap: clamp(1.75rem, 3vw, 2.5rem);
          padding: clamp(2rem, 4.5vw, 3rem);
        }

        .subscribe-message__wordmark {
          width: clamp(9.5rem, 19vw, 12rem);
        }

        .subscribe-message h1,
        .subscribe-form-block__title {
          font-size: clamp(1.3rem, 2.65vw, 1.7rem);
        }
      }

      @media (max-width: 44rem) {
        main {
          padding: 1.25rem var(--shell-gutter);
        }

        .subscribe-stage {
          aspect-ratio: auto;
          min-height: clamp(38rem, 112svh, 46rem);
        }

        .subscribe-stage__image {
          object-position: 44% center;
        }

        .subscribe-stage__content {
          grid-template-columns: 1fr;
          align-content: center;
          gap: clamp(3rem, 10vw, 4.5rem);
          padding: clamp(2rem, 7vw, 3.25rem);
        }

        .subscribe-message__wordmark {
          width: clamp(10rem, 34vw, 12rem);
        }

        .subscribe-message h1,
        .subscribe-form-block__title {
          font-size: clamp(1.55rem, 6.2vw, 2rem);
        }

        .subscribe-message h1 span,
        .subscribe-form-block__title {
          white-space: normal;
        }

        .subscribe-form-block {
          max-width: 34rem;
          justify-self: start;
        }
      }

      @media (max-width: 23rem) {
        :global(:root) { --shell-gutter: 1rem; }
      }
    </style>
  </body>
</html>