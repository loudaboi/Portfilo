---
import { getCollection } from "astro:content";
import SiteHead from "../../components/SiteHead.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
const entries = (await getCollection("work", ({ data }) => data.status === "published")).sort((a,b)=>b.data.year-a.data.year);
---
<!doctype html>
<html lang="en">
<head><SiteHead title="Work | Portfilo" description="Work | Portfilo" robots="noindex" /></head>
<body><a class="skip-link" href="#main-content">Skip to Work</a><SiteHeader current="work" />
<main id="main-content" tabindex="-1" class="work"><header><p>Work / {String(entries.length).padStart(2,"0")}</p><h1>Work</h1></header>
{entries.length===0?<p class="work__empty">No case studies published yet.</p>:<div class="work__list">{entries.map((project,index)=><article><span>{String(index+1).padStart(2,"0")} / {project.data.year}</span><h2><a href={`/work/${project.id}`}>{project.data.title}</a></h2><p>{project.data.dek}</p></article>)}</div>}</main>
<SiteFooter /></body></html>
<style>
.work{width:min(calc(100% - (2 * var(--shell-gutter))),var(--page-max));min-height:60vh;margin-inline:auto;padding-block:clamp(4rem,8vw,8rem)}
.work header p,.work__list span{margin:0;color:var(--muted-silver);font:400 .68rem/1.3 var(--mono);text-transform:uppercase}
.work header h1{margin:var(--space-4) 0 0;color:var(--cold-white);font:650 clamp(4rem,10vw,10rem)/.82 var(--sans);font-variation-settings:"wdth" 80,"wght" 650;letter-spacing:-.075em}
.work__empty{margin-top:clamp(4rem,10vw,10rem);color:var(--muted-silver);font:430 1rem/1.6 var(--sans)}
.work__list{margin-top:clamp(4rem,8vw,8rem);border-top:1px solid var(--line)}.work__list article{padding-block:clamp(2rem,5vw,5rem);border-bottom:1px solid var(--line)}
.work__list h2{max-width:18ch;margin:var(--space-4) 0 0;font:630 clamp(2.5rem,6vw,6.5rem)/.9 var(--sans);letter-spacing:-.065em}.work__list h2 a{color:var(--cold-white);text-decoration:none}
.work__list p{max-width:54ch;margin:var(--space-4) 0 0;color:var(--muted-silver);font:430 1rem/1.55 var(--sans)}
</style>
