---
import SiteHead from "../components/SiteHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      title="Privacy | Portfilo"
      description="How Portfilo handles information submitted through the current website and Portfilo Brief signup."
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <SiteHeader />

    <main id="main-content" tabindex="-1">
      <section class="privacy-hero" aria-labelledby="privacy-title">
        <p class="privacy-kicker">Privacy / Portfilo</p>
        <h1 id="privacy-title">Privacy</h1>
        <p class="privacy-intro">
          This page explains how Portfilo handles information submitted through the
          current website.
        </p>
      </section>

      <section class="privacy-section" aria-labelledby="newsletter-title">
        <p class="privacy-section__index">01 / Newsletter signup</p>
        <div class="privacy-section__body">
          <h2 id="newsletter-title">Portfilo Brief</h2>
          <p>
            When you subscribe to Portfilo Brief, Portfilo receives the email address
            you submit and forwards the signup to beehiiv.
          </p>
          <p>
            beehiiv handles confirmation, subscriber records, newsletter delivery,
            and unsubscribe requests for Portfilo v0. The Portfilo website does not
            maintain a separate subscriber database.
          </p>
        </div>
      </section>

      <section class="privacy-section" aria-labelledby="providers-title">
        <p class="privacy-section__index">02 / Service providers</p>
        <div class="privacy-section__body">
          <h2 id="providers-title">Infrastructure</h2>
          <p>
            Cloudflare hosts the website and the newsletter signup endpoint. beehiiv
            operates the newsletter infrastructure. These providers may process the
            technical or subscriber information needed to provide those services.
          </p>
        </div>
      </section>

      <section class="privacy-section" aria-labelledby="choices-title">
        <p class="privacy-section__index">03 / Your choices</p>
        <div class="privacy-section__body">
          <h2 id="choices-title">Unsubscribe</h2>
          <p>
            Every Portfilo Brief email includes an unsubscribe link. You can use it
            at any time to stop receiving the newsletter.
          </p>
        </div>
      </section>

      <p class="privacy-updated">Last updated: 2 September 2026.</p>
    </main>

    <SiteFooter />

    <style>
      @font-face {
        font-family: "Instrument Sans";
        font-style: normal;
        font-display: swap;
        font-weight: 400 700;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/instrument-sans:vf@5.3.0/latin-wght-normal.woff2") format("woff2-variations");
      }
      @font-face {
        font-family: "Source Serif 4";
        font-style: normal;
        font-display: swap;
        font-weight: 200 900;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/source-serif-4:vf@5.3.0/latin-wght-normal.woff2") format("woff2-variations");
      }
      @font-face {
        font-family: "IBM Plex Mono";
        font-style: normal;
        font-display: swap;
        font-weight: 400;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/ibm-plex-mono@5.3.0/latin-400-normal.woff2") format("woff2");
      }

      :global(:root) {
        --paper: #f4f0e8;
        --ink: #171614;
        --muted: #69655e;
        --line: #cbc5bb;
        --accent: #0050a4;
        --correction: #b42318;
        --page-max: 100rem;
        --gutter: clamp(1.25rem, 3.3vw, 3.75rem);
        --grid-gap: clamp(0.8rem, 1.6vw, 1.5rem);
        --sans: "Instrument Sans", "Helvetica Neue", Arial, sans-serif;
        --serif: "Source Serif 4", Georgia, serif;
        --mono: "IBM Plex Mono", "Courier New", monospace;
      }

      :global(*) { box-sizing: border-box; }
      :global(html) { background: var(--paper); color: var(--ink); font-family: var(--sans); font-synthesis: none; }
      :global(body) { margin: 0; min-width: 0; background: var(--paper); }
      :global(a) { color: inherit; }
      :global(a:focus-visible) { outline: 3px solid var(--accent); outline-offset: 4px; }
      :global(#main-content:focus) { outline: none; }

      .skip-link {
        position: fixed;
        z-index: 20;
        top: 0.75rem;
        left: 0.75rem;
        padding: 0.65rem 0.8rem;
        background: var(--ink);
        color: var(--paper);
        font: 400 0.75rem/1 var(--mono);
        text-decoration: none;
        transform: translateY(-200%);
      }
      .skip-link:focus { transform: translateY(0); }

      .privacy-hero,
      .privacy-section,
      .privacy-updated {
        width: min(100%, var(--page-max));
        margin-inline: auto;
      }

      .privacy-hero {
        padding: clamp(4rem, 8vw, 8rem) var(--gutter) clamp(4rem, 7vw, 6.5rem);
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
      }
      .privacy-kicker {
        grid-column: 1 / 4;
        margin: 0;
        color: var(--accent);
        font: 400 0.66rem/1.4 var(--mono);
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }
      .privacy-hero h1 {
        grid-column: 5 / 12;
        margin: 0;
        font: 500 clamp(3.8rem, 7vw, 7rem) / 0.92 var(--sans);
        letter-spacing: -0.065em;
      }
      .privacy-intro {
        grid-column: 5 / 11;
        margin: clamp(1.8rem, 3vw, 2.8rem) 0 0;
        color: var(--muted);
        font: 400 clamp(1.15rem, 1.45vw, 1.4rem) / 1.58 var(--serif);
      }

      .privacy-section {
        padding: clamp(2.5rem, 4vw, 4rem) var(--gutter);
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
        border-top: 1px solid var(--line);
      }
      .privacy-section__index {
        grid-column: 1 / 4;
        margin: 0;
        color: var(--muted);
        font: 400 0.64rem/1.45 var(--mono);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .privacy-section__body { grid-column: 5 / 11; }
      .privacy-section h2 {
        margin: 0 0 1.4rem;
        font: 500 clamp(1.8rem, 2.8vw, 2.8rem) / 1 var(--sans);
        letter-spacing: -0.045em;
      }
      .privacy-section p:not(.privacy-section__index) {
        margin: 0;
        color: var(--muted);
        font: 400 1.05rem/1.65 var(--serif);
      }
      .privacy-section p:not(.privacy-section__index) + p {
        margin-top: 1rem;
      }

      .privacy-updated {
        padding: 2rem var(--gutter) clamp(4rem, 7vw, 7rem);
        border-top: 1px solid var(--line);
        color: var(--muted);
        font: 400 0.64rem/1.45 var(--mono);
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      @media (max-width: 50rem) {
        .privacy-hero,
        .privacy-section { display: block; }
        .privacy-kicker,
        .privacy-section__index { margin-bottom: 1.6rem; }
        .privacy-hero h1 { font-size: clamp(3.5rem, 15vw, 5.2rem); }
        .privacy-intro { max-width: 36rem; }
        .privacy-section__body { max-width: 42rem; }
      }

      @media (prefers-reduced-motion: reduce) {
        .skip-link { transition: none; }
      }
    </style>
  </body>
</html>
