---
import SiteHead from "../components/SiteHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      title="Subscription confirmed | Portfilo"
      description="Your Portfilo newsletter subscription is confirmed."
      robots="noindex"
      canonical={false}
      social={false}
    />
  </head>
  <body class="utility-page">
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <SiteHeader />

    <main id="main-content" tabindex="-1">
      <section class="utility-panel" aria-labelledby="confirmation-title">
        <p class="utility-kicker">Confirmed</p>
        <h1 id="confirmation-title">Subscription confirmed.</h1>
        <p class="utility-copy">You’re subscribed to the Portfilo newsletter.</p>
        <a class="utility-action" href="/stories">Browse stories <span aria-hidden="true">↗</span></a>
      </section>
    </main>

    <SiteFooter />

    <style>
      .utility-panel {
        width: min(calc(100% - (2 * var(--shell-gutter))), 54rem);
        min-height: clamp(26rem, 58vh, 38rem);
        margin-inline: auto;
        padding: clamp(3.5rem, 7vw, 6.5rem) 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      .utility-kicker,
      .utility-copy,
      .utility-panel h1 {
        margin: 0;
      }

      .utility-kicker {
        color: var(--accent);
        font: 600 0.7rem/1.3 var(--sans);
        letter-spacing: 0.07em;
        text-transform: uppercase;
      }

      .utility-panel h1 {
        max-width: 13ch;
        margin-top: 0.85rem;
        font: 670 clamp(2.7rem, 1.35rem + 3.5vw, 5rem) / 0.95 var(--sans);
        letter-spacing: -0.055em;
        text-wrap: balance;
      }

      .utility-copy {
        max-width: 36rem;
        margin-top: clamp(1.25rem, 2vw, 1.75rem);
        color: var(--muted);
        font: 400 clamp(1.05rem, 0.95rem + 0.25vw, 1.2rem) / 1.6 var(--serif);
      }

      .utility-action {
        width: fit-content;
        min-height: 2.75rem;
        margin-top: clamp(1.8rem, 3vw, 2.5rem);
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        border-bottom: 1px solid var(--ink);
        font: 600 0.9rem/1.2 var(--sans);
        text-decoration: none;
      }

      .utility-action span {
        color: var(--accent);
      }

      .utility-action:hover {
        color: var(--accent);
      }

      @media (max-width: 40rem) {
        .utility-panel {
          min-height: 24rem;
          padding-block: 3.5rem 4.5rem;
          justify-content: flex-start;
        }

        .utility-panel h1 {
          font-size: clamp(2.45rem, 11vw, 3.35rem);
        }
      }
    </style>
  </body>
</html>
