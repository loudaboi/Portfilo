---
import SiteHead from "../components/SiteHead.astro";import SiteHeader from "../components/SiteHeader.astro";import SiteFooter from "../components/SiteFooter.astro";
---
<!doctype html><html lang="en"><head><SiteHead title="Contact | Portfilo" description="Contact | Portfilo" robots="noindex"/></head><body>
<a class="skip-link" href="#main-content">Skip to Contact</a><SiteHeader current="contact"/>
<main id="main-content" tabindex="-1" class="contact"><p>Contact</p><h1>Contact</h1><div class="contact__status"><span>01</span><p>Contact details are being finalized before release.</p></div></main><SiteFooter/></body></html>
<style>
.contact{width:min(calc(100% - (2 * var(--shell-gutter))),var(--page-max));min-height:68vh;margin-inline:auto;padding-block:clamp(4rem,8vw,8rem)}
.contact>p,.contact__status span{margin:0;color:var(--muted-silver);font:400 .68rem/1.3 var(--mono);text-transform:uppercase}
.contact h1{margin:var(--space-4) 0 0;color:var(--cold-white);font:650 clamp(4rem,10vw,10rem)/.82 var(--sans);font-variation-settings:"wdth" 80,"wght" 650;letter-spacing:-.075em}
.contact__status{margin-top:clamp(5rem,12vw,12rem);padding-block:var(--space-6);display:grid;grid-template-columns:3rem minmax(0,1fr);gap:var(--grid-gap);border-block:1px solid var(--line)}
.contact__status p{max-width:42rem;margin:0;color:var(--silver);font:430 clamp(1.15rem,2vw,1.6rem)/1.45 var(--sans)}
</style>
