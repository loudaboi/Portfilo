---
import { getCollection } from "astro:content";
import SiteHead from "../../components/SiteHead.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";

const publishedStories = await getCollection(
  "stories",
  ({ data }) => data.status === "published",
);

const stories = [...publishedStories].sort(
  (a, b) =>
    (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0),
);

const dateFormatter = new Intl.DateTimeFormat("en-PH", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});

const formatDate = (date?: Date) => (date ? dateFormatter.format(date) : "");
const formatLabel = (value: string) => value.replaceAll("-", " ");
const storyCountLabel = `${stories.length} ${stories.length === 1 ? "story" : "stories"}`;
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      title="Stories | Portfilo"
      description="Published Portfilo stories about business, technology, startups, AI, and building."
    />
  </head>
  <body>
    <a class="skip-link" href="#stories-list">Skip to stories</a>

    <SiteHeader current="stories" />

    <main id="main-content">
      <section class="stories-hero" aria-labelledby="stories-title">
        <p class="stories-kicker">Stories</p>
        <h1 id="stories-title">Stories</h1>
        <p class="stories-count">{storyCountLabel}</p>
      </section>

      <section class="stories-index" id="stories-list" tabindex="-1" aria-label="Published stories">
        {
          stories.length > 0 ? (
            <ol class="story-list">
              {stories.map((story, index) => (
                <li class="story-item">
                  <p class="story-item__number">{String(index + 1).padStart(2, "0")}</p>

                  <div class="story-item__meta">
                    <span>{formatLabel(story.data.contentType)}</span>
                    <span>{formatLabel(story.data.topic)}</span>
                    {story.data.publishedAt && (
                      <time datetime={story.data.publishedAt.toISOString()}>
                        {formatDate(story.data.publishedAt)}
                      </time>
                    )}
                  </div>

                  <div class="story-item__copy">
                    <h2>
                      <a href={`/stories/${story.id}`}>{story.data.title}</a>
                    </h2>
                    <p>{story.data.description}</p>
                    <p class="story-item__author">{story.data.author}</p>
                  </div>

                  <a class="story-item__action" href={`/stories/${story.id}`}>
                    Read story <span aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ol>
          ) : (
            <p class="stories-empty">No published stories yet.</p>
          )
        }
      </section>
    </main>

    <SiteFooter />

    <style>
      @font-face {
        font-family: "Instrument Sans";
        font-style: normal;
        font-display: swap;
        font-weight: 400 700;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/instrument-sans:vf@5.3.0/latin-wght-normal.woff2") format("woff2-variations");
      }
      @font-face {
        font-family: "Source Serif 4";
        font-style: normal;
        font-display: swap;
        font-weight: 200 900;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/source-serif-4:vf@5.3.0/latin-wght-normal.woff2") format("woff2-variations");
      }
      @font-face {
        font-family: "IBM Plex Mono";
        font-style: normal;
        font-display: swap;
        font-weight: 400;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/ibm-plex-mono@5.3.0/latin-400-normal.woff2") format("woff2");
      }

      :global(:root) {
        --paper: #f4f0e8;
        --ink: #171614;
        --muted: #69655e;
        --line: #cbc5bb;
        --accent: #0050a4;
        --correction: #b42318;
        --page-max: 100rem;
        --gutter: clamp(1.25rem, 3.3vw, 3.75rem);
        --grid-gap: clamp(0.8rem, 1.6vw, 1.5rem);
        --sans: "Instrument Sans", "Helvetica Neue", Arial, sans-serif;
        --serif: "Source Serif 4", Georgia, serif;
        --mono: "IBM Plex Mono", "Courier New", monospace;
      }

      :global(*) { box-sizing: border-box; }
      :global(html) { background: var(--paper); color: var(--ink); font-family: var(--sans); font-synthesis: none; }
      :global(body) { margin: 0; min-width: 0; background: var(--paper); }
      :global(a) { color: inherit; }
      :global(a:focus-visible) { outline: 3px solid var(--accent); outline-offset: 4px; }
      :global(#stories-list:focus) { outline: none; }

      .skip-link {
        position: fixed;
        z-index: 20;
        top: 0.75rem;
        left: 0.75rem;
        padding: 0.65rem 0.8rem;
        background: var(--ink);
        color: var(--paper);
        font: 400 0.75rem/1 var(--mono);
        text-decoration: none;
        transform: translateY(-200%);
      }
      .skip-link:focus { transform: translateY(0); }

      .stories-hero,
      .stories-index {
        width: min(100%, var(--page-max));
        margin-inline: auto;
      }

      .stories-hero {
        padding: clamp(3.8rem, 7vw, 7.5rem) var(--gutter) clamp(3.5rem, 6vw, 6rem);
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
        align-items: end;
      }

      .stories-kicker {
        grid-column: 1 / 3;
        margin: 0 0 0.55rem;
        color: var(--accent);
        font: 400 0.67rem/1.4 var(--mono);
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }

      .stories-hero h1 {
        grid-column: 3 / 11;
        margin: 0;
        font: 500 clamp(4.2rem, 8vw, 8rem) / 0.88 var(--sans);
        letter-spacing: -0.075em;
      }

      .stories-count {
        grid-column: 11 / 13;
        margin: 0 0 0.45rem;
        text-align: right;
        color: var(--muted);
        font: 400 0.68rem/1.4 var(--mono);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .stories-index {
        padding: 0 var(--gutter) clamp(5rem, 9vw, 9rem);
      }

      .story-list {
        margin: 0;
        padding: 0;
        list-style: none;
        border-top: 1px solid var(--ink);
      }

      .story-item {
        min-width: 0;
        padding: clamp(2.6rem, 4.5vw, 4.7rem) 0;
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
        border-bottom: 1px solid var(--line);
      }

      .story-item__number {
        grid-column: 1 / 3;
        margin: 0;
        color: var(--accent);
        font: 500 clamp(4rem, 6.5vw, 6.7rem) / 0.78 var(--sans);
        letter-spacing: -0.08em;
      }

      .story-item__meta {
        grid-column: 3 / 5;
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
        align-self: start;
        color: var(--muted);
        font: 400 0.63rem/1.45 var(--mono);
        letter-spacing: 0.07em;
        text-transform: uppercase;
      }

      .story-item__meta span + span::before,
      .story-item__meta time::before {
        content: "/";
        margin-right: 0.45rem;
        color: var(--accent);
      }

      .story-item__copy {
        grid-column: 5 / 11;
        min-width: 0;
      }

      .story-item__copy h2 {
        max-width: 20ch;
        margin: 0;
        font: 500 clamp(2rem, 3.1vw, 3.35rem) / 1 var(--sans);
        letter-spacing: -0.05em;
        text-wrap: balance;
        overflow-wrap: break-word;
      }

      .story-item__copy h2 a { text-decoration: none; }
      .story-item__copy h2 a:hover { color: var(--accent); }

      .story-item__copy > p:not(.story-item__author) {
        max-width: 39rem;
        margin: 1.35rem 0 0;
        color: var(--muted);
        font: 400 1.06rem/1.58 var(--serif);
      }

      .story-item__author {
        margin: 1.4rem 0 0;
        color: var(--muted);
        font: 400 0.65rem/1.45 var(--mono);
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .story-item__action {
        grid-column: 11 / 13;
        align-self: end;
        justify-self: stretch;
        padding: 0.85rem 0 0.7rem;
        border-top: 3px solid var(--accent);
        border-bottom: 1px solid var(--ink);
        font: 500 clamp(1rem, 1.35vw, 1.2rem) / 1.2 var(--sans);
        text-decoration: none;
      }
      .story-item__action span { color: var(--accent); }
      .story-item__action:hover { color: var(--accent); }

      .stories-empty {
        margin: 0;
        padding: 3rem 0;
        color: var(--muted);
        font: 400 1.1rem/1.55 var(--serif);
        border-top: 1px solid var(--ink);
        border-bottom: 1px solid var(--line);
      }

      @media (max-width: 64rem) {
        .stories-hero h1 { grid-column: 2 / 10; }
        .stories-count { grid-column: 10 / 13; }
        .story-item__number { grid-column: 1 / 2; }
        .story-item__meta { grid-column: 2 / 5; }
        .story-item__copy { grid-column: 5 / 10; }
        .story-item__action { grid-column: 10 / 13; }
      }

      @media (max-width: 50rem) {
        .stories-hero {
          display: block;
          padding-top: 3.6rem;
          padding-bottom: 3.8rem;
        }
        .stories-kicker { margin-bottom: 1.2rem; }
        .stories-hero h1 {
          font-size: clamp(3.5rem, 16vw, 5.5rem);
          line-height: 0.9;
        }
        .stories-count {
          margin-top: 1.7rem;
          text-align: left;
        }
        .story-item {
          display: block;
          padding-top: 2.75rem;
          padding-bottom: 3rem;
        }
        .story-item__number {
          font-size: clamp(3.6rem, 17vw, 5.2rem);
          line-height: 0.8;
        }
        .story-item__meta {
          margin-top: 1.5rem;
          flex-direction: row;
          flex-wrap: wrap;
          gap: 0.45rem 0.7rem;
        }
        .story-item__copy { margin-top: 1.7rem; }
        .story-item__copy h2 {
          max-width: none;
          font-size: clamp(2rem, 8.7vw, 3rem);
          text-wrap: pretty;
        }
        .story-item__copy > p:not(.story-item__author) { font-size: 1.05rem; }
        .story-item__action {
          display: block;
          max-width: 15rem;
          margin-top: 2rem;
        }
      }

      @media (max-width: 28rem) {
        .story-item__meta { display: block; }
        .story-item__meta span,
        .story-item__meta time { display: block; margin-top: 0.35rem; }
        .story-item__meta span:first-child { margin-top: 0; }
      }

      @media (prefers-reduced-motion: reduce) {
        .skip-link { transition: none; }
      }
    </style>
  </body>
</html>
