---
import { getCollection } from "astro:content";
import SiteHead from "../../components/SiteHead.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import EditorialArchive from "../../components/EditorialArchive.astro";
import { DEV_EDITORIAL_IMAGE } from "../../data/devEditorialImage";

const entries = await getCollection(
  "stories",
  ({ data }) => data.section === "stories" && (data.status === "published" || import.meta.env.DEV),
);

const stories = entries
  .filter((story) => !story.id.startsWith("portfilo-"))
  .sort(
    (a, b) =>
      (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0),
  );

const dateFormatter = new Intl.DateTimeFormat("en-PH", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});

const formatDate = (date?: Date) => (date ? dateFormatter.format(date) : "");
const formatLabel = (value: string) => value.replaceAll("-", " ");

const items = stories.map((story) => ({
  href: `/stories/${story.id}`,
  title: story.data.title,
  dek: story.data.dek,
  meta: [
    formatLabel(story.data.contentType),
    formatLabel(story.data.topic),
    ...(story.data.publishedAt ? [formatDate(story.data.publishedAt)] : []),
    ...(import.meta.env.DEV && story.data.status === "draft" ? ["Draft"] : []),
  ],
  accentMetaCount: 2,
  author: story.data.author,
  image: story.data.image ?? (import.meta.env.DEV ? DEV_EDITORIAL_IMAGE : undefined),
}));
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      title="Stories | Portfilo"
      description="Deeper Portfilo stories about business, technology, startups, and AI."
    />
  </head>
  <body class="editorial-page">
    <a class="skip-link" href="#stories-list">Skip to stories</a>
    <SiteHeader current="stories" />

    <EditorialArchive
      title="Stories"
      items={items}
      listId="stories-list"
      leadAriaLabel="Lead story"
      streamAriaLabel="More stories"
      emptyText="No published stories yet."
      signupId="stories-archive-newsletter"
      signupAriaLabel="Subscribe to Portfilo stories"
      signupHeading="Get Portfilo stories in your inbox."
      signupCopy="Deeper reporting, explainers, and analysis on business and technology."
    />

    <SiteFooter showAcquisition={items.length > 0} />
  </body>
</html>
