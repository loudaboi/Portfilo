---
import { getCollection } from "astro:content";
import SiteHead from "../../components/SiteHead.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import NewsletterSignup from "../../components/NewsletterSignup.astro";
import { DEV_EDITORIAL_IMAGE } from "../../data/devEditorialImage";

const entries = await getCollection(
  "stories",
  ({ data }) => data.section === "stories" && (data.status === "published" || import.meta.env.DEV),
);

const stories = entries
  .filter((story) => !story.id.startsWith("portfilo-"))
  .sort(
    (a, b) =>
      (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0),
  );

const leadStory = stories[0];
const leadImage = leadStory?.data.image ?? (import.meta.env.DEV ? DEV_EDITORIAL_IMAGE : undefined);
const supportingStories = stories.slice(1).map((story) => ({
  story,
  image: story.data.image ?? (import.meta.env.DEV ? DEV_EDITORIAL_IMAGE : undefined),
}));

const dateFormatter = new Intl.DateTimeFormat("en-PH", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});

const formatDate = (date?: Date) => (date ? dateFormatter.format(date) : "");
const formatLabel = (value: string) => value.replaceAll("-", " ");
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      title="Stories | Portfilo"
      description="Deeper Portfilo stories about business, technology, startups, and AI."
    />
  </head>
  <body class="editorial-page">
    <a class="skip-link" href="#stories-list">Skip to stories</a>
    <SiteHeader current="stories" />

    <main id="main-content">
      <header class="page-header">
        <h1>Stories</h1>
      </header>

      {
        leadStory ? (
          <section class="lead-story" aria-label="Lead story">
            {leadImage && (
              <a class="lead-story__image" href={`/stories/${leadStory.id}`} aria-label={`Read ${leadStory.data.title}`}>
                <img
                  src={leadImage.src}
                  alt={leadImage.alt}
                  width="1600"
                  height="900"
                  loading="eager"
                  decoding="async"
                />
                {leadImage.generated && (
                  <span class="image-disclosure">AI-generated editorial image</span>
                )}
              </a>
            )}

            <div class="lead-story__package">
              <p class="story-meta">
                <span>{formatLabel(leadStory.data.contentType)}</span>
                <span>{formatLabel(leadStory.data.topic)}</span>
                {leadStory.data.publishedAt && <time datetime={leadStory.data.publishedAt.toISOString()}>{formatDate(leadStory.data.publishedAt)}</time>}
                {import.meta.env.DEV && leadStory.data.status === "draft" && <span>Draft</span>}
              </p>
              <h2><a href={`/stories/${leadStory.id}`}>{leadStory.data.title}</a></h2>
              <p class="lead-story__dek">{leadStory.data.dek}</p>
              <p class="story-author">{leadStory.data.author}</p>
            </div>
          </section>
        ) : (
          <p class="empty-state" id="stories-list">No published stories yet.</p>
        )
      }

      <section class="archive-newsletter" aria-label="Subscribe to Portfilo stories">
        <NewsletterSignup
          id="stories-archive-newsletter"
          heading="Get Portfilo stories in your inbox."
          copy="Deeper reporting, explainers, and analysis on business and technology."
          variant="inline"
        />
      </section>

      {
        leadStory && (
          <section class="story-stream" id="stories-list" tabindex="-1" aria-label="More stories">
            {supportingStories.map(({ story, image }) => (
              <article class="story-row">
                <div class="story-row__package">
                  <p class="story-meta">
                    <span>{formatLabel(story.data.contentType)}</span>
                    <span>{formatLabel(story.data.topic)}</span>
                    {story.data.publishedAt && <time datetime={story.data.publishedAt.toISOString()}>{formatDate(story.data.publishedAt)}</time>}
                    {import.meta.env.DEV && story.data.status === "draft" && <span>Draft</span>}
                  </p>
                  <h2><a href={`/stories/${story.id}`}>{story.data.title}</a></h2>
                  <p class="story-row__dek">{story.data.dek}</p>
                  <p class="story-author">{story.data.author}</p>
                </div>

                {image && (
                  <a class="story-row__image" href={`/stories/${story.id}`} aria-label={`Read ${story.data.title}`}>
                    <img
                      src={image.src}
                      alt={image.alt}
                      width="1600"
                      height="900"
                      loading="lazy"
                      decoding="async"
                    />
                    {image.generated && (
                      <span class="image-disclosure">AI-generated editorial image</span>
                    )}
                  </a>
                )}
              </article>
            ))}
          </section>
        )
      }
    </main>

    <SiteFooter />

    <style>
      @font-face { font-family: "Instrument Sans"; font-style: normal; font-display: swap; font-weight: 400 700; src: url("https://cdn.jsdelivr.net/fontsource/fonts/instrument-sans:vf@5.3.0/latin-wght-normal.woff2") format("woff2-variations"); }
      @font-face { font-family: "Source Serif 4"; font-style: normal; font-display: swap; font-weight: 200 900; src: url("https://cdn.jsdelivr.net/fontsource/fonts/source-serif-4:vf@5.3.0/latin-wght-normal.woff2") format("woff2-variations"); }
      @font-face { font-family: "IBM Plex Mono"; font-style: normal; font-display: swap; font-weight: 400; src: url("https://cdn.jsdelivr.net/fontsource/fonts/ibm-plex-mono@5.3.0/latin-400-normal.woff2") format("woff2"); }

      :global(:root) {
        --paper: #f8f6f1;
        --paper-soft: #efebe3;
        --ink: #171614;
        --muted: #68645e;
        --line: #d4cfc6;
        --line-strong: #aaa39a;
        --accent: #0050a4;
        --correction: #b42318;
        --page-max: 84rem;
        --content-max: 84rem;
        --shell-gutter: clamp(1.25rem, 2.6vw, 2rem);
        --gutter: var(--shell-gutter);
        --sans: "Instrument Sans", "Helvetica Neue", Arial, sans-serif;
        --serif: "Source Serif 4", Georgia, serif;
        --mono: "IBM Plex Mono", "Courier New", monospace;
      }

      :global(*) { box-sizing: border-box; }
      :global(html) { background: var(--paper); color: var(--ink); font-family: var(--sans); font-synthesis: none; }
      :global(body) { margin: 0; min-width: 0; background: var(--paper); }
      :global(a) { color: inherit; }
      :global(a:focus-visible) { outline: 3px solid var(--accent); outline-offset: 4px; }
      :global(#stories-list:focus) { outline: none; }

      .skip-link {
        position: fixed;
        z-index: 50;
        top: 0.75rem;
        left: 0.75rem;
        padding: 0.7rem 0.85rem;
        background: var(--ink);
        color: var(--paper);
        font: 550 0.75rem/1 var(--sans);
        text-decoration: none;
        transform: translateY(-200%);
      }
      .skip-link:focus { transform: translateY(0); }

      .page-header,
      .lead-story,
      .story-stream,
      .empty-state,
      .archive-newsletter {
        width: min(calc(100% - (2 * var(--shell-gutter))), var(--content-max));
        margin-inline: auto;
      }

      .page-header {
        padding: clamp(3.2rem, 6vw, 5.8rem) 0 clamp(1.4rem, 2.6vw, 2.25rem);
        border-bottom: 1px solid var(--ink);
      }

      .page-header h1 {
        margin: 0;
        font: 680 clamp(3rem, 6vw, 5.6rem) / 0.92 var(--sans);
        letter-spacing: -0.055em;
      }

      .lead-story {
        padding: clamp(1.5rem, 3vw, 2.5rem) 0 clamp(3rem, 5vw, 4.75rem);
        display: grid;
        grid-template-columns: minmax(0, 1.45fr) minmax(20rem, 0.8fr);
        gap: clamp(1.5rem, 3vw, 3rem);
        align-items: start;
        border-bottom: 1px solid var(--line);
      }

      .lead-story__image,
      .story-row__image {
        position: relative;
        display: block;
        overflow: hidden;
        border-top: 3px solid var(--accent);
        background: var(--paper-soft);
        line-height: 0;
      }

      .lead-story__image img,
      .story-row__image img {
        display: block;
        width: 100%;
        height: auto;
      }

      .image-disclosure {
        position: absolute;
        right: 0.55rem;
        bottom: 0.5rem;
        padding: 0.27rem 0.36rem;
        background: rgba(23, 22, 20, 0.78);
        color: #fff;
        font: 520 0.57rem/1 var(--sans);
        letter-spacing: 0.035em;
      }

      .lead-story__package {
        padding-top: 0.1rem;
      }

      .story-meta,
      .story-author,
      .lead-story__dek,
      .story-row__dek,
      .lead-story h2,
      .story-row h2 {
        margin: 0;
      }

      .story-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem 0.75rem;
        color: var(--muted);
        font: 560 0.64rem/1.3 var(--sans);
        letter-spacing: 0.045em;
        text-transform: uppercase;
      }

      .story-meta span:first-child,
      .story-meta span:nth-child(2) {
        color: var(--accent);
      }

      .story-meta > * + *::before {
        content: "/";
        margin-right: 0.75rem;
        color: var(--line-strong);
      }

      .lead-story h2 {
        max-width: 18ch;
        margin-top: 0.7rem;
        font: 670 clamp(2.2rem, 3.5vw, 3.8rem) / 0.98 var(--sans);
        letter-spacing: -0.048em;
        text-wrap: balance;
      }

      h2 a {
        text-decoration: none;
      }

      h2 a:hover {
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.14em;
      }

      .lead-story__dek {
        max-width: 38rem;
        margin-top: 0.8rem;
        color: var(--muted);
        font: 430 clamp(1rem, 1.2vw, 1.12rem) / 1.52 var(--sans);
      }

      .story-author {
        margin-top: 1rem;
        color: var(--muted);
        font: 540 0.67rem/1.3 var(--sans);
      }

      .archive-newsletter {
        padding: clamp(1.5rem, 3vw, 2.25rem) 0 clamp(1.8rem, 3.5vw, 2.75rem);
        border-top: 3px solid var(--accent);
      }

      .story-stream {
        padding-bottom: clamp(4rem, 7vw, 7rem);
      }

      .story-row {
        padding: clamp(1.75rem, 3vw, 2.75rem) 0;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(13rem, 20rem);
        gap: clamp(1.5rem, 3vw, 3rem);
        align-items: start;
        border-bottom: 1px solid var(--line);
      }

      .story-row:not(:has(.story-row__image)) .story-row__package {
        max-width: 54rem;
      }

      .story-row h2 {
        max-width: 25ch;
        margin-top: 0.55rem;
        font: 660 clamp(1.55rem, 2.35vw, 2.55rem) / 1.02 var(--sans);
        letter-spacing: -0.04em;
      }

      .story-row__dek {
        max-width: 43rem;
        margin-top: 0.65rem;
        color: var(--muted);
        font: 425 clamp(0.92rem, 1vw, 1rem) / 1.52 var(--sans);
      }

      .empty-state {
        padding: 2rem 0;
        color: var(--muted);
        font: 430 0.95rem/1.55 var(--sans);
      }

      @media (max-width: 64rem) {
        .lead-story {
          grid-template-columns: minmax(0, 1.25fr) minmax(17rem, 0.75fr);
          gap: 1.75rem;
        }
      }

      @media (max-width: 48rem) {
        .lead-story,
        .story-row {
          grid-template-columns: 1fr;
        }

        .lead-story__image {
          order: 0;
        }

        .lead-story__package {
          order: 1;
        }

        .story-row__image {
          order: -1;
          max-width: 36rem;
        }

        .lead-story h2 {
          max-width: 22ch;
        }
      }

      @media (max-width: 36rem) {
        :global(:root) { --shell-gutter: 1.1rem; }
        .page-header { padding-top: 2.75rem; }
        .page-header h1 { font-size: clamp(2.8rem, 15vw, 4.25rem); }
        .lead-story { padding-top: 1.15rem; }
        .lead-story h2 { font-size: clamp(2rem, 9.5vw, 2.8rem); }
        .story-row { padding-block: 1.6rem; }
        .story-row h2 { font-size: clamp(1.55rem, 7.5vw, 2.1rem); }
      }

      @media (max-width: 23rem) {
        :global(:root) { --shell-gutter: 1rem; }
      }
    </style>
  </body>
</html>
