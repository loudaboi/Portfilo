---
import { getCollection, render } from "astro:content";
import SiteHead from "../../components/SiteHead.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";

export async function getStaticPaths() {
  const stories = await getCollection(
    "stories",
    ({ data }) => data.status === "published",
  );

  return stories.map((story) => ({
    params: { slug: story.id },
    props: { story },
  }));
}

const { story } = Astro.props;
const {
  title,
  description,
  contentType,
  topic,
  author,
  publishedAt,
  updatedAt,
  series,
  seriesOrder,
  methodology,
  correction,
} = story.data;
const { Content } = await render(story);

const dateFormatter = new Intl.DateTimeFormat("en-PH", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});

const formatDate = (date: Date) => dateFormatter.format(date);
const formatLabel = (value: string) => value.replaceAll("-", " ");
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      title={`${title} | Portfilo`}
      description={description}
      article={{ author, publishedAt, updatedAt }}
    />
  </head>
  <body>
    <a class="skip-link" href="#story-body">Skip to story</a>

    <SiteHeader />

    <main id="main-content">
      <article aria-labelledby="story-title">
        <header class="story-header">
          <p class="story-kicker" aria-label="Story classification">
            <span>{formatLabel(contentType)}</span>
            <span>{formatLabel(topic)}</span>
          </p>

          <h1 id="story-title">{title}</h1>
          <p class="story-dek">{description}</p>

          <dl class="story-meta">
            <div class="story-meta__item">
              <dt>Author</dt>
              <dd>{author}</dd>
            </div>

            {
              publishedAt && (
                <div class="story-meta__item">
                  <dt>Published</dt>
                  <dd>
                    <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
                  </dd>
                </div>
              )
            }

            {
              updatedAt && (
                <div class="story-meta__item">
                  <dt>Updated</dt>
                  <dd>
                    <time datetime={updatedAt.toISOString()}>{formatDate(updatedAt)}</time>
                  </dd>
                </div>
              )
            }

            {
              series && (
                <div class="story-meta__item story-meta__series">
                  <dt>Series</dt>
                  <dd>
                    {formatLabel(series)}
                    {seriesOrder !== undefined && ` · Part ${seriesOrder}`}
                  </dd>
                </div>
              )
            }
          </dl>
        </header>

        <div class="story-rule" aria-hidden="true">
          <span>Portfilo / {formatLabel(contentType)}</span>
          <span>{formatLabel(topic)}</span>
        </div>

        <div class="story-layout">
          <aside class="story-rail" aria-label="Story metadata">
            <dl>
              <div>
                <dt>Editorial type</dt>
                <dd>{formatLabel(contentType)}</dd>
              </div>
              <div>
                <dt>Topic</dt>
                <dd>{formatLabel(topic)}</dd>
              </div>
              {
                series && (
                  <div>
                    <dt>Series</dt>
                    <dd>
                      {seriesOrder !== undefined ? `Part ${seriesOrder}` : formatLabel(series)}
                    </dd>
                  </div>
                )
              }
            </dl>
          </aside>

          <div class="story-body" id="story-body" tabindex="-1">
            <Content />
          </div>
        </div>

        {
          (methodology || correction) && (
            <div class="story-modules">
              {methodology && (
                <section class="methodology" aria-labelledby="methodology-title">
                  <h2 id="methodology-title">Methodology</h2>
                  <p>{methodology}</p>
                </section>
              )}

              {correction && (
                <aside class="correction" aria-labelledby="correction-title">
                  <h2 id="correction-title">Correction</h2>
                  <p>
                    <time datetime={correction.correctedAt.toISOString()}>
                      {formatDate(correction.correctedAt)}
                    </time>
                    <span aria-hidden="true"> · </span>
                    {correction.note}
                  </p>
                </aside>
              )}
            </div>
          )
        }
      </article>
    </main>

    <SiteFooter />

    <style>
      @font-face { font-family: "Instrument Sans"; font-style: normal; font-display: swap; font-weight: 400 700; src: url("https://cdn.jsdelivr.net/fontsource/fonts/instrument-sans:vf@5.3.0/latin-wght-normal.woff2") format("woff2-variations"); }
      @font-face { font-family: "Source Serif 4"; font-style: normal; font-display: swap; font-weight: 200 900; src: url("https://cdn.jsdelivr.net/fontsource/fonts/source-serif-4:vf@5.3.0/latin-wght-normal.woff2") format("woff2-variations"); }
      @font-face { font-family: "IBM Plex Mono"; font-style: normal; font-display: swap; font-weight: 400; src: url("https://cdn.jsdelivr.net/fontsource/fonts/ibm-plex-mono@5.3.0/latin-400-normal.woff2") format("woff2"); }

      :global(:root) {
        --paper: #f4f0e8; --ink: #171614; --muted: #69655e; --line: #cbc5bb;
        --accent: #0050a4; --accent-on-ink: #8fc7ff; --correction: #b42318;
        --correction-soft: #f6e7e3; --page-max: 100rem;
        --gutter: clamp(1.25rem, 3.3vw, 3.75rem); --grid-gap: clamp(0.8rem, 1.6vw, 1.5rem);
        --sans: "Instrument Sans", "Helvetica Neue", Arial, sans-serif;
        --serif: "Source Serif 4", Georgia, serif; --mono: "IBM Plex Mono", "Courier New", monospace;
      }
      :global(*) { box-sizing: border-box; }
      :global(html) { background: var(--paper); color: var(--ink); font-family: var(--sans); font-synthesis: none; }
      :global(body) { margin: 0; min-width: 0; background: var(--paper); }
      :global(a) { color: inherit; }
      :global(a:focus-visible) { outline: 3px solid var(--accent); outline-offset: 4px; }

      .skip-link { position: fixed; z-index: 20; top: 0.75rem; left: 0.75rem; padding: 0.65rem 0.8rem; background: var(--ink); color: var(--paper); font: 400 0.75rem/1 var(--mono); text-decoration: none; transform: translateY(-200%); }
      .skip-link:focus { transform: translateY(0); }

      .story-header { width: min(100%, var(--page-max)); margin-inline: auto; padding: clamp(3rem, 7vw, 7.5rem) var(--gutter) clamp(3.5rem, 6.5vw, 6.75rem); display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--grid-gap); }
      .story-kicker { grid-column: 1 / 4; display: flex; flex-wrap: wrap; gap: 0.65rem; align-self: start; margin: 0.45rem 0 0; font: 400 0.69rem/1.35 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; }
      .story-kicker span + span::before { content: "/"; margin-right: 0.65rem; color: var(--accent); }
      h1 { grid-column: 3 / 13; min-width: 0; max-width: 19ch; margin: 0; font: 500 clamp(3.55rem, 7.15vw, 7.15rem) / 0.91 var(--sans); letter-spacing: -0.065em; text-wrap: balance; overflow-wrap: break-word; }
      .story-dek { grid-column: 5 / 11; max-width: 42rem; margin: clamp(2.1rem, 4vw, 3.9rem) 0 0; font: 400 clamp(1.32rem, 1.75vw, 1.76rem) / 1.42 var(--serif); }
      .story-meta { grid-column: 5 / 13; margin: clamp(2.3rem, 4vw, 3.8rem) 0 0; padding: 1rem 0 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; border-top: 1px solid var(--line); font: 400 0.7rem/1.5 var(--mono); }
      .story-meta__item { min-width: 0; }
      .story-meta dt, .story-rail dt { margin: 0 0 0.32rem; color: var(--muted); letter-spacing: 0.08em; text-transform: uppercase; }
      .story-meta dd, .story-rail dd { margin: 0; overflow-wrap: anywhere; }
      .story-meta__series { grid-column: span 2; padding-left: 0.8rem; border-left: 3px solid var(--accent); }

      .story-rule { width: min(100%, var(--page-max)); margin-inline: auto; padding: 0.65rem var(--gutter) 0; display: flex; justify-content: space-between; gap: 1rem; border-top: 1px solid var(--ink); color: var(--muted); font: 400 0.64rem/1.35 var(--mono); letter-spacing: 0.1em; text-transform: uppercase; }
      .story-layout { width: min(100%, var(--page-max)); margin-inline: auto; padding: clamp(3.75rem, 7vw, 7.25rem) var(--gutter); display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--grid-gap); }
      .story-rail { grid-column: 1 / 3; align-self: start; position: sticky; top: 1.5rem; color: var(--muted); font: 400 0.66rem/1.55 var(--mono); letter-spacing: 0.06em; text-transform: uppercase; }
      .story-rail dl { margin: 0; }
      .story-rail dl > div { padding: 0.72rem 0; border-top: 1px solid var(--line); }
      .story-rail dd { color: var(--ink); }
      .story-body { grid-column: 4 / 9; min-width: 0; max-width: 42rem; counter-reset: story-section; font: 400 clamp(1.16rem, 1.3vw, 1.28rem) / 1.72 var(--serif); }
      .story-body :global(p) { margin: 0 0 1.45em; }
      .story-body :global(p:first-child) { font-size: 1.1em; line-height: 1.62; }
      .story-body :global(h2) { counter-increment: story-section; margin: 3.6rem 0 1.25rem; font: 500 clamp(1.8rem, 2.4vw, 2.3rem) / 1.08 var(--sans); letter-spacing: -0.04em; }
      .story-body :global(h2::before) { content: "0" counter(story-section) "/"; display: block; margin-bottom: 0.78rem; color: var(--accent); font: 400 0.66rem/1 var(--mono); letter-spacing: 0.08em; }
      .story-body :global(h3) { margin: 2.6rem 0 1rem; font: 500 clamp(1.35rem, 1.7vw, 1.6rem) / 1.18 var(--sans); letter-spacing: -0.025em; }
      .story-body :global(a) { text-decoration-color: var(--accent); text-decoration-thickness: 0.08em; text-underline-offset: 0.15em; }
      .story-body :global(a:hover) { color: var(--accent); }
      .story-body :global(ul), .story-body :global(ol) { margin: 0 0 1.8rem; padding-left: 1.4rem; }
      .story-body :global(ul) { padding-left: 0; list-style: none; }
      .story-body :global(li) { margin: 0.52rem 0; }
      .story-body :global(ul > li) { position: relative; padding-left: 1.25rem; }
      .story-body :global(ul > li::before) { content: "■"; position: absolute; top: 0.48em; left: 0; color: var(--accent); font-size: 0.36em; }
      .story-body :global(blockquote) { margin: 2.6rem 0; padding: 0.25rem 0 0.25rem 1.25rem; border-left: 3px solid var(--accent); font-size: 1.15em; line-height: 1.58; }
      .story-body :global(hr) { margin: 3.2rem 0; border: 0; border-top: 1px solid var(--line); }
      .story-body :global(img), .story-body :global(video), .story-body :global(svg) { display: block; max-width: 100%; height: auto; }
      .story-body :global(pre) { max-width: 100%; overflow-x: auto; padding: 1rem; background: #e7e2d9; font: 400 0.82rem/1.6 var(--mono); }
      .story-body :global(code) { font-family: var(--mono); font-size: 0.82em; }

      .story-modules { width: min(100%, var(--page-max)); margin-inline: auto; padding: 0 var(--gutter) clamp(5rem, 9vw, 9rem); display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--grid-gap); }
      .methodology { grid-column: 3 / 11; padding: clamp(1.5rem, 3vw, 2.5rem); display: grid; grid-template-columns: 2fr 6fr; gap: 2rem; background: var(--ink); color: var(--paper); }
      .methodology h2, .correction h2 { margin: 0; font: 400 0.68rem/1.4 var(--mono); letter-spacing: 0.09em; text-transform: uppercase; }
      .methodology h2 { color: var(--accent-on-ink); }
      .methodology p { margin: 0; font: 400 clamp(1.08rem, 1.4vw, 1.25rem) / 1.62 var(--serif); }
      .correction { grid-column: 5 / 11; margin-top: 1.5rem; padding: 1.35rem 1.5rem; display: grid; grid-template-columns: 2fr 6fr; gap: 1.5rem; border-top: 3px solid var(--correction); background: var(--correction-soft); }
      .correction h2 { color: var(--correction); }
      .correction p { margin: 0; font: 400 0.88rem/1.62 var(--mono); }
      .correction time { font-weight: 400; }

      @media (max-width: 64rem) {
        h1 { grid-column: 2 / 13; }
        .story-dek, .story-meta { grid-column: 4 / 12; }
        .story-body { grid-column: 4 / 10; }
        .methodology { grid-column: 2 / 12; }
        .correction { grid-column: 4 / 12; }
      }

      @media (max-width: 50rem) {
        .story-header { display: block; padding-top: 3.5rem; padding-bottom: 3.6rem; }
        .story-kicker { margin: 0 0 1.35rem; }
        h1 { max-width: none; font-size: clamp(3rem, 12.7vw, 4.35rem); line-height: 0.94; letter-spacing: -0.06em; text-wrap: pretty; }
        .story-dek { margin-top: 1.9rem; font-size: 1.27rem; line-height: 1.46; }
        .story-meta { margin-top: 2.3rem; grid-template-columns: 1fr 1fr; gap: 1.15rem 0.85rem; }
        .story-meta__series { grid-column: 1 / -1; }
        .story-rule { font-size: 0.58rem; }
        .story-layout { display: block; padding-top: 3.25rem; padding-bottom: 4rem; }
        .story-rail { display: none; }
        .story-body { max-width: 100%; font-size: 1.14rem; line-height: 1.7; }
        .story-body :global(h2) { margin-top: 3.1rem; }
        .story-modules { display: block; padding-bottom: 5rem; }
        .methodology, .correction { display: block; }
        .methodology h2, .correction h2 { margin-bottom: 1rem; }
        .correction { margin-top: 1rem; }
      }

      @media (max-width: 28rem) {
        .story-header { padding-top: 2.9rem; }
        h1 { font-size: clamp(2.75rem, 13vw, 3.5rem); }
        .story-meta { grid-template-columns: 1fr; }
        .story-meta__series { grid-column: auto; }
        .story-rule span:last-child { display: none; }
      }

      @media (prefers-reduced-motion: reduce) { .skip-link { transition: none; } }
    </style>
  </body>
</html>
