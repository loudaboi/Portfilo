---
import { getCollection, render } from "astro:content";
import SiteHead from "../../components/SiteHead.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import EditorialArticle from "../../components/EditorialArticle.astro";
import { DEV_EDITORIAL_IMAGE } from "../../data/devEditorialImage";

export async function getStaticPaths() {
  const stories = await getCollection(
    "stories",
    ({ data }) =>
      data.section === "stories" && (data.status === "published" || import.meta.env.DEV),
  );

  return stories.map((story) => ({
    params: { slug: story.id },
    props: { story },
  }));
}

const { story } = Astro.props;
const {
  title,
  dek,
  metaDescription,
  contentType,
  topic,
  publishedAt,
  updatedAt,
  image,
  methodology,
  correction,
  status,
} = story.data;
const { Content, headings } = await render(story);

const dateFormatter = new Intl.DateTimeFormat("en-PH", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});

const formatDate = (date: Date) => dateFormatter.format(date);
const formatLabel = (value: string) => value.replaceAll("-", " ");
const pageDescription = metaDescription ?? dek;
const displayImage = image ?? (import.meta.env.DEV ? DEV_EDITORIAL_IMAGE : undefined);

const classification = [
  formatLabel(contentType),
  formatLabel(topic),
  ...(publishedAt ? [formatDate(publishedAt)] : []),
  ...(import.meta.env.DEV && status === "draft" ? ["Draft"] : []),
];

const metadata = [
  ...(updatedAt ? [{ label: "Updated", value: formatDate(updatedAt) }] : []),
];

const tocItems = headings
  .filter((heading) => heading.depth === 2)
  .map(({ slug, text }) => ({ slug, text }));

const normalizedCorrection = correction
  ? {
      dateLabel: formatDate(correction.correctedAt),
      iso: correction.correctedAt.toISOString(),
      note: correction.note,
    }
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      title={`${title} | Portfilo`}
      description={pageDescription}
      article={{
        publishedAt,
        updatedAt,
        image: image ? { src: image.src, alt: image.alt } : undefined,
      }}
    />
  </head>
  <body class="editorial-page">
    <a class="skip-link" href="#article-body">Skip to story</a>
    <SiteHeader current="stories" />

    <EditorialArticle
      mode="stories"
      title={title}
      dek={dek}
      classification={classification}
      metadata={metadata}
      image={displayImage}
      methodology={methodology}
      correction={normalizedCorrection}
      tocItems={tocItems}
    >
      <Content />
    </EditorialArticle>

    <SiteFooter />
  </body>
</html>
