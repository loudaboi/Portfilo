---
import { getCollection, render } from "astro:content";
import SiteHead from "../../components/SiteHead.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import NewsletterSignup from "../../components/NewsletterSignup.astro";

export async function getStaticPaths() {
  const stories = await getCollection(
    "stories",
    ({ data }) =>
      data.section === "stories" && (data.status === "published" || import.meta.env.DEV),
  );

  return stories.map((story) => ({
    params: { slug: story.id },
    props: { story },
  }));
}

const { story } = Astro.props;
const {
  title,
  dek,
  metaDescription,
  contentType,
  topic,
  author,
  publishedAt,
  updatedAt,
  image,
  series,
  seriesOrder,
  methodology,
  correction,
  status,
} = story.data;
const { Content } = await render(story);

const dateFormatter = new Intl.DateTimeFormat("en-PH", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});

const formatDate = (date: Date) => dateFormatter.format(date);
const formatLabel = (value: string) => value.replaceAll("-", " ");
const authorHref = author === "Louda Tuppal" ? "/about#louda-tuppal" : undefined;
const pageDescription = metaDescription ?? dek;
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      title={`${title} | Portfilo`}
      description={pageDescription}
      article={{ author, authorUrl: authorHref, publishedAt, updatedAt }}
    />
  </head>
  <body class="editorial-page">
    <a class="skip-link" href="#story-body">Skip to story</a>
    <SiteHeader current="stories" />

    <main id="main-content">
      <article>
        <header class="story-header">
          <p class="story-classification">
            <span>{formatLabel(contentType)}</span>
            <span>{formatLabel(topic)}</span>
            {import.meta.env.DEV && status === "draft" && <span>Draft</span>}
          </p>

          <h1>{title}</h1>
          <p class="story-dek">{dek}</p>

          <dl class="story-byline">
            <div>
              <dt>Author</dt>
              <dd>{authorHref ? <a href={authorHref}>{author}</a> : author}</dd>
            </div>
            {publishedAt && (
              <div>
                <dt>Published</dt>
                <dd><time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time></dd>
              </div>
            )}
            {updatedAt && (
              <div>
                <dt>Updated</dt>
                <dd><time datetime={updatedAt.toISOString()}>{formatDate(updatedAt)}</time></dd>
              </div>
            )}
            {series && (
              <div>
                <dt>Series</dt>
                <dd>{formatLabel(series)}{seriesOrder !== undefined && ` · Part ${seriesOrder}`}</dd>
              </div>
            )}
          </dl>
        </header>

        {image && (
          <figure class="story-hero">
            <div class="story-hero__media">
              <img src={image.src} alt={image.alt} width="1600" height="900" decoding="async" />
              {image.generated && <span class="image-disclosure">AI-generated editorial image</span>}
            </div>
            {image.credit && <figcaption>{image.credit}</figcaption>}
          </figure>
        )}

        <div class="story-body" id="story-body" tabindex="-1">
          <Content />
        </div>

        {(methodology || correction) && (
          <div class="story-notes">
            {methodology && (
              <section class="story-note" aria-labelledby="methodology-title">
                <h2 id="methodology-title">Methodology</h2>
                <p>{methodology}</p>
              </section>
            )}
            {correction && (
              <aside class="story-note story-note--correction" aria-labelledby="correction-title">
                <h2 id="correction-title">Correction</h2>
                <p>
                  <time datetime={correction.correctedAt.toISOString()}>{formatDate(correction.correctedAt)}</time>
                  <span aria-hidden="true"> · </span>
                  {correction.note}
                </p>
              </aside>
            )}
          </div>
        )}

        <section class="article-newsletter" aria-label="Subscribe to the Portfilo newsletter">
          <NewsletterSignup id={`story-${story.id}-newsletter`} variant="inline" />
        </section>
      </article>
    </main>

    <SiteFooter />

    <style>
      @font-face { font-family: "Instrument Sans"; font-style: normal; font-display: swap; font-weight: 400 700; src: url("https://cdn.jsdelivr.net/fontsource/fonts/instrument-sans:vf@5.3.0/latin-wght-normal.woff2") format("woff2-variations"); }
      @font-face { font-family: "Source Serif 4"; font-style: normal; font-display: swap; font-weight: 200 900; src: url("https://cdn.jsdelivr.net/fontsource/fonts/source-serif-4:vf@5.3.0/latin-wght-normal.woff2") format("woff2-variations"); }
      @font-face { font-family: "IBM Plex Mono"; font-style: normal; font-display: swap; font-weight: 400; src: url("https://cdn.jsdelivr.net/fontsource/fonts/ibm-plex-mono@5.3.0/latin-400-normal.woff2") format("woff2"); }

      :global(:root) {
        --paper: #f8f6f1;
        --paper-soft: #efebe3;
        --ink: #171614;
        --muted: #68645e;
        --line: #d4cfc6;
        --line-strong: #aaa39a;
        --accent: #0050a4;
        --correction: #b42318;
        --page-max: 84rem;
        --content-max: 84rem;
        --shell-gutter: clamp(1.25rem, 2.6vw, 2rem);
        --gutter: var(--shell-gutter);
        --sans: "Instrument Sans", "Helvetica Neue", Arial, sans-serif;
        --serif: "Source Serif 4", Georgia, serif;
        --mono: "IBM Plex Mono", "Courier New", monospace;
      }

      :global(*) { box-sizing: border-box; }
      :global(html) { background: var(--paper); color: var(--ink); font-family: var(--sans); font-synthesis: none; }
      :global(body) { margin: 0; min-width: 0; background: var(--paper); }
      :global(a) { color: inherit; }
      :global(a:focus-visible) { outline: 3px solid var(--accent); outline-offset: 4px; }
      :global(#story-body:focus) { outline: none; }

      .skip-link {
        position: fixed;
        z-index: 50;
        top: 0.75rem;
        left: 0.75rem;
        padding: 0.7rem 0.85rem;
        background: var(--ink);
        color: var(--paper);
        font: 550 0.75rem/1 var(--sans);
        text-decoration: none;
        transform: translateY(-200%);
      }
      .skip-link:focus { transform: translateY(0); }

      .story-header,
      .story-hero,
      .story-body,
      .story-notes,
      .article-newsletter {
        width: min(calc(100% - (2 * var(--shell-gutter))), var(--content-max));
        margin-inline: auto;
      }

      .story-header {
        padding: clamp(3rem, 6vw, 5.75rem) 0 clamp(2rem, 4vw, 3.5rem);
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: clamp(1rem, 1.8vw, 1.75rem);
      }

      .story-classification {
        grid-column: 1 / 3;
        align-self: start;
        margin: 0.4rem 0 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem 0.65rem;
        color: var(--muted);
        font: 570 0.65rem/1.3 var(--sans);
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      .story-classification span:first-child,
      .story-classification span:nth-child(2) {
        color: var(--accent);
      }

      .story-classification span + span::before {
        content: "/";
        margin-right: 0.65rem;
        color: var(--line-strong);
      }

      .story-header h1 {
        grid-column: 3 / 12;
        max-width: 18ch;
        margin: 0;
        font: 680 clamp(3rem, 6.2vw, 6.25rem) / 0.94 var(--sans);
        letter-spacing: -0.058em;
        text-wrap: balance;
        overflow-wrap: break-word;
      }

      .story-dek {
        grid-column: 4 / 10;
        max-width: 44rem;
        margin: clamp(1.4rem, 2.6vw, 2.25rem) 0 0;
        color: var(--muted);
        font: 440 clamp(1.12rem, 1.55vw, 1.42rem) / 1.48 var(--sans);
      }

      .story-byline {
        grid-column: 4 / 11;
        margin: clamp(1.65rem, 3vw, 2.6rem) 0 0;
        padding-top: 0.85rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem clamp(1.25rem, 2.5vw, 2.4rem);
        border-top: 1px solid var(--line);
        font: 520 0.68rem/1.4 var(--sans);
      }

      .story-byline div { min-width: 0; }
      .story-byline dt { color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; }
      .story-byline dd { margin: 0.18rem 0 0; }
      .story-byline a { text-underline-offset: 0.15em; }

      .story-hero {
        margin-bottom: clamp(2.5rem, 5vw, 4.75rem);
      }

      .story-hero__media {
        position: relative;
        width: min(100%, 64rem);
        margin-inline: auto;
        overflow: hidden;
        border-top: 3px solid var(--accent);
        background: var(--paper-soft);
        line-height: 0;
      }

      .story-hero img {
        display: block;
        width: 100%;
        height: auto;
      }

      .image-disclosure {
        position: absolute;
        right: 0.6rem;
        bottom: 0.55rem;
        padding: 0.27rem 0.36rem;
        background: rgba(23, 22, 20, 0.78);
        color: #fff;
        font: 520 0.57rem/1 var(--sans);
        letter-spacing: 0.035em;
      }

      .story-hero figcaption {
        width: min(100%, 64rem);
        margin: 0.5rem auto 0;
        color: var(--muted);
        font: 480 0.65rem/1.4 var(--sans);
      }

      .story-body {
        max-width: 44rem;
        padding-bottom: clamp(3rem, 5vw, 4.75rem);
        font: 400 clamp(1.16rem, 1.3vw, 1.25rem) / 1.72 var(--serif);
      }

      .story-body :global(p) { margin: 0 0 1.45em; }
      .story-body :global(h2) {
        margin: 3.1rem 0 1rem;
        font: 660 clamp(1.75rem, 2.3vw, 2.25rem) / 1.08 var(--sans);
        letter-spacing: -0.04em;
      }
      .story-body :global(h3) {
        margin: 2.3rem 0 0.85rem;
        font: 640 clamp(1.3rem, 1.7vw, 1.6rem) / 1.16 var(--sans);
        letter-spacing: -0.025em;
      }
      .story-body :global(a) { text-decoration-color: var(--accent); text-decoration-thickness: 0.08em; text-underline-offset: 0.15em; }
      .story-body :global(a:hover) { color: var(--accent); }
      .story-body :global(ul),
      .story-body :global(ol) { margin: 0 0 1.6rem; padding-left: 1.35rem; }
      .story-body :global(li) { margin: 0.5rem 0; }
      .story-body :global(blockquote) {
        margin: 2.4rem 0;
        padding-left: 1.1rem;
        border-left: 3px solid var(--accent);
        font-size: 1.08em;
        line-height: 1.62;
      }
      .story-body :global(hr) { margin: 2.8rem 0; border: 0; border-top: 1px solid var(--line); }
      .story-body :global(img),
      .story-body :global(video),
      .story-body :global(svg) { display: block; max-width: 100%; height: auto; }
      .story-body :global(pre) { max-width: 100%; overflow-x: auto; padding: 1rem; background: var(--paper-soft); font: 400 0.82rem/1.6 var(--mono); }
      .story-body :global(code) { font-family: var(--mono); font-size: 0.82em; }

      .story-notes {
        max-width: 44rem;
        padding-bottom: clamp(2.5rem, 5vw, 4.5rem);
      }

      .story-note {
        padding: 1.25rem 0 0;
        border-top: 3px solid var(--accent);
      }
      .story-note + .story-note { margin-top: 2rem; }
      .story-note h2 { margin: 0; font: 650 0.78rem/1.3 var(--sans); letter-spacing: 0.05em; text-transform: uppercase; }
      .story-note p { margin: 0.65rem 0 0; color: var(--muted); font: 430 0.93rem/1.58 var(--sans); }
      .story-note--correction { border-top-color: var(--correction); }

      .article-newsletter {
        padding: clamp(1.5rem, 3vw, 2.25rem) 0 clamp(3.5rem, 6vw, 6rem);
        border-top: 3px solid var(--accent);
      }

      @media (max-width: 64rem) {
        .story-header h1 { grid-column: 3 / 13; }
        .story-dek, .story-byline { grid-column: 4 / 12; }
      }

      @media (max-width: 48rem) {
        .story-header { display: block; }
        .story-classification { margin: 0 0 1rem; }
        .story-header h1 { max-width: 22ch; }
        .story-dek { max-width: 40rem; }
        .story-byline { max-width: 42rem; }
        .story-hero__media { width: 100%; }
      }

      @media (max-width: 36rem) {
        :global(:root) { --shell-gutter: 1.1rem; }
        .story-header { padding-top: 2.6rem; }
        .story-header h1 { font-size: clamp(2.55rem, 12vw, 3.6rem); }
        .story-dek { font-size: 1.05rem; }
        .story-byline { gap: 0.7rem 1.2rem; }
        .story-body { font-size: 1.1rem; line-height: 1.7; }
      }

      @media (max-width: 23rem) {
        :global(:root) { --shell-gutter: 1rem; }
      }
    </style>
  </body>
</html>
