---
import { getCollection } from "astro:content";
import SiteHead from "../components/SiteHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";

const publishedStories = await getCollection(
  "stories",
  ({ data }) => data.status === "published",
);

const storiesByDate = [...publishedStories].sort(
  (a, b) =>
    (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0),
);

const featureStory =
  storiesByDate.find(({ data }) => data.featured) ?? storiesByDate[0];

const dateFormatter = new Intl.DateTimeFormat("en-PH", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});

const formatDate = (date?: Date) => (date ? dateFormatter.format(date) : "");
const formatLabel = (value: string) => value.replaceAll("-", " ");

const devNews = import.meta.env.DEV
  ? [
      {
        topic: "business",
        time: "12 min ago",
        title: "Development fixture: lead headline tests a two-line current story",
        dek: "Synthetic layout copy used only in local development to test the future News hierarchy.",
      },
      {
        topic: "technology",
        time: "28 min ago",
        title: "Development fixture: compact technology headline",
        dek: "Synthetic copy for testing a shorter supporting item.",
      },
      {
        topic: "startup",
        time: "46 min ago",
        title: "Development fixture: startup update with a medium-length headline",
        dek: "Synthetic copy for testing supporting-news density and mobile stacking.",
      },
      {
        topic: "ai",
        time: "1 hr ago",
        title: "Development fixture: fourth update for the chronological feed",
        dek: "Synthetic copy for testing the final supporting item.",
      },
    ]
  : [];

const tickerItems =
  devNews.length > 0
    ? devNews.map((item) => ({
        label: item.topic,
        title: item.title,
        href: undefined,
      }))
    : storiesByDate.map((story) => ({
        label: story.data.topic,
        title: story.data.title,
        href: `/stories/${story.id}`,
      }));
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      title="Portfilo | Business and Technology News"
      description="The latest news on companies, startups, products, markets, AI, and technology."
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader />

    <main id="main-content" tabindex="-1">
      <section class="newsletter-hero" id="newsletter" aria-labelledby="newsletter-title">
        <div class="newsletter-hero__copy">
          <p class="section-label">Newsletter</p>
          <h1 id="newsletter-title">Get ahead in business and tech in 7 minutes.</h1>
          <p>
            The latest news on companies, startups, products, markets, AI, and technology.
            Three times a week, straight to your inbox.
          </p>
        </div>

        <div class="newsletter-hero__form">
          <NewsletterSignup
            id="home-hero-newsletter"
            variant="hero"
            showCopy={false}
          />
        </div>
      </section>

      {
        tickerItems.length > 0 && (
          <section class="latest-strip" id="latest" aria-label="Latest from Portfilo">
            <div class="latest-strip__label">
              <strong>Latest</strong>
            </div>
            <div class="latest-strip__rail">
              {tickerItems.map((item) =>
                item.href ? (
                  <a class="latest-strip__item" href={item.href}>
                    <span>{formatLabel(item.label)}</span>
                    <strong>{item.title}</strong>
                  </a>
                ) : (
                  <span class="latest-strip__item">
                    <span>{formatLabel(item.label)}</span>
                    <strong>{item.title}</strong>
                  </span>
                ),
              )}
            </div>
          </section>
        )
      }

      {
        devNews.length > 0 && (
          <section class="latest-section" aria-labelledby="latest-section-title">
            <header class="section-heading">
              <div>
                <p class="section-label">Current</p>
                <h2 id="latest-section-title">The latest</h2>
              </div>
              <p class="fixture-warning">Development fixtures only. Not Portfilo reporting.</p>
            </header>

            <div class="latest-grid">
              <article class="lead-news">
                <div class="news-image-placeholder" aria-hidden="true">
                  <span>News image</span>
                  <small>Development layout only</small>
                </div>
                <div class="news-meta">
                  <span>{devNews[0].topic}</span>
                  <span>{devNews[0].time}</span>
                </div>
                <h3>{devNews[0].title}</h3>
                <p>{devNews[0].dek}</p>
              </article>

              <div class="news-list">
                {devNews.slice(1).map((item) => (
                  <article class="news-list__item">
                    <div class="news-meta">
                      <span>{item.topic}</span>
                      <span>{item.time}</span>
                    </div>
                    <h3>{item.title}</h3>
                    <p>{item.dek}</p>
                  </article>
                ))}
              </div>
            </div>
          </section>
        )
      }

      {
        featureStory && (
          <section class="feature-section" aria-labelledby="feature-section-title">
            <header class="section-heading section-heading--feature">
              <div>
                <p class="section-label">Feature</p>
                <h2 id="feature-section-title">A closer look</h2>
              </div>
              <a href="/stories">Browse Features</a>
            </header>

            <div class="feature-pair">
              <article class="feature-story">
                <a
                  class="feature-story__media"
                  href={`/stories/${featureStory.id}`}
                  aria-label={`Read ${featureStory.data.title}`}
                >
                  <img
                    src="/images/homepage-feature-image.webp"
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="feature-story__disclosure">AI-generated editorial image</span>
                </a>

                <div class="feature-story__body">
                  <div class="feature-story__meta">
                    <span>{formatLabel(featureStory.data.contentType)}</span>
                    <span>{formatLabel(featureStory.data.topic)}</span>
                    <span>{formatDate(featureStory.data.publishedAt)}</span>
                  </div>
                  <h3>
                    <a href={`/stories/${featureStory.id}`}>{featureStory.data.title}</a>
                  </h3>
                  <p>{featureStory.data.dek}</p>
                  <div class="feature-story__footer">
                    <span>{featureStory.data.author}</span>
                    <a href={`/stories/${featureStory.id}`}>Read Feature <span aria-hidden="true">→</span></a>
                  </div>
                </div>
              </article>

              <aside class="newsletter-card" aria-label="Subscribe to the Portfilo newsletter">
                <p class="newsletter-card__label">Newsletter</p>
                <NewsletterSignup
                  id="home-feature-newsletter"
                  heading="Get ahead in business and tech in 7 minutes."
                  copy="The latest news on companies, startups, products, markets, AI, and technology. Three times a week, straight to your inbox."
                  variant="card"
                />
              </aside>
            </div>
          </section>
        )
      }

      <section class="footer-newsletter" aria-label="Subscribe to the Portfilo newsletter">
        <p class="section-label">Newsletter</p>
        <NewsletterSignup
          id="home-footer-newsletter"
          heading="Get ahead in business and tech in 7 minutes."
          copy="The latest news on companies, startups, products, markets, AI, and technology. Three times a week, straight to your inbox."
          variant="footer"
        />
      </section>
    </main>

    <SiteFooter />

    <style>
      @font-face {
        font-family: "Instrument Sans";
        font-style: normal;
        font-display: swap;
        font-weight: 400 700;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/instrument-sans:vf@5.3.0/latin-wght-normal.woff2") format("woff2-variations");
      }

      @font-face {
        font-family: "Source Serif 4";
        font-style: normal;
        font-display: swap;
        font-weight: 200 900;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/source-serif-4:vf@5.3.0/latin-wght-normal.woff2") format("woff2-variations");
      }

      @font-face {
        font-family: "IBM Plex Mono";
        font-style: normal;
        font-display: swap;
        font-weight: 400;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/ibm-plex-mono@5.3.0/latin-400-normal.woff2") format("woff2");
      }

      :global(:root) {
        --paper: #f8f6f1;
        --paper-soft: #efebe3;
        --ink: #171614;
        --muted: #68645e;
        --line: #d4cfc6;
        --line-strong: #aaa39a;
        --accent: #0050a4;
        --accent-soft: #e9f1f8;
        --correction: #b42318;
        --page-max: 100rem;
        --gutter: clamp(1.25rem, 3.3vw, 3.75rem);
        --grid-gap: clamp(1rem, 1.8vw, 1.75rem);
        --sans: "Instrument Sans", "Helvetica Neue", Arial, sans-serif;
        --serif: "Source Serif 4", Georgia, serif;
        --mono: "IBM Plex Mono", "Courier New", monospace;
      }

      :global(*) { box-sizing: border-box; }
      :global(html) {
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
        font-synthesis: none;
      }
      :global(body) { margin: 0; min-width: 0; background: var(--paper); }
      :global(a) { color: inherit; }
      :global(a:focus-visible) { outline: 3px solid var(--accent); outline-offset: 4px; }
      :global(main:focus) { outline: none; }

      .skip-link {
        position: fixed;
        z-index: 50;
        top: 0.75rem;
        left: 0.75rem;
        padding: 0.7rem 0.85rem;
        background: var(--ink);
        color: var(--paper);
        font: 550 0.75rem/1 var(--sans);
        text-decoration: none;
        transform: translateY(-200%);
      }
      .skip-link:focus { transform: translateY(0); }

      .newsletter-hero,
      .latest-strip,
      .latest-section,
      .feature-section,
      .footer-newsletter {
        width: min(100%, var(--page-max));
        margin-inline: auto;
      }

      .section-label {
        margin: 0;
        color: var(--accent);
        font: 650 0.68rem/1.2 var(--sans);
        letter-spacing: 0.085em;
        text-transform: uppercase;
      }

      .newsletter-hero {
        min-height: 0;
        padding: clamp(1.65rem, 2.7vw, 2.7rem) var(--gutter);
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(20rem, 0.8fr);
        gap: clamp(2rem, 5vw, 5.5rem);
        align-items: center;
        border-bottom: 1px solid var(--line);
      }

      .newsletter-hero__copy h1 {
        max-width: 16ch;
        margin: 0.45rem 0 0;
        font: 680 clamp(2rem, 3.35vw, 3.75rem) / 0.98 var(--sans);
        letter-spacing: -0.052em;
        text-wrap: balance;
      }

      .newsletter-hero__copy > p:last-child {
        max-width: 48rem;
        margin: 0.8rem 0 0;
        color: var(--muted);
        font: 430 clamp(0.92rem, 1.05vw, 1.04rem) / 1.5 var(--sans);
      }

      .newsletter-hero__form {
        min-width: 0;
        padding-top: 1.1rem;
        border-top: 2px solid var(--accent);
      }

      .latest-strip {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        min-height: 2.85rem;
        border-bottom: 1px solid var(--line);
        overflow: hidden;
      }

      .latest-strip__label {
        display: flex;
        align-items: center;
        padding: 0.72rem var(--gutter);
        background: var(--ink);
        color: #fff;
        font: 650 0.65rem/1 var(--sans);
        letter-spacing: 0.085em;
        text-transform: uppercase;
      }

      .latest-strip__rail {
        min-width: 0;
        display: flex;
        align-items: stretch;
        overflow-x: auto;
        scrollbar-width: none;
      }
      .latest-strip__rail::-webkit-scrollbar { display: none; }

      .latest-strip__item {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        gap: 0.65rem;
        padding: 0.7rem clamp(1rem, 1.8vw, 1.55rem);
        border-right: 1px solid var(--line);
        text-decoration: none;
        white-space: nowrap;
      }

      .latest-strip__item > span {
        color: var(--accent);
        font: 650 0.63rem/1 var(--sans);
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .latest-strip__item > strong {
        max-width: 34rem;
        overflow: hidden;
        font: 520 0.75rem/1.2 var(--sans);
        text-overflow: ellipsis;
      }

      a.latest-strip__item:hover strong {
        text-decoration: underline;
        text-underline-offset: 0.18em;
      }

      .latest-section,
      .feature-section {
        padding: clamp(2.5rem, 5vw, 5rem) var(--gutter);
      }

      .section-heading {
        padding-bottom: 0.9rem;
        display: flex;
        justify-content: space-between;
        gap: 2rem;
        align-items: end;
        border-bottom: 1px solid var(--ink);
      }

      .section-heading h2 {
        margin: 0.32rem 0 0;
        font: 680 clamp(2rem, 3.1vw, 3.4rem) / 0.96 var(--sans);
        letter-spacing: -0.045em;
      }

      .section-heading > a,
      .fixture-warning {
        margin: 0 0 0.2rem;
        color: var(--muted);
        font: 520 0.72rem/1.35 var(--sans);
      }

      .section-heading > a {
        text-decoration-thickness: 1px;
        text-underline-offset: 0.22em;
      }

      .fixture-warning {
        max-width: 18rem;
        text-align: right;
      }

      .latest-grid {
        padding-top: clamp(1.25rem, 2.5vw, 2.25rem);
        display: grid;
        grid-template-columns: minmax(0, 1.7fr) minmax(18rem, 0.8fr);
        gap: clamp(1.5rem, 3.5vw, 3.5rem);
        align-items: start;
      }

      .lead-news h3,
      .news-list__item h3,
      .lead-news p,
      .news-list__item p,
      .news-meta {
        margin: 0;
      }

      .news-image-placeholder {
        aspect-ratio: 16 / 8.6;
        margin-bottom: 1rem;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        background: var(--paper-soft);
        border-top: 3px solid var(--accent);
        color: var(--muted);
      }

      .news-image-placeholder span {
        color: var(--ink);
        font: 620 clamp(1.3rem, 2vw, 2rem) / 1 var(--sans);
        letter-spacing: -0.025em;
      }

      .news-image-placeholder small {
        font: 540 0.65rem/1.2 var(--sans);
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .news-meta,
      .feature-story__meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem 0.8rem;
        color: var(--muted);
        font: 550 0.64rem/1.2 var(--sans);
        letter-spacing: 0.045em;
        text-transform: uppercase;
      }

      .news-meta span:first-child,
      .feature-story__meta span:first-child {
        color: var(--accent);
      }

      .lead-news h3 {
        max-width: 20ch;
        margin-top: 0.55rem;
        font: 670 clamp(2rem, 3.3vw, 3.55rem) / 0.98 var(--sans);
        letter-spacing: -0.048em;
      }

      .lead-news > p {
        max-width: 48rem;
        margin-top: 0.75rem;
        color: var(--muted);
        font: 420 clamp(0.95rem, 1.1vw, 1.06rem) / 1.55 var(--sans);
      }

      .news-list {
        border-top: 1px solid var(--line);
      }

      .news-list__item {
        padding: 1rem 0 1.15rem;
        border-bottom: 1px solid var(--line);
      }

      .news-list__item h3 {
        max-width: 28ch;
        margin-top: 0.45rem;
        font: 650 clamp(1.2rem, 1.55vw, 1.55rem) / 1.08 var(--sans);
        letter-spacing: -0.03em;
      }

      .news-list__item p {
        margin-top: 0.55rem;
        color: var(--muted);
        font: 420 0.84rem/1.5 var(--sans);
      }

      .feature-section {
        border-top: 1px solid var(--line);
      }

      .feature-pair {
        padding-top: clamp(1.25rem, 2.5vw, 2.25rem);
        display: grid;
        grid-template-columns: minmax(0, 1.7fr) minmax(19rem, 0.72fr);
        gap: clamp(1.5rem, 3.4vw, 3.5rem);
        align-items: stretch;
      }

      .feature-story {
        min-width: 0;
      }

      .feature-story__media {
        position: relative;
        display: block;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background: var(--paper-soft);
        line-height: 0;
      }

      .feature-story__media img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(1);
      }

      .feature-story__disclosure {
        position: absolute;
        right: 0.7rem;
        bottom: 0.65rem;
        padding: 0.28rem 0.38rem;
        background: rgba(23, 22, 20, 0.78);
        color: #fff;
        font: 520 0.58rem/1 var(--sans);
        letter-spacing: 0.04em;
      }

      .feature-story__body {
        padding-top: 1rem;
      }

      .feature-story__body h3 {
        max-width: 22ch;
        margin: 0.6rem 0 0;
        font: 540 clamp(2rem, 3vw, 3.35rem) / 1 var(--serif);
        letter-spacing: -0.038em;
      }

      .feature-story__body h3 a {
        text-decoration: none;
      }

      .feature-story__body h3 a:hover {
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.14em;
      }

      .feature-story__body > p {
        max-width: 49rem;
        margin: 0.75rem 0 0;
        color: var(--muted);
        font: 410 clamp(0.98rem, 1.12vw, 1.08rem) / 1.58 var(--serif);
      }

      .feature-story__footer {
        margin-top: 1.05rem;
        padding-top: 0.8rem;
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        border-top: 1px solid var(--line);
        color: var(--muted);
        font: 530 0.72rem/1.3 var(--sans);
      }

      .feature-story__footer a {
        color: var(--ink);
        text-decoration: none;
      }

      .feature-story__footer a:hover {
        color: var(--accent);
      }

      .newsletter-card {
        min-width: 0;
        padding: clamp(1.3rem, 2.3vw, 2rem);
        background: var(--accent);
        color: #fff;
      }

      .newsletter-card__label {
        margin: 0 0 clamp(1.6rem, 3vw, 3rem);
        font: 650 0.66rem/1.2 var(--sans);
        letter-spacing: 0.085em;
        text-transform: uppercase;
      }

      .newsletter-card :global(.newsletter-signup__copy h2) {
        color: #fff;
      }

      .footer-newsletter {
        padding: clamp(1.75rem, 3.4vw, 3.2rem) var(--gutter);
        border-top: 1px solid var(--ink);
      }

      .footer-newsletter > .section-label {
        margin-bottom: 0.8rem;
      }

      @media (max-width: 64rem) {
        .newsletter-hero {
          grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.95fr);
          gap: 2rem;
        }

        .feature-pair {
          grid-template-columns: minmax(0, 1.45fr) minmax(18rem, 0.75fr);
        }
      }

      @media (max-width: 48rem) {
        .newsletter-hero,
        .latest-grid,
        .feature-pair {
          grid-template-columns: 1fr;
        }

        .newsletter-hero {
          gap: 1.5rem;
        }

        .newsletter-hero__form {
          padding-top: 0;
          border-top: 0;
        }

        .fixture-warning {
          max-width: 13rem;
        }

        .news-image-placeholder {
          aspect-ratio: 16 / 9;
        }

        .newsletter-card {
          min-height: 0;
        }
      }

      @media (max-width: 36rem) {
        .newsletter-hero,
        .latest-section,
        .feature-section,
        .footer-newsletter {
          --gutter: 1.1rem;
        }

        .newsletter-hero {
          padding-top: 1.45rem;
          padding-bottom: 1.55rem;
        }

        .newsletter-hero__copy h1 {
          max-width: 17ch;
          font-size: clamp(2rem, 10vw, 2.75rem);
        }

        .latest-strip {
          grid-template-columns: auto minmax(0, 1fr);
        }

        .latest-strip__label {
          padding-inline: 0.85rem;
        }

        .latest-strip__item {
          max-width: 82vw;
          padding-inline: 0.9rem;
        }

        .latest-strip__item > strong {
          max-width: 62vw;
        }

        .section-heading {
          align-items: start;
        }

        .fixture-warning {
          font-size: 0.64rem;
        }

        .feature-story__footer {
          align-items: flex-start;
          flex-direction: column;
        }
      }

      @media (max-width: 23rem) {
        .newsletter-hero,
        .latest-section,
        .feature-section,
        .footer-newsletter {
          --gutter: 1rem;
        }
      }
    </style>
  </body>
</html>
