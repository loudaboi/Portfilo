---
const latestFixtures = [
  {
    number: "02.1",
    contentType: "Guide",
    topic: "Skills",
    title: "What makes a skill worth learning now?",
    description:
      "A design preview for a practical guide. No reported findings are being presented.",
  },
  {
    number: "02.2",
    contentType: "Analysis",
    topic: "Money",
    title: "When is a higher salary actually a better deal?",
    description:
      "A design preview for an analysis story. No real-world claim is being made.",
  },
  {
    number: "02.3",
    contentType: "Field notes",
    topic: "Building",
    title: "What do you learn by building something on the side?",
    description:
      "A design preview for field notes. This is not a published Portfilo story.",
  },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Portfilo is practical intelligence for ambitious Filipinos."
    />
    <meta name="theme-color" content="#f4f0e8" />
    <title>Portfilo | Practical intelligence for ambitious Filipinos</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Portfilo home">
        <span class="wordmark__inner">
          <span class="wordmark__port">Port</span><span class="wordmark__fi">fi</span><span class="wordmark__lo">lo</span>
        </span>
      </a>
      <p class="site-header__strapline">
        Practical intelligence for ambitious Filipinos
      </p>
      <p class="site-header__section">Editorial / Philippines</p>
    </header>

    <main id="main-content" tabindex="-1">
      <section class="identity" aria-labelledby="identity-title">
        <p class="identity__eyebrow">Work / Money / Skills / Building / Life</p>

        <h1 id="identity-title">
          Practical intelligence
          <span>for ambitious Filipinos.</span>
        </h1>

        <div class="identity__note">
          <p>
            Portfilo looks closely at work, money, skills, building, and life in
            the Philippines. We do the digging, show our work, and make the useful
            part clear.
          </p>
        </div>

        <aside class="fixture-note" aria-label="Homepage preview status">
          <span>Preview mode</span>
          <strong>Launch stories are still being selected</strong>
          <p>
            The story headlines on this page are design previews, not published
            journalism.
          </p>
        </aside>
      </section>

      <section class="feature-section" aria-labelledby="feature-title">
        <header class="section-head">
          <p>01 / Feature preview</p>
          <p>Explained / Work</p>
          <p>Not published</p>
        </header>

        <article class="feature">
          <div class="feature__copy">
            <p class="story-label">Feature preview / Not published</p>
            <h2 id="feature-title">
              What should you know before making a big career move?
            </h2>
            <p class="feature__dek">
              A homepage design preview, not a published Portfilo story. It is here
              to test how a real feature will read and feel.
            </p>
            <dl class="feature__meta">
              <div>
                <dt>Editorial type</dt>
                <dd>Explained</dd>
              </div>
              <div>
                <dt>Topic</dt>
                <dd>Work</dd>
              </div>
              <div>
                <dt>Status</dt>
                <dd>Preview</dd>
              </div>
            </dl>
          </div>

          <aside class="evidence-panel" aria-label="Synthetic evidence panel">
            <div class="evidence-panel__topline">
              <span>How we think</span>
              <span>Preview / 01</span>
            </div>
            <p class="evidence-panel__number" aria-hidden="true">01</p>
            <dl>
              <div>
                <dt>Question</dt>
                <dd>What are you deciding?</dd>
              </div>
              <div>
                <dt>Sources</dt>
                <dd>What do we know?</dd>
              </div>
              <div>
                <dt>Limits</dt>
                <dd>What don't we know?</dd>
              </div>
              <div>
                <dt>Takeaway</dt>
                <dd>What changes?</dd>
              </div>
            </dl>
            <p class="evidence-panel__note">
              Preview module. No data or reported findings are shown.
            </p>
          </aside>
        </article>
      </section>

      <section class="latest" aria-labelledby="latest-title">
        <header class="section-head section-head--latest">
          <p id="latest-title">02 / Latest + selected</p>
          <p>Story preview</p>
          <p>Not published</p>
        </header>

        <div class="latest__grid">
          {
            latestFixtures.map((story, index) => (
              <article
                class:list={[
                  "latest-story",
                  index === 0 ? "latest-story--lead" : "latest-story--compact",
                ]}
              >
                <div class="latest-story__meta">
                  <span>{story.number}</span>
                  <span>{story.contentType}</span>
                  <span>{story.topic}</span>
                </div>
                <h3>{story.title}</h3>
                <p>{story.description}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="institution" aria-labelledby="institution-title">
        <p class="institution__index">03 / What Portfilo is for</p>
        <div class="institution__statement">
          <h2 id="institution-title">Clear enough to use. Careful enough to trust.</h2>
          <p>
            No hustle sermons. No recycled advice pasted onto the Philippines.
            Portfilo reports, explains, checks the evidence, and says when the
            answer is still uncertain.
          </p>
        </div>
        <ul class="institution__topics" aria-label="Portfilo editorial topics">
          <li>Work</li>
          <li>Money</li>
          <li>Skills</li>
          <li>Building</li>
          <li>Life</li>
        </ul>
      </section>

      <section class="newsletter" id="newsletter" aria-labelledby="newsletter-title">
        <div class="newsletter__label">
          <p>04 / Portfilo Brief</p>
          <p>Email / Preview</p>
        </div>
        <div class="newsletter__copy">
          <h2 id="newsletter-title">The useful part, in your inbox.</h2>
          <p>
            New stories, sharp explanations, and the useful bits worth keeping.
            Portfilo Brief will be the simplest way to keep up.
          </p>
        </div>
        <p class="newsletter__action" aria-label="Newsletter signup design preview">
          Join Portfilo Brief <span aria-hidden="true">↗</span>
        </p>
      </section>
    </main>

    <footer class="site-footer">
      <div class="site-footer__brand" aria-label="Portfilo">
        <span class="site-footer__port">Port</span><span class="site-footer__fi">fi</span><span class="site-footer__lo">lo</span>
      </div>
      <p>Practical intelligence for ambitious Filipinos</p>
      <a href="/stories/portfilo-content-architecture-test">
        Open development story fixture
      </a>
    </footer>

    <style>
      @font-face {
        font-family: "Instrument Sans";
        font-style: normal;
        font-display: swap;
        font-weight: 400 700;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/instrument-sans:vf@5.3.0/latin-wght-normal.woff2")
          format("woff2-variations");
      }

      @font-face {
        font-family: "Source Serif 4";
        font-style: normal;
        font-display: swap;
        font-weight: 200 900;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/source-serif-4:vf@5.3.0/latin-wght-normal.woff2")
          format("woff2-variations");
      }

      @font-face {
        font-family: "IBM Plex Mono";
        font-style: normal;
        font-display: swap;
        font-weight: 400;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/ibm-plex-mono@5.3.0/latin-400-normal.woff2")
          format("woff2");
      }

      :global(:root) {
        --paper: #f4f0e8;
        --ink: #171614;
        --muted: #69655e;
        --line: #cbc5bb;
        --accent: #0050a4;
        --accent-on-ink: #8fc7ff;
        --correction: #b42318;
        --correction-soft: #f6e7e3;
        --page-max: 100rem;
        --gutter: clamp(1.25rem, 3.3vw, 3.75rem);
        --grid-gap: clamp(0.8rem, 1.6vw, 1.5rem);
        --sans: "Instrument Sans", "Helvetica Neue", Arial, sans-serif;
        --serif: "Source Serif 4", Georgia, serif;
        --mono: "IBM Plex Mono", "Courier New", monospace;
      }

      :global(*) {
        box-sizing: border-box;
      }

      :global(html) {
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
        font-synthesis: none;
      }

      :global(body) {
        margin: 0;
        min-width: 0;
        background: var(--paper);
      }

      :global(a) {
        color: inherit;
      }

      :global(a:focus-visible) {
        outline: 3px solid var(--accent);
        outline-offset: 4px;
      }

      :global(main:focus) {
        outline: none;
      }

      .skip-link {
        position: fixed;
        z-index: 20;
        top: 0.75rem;
        left: 0.75rem;
        padding: 0.65rem 0.8rem;
        background: var(--ink);
        color: var(--paper);
        font: 400 0.75rem/1 var(--mono);
        text-decoration: none;
        transform: translateY(-200%);
      }

      .skip-link:focus {
        transform: translateY(0);
      }

      .site-header,
      .identity,
      .feature-section,
      .latest,
      .newsletter,
      .site-footer {
        width: min(100%, var(--page-max));
        margin-inline: auto;
      }

      .site-header {
        padding: 1.05rem var(--gutter) 0.95rem;
        display: grid;
        grid-template-columns: 3fr 6fr 3fr;
        gap: var(--grid-gap);
        align-items: end;
        border-bottom: 1px solid var(--ink);
      }

      .wordmark {
        width: fit-content;
        display: inline-block;
        text-decoration: none;
      }

      .wordmark__inner {
        display: inline-block;
        white-space: nowrap;
        font: 700 clamp(1.75rem, 2.2vw, 2.3rem) / 0.9 var(--sans);
        letter-spacing: -0.085em;
        transform: skewX(-12deg);
        transform-origin: left center;
      }

      .wordmark__port,
      .wordmark__fi,
      .wordmark__lo {
        display: inline-block;
      }

      .wordmark__port,
      .site-footer__port {
        color: var(--ink);
      }

      .wordmark__fi,
      .site-footer__fi {
        color: var(--accent);
      }

      .wordmark__lo,
      .site-footer__lo {
        color: var(--correction);
      }

      .site-header__strapline,
      .site-header__section {
        margin: 0;
        color: var(--muted);
        font: 400 0.68rem/1.35 var(--mono);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .site-header__strapline {
        text-align: center;
      }

      .site-header__section {
        color: var(--ink);
        text-align: right;
      }

      .identity {
        padding: clamp(3.8rem, 7vw, 7.5rem) var(--gutter)
          clamp(4.5rem, 8vw, 8rem);
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: var(--grid-gap);
        row-gap: clamp(2rem, 4vw, 4rem);
      }

      .identity__eyebrow {
        grid-column: 1 / 4;
        margin: 0.55rem 0 0;
        color: var(--muted);
        font: 400 0.67rem/1.4 var(--mono);
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }

      .identity h1 {
        grid-column: 3 / 13;
        min-width: 0;
        max-width: 14ch;
        margin: 0;
        font: 500 clamp(3.75rem, 7.75vw, 8.2rem) / 0.88 var(--sans);
        letter-spacing: -0.07em;
        word-spacing: 0.06em;
        text-wrap: balance;
        overflow-wrap: break-word;
      }

      .identity h1 span {
        color: var(--accent);
      }

      .identity__note {
        grid-column: 7 / 12;
        max-width: 38rem;
      }

      .identity__note p {
        margin: 0;
        font: 400 clamp(1.25rem, 1.7vw, 1.68rem) / 1.48 var(--serif);
      }

      .fixture-note {
        grid-column: 1 / 4;
        grid-row: 3;
        align-self: end;
        padding-top: 0.85rem;
        border-top: 1px solid var(--line);
        font: 400 0.68rem/1.55 var(--mono);
      }

      .fixture-note span {
        display: block;
        margin-bottom: 0.45rem;
        color: var(--muted);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .fixture-note strong {
        display: block;
        font-weight: 400;
      }

      .fixture-note p {
        margin: 0.55rem 0 0;
        color: var(--muted);
      }

      .feature-section,
      .latest,
      .newsletter {
        padding-inline: var(--gutter);
      }

      .section-head {
        padding: 0.7rem 0 0.65rem;
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
        border-top: 1px solid var(--ink);
        border-bottom: 1px solid var(--line);
        color: var(--muted);
        font: 400 0.64rem/1.4 var(--mono);
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }

      .section-head p {
        margin: 0;
      }

      .section-head p:first-child {
        grid-column: 1 / 5;
        color: var(--ink);
      }

      .section-head p:nth-child(2) {
        grid-column: 7 / 10;
      }

      .section-head p:last-child {
        grid-column: 10 / 13;
        text-align: right;
      }

      .feature {
        padding: clamp(2.5rem, 5vw, 5.5rem) 0 clamp(4rem, 7vw, 7rem);
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
      }

      .feature__copy {
        grid-column: 1 / 9;
        min-width: 0;
        padding-right: clamp(0rem, 2vw, 2rem);
      }

      .story-label {
        margin: 0 0 1.25rem;
        color: var(--accent);
        font: 400 0.68rem/1.4 var(--mono);
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }

      .feature h2 {
        max-width: 16ch;
        margin: 0;
        font: 500 clamp(3rem, 5.55vw, 5.85rem) / 0.93 var(--sans);
        letter-spacing: -0.06em;
        text-wrap: balance;
        overflow-wrap: break-word;
      }

      .feature__dek {
        max-width: 40rem;
        margin: clamp(2rem, 3.4vw, 3.25rem) 0 0;
        font: 400 clamp(1.2rem, 1.55vw, 1.5rem) / 1.5 var(--serif);
      }

      .feature__meta {
        max-width: 42rem;
        margin: clamp(2.4rem, 4vw, 4rem) 0 0;
        padding-top: 0.9rem;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
        border-top: 1px solid var(--line);
        font: 400 0.67rem/1.5 var(--mono);
      }

      .feature__meta dt,
      .evidence-panel dt {
        margin-bottom: 0.3rem;
        color: var(--muted);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .feature__meta dd,
      .evidence-panel dd {
        margin: 0;
      }

      .evidence-panel {
        grid-column: 9 / 13;
        min-width: 0;
        min-height: 36rem;
        padding: clamp(1.25rem, 2vw, 2rem);
        display: flex;
        flex-direction: column;
        background: var(--ink);
        color: var(--paper);
      }

      .evidence-panel__topline {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        color: var(--accent-on-ink);
        font: 400 0.62rem/1.4 var(--mono);
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }

      .evidence-panel__number {
        margin: auto 0 1.2rem;
        color: var(--accent-on-ink);
        font: 500 clamp(7rem, 13vw, 13rem) / 0.72 var(--sans);
        letter-spacing: -0.09em;
      }

      .evidence-panel dl {
        margin: 0;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0;
        border-top: 1px solid #55524d;
      }

      .evidence-panel dl > div {
        min-width: 0;
        padding: 0.85rem 0.75rem 0.85rem 0;
        border-bottom: 1px solid #55524d;
      }

      .evidence-panel dl > div:nth-child(even) {
        padding-left: 0.75rem;
        border-left: 1px solid #55524d;
      }

      .evidence-panel dt {
        color: var(--accent-on-ink);
        font: 400 0.58rem/1.35 var(--mono);
      }

      .evidence-panel dd {
        font: 400 0.78rem/1.45 var(--mono);
        overflow-wrap: anywhere;
      }

      .evidence-panel__note {
        margin: 1.15rem 0 0;
        color: #bdb8af;
        font: 400 0.62rem/1.55 var(--mono);
      }

      .latest {
        padding-bottom: clamp(5rem, 8vw, 8rem);
      }

      .latest__grid {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
      }

      .latest-story {
        min-width: 0;
        padding-top: clamp(2rem, 3vw, 3rem);
      }

      .latest-story__meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem;
        margin-bottom: 1.1rem;
        color: var(--muted);
        font: 400 0.62rem/1.4 var(--mono);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .latest-story__meta span + span::before {
        content: "/";
        margin-right: 0.55rem;
        color: var(--accent);
      }

      .latest-story h3 {
        margin: 0;
        font-weight: 500;
        letter-spacing: -0.045em;
        overflow-wrap: break-word;
      }

      .latest-story > p {
        margin: 1.2rem 0 0;
        color: var(--muted);
        font: 400 1.03rem/1.56 var(--serif);
      }

      .latest-story--lead {
        grid-column: 1 / 8;
        grid-row: 1 / 3;
        padding-right: clamp(1rem, 3vw, 3rem);
      }

      .latest-story--lead h3 {
        max-width: 17ch;
        font-size: clamp(2.4rem, 3.8vw, 4rem);
        line-height: 0.98;
      }

      .latest-story--lead > p {
        max-width: 35rem;
        font-size: 1.15rem;
      }

      .latest-story--compact {
        grid-column: 9 / 13;
        padding-bottom: clamp(2rem, 3vw, 3rem);
        border-bottom: 1px solid var(--line);
      }

      .latest-story--compact:nth-child(2) {
        grid-row: 1;
      }

      .latest-story--compact:nth-child(3) {
        grid-row: 2;
      }

      .latest-story--compact h3 {
        font-size: clamp(1.65rem, 2.25vw, 2.3rem);
        line-height: 1.04;
      }

      .institution {
        width: 100%;
        padding: clamp(4rem, 7vw, 7.5rem)
          max(var(--gutter), calc((100vw - var(--page-max)) / 2 + var(--gutter)));
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
        background: var(--ink);
        color: var(--paper);
      }

      .institution__index {
        grid-column: 1 / 3;
        margin: 0;
        color: var(--accent-on-ink);
        font: 400 0.64rem/1.4 var(--mono);
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }

      .institution__statement {
        grid-column: 4 / 11;
      }

      .institution h2 {
        max-width: 16ch;
        margin: 0;
        font: 500 clamp(2.9rem, 5.3vw, 5.5rem) / 0.94 var(--sans);
        letter-spacing: -0.06em;
        text-wrap: balance;
      }

      .institution__statement > p {
        max-width: 42rem;
        margin: clamp(2rem, 3.5vw, 3.5rem) 0 0;
        color: #d7d2c9;
        font: 400 clamp(1.15rem, 1.45vw, 1.4rem) / 1.58 var(--serif);
      }

      .institution__topics {
        grid-column: 11 / 13;
        margin: 0;
        padding: 0;
        list-style: none;
        align-self: end;
        border-top: 1px solid #55524d;
        font: 400 0.65rem/1.4 var(--mono);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .institution__topics li {
        padding: 0.65rem 0;
        border-bottom: 1px solid #55524d;
      }

      .institution__topics li::before {
        content: "■";
        margin-right: 0.6rem;
        color: var(--accent-on-ink);
        font-size: 0.55em;
        vertical-align: 0.12em;
      }

      .newsletter {
        padding-top: clamp(4rem, 7vw, 7rem);
        padding-bottom: clamp(4rem, 7vw, 7rem);
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
        border-bottom: 1px solid var(--ink);
      }

      .newsletter__label {
        grid-column: 1 / 4;
        padding-top: 0.7rem;
        border-top: 1px solid var(--ink);
        font: 400 0.64rem/1.5 var(--mono);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .newsletter__label p {
        margin: 0 0 0.45rem;
      }

      .newsletter__label p:last-child {
        color: var(--muted);
      }

      .newsletter__copy {
        grid-column: 5 / 11;
      }

      .newsletter h2 {
        max-width: 13ch;
        margin: 0;
        font: 500 clamp(3rem, 5.6vw, 5.8rem) / 0.92 var(--sans);
        letter-spacing: -0.06em;
        text-wrap: balance;
      }

      .newsletter__copy > p {
        max-width: 39rem;
        margin: clamp(1.8rem, 3vw, 2.8rem) 0 0;
        font: 400 clamp(1.12rem, 1.4vw, 1.35rem) / 1.58 var(--serif);
      }

      .newsletter__action {
        grid-column: 11 / 13;
        align-self: end;
        margin: 0;
        padding: 0.9rem 0 0.7rem;
        border-top: 3px solid var(--accent);
        border-bottom: 1px solid var(--ink);
        font: 500 clamp(1.1rem, 1.5vw, 1.35rem) / 1.15 var(--sans);
      }

      .newsletter__action span {
        color: var(--accent);
      }

      .site-footer {
        padding: 1.2rem var(--gutter) 1.4rem;
        display: grid;
        grid-template-columns: 3fr 6fr 3fr;
        gap: var(--grid-gap);
        align-items: end;
        font: 400 0.64rem/1.45 var(--mono);
      }

      .site-footer__brand {
        width: fit-content;
        white-space: nowrap;
        font: 700 1.55rem/0.9 var(--sans);
        letter-spacing: -0.085em;
        transform: skewX(-12deg);
        transform-origin: left center;
      }

      .site-footer p {
        margin: 0;
        color: var(--muted);
        text-align: center;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .site-footer a {
        justify-self: end;
        color: var(--ink);
        text-decoration-color: var(--accent);
        text-decoration-thickness: 0.1em;
        text-underline-offset: 0.18em;
      }

      .site-footer a:hover {
        color: var(--accent);
      }

      @media (max-width: 64rem) {
        .identity h1 {
          grid-column: 2 / 13;
        }

        .identity__note {
          grid-column: 6 / 12;
        }

        .feature__copy {
          grid-column: 1 / 8;
        }

        .evidence-panel {
          grid-column: 8 / 13;
        }

        .latest-story--lead {
          grid-column: 1 / 8;
        }

        .latest-story--compact {
          grid-column: 8 / 13;
        }

        .institution__statement {
          grid-column: 3 / 11;
        }

        .institution__topics {
          grid-column: 11 / 13;
        }

        .newsletter__copy {
          grid-column: 4 / 10;
        }

        .newsletter__action {
          grid-column: 10 / 13;
        }
      }

      @media (max-width: 50rem) {
        .site-header {
          grid-template-columns: 1fr auto;
          align-items: center;
          padding-top: 0.9rem;
        }

        .site-header__strapline {
          grid-column: 1 / -1;
          grid-row: 2;
          max-width: 32rem;
          padding-top: 0.55rem;
          text-align: left;
        }

        .site-header__section {
          grid-column: 2;
          grid-row: 1;
        }

        .identity {
          display: block;
          padding-top: 3.6rem;
          padding-bottom: 4.25rem;
        }

        .identity__eyebrow {
          margin: 0 0 1.35rem;
        }

        .identity h1 {
          max-width: none;
          font-size: clamp(3.25rem, 13vw, 5.2rem);
          line-height: 0.91;
          text-wrap: pretty;
        }

        .identity__note {
          max-width: 35rem;
          margin-top: 2.2rem;
        }

        .identity__note p {
          font-size: 1.25rem;
        }

        .fixture-note {
          max-width: 24rem;
          margin-top: 3rem;
        }

        .section-head {
          grid-template-columns: 1fr auto;
          gap: 0.5rem 1rem;
        }

        .section-head p:first-child,
        .section-head p:nth-child(2),
        .section-head p:last-child {
          grid-column: auto;
        }

        .section-head p:nth-child(2) {
          display: none;
        }

        .section-head p:last-child {
          text-align: right;
        }

        .feature {
          display: block;
          padding-top: 2.7rem;
          padding-bottom: 4.25rem;
        }

        .feature__copy {
          padding-right: 0;
        }

        .feature h2 {
          max-width: none;
          font-size: clamp(2.85rem, 11.5vw, 4.6rem);
          line-height: 0.95;
          text-wrap: pretty;
        }

        .feature__dek {
          font-size: 1.2rem;
        }

        .feature__meta {
          grid-template-columns: 1fr 1fr;
          gap: 1rem;
        }

        .feature__meta div:last-child {
          grid-column: 1 / -1;
        }

        .evidence-panel {
          min-height: 0;
          margin-top: 3rem;
        }

        .evidence-panel__topline {
          flex-wrap: wrap;
          align-items: flex-start;
          row-gap: 0.35rem;
        }

        .evidence-panel__number {
          margin: 2.25rem 0 1.75rem;
          font-size: clamp(6rem, 27vw, 8.5rem);
          line-height: 0.8;
        }

        .latest {
          padding-bottom: 4.75rem;
        }

        .latest__grid {
          display: block;
        }

        .latest-story--lead,
        .latest-story--compact {
          padding-right: 0;
          padding-bottom: 2.5rem;
          border-bottom: 1px solid var(--line);
        }

        .latest-story--lead h3 {
          max-width: none;
          font-size: clamp(2.3rem, 9vw, 3.35rem);
        }

        .latest-story--compact h3 {
          font-size: clamp(1.75rem, 7vw, 2.4rem);
        }

        .institution {
          display: block;
          padding-top: 4rem;
          padding-bottom: 4.25rem;
        }

        .institution__index {
          margin-bottom: 2.1rem;
        }

        .institution h2 {
          max-width: none;
          font-size: clamp(2.8rem, 11vw, 4.5rem);
        }

        .institution__statement > p {
          font-size: 1.15rem;
        }

        .institution__topics {
          max-width: 22rem;
          margin-top: 3rem;
        }

        .newsletter {
          display: block;
          padding-top: 4rem;
          padding-bottom: 4.5rem;
        }

        .newsletter__label {
          max-width: 24rem;
          margin-bottom: 2.5rem;
        }

        .newsletter h2 {
          max-width: none;
          font-size: clamp(3rem, 12vw, 4.8rem);
        }

        .newsletter__copy > p {
          font-size: 1.15rem;
        }

        .newsletter__action {
          max-width: 18rem;
          margin-top: 2.8rem;
        }

        .site-footer {
          grid-template-columns: 1fr auto;
          align-items: start;
          gap: 1rem;
        }

        .site-footer p {
          grid-column: 1 / -1;
          grid-row: 2;
          text-align: left;
        }

        .site-footer a {
          max-width: 13rem;
          text-align: right;
        }
      }

      @media (max-width: 30rem) {
        .site-header__section {
          font-size: 0.58rem;
        }

        .identity h1 {
          font-size: clamp(3rem, 14vw, 4rem);
        }

        .feature h2 {
          font-size: clamp(2.65rem, 12.5vw, 3.7rem);
        }

        .evidence-panel dl {
          grid-template-columns: 1fr;
        }

        .evidence-panel dl > div:nth-child(even) {
          padding-left: 0;
          border-left: 0;
        }

        .site-footer {
          display: block;
        }

        .site-footer p,
        .site-footer a {
          display: block;
          margin-top: 1rem;
          text-align: left;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .skip-link {
          transition: none;
        }
      }
    </style>
  </body>
</html>
