---
import { getCollection } from "astro:content";
import SiteHead from "../components/SiteHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";

const publishedStories = await getCollection(
  "stories",
  ({ data }) => data.status === "published",
);

const storiesByDate = [...publishedStories].sort(
  (a, b) =>
    (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0),
);

const featureStory =
  storiesByDate.find(({ data }) => data.featured) ?? storiesByDate[0];

const dateFormatter = new Intl.DateTimeFormat("en-PH", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});

const formatDate = (date?: Date) => (date ? dateFormatter.format(date) : "");
const formatLabel = (value: string) => value.replaceAll("-", " ");

const devNews = import.meta.env.DEV
  ? [
      {
        topic: "business",
        time: "12 min ago",
        title: "Development fixture: a long lead-news headline tests hierarchy and wrapping",
        dek: "Synthetic layout copy used only in local development to test the future News composition.",
      },
      {
        topic: "technology",
        time: "28 min ago",
        title: "Development fixture: compact technology headline",
        dek: "Tests a shorter secondary item without presenting fabricated reporting.",
      },
      {
        topic: "startups",
        time: "46 min ago",
        title: "Development fixture: startup update with a medium-length headline",
        dek: "Tests supporting-news density and mobile stacking.",
      },
      {
        topic: "ai",
        time: "1 hr ago",
        title: "Development fixture: another update for the chronological feed",
        dek: "Tests the fourth item in a realistic local-development composition.",
      },
    ]
  : [];

const tickerItems =
  devNews.length > 0
    ? devNews.map((item) => ({ label: item.topic, title: item.title }))
    : storiesByDate.map((story) => ({
        label: story.data.topic,
        title: story.data.title,
      }));
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      title="Portfilo | Business and Technology News"
      description="Business and technology news, plus deeper stories from Portfilo."
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader />

    <main id="main-content" tabindex="-1">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero__main">
          <p class="hero__kicker">Business / Technology / Startups / AI / Building</p>
          <h1 id="hero-title">Keep up with business and technology.</h1>
          <p class="hero__dek">Get the latest news and deeper stories from Portfilo by email.</p>

          <div class="hero__signup" id="newsletter">
            <NewsletterSignup
              id="home-hero-newsletter"
              heading="Get Portfilo by email."
              copy="News and features from Portfilo, free."
              variant="hero"
            />
          </div>
        </div>

        <aside class="hero__panel" aria-label="Portfilo coverage">
          <div class="hero__panel-top">
            <span>Portfilo</span>
            <span>Newsletter</span>
          </div>
          <p class="hero__panel-statement">Latest news.<br />Deeper stories.</p>
          <div class="hero__panel-bottom">
            <span>Business</span>
            <span>Technology</span>
            <span>Startups</span>
            <span>AI</span>
            <span>Building</span>
          </div>
        </aside>
      </section>

      {
        tickerItems.length > 0 && (
          <section class="latest-strip" id="latest" aria-label="Latest from Portfilo">
            <div class="latest-strip__label">
              <span class="latest-strip__dot" aria-hidden="true"></span>
              <strong>Latest</strong>
              {devNews.length > 0 && <span>Development fixture</span>}
            </div>
            <div class="latest-strip__items">
              {tickerItems.map((item) => (
                <span class="latest-strip__item">
                  <span>{formatLabel(item.label)}</span>
                  <strong>{item.title}</strong>
                </span>
              ))}
            </div>
          </section>
        )
      }

      {
        devNews.length > 0 && (
          <section class="latest-layout" aria-labelledby="latest-layout-title">
            <header class="section-title-row">
              <div>
                <p>Local development preview</p>
                <h2 id="latest-layout-title">The latest</h2>
              </div>
              <p class="fixture-warning">Synthetic fixture copy. Not Portfilo reporting.</p>
            </header>

            <div class="latest-grid">
              <article class="lead-news">
                <div class="fixture-media" aria-hidden="true">
                  <span>News</span>
                </div>
                <div class="lead-news__copy">
                  <div class="news-meta">
                    <span>{devNews[0].topic}</span>
                    <span>{devNews[0].time}</span>
                  </div>
                  <h3>{devNews[0].title}</h3>
                  <p>{devNews[0].dek}</p>
                </div>
              </article>

              <div class="news-cluster">
                {devNews.slice(1).map((item) => (
                  <article class="cluster-news">
                    <div class="news-meta">
                      <span>{item.topic}</span>
                      <span>{item.time}</span>
                    </div>
                    <h3>{item.title}</h3>
                    <p>{item.dek}</p>
                  </article>
                ))}
              </div>
            </div>
          </section>
        )
      }

      {
        featureStory && (
          <section class="feature-showcase" aria-labelledby="feature-title">
            <header class="section-title-row section-title-row--feature">
              <div>
                <p>Feature</p>
                <h2>A closer look</h2>
              </div>
              <a href="/stories">Browse Features</a>
            </header>

            <article class="feature-card">
              <a class="feature-card__media" href={`/stories/${featureStory.id}`} aria-label={`Read ${featureStory.data.title}`}>
                <img
                  src="/images/homepage-feature-image.webp"
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
                <span class="feature-card__disclosure">AI-generated editorial image</span>
              </a>

              <div class="feature-card__copy">
                <div class="feature-card__meta">
                  <span>{formatLabel(featureStory.data.contentType)}</span>
                  <span>{formatLabel(featureStory.data.topic)}</span>
                  <span>{formatDate(featureStory.data.publishedAt)}</span>
                </div>
                <h2 id="feature-title">
                  <a href={`/stories/${featureStory.id}`}>{featureStory.data.title}</a>
                </h2>
                <p>{featureStory.data.dek}</p>
                <div class="feature-card__footer">
                  <span>{featureStory.data.author}</span>
                  <a href={`/stories/${featureStory.id}`}>Read Feature <span aria-hidden="true">→</span></a>
                </div>
              </div>
            </article>
          </section>
        )
      }

      <section class="newsletter-band" aria-label="Subscribe to Portfilo">
        <NewsletterSignup
          id="home-mid-newsletter"
          heading="Follow the next update."
          copy="Get Portfilo's business and technology news and deeper Features by email."
          variant="inline"
        />
      </section>

      {
        storiesByDate.length > 1 && (
          <section class="more-features" aria-labelledby="more-features-title">
            <header class="section-title-row">
              <div>
                <p>Features</p>
                <h2 id="more-features-title">More from Portfilo</h2>
              </div>
              <a href="/stories">View all</a>
            </header>

            <div class="more-features__grid">
              {storiesByDate
                .filter((story) => story.id !== featureStory?.id)
                .slice(0, 3)
                .map((story) => (
                  <article>
                    <div class="feature-card__meta">
                      <span>{formatLabel(story.data.contentType)}</span>
                      <span>{formatLabel(story.data.topic)}</span>
                    </div>
                    <h3><a href={`/stories/${story.id}`}>{story.data.title}</a></h3>
                    <p>{story.data.dek}</p>
                  </article>
                ))}
            </div>
          </section>
        )
      }

      <section class="newsletter-final" aria-label="Subscribe to the Portfilo newsletter">
        <NewsletterSignup
          id="home-footer-newsletter"
          heading="Portfilo in your inbox."
          copy="Subscribe free for the next business and technology update."
          variant="footer"
        />
      </section>
    </main>

    <SiteFooter />

    <style>
      @font-face {
        font-family: "Instrument Sans";
        font-style: normal;
        font-display: swap;
        font-weight: 400 700;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/instrument-sans:vf@5.3.0/latin-wght-normal.woff2") format("woff2-variations");
      }

      @font-face {
        font-family: "Source Serif 4";
        font-style: normal;
        font-display: swap;
        font-weight: 200 900;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/source-serif-4:vf@5.3.0/latin-wght-normal.woff2") format("woff2-variations");
      }

      @font-face {
        font-family: "IBM Plex Mono";
        font-style: normal;
        font-display: swap;
        font-weight: 400;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/ibm-plex-mono@5.3.0/latin-400-normal.woff2") format("woff2");
      }

      :global(:root) {
        --paper: #f8f6f1;
        --paper-soft: #efebe3;
        --ink: #171614;
        --muted: #68645e;
        --line: #d4cfc6;
        --line-strong: #aaa39a;
        --accent: #0050a4;
        --accent-on-ink: #9dceff;
        --correction: #b42318;
        --page-max: 100rem;
        --gutter: clamp(1.25rem, 3.3vw, 3.75rem);
        --grid-gap: clamp(0.9rem, 1.7vw, 1.6rem);
        --sans: "Instrument Sans", "Helvetica Neue", Arial, sans-serif;
        --serif: "Source Serif 4", Georgia, serif;
        --mono: "IBM Plex Mono", "Courier New", monospace;
      }

      :global(*) { box-sizing: border-box; }
      :global(html) { background: var(--paper); color: var(--ink); font-family: var(--sans); font-synthesis: none; scroll-behavior: smooth; }
      :global(body) { margin: 0; min-width: 0; background: var(--paper); }
      :global(a) { color: inherit; }
      :global(a:focus-visible) { outline: 3px solid var(--accent); outline-offset: 4px; }
      :global(main:focus) { outline: none; }

      .skip-link {
        position: fixed;
        z-index: 50;
        top: 0.75rem;
        left: 0.75rem;
        padding: 0.7rem 0.85rem;
        background: var(--ink);
        color: var(--paper);
        font: 500 0.75rem/1 var(--sans);
        text-decoration: none;
        transform: translateY(-200%);
      }
      .skip-link:focus { transform: translateY(0); }

      .hero,
      .latest-strip,
      .latest-layout,
      .feature-showcase,
      .newsletter-band,
      .more-features,
      .newsletter-final {
        width: min(100%, var(--page-max));
        margin-inline: auto;
      }

      .hero {
        min-height: min(49rem, calc(100svh - 5rem));
        padding: clamp(3.25rem, 6vw, 7rem) var(--gutter) clamp(3.25rem, 5vw, 5.5rem);
        display: grid;
        grid-template-columns: minmax(0, 1.08fr) minmax(20rem, 0.72fr);
        gap: clamp(2.5rem, 7vw, 8rem);
        align-items: stretch;
      }

      .hero__main { align-self: center; }

      .hero__kicker {
        margin: 0 0 1.25rem;
        color: var(--accent);
        font: 650 clamp(0.72rem, 0.85vw, 0.82rem) / 1.2 var(--sans);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .hero h1 {
        max-width: 10.5ch;
        margin: 0;
        font: 650 clamp(4rem, 7.8vw, 8.8rem) / 0.88 var(--sans);
        letter-spacing: -0.065em;
      }

      .hero__dek {
        max-width: 35rem;
        margin: 1.5rem 0 0;
        color: var(--muted);
        font: 400 clamp(1.15rem, 1.6vw, 1.45rem) / 1.45 var(--serif);
      }

      .hero__signup {
        max-width: 46rem;
        margin-top: clamp(2.5rem, 5vw, 4.5rem);
        padding-top: 1.5rem;
        border-top: 1px solid var(--line);
      }

      .hero__signup :global(.newsletter-signup__copy h2) {
        font-size: clamp(1.65rem, 2.3vw, 2.5rem);
        letter-spacing: -0.035em;
      }
      .hero__signup :global(.newsletter-signup__copy p) { margin-top: 0.45rem; }
      .hero__signup :global(.newsletter-signup) { gap: 1.2rem; }

      .hero__panel {
        min-height: 33rem;
        padding: clamp(1.5rem, 3vw, 2.5rem);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        background: var(--ink);
        color: var(--paper);
      }

      .hero__panel-top,
      .hero__panel-bottom {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        color: #c7c3bc;
        font: 550 0.7rem/1.2 var(--sans);
        letter-spacing: 0.07em;
        text-transform: uppercase;
      }

      .hero__panel-statement {
        max-width: 7ch;
        margin: 0;
        font: 450 clamp(3rem, 5.3vw, 6rem) / 0.92 var(--serif);
        letter-spacing: -0.04em;
      }

      .hero__panel-bottom {
        justify-content: flex-start;
        flex-wrap: wrap;
        gap: 0.55rem 1.1rem;
      }

      .latest-strip {
        min-height: 3.5rem;
        padding-inline: var(--gutter);
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        align-items: center;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }

      .latest-strip__label {
        padding-right: 1.4rem;
        display: flex;
        align-items: center;
        gap: 0.55rem;
        white-space: nowrap;
        font: 600 0.7rem/1 var(--sans);
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .latest-strip__label > span:last-child:not(.latest-strip__dot) {
        color: var(--correction);
        font-weight: 500;
      }

      .latest-strip__dot {
        width: 0.48rem;
        height: 0.48rem;
        border-radius: 50%;
        background: var(--accent);
      }

      .latest-strip__items {
        min-width: 0;
        padding-block: 1rem;
        display: flex;
        gap: 1.6rem;
        overflow-x: auto;
        overscroll-behavior-inline: contain;
        scrollbar-width: none;
      }
      .latest-strip__items::-webkit-scrollbar { display: none; }

      .latest-strip__item {
        flex: 0 0 auto;
        display: flex;
        gap: 0.65rem;
        align-items: baseline;
        white-space: nowrap;
        font-size: 0.77rem;
      }
      .latest-strip__item::after {
        content: "•";
        margin-left: 0.95rem;
        color: var(--muted);
      }
      .latest-strip__item > span {
        color: var(--accent);
        font-size: 0.65rem;
        font-weight: 650;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }
      .latest-strip__item strong { font-weight: 500; }

      .latest-layout,
      .feature-showcase,
      .more-features {
        padding: clamp(4rem, 7vw, 7rem) var(--gutter);
      }

      .section-title-row {
        padding-bottom: 1.1rem;
        display: flex;
        justify-content: space-between;
        gap: 1.5rem;
        align-items: end;
        border-bottom: 1px solid var(--line-strong);
      }
      .section-title-row p,
      .section-title-row h2 { margin: 0; }
      .section-title-row > div > p {
        margin-bottom: 0.35rem;
        color: var(--accent);
        font: 650 0.68rem/1.2 var(--sans);
        letter-spacing: 0.07em;
        text-transform: uppercase;
      }
      .section-title-row h2 {
        font: 550 clamp(2rem, 3.4vw, 3.6rem) / 0.98 var(--serif);
        letter-spacing: -0.04em;
      }
      .section-title-row > a {
        color: var(--accent);
        font: 600 0.8rem/1 var(--sans);
        text-decoration: none;
      }

      .fixture-warning {
        max-width: 24rem;
        color: var(--correction);
        font: 550 0.7rem/1.4 var(--sans);
        text-align: right;
      }

      .latest-grid {
        padding-top: 1.5rem;
        display: grid;
        grid-template-columns: minmax(0, 1.45fr) minmax(18rem, 0.72fr);
        gap: clamp(2rem, 5vw, 5rem);
      }

      .lead-news {
        display: grid;
        grid-template-columns: minmax(14rem, 0.85fr) minmax(0, 1.15fr);
        gap: clamp(1.5rem, 3vw, 3rem);
      }

      .fixture-media {
        position: relative;
        min-height: 28rem;
        padding: 1.5rem;
        display: flex;
        align-items: end;
        overflow: hidden;
        background: var(--ink);
        color: var(--paper);
      }
      .fixture-media::after {
        content: "";
        position: absolute;
        top: 0;
        right: 0;
        width: 0.32rem;
        height: 100%;
        background: var(--accent);
      }
      .fixture-media span {
        font: 650 clamp(3rem, 6vw, 6rem) / 0.9 var(--sans);
        letter-spacing: -0.06em;
      }

      .lead-news__copy {
        align-self: end;
        padding-bottom: 0.25rem;
      }

      .news-meta,
      .feature-card__meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem 1rem;
        color: var(--muted);
        font: 600 0.66rem/1.3 var(--sans);
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }
      .news-meta span:first-child,
      .feature-card__meta span:first-child { color: var(--accent); }

      .lead-news h3,
      .cluster-news h3,
      .more-features h3 {
        margin: 0;
        font-family: var(--serif);
        font-weight: 520;
        letter-spacing: -0.035em;
      }
      .lead-news h3 {
        margin-top: 0.8rem;
        font-size: clamp(2.3rem, 4vw, 4.6rem);
        line-height: 0.97;
      }
      .lead-news p,
      .cluster-news p,
      .more-features p {
        color: var(--muted);
        font-family: var(--serif);
      }
      .lead-news p {
        max-width: 38rem;
        margin: 1rem 0 0;
        font-size: 1.05rem;
        line-height: 1.45;
      }

      .news-cluster { border-top: 1px solid var(--line); }
      .cluster-news {
        padding: 1.25rem 0 1.45rem;
        border-bottom: 1px solid var(--line);
      }
      .cluster-news h3 {
        margin-top: 0.65rem;
        font-size: clamp(1.35rem, 2vw, 2rem);
        line-height: 1.05;
      }
      .cluster-news p {
        margin: 0.6rem 0 0;
        font-size: 0.92rem;
        line-height: 1.42;
      }

      .feature-showcase { padding-top: 1rem; }
      .section-title-row--feature { margin-bottom: 1.5rem; }

      .feature-card {
        display: grid;
        grid-template-columns: minmax(0, 1.04fr) minmax(20rem, 0.96fr);
        gap: clamp(2rem, 5vw, 5.5rem);
        align-items: stretch;
      }

      .feature-card__media {
        position: relative;
        min-height: 31rem;
        display: block;
        overflow: hidden;
        background: var(--paper-soft);
      }
      .feature-card__media img {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
      }
      .feature-card__disclosure {
        position: absolute;
        right: 0.8rem;
        bottom: 0.8rem;
        padding: 0.4rem 0.5rem;
        background: rgb(23 22 20 / 82%);
        color: white;
        font: 500 0.62rem/1 var(--sans);
      }

      .feature-card__copy { align-self: center; }
      .feature-card__copy h2 {
        margin: 0.9rem 0 0;
        font: 520 clamp(3rem, 5.3vw, 6.3rem) / 0.91 var(--serif);
        letter-spacing: -0.055em;
      }
      .feature-card__copy h2 a,
      .more-features h3 a { text-decoration: none; }
      .feature-card__copy > p {
        max-width: 40rem;
        margin: 1.25rem 0 0;
        color: var(--muted);
        font: 400 clamp(1.08rem, 1.4vw, 1.28rem) / 1.5 var(--serif);
      }
      .feature-card__footer {
        margin-top: 2rem;
        padding-top: 1rem;
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        border-top: 1px solid var(--line);
        font: 550 0.75rem/1.2 var(--sans);
      }
      .feature-card__footer a {
        color: var(--accent);
        text-decoration: none;
      }

      .newsletter-band,
      .newsletter-final {
        padding: clamp(3rem, 5vw, 5rem) var(--gutter);
        border-top: 1px solid var(--line);
      }
      .newsletter-band { background: var(--paper-soft); }

      .more-features { padding-top: clamp(3rem, 5vw, 5rem); }
      .more-features__grid {
        padding-top: 1.3rem;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--grid-gap);
      }
      .more-features article {
        padding-right: 1.25rem;
        border-right: 1px solid var(--line);
      }
      .more-features article:last-child { border-right: 0; }
      .more-features h3 {
        margin-top: 0.75rem;
        font-size: clamp(1.5rem, 2.2vw, 2.25rem);
        line-height: 1.05;
      }
      .more-features p {
        margin: 0.75rem 0 0;
        font-size: 0.95rem;
        line-height: 1.45;
      }

      .newsletter-final {
        margin-top: clamp(2rem, 4vw, 4rem);
        border-top-color: var(--ink);
      }

      @media (max-width: 68rem) {
        .hero {
          min-height: auto;
          grid-template-columns: 1fr;
        }
        .hero__main { max-width: 54rem; }
        .hero__panel { min-height: 22rem; }
        .hero__panel-statement { font-size: clamp(3rem, 9vw, 5.6rem); }
        .latest-grid,
        .feature-card { grid-template-columns: 1fr; }
        .lead-news { grid-template-columns: minmax(12rem, 0.75fr) minmax(0, 1.25fr); }
        .news-cluster {
          display: grid;
          grid-template-columns: repeat(3, minmax(0, 1fr));
          gap: 1.25rem;
          border-top: 0;
        }
        .cluster-news { border-top: 1px solid var(--line); }
        .feature-card__media { min-height: 28rem; }
      }

      @media (max-width: 48rem) {
        :global(:root) { --gutter: 1.15rem; }
        .hero {
          padding-top: 2.8rem;
          gap: 2.5rem;
        }
        .hero h1 {
          max-width: 9ch;
          font-size: clamp(3.8rem, 16.5vw, 6.4rem);
        }
        .hero__panel {
          min-height: 19rem;
          padding: 1.25rem;
        }
        .hero__panel-top,
        .hero__panel-bottom { font-size: 0.62rem; }
        .latest-strip {
          grid-template-columns: 1fr;
          padding-top: 0.85rem;
        }
        .latest-strip__label { padding-right: 0; }
