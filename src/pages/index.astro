        .evidence-panel { min-height: 0; margin-top: 3rem; }
        .evidence-panel__topline { flex-wrap: wrap; row-gap: 0.35rem; }
        .evidence-panel__number { margin: 2.25rem 0 1.75rem; font-size: clamp(6rem, 27vw, 8.5rem); line-height: 0.8; }

        .latest { padding-bottom: 4.75rem; }
