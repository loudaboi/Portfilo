---
const latestFixtures = [
  {
    number: "02.1",
    contentType: "Analysis",
    topic: "AI",
    title: "What does an AI product need before a company will pay for it?",
    description:
      "A design preview for an AI analysis. No reported findings are being presented.",
  },
  {
    number: "02.2",
    contentType: "Profile",
    topic: "Startups",
    title: "What can you learn from how a startup chooses its first market?",
    description:
      "A design preview for a startup profile. No real person or company is being represented.",
  },
  {
    number: "02.3",
    contentType: "Field notes",
    topic: "Building",
    title: "How do you know when a product is ready to charge for?",
    description:
      "A design preview for field notes. This is not a published Portfilo story.",
  },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Portfilo covers business, technology, startups, AI, and building."
    />
    <meta name="theme-color" content="#f4f0e8" />
    <title>Portfilo</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Portfilo home">
        <span class="wordmark__inner">
          <span class="wordmark__port">Port</span><span class="wordmark__fi">fi</span><span class="wordmark__lo">lo</span>
        </span>
      </a>

      <nav class="site-nav" aria-label="Primary">
        <ul>
          <li><a href="#latest">Latest</a></li>
          <li><a href="/standards">Standards</a></li>
          <li><a href="/about">About</a></li>
          <li><a class="site-nav__subscribe" href="/subscribe">Subscribe</a></li>
        </ul>
      </nav>
    </header>

    <main id="main-content" tabindex="-1">
      <section class="identity" aria-label="Portfilo coverage">
        <p class="identity__eyebrow">Business / Technology / Startups / AI / Building</p>
        <p class="identity__descriptor">
          Stories about companies, products, markets, and the people building them.
        </p>

        <aside class="fixture-note" aria-label="Homepage preview status">
          <span>Preview mode</span>
          <strong>Launch stories are still being selected</strong>
          <p>
            The story headlines on this page are design previews, not published
            journalism.
          </p>
        </aside>
      </section>

      <section class="feature-section" aria-labelledby="feature-title">
        <header class="section-head">
          <p>01 / Feature preview</p>
          <p>Explained / Business</p>
          <p>Not published</p>
        </header>

        <article class="feature">
          <div class="feature__copy">
            <p class="story-label">Feature preview / Not published</p>
            <h1 id="feature-title">
              What should a founder know before entering a crowded market?
            </h1>
            <p class="feature__dek">
              A design preview for a future business story. No reported findings are
              being presented.
            </p>
            <dl class="feature__meta">
              <div>
                <dt>Editorial type</dt>
                <dd>Explained</dd>
              </div>
              <div>
                <dt>Topic</dt>
                <dd>Business</dd>
              </div>
              <div>
                <dt>Status</dt>
                <dd>Preview</dd>
              </div>
            </dl>
          </div>

          <aside class="evidence-panel" aria-label="Synthetic evidence panel">
            <div class="evidence-panel__topline">
              <span>How we think</span>
              <span>Preview / 01</span>
            </div>
            <p class="evidence-panel__number" aria-hidden="true">01</p>
            <dl>
              <div>
                <dt>Question</dt>
                <dd>What are you deciding?</dd>
              </div>
              <div>
                <dt>Sources</dt>
                <dd>What do we know?</dd>
              </div>
              <div>
                <dt>Limits</dt>
                <dd>What don't we know?</dd>
              </div>
              <div>
                <dt>Takeaway</dt>
                <dd>What changes?</dd>
              </div>
            </dl>
            <p class="evidence-panel__note">
              Preview module. No data or reported findings are shown.
            </p>
          </aside>
        </article>
      </section>

      <section class="latest" id="latest" aria-labelledby="latest-title">
        <header class="section-head section-head--latest">
          <p id="latest-title">02 / Latest + selected</p>
          <p>Story preview</p>
          <p>Not published</p>
        </header>

        <div class="latest__grid">
          {
            latestFixtures.map((story, index) => (
              <article
                class:list={[
                  "latest-story",
                  index === 0 ? "latest-story--lead" : "latest-story--compact",
                ]}
              >
                <div class="latest-story__meta">
                  <span>{story.number}</span>
                  <span>{story.contentType}</span>
                  <span>{story.topic}</span>
                </div>
                <h2>{story.title}</h2>
                <p>{story.description}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="institution" aria-labelledby="institution-title">
        <p class="institution__index">03 / About</p>
        <div class="institution__statement">
          <h2 id="institution-title">Portfilo is a business and technology publication.</h2>
          <p>
            We cover companies, startups, AI, markets, products, and the work of
            building them.
          </p>
        </div>
        <a class="institution__action" href="/about">
          About Portfilo <span aria-hidden="true">↗</span>
        </a>
      </section>

      <section class="newsletter" id="newsletter" aria-labelledby="newsletter-title">
        <div class="newsletter__label">
          <p>04 / Portfilo Brief</p>
          <p>Email / Subscribe</p>
        </div>
        <div class="newsletter__copy">
          <h2 id="newsletter-title">Portfilo Brief</h2>
          <p>New stories by email.</p>
        </div>
        <a class="newsletter__action" href="/subscribe" aria-label="Subscribe to Portfilo Brief">
          Subscribe <span aria-hidden="true">↗</span>
        </a>
      </section>
    </main>

    <footer class="site-footer">
      <div class="site-footer__brand" aria-label="Portfilo">
        <span class="site-footer__port">Port</span><span class="site-footer__fi">fi</span><span class="site-footer__lo">lo</span>
      </div>
      <a href="/about">About Portfilo</a>
    </footer>

    <style>
      @font-face {
        font-family: "Instrument Sans";
        font-style: normal;
        font-display: swap;
        font-weight: 400 700;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/instrument-sans:vf@5.3.0/latin-wght-normal.woff2") format("woff2-variations");
      }

      @font-face {
        font-family: "Source Serif 4";
        font-style: normal;
        font-display: swap;
        font-weight: 200 900;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/source-serif-4:vf@5.3.0/latin-wght-normal.woff2") format("woff2-variations");
      }

      @font-face {
        font-family: "IBM Plex Mono";
        font-style: normal;
        font-display: swap;
        font-weight: 400;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/ibm-plex-mono@5.3.0/latin-400-normal.woff2") format("woff2");
      }

      :global(:root) {
        --paper: #f4f0e8;
        --ink: #171614;
        --muted: #69655e;
        --line: #cbc5bb;
        --accent: #0050a4;
        --accent-on-ink: #8fc7ff;
        --correction: #b42318;
        --page-max: 100rem;
        --gutter: clamp(1.25rem, 3.3vw, 3.75rem);
        --grid-gap: clamp(0.8rem, 1.6vw, 1.5rem);
        --sans: "Instrument Sans", "Helvetica Neue", Arial, sans-serif;
        --serif: "Source Serif 4", Georgia, serif;
        --mono: "IBM Plex Mono", "Courier New", monospace;
      }

      :global(*) { box-sizing: border-box; }
      :global(html) { background: var(--paper); color: var(--ink); font-family: var(--sans); font-synthesis: none; scroll-behavior: smooth; }
      :global(body) { margin: 0; min-width: 0; background: var(--paper); }
      :global(a) { color: inherit; }
      :global(a:focus-visible) { outline: 3px solid var(--accent); outline-offset: 4px; }
      :global(main:focus) { outline: none; }

      .skip-link {
        position: fixed;
        z-index: 20;
        top: 0.75rem;
        left: 0.75rem;
        padding: 0.65rem 0.8rem;
        background: var(--ink);
        color: var(--paper);
        font: 400 0.75rem/1 var(--mono);
        text-decoration: none;
        transform: translateY(-200%);
      }
      .skip-link:focus { transform: translateY(0); }

      .site-header,
      .identity,
      .feature-section,
      .latest,
      .newsletter,
      .site-footer {
        width: min(100%, var(--page-max));
        margin-inline: auto;
      }

      .site-header {
        padding: 1.05rem var(--gutter) 0.95rem;
        display: grid;
        grid-template-columns: auto 1fr;
        gap: clamp(1.5rem, 3vw, 3.5rem);
        align-items: center;
        border-bottom: 1px solid var(--ink);
      }

      .wordmark { width: fit-content; display: inline-block; text-decoration: none; }
      .wordmark__inner {
        display: inline-block;
        white-space: nowrap;
        font: 700 clamp(1.75rem, 2.2vw, 2.3rem) / 0.9 var(--sans);
        letter-spacing: -0.085em;
        transform: skewX(-12deg);
        transform-origin: left center;
      }

      .wordmark__port,
      .wordmark__fi,
      .wordmark__lo,
      .site-footer__port,
      .site-footer__fi,
      .site-footer__lo { display: inline-block; }
      .wordmark__port, .site-footer__port { color: var(--ink); }
      .wordmark__fi, .site-footer__fi { color: var(--accent); }
      .wordmark__lo, .site-footer__lo { color: var(--correction); }

      .site-nav { justify-self: end; }
      .site-nav ul {
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        align-items: center;
        gap: clamp(1rem, 2vw, 2rem);
        list-style: none;
      }
      .site-nav a {
        position: relative;
        font: 500 0.76rem/1 var(--sans);
        text-decoration: none;
      }
      .site-nav a::after {
        content: "";
        position: absolute;
        right: 0;
        bottom: -0.45rem;
        left: 0;
        height: 2px;
        background: transparent;
      }
      .site-nav a:hover,
      .site-nav a[aria-current="page"] { color: var(--accent); }
      .site-nav a[aria-current="page"]::after { background: var(--accent); }
      .site-nav__subscribe { color: var(--accent); }

      .identity {
        padding: clamp(2.2rem, 4vw, 3.8rem) var(--gutter) clamp(2.6rem, 4.5vw, 4.5rem);
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
        align-items: start;
      }
      .identity__eyebrow {
        grid-column: 1 / 7;
        margin: 0;
        color: var(--accent);
        font: 400 0.67rem/1.4 var(--mono);
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }
      .identity__descriptor {
        grid-column: 7 / 13;
        max-width: 40rem;
        margin: 0;
        font: 400 clamp(1.15rem, 1.45vw, 1.4rem) / 1.5 var(--serif);
      }
      .fixture-note {
        grid-column: 1 / 5;
        margin-top: clamp(1.5rem, 3vw, 3rem);
        padding-top: 0.85rem;
        border-top: 1px solid var(--line);
        font: 400 0.68rem/1.55 var(--mono);
      }
      .fixture-note span {
        display: block;
        margin-bottom: 0.45rem;
        color: var(--muted);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .fixture-note strong { display: block; font-weight: 400; }
      .fixture-note p { margin: 0.55rem 0 0; color: var(--muted); }

      .feature-section,
      .latest,
      .newsletter { padding-inline: var(--gutter); }

      .section-head {
        padding: 0.7rem 0 0.65rem;
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
        border-top: 1px solid var(--ink);
        border-bottom: 1px solid var(--line);
        color: var(--muted);
        font: 400 0.64rem/1.4 var(--mono);
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }
      .section-head p { margin: 0; }
      .section-head p:first-child { grid-column: 1 / 5; color: var(--ink); }
      .section-head p:nth-child(2) { grid-column: 7 / 10; }
      .section-head p:last-child { grid-column: 10 / 13; text-align: right; }

      .feature {
        padding: clamp(2.8rem, 5vw, 5.8rem) 0 clamp(4rem, 7vw, 7rem);
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
      }
      .feature__copy { grid-column: 1 / 9; min-width: 0; padding-right: clamp(0rem, 2vw, 2rem); }
      .story-label {
        margin: 0 0 1.25rem;
        color: var(--accent);
        font: 400 0.68rem/1.4 var(--mono);
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }
      .feature h1 {
        max-width: 16ch;
        margin: 0;
        font: 500 clamp(3.6rem, 6.5vw, 7rem) / 0.91 var(--sans);
        letter-spacing: -0.065em;
        text-wrap: balance;
        overflow-wrap: break-word;
      }
      .feature__dek {
        max-width: 40rem;
        margin: clamp(2rem, 3.4vw, 3.25rem) 0 0;
        font: 400 clamp(1.2rem, 1.55vw, 1.5rem) / 1.5 var(--serif);
      }
      .feature__meta {
        max-width: 42rem;
        margin: clamp(2.4rem, 4vw, 4rem) 0 0;
        padding-top: 0.9rem;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
        border-top: 1px solid var(--line);
        font: 400 0.67rem/1.5 var(--mono);
      }
      .feature__meta dt, .evidence-panel dt {
        margin-bottom: 0.3rem;
        color: var(--muted);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .feature__meta dd, .evidence-panel dd { margin: 0; }

      .evidence-panel {
        grid-column: 9 / 13;
        min-width: 0;
        min-height: 36rem;
        padding: clamp(1.25rem, 2vw, 2rem);
        display: flex;
        flex-direction: column;
        background: var(--ink);
        color: var(--paper);
      }
      .evidence-panel__topline {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        color: var(--accent-on-ink);
        font: 400 0.62rem/1.4 var(--mono);
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }
      .evidence-panel__number {
        margin: auto 0 1.2rem;
        color: var(--accent-on-ink);
        font: 500 clamp(7rem, 13vw, 13rem) / 0.72 var(--sans);
        letter-spacing: -0.09em;
      }
      .evidence-panel dl {
        margin: 0;
        display: grid;
        grid-template-columns: 1fr 1fr;
        border-top: 1px solid #55524d;
      }
      .evidence-panel dl > div {
        min-width: 0;
        padding: 0.85rem 0.75rem 0.85rem 0;
        border-bottom: 1px solid #55524d;
      }
      .evidence-panel dl > div:nth-child(even) {
        padding-left: 0.75rem;
        border-left: 1px solid #55524d;
      }
      .evidence-panel dt { color: var(--accent-on-ink); font: 400 0.58rem/1.35 var(--mono); }
      .evidence-panel dd { font: 400 0.78rem/1.45 var(--mono); overflow-wrap: anywhere; }
      .evidence-panel__note { margin: 1.15rem 0 0; color: #bdb8af; font: 400 0.62rem/1.55 var(--mono); }

      .latest { padding-bottom: clamp(5rem, 8vw, 8rem); scroll-margin-top: 1rem; }
      .latest__grid {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
      }
      .latest-story { min-width: 0; padding-top: clamp(2rem, 3vw, 3rem); }
      .latest-story__meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem;
        margin-bottom: 1.1rem;
        color: var(--muted);
        font: 400 0.62rem/1.4 var(--mono);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .latest-story__meta span + span::before { content: "/"; margin-right: 0.55rem; color: var(--accent); }
      .latest-story h2 { margin: 0; font-weight: 500; letter-spacing: -0.045em; overflow-wrap: break-word; }
      .latest-story > p { margin: 1.2rem 0 0; color: var(--muted); font: 400 1.03rem/1.56 var(--serif); }
      .latest-story--lead { grid-column: 1 / 8; grid-row: 1 / 3; padding-right: clamp(1rem, 3vw, 3rem); }
      .latest-story--lead h2 { max-width: 17ch; font-size: clamp(2.4rem, 3.8vw, 4rem); line-height: 0.98; }
      .latest-story--lead > p { max-width: 35rem; font-size: 1.15rem; }
      .latest-story--compact { grid-column: 9 / 13; padding-bottom: clamp(2rem, 3vw, 3rem); border-bottom: 1px solid var(--line); }
      .latest-story--compact:nth-child(2) { grid-row: 1; }
      .latest-story--compact:nth-child(3) { grid-row: 2; }
      .latest-story--compact h2 { font-size: clamp(1.65rem, 2.25vw, 2.3rem); line-height: 1.04; }

      .institution {
        width: 100%;
        padding: clamp(4rem, 7vw, 7.5rem) max(var(--gutter), calc((100vw - var(--page-max)) / 2 + var(--gutter)));
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
        background: var(--ink);
        color: var(--paper);
      }
      .institution__index {
        grid-column: 1 / 3;
        margin: 0;
        color: var(--accent-on-ink);
        font: 400 0.64rem/1.4 var(--mono);
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }
      .institution__statement { grid-column: 4 / 10; }
      .institution h2 {
        max-width: 15ch;
        margin: 0;
        font: 500 clamp(2.9rem, 5.3vw, 5.5rem) / 0.94 var(--sans);
        letter-spacing: -0.06em;
        text-wrap: balance;
      }
      .institution__statement > p {
        max-width: 42rem;
        margin: clamp(2rem, 3.5vw, 3.5rem) 0 0;
        color: #d7d2c9;
        font: 400 clamp(1.15rem, 1.45vw, 1.4rem) / 1.58 var(--serif);
      }
      .institution__action {
        grid-column: 11 / 13;
        align-self: end;
        padding: 0.85rem 0 0.7rem;
        border-top: 3px solid var(--accent-on-ink);
        border-bottom: 1px solid #55524d;
        font: 500 clamp(1rem, 1.3vw, 1.2rem) / 1.2 var(--sans);
        text-decoration: none;
      }
      .institution__action span { color: var(--accent-on-ink); }
      .institution__action:hover { color: var(--accent-on-ink); }

      .newsletter {
        padding-top: clamp(4rem, 7vw, 7rem);
        padding-bottom: clamp(4rem, 7vw, 7rem);
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
        border-bottom: 1px solid var(--ink);
      }
      .newsletter__label {
        grid-column: 1 / 4;
        padding-top: 0.7rem;
        border-top: 1px solid var(--ink);
        font: 400 0.64rem/1.5 var(--mono);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .newsletter__label p { margin: 0 0 0.45rem; }
      .newsletter__label p:last-child { color: var(--muted); }
      .newsletter__copy { grid-column: 5 / 11; }
      .newsletter h2 {
        max-width: 13ch;
        margin: 0;
        font: 500 clamp(3rem, 5.6vw, 5.8rem) / 0.92 var(--sans);
        letter-spacing: -0.06em;
      }
      .newsletter__copy > p { max-width: 39rem; margin: clamp(1.8rem, 3vw, 2.8rem) 0 0; font: 400 clamp(1.12rem, 1.4vw, 1.35rem) / 1.58 var(--serif); }
      .newsletter__action {
        grid-column: 11 / 13;
        align-self: end;
        padding: 0.9rem 0 0.7rem;
        border-top: 3px solid var(--accent);
        border-bottom: 1px solid var(--ink);
        font: 500 clamp(1.1rem, 1.5vw, 1.35rem) / 1.15 var(--sans);
        text-decoration: none;
      }
      .newsletter__action span { color: var(--accent); }
      .newsletter__action:hover { color: var(--accent); }

      .site-footer {
        padding: 1.2rem var(--gutter) 1.4rem;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: var(--grid-gap);
        align-items: end;
        font: 400 0.64rem/1.45 var(--mono);
      }
      .site-footer__brand {
        width: fit-content;
        white-space: nowrap;
        font: 700 1.55rem/0.9 var(--sans);
        letter-spacing: -0.085em;
        transform: skewX(-12deg);
        transform-origin: left center;
      }
      .site-footer a {
        justify-self: end;
        text-decoration-color: var(--accent);
        text-decoration-thickness: 0.1em;
        text-underline-offset: 0.18em;
      }
      .site-footer a:hover { color: var(--accent); }

      @media (max-width: 64rem) {
        .feature__copy { grid-column: 1 / 8; }
        .evidence-panel { grid-column: 8 / 13; }
        .latest-story--lead { grid-column: 1 / 8; }
        .latest-story--compact { grid-column: 8 / 13; }
        .institution__statement { grid-column: 3 / 10; }
        .institution__action { grid-column: 10 / 13; }
        .newsletter__copy { grid-column: 4 / 10; }
        .newsletter__action { grid-column: 10 / 13; }
      }

      @media (max-width: 50rem) {
        .site-header {
          grid-template-columns: 1fr;
          align-items: start;
          padding-top: 0.9rem;
        }
        .site-nav {
          width: 100%;
          padding-top: 0.8rem;
          justify-self: stretch;
          border-top: 1px solid var(--line);
        }
        .site-nav ul { justify-content: flex-start; gap: 0.8rem 1.3rem; }

        .identity {
          display: block;
          padding-top: 2.5rem;
          padding-bottom: 3.5rem;
        }
        .identity__descriptor { max-width: 34rem; margin-top: 1.25rem; font-size: 1.2rem; }
        .fixture-note { max-width: 24rem; margin-top: 2.4rem; }

        .section-head { grid-template-columns: 1fr auto; gap: 0.5rem 1rem; }
        .section-head p:first-child, .section-head p:nth-child(2), .section-head p:last-child { grid-column: auto; }
        .section-head p:nth-child(2) { display: none; }
        .section-head p:last-child { text-align: right; }

        .feature { display: block; padding-top: 2.7rem; padding-bottom: 4.25rem; }
        .feature__copy { padding-right: 0; }
        .feature h1 { max-width: none; font-size: clamp(3rem, 12vw, 4.8rem); line-height: 0.93; text-wrap: pretty; }
