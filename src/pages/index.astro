---
import { getCollection } from "astro:content";
import SiteHead from "../components/SiteHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

const publishedStories = await getCollection(
  "stories",
  ({ data }) => data.status === "published",
);

const storiesByDate = [...publishedStories].sort(
  (a, b) =>
    (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0),
);

const featuredStory =
  storiesByDate.find(({ data }) => data.featured) ?? storiesByDate[0];
const latestStories = storiesByDate.filter(
  (story) => story.id !== featuredStory?.id,
);

const dateFormatter = new Intl.DateTimeFormat("en-PH", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});

const formatDate = (date?: Date) => (date ? dateFormatter.format(date) : "");
const formatLabel = (value: string) => value.replaceAll("-", " ");
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      title="Portfilo | Business and Technology Publication"
      description="Portfilo is a business and technology publication covering companies, startups, AI, markets, products, and the work of building them."
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <SiteHeader />

    <main id="main-content" tabindex="-1">
      <section class="identity" aria-label="Portfilo coverage">
        <p class="identity__eyebrow">Business / Technology / Startups / AI / Building</p>
      </section>

      {
        featuredStory && (
          <section class="feature-section" aria-labelledby="feature-title">
            <header class="section-head">
              <p>01 / Featured</p>
              <p>
                {formatLabel(featuredStory.data.contentType)} / {formatLabel(featuredStory.data.topic)}
              </p>
              <p>{formatDate(featuredStory.data.publishedAt)}</p>
            </header>

            <article class="feature">
              <div class="feature__copy">
                <h1 id="feature-title">
                  <a href={`/stories/${featuredStory.id}`}>{featuredStory.data.title}</a>
                </h1>
                <p class="feature__dek">{featuredStory.data.description}</p>

                <dl class="feature__meta">
                  <div>
                    <dt>Author</dt>
                    <dd>{featuredStory.data.author}</dd>
                  </div>
                  <div>
                    <dt>Editorial type</dt>
                    <dd>{formatLabel(featuredStory.data.contentType)}</dd>
                  </div>
                  <div>
                    <dt>Topic</dt>
                    <dd>{formatLabel(featuredStory.data.topic)}</dd>
                  </div>
                </dl>

                <a class="feature__action" href={`/stories/${featuredStory.id}`}>
                  Read story <span aria-hidden="true">↗</span>
                </a>
              </div>

              <aside class="feature-panel" aria-label="Featured story cover">
                <div class="feature-panel__topline">
                  <span>Portfilo / {formatLabel(featuredStory.data.contentType)}</span>
                  <span>01</span>
                </div>
                <p class="feature-panel__topic">{formatLabel(featuredStory.data.topic)}</p>
                <div class="feature-panel__bottom">
                  <p>{featuredStory.data.author}</p>
                  <a href={`/stories/${featuredStory.id}`} aria-label={`Read ${featuredStory.data.title}`}>
                    Read <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </aside>
            </article>
          </section>
        )
      }

      {
        latestStories.length > 0 && (
          <section class="latest" id="latest" aria-labelledby="latest-title">
            <header class="section-head section-head--latest">
              <p id="latest-title">02 / Latest</p>
              <p class="section-count">{latestStories.length === 1 ? "1 story" : `${latestStories.length} stories`}</p>
            </header>

            <div class="latest__list">
              {latestStories.map((story, index) => (
                <article class="latest-story">
                  <div class="latest-story__index">02.{index + 1}</div>
                  <div class="latest-story__content">
                    <div class="latest-story__meta">
                      <span>{formatLabel(story.data.contentType)}</span>
                      <span>{formatLabel(story.data.topic)}</span>
                      <span>{formatDate(story.data.publishedAt)}</span>
                    </div>
                    <h2>
                      <a href={`/stories/${story.id}`}>{story.data.title}</a>
                    </h2>
                    <p>{story.data.description}</p>
                    <div class="latest-story__footer">
                      <span>{story.data.author}</span>
                      <a href={`/stories/${story.id}`}>
                        Read story <span aria-hidden="true">↗</span>
                      </a>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </section>
        )
      }

      <section class="institution" aria-labelledby="institution-title">
        <p class="institution__index">03 / About</p>
        <div class="institution__statement">
          <h2 id="institution-title">Portfilo is a business and technology publication.</h2>
          <p>
            We cover companies, startups, AI, markets, products, and the work of
            building them.
          </p>
        </div>
        <a class="institution__action" href="/about">
          About Portfilo <span aria-hidden="true">↗</span>
        </a>
      </section>

      <section class="newsletter" id="newsletter" aria-labelledby="newsletter-title">
        <div class="newsletter__label">
          <p>04 / Portfilo Brief</p>
          <p>Email / Subscribe</p>
        </div>
        <div class="newsletter__copy">
          <h2 id="newsletter-title">Portfilo Brief</h2>
          <p>New stories by email.</p>
        </div>
        <a class="newsletter__action" href="/subscribe" aria-label="Subscribe to Portfilo Brief">
          Subscribe <span aria-hidden="true">↗</span>
        </a>
      </section>
    </main>

    <SiteFooter />

    <style>
      @font-face {
        font-family: "Instrument Sans";
        font-style: normal;
        font-display: swap;
        font-weight: 400 700;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/instrument-sans:vf@5.3.0/latin-wght-normal.woff2") format("woff2-variations");
      }

      @font-face {
        font-family: "Source Serif 4";
        font-style: normal;
        font-display: swap;
        font-weight: 200 900;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/source-serif-4:vf@5.3.0/latin-wght-normal.woff2") format("woff2-variations");
      }

      @font-face {
        font-family: "IBM Plex Mono";
        font-style: normal;
        font-display: swap;
        font-weight: 400;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/ibm-plex-mono@5.3.0/latin-400-normal.woff2") format("woff2");
      }

      :global(:root) {
        --paper: #f4f0e8;
        --ink: #171614;
        --muted: #69655e;
        --line: #cbc5bb;
        --accent: #0050a4;
        --accent-on-ink: #8fc7ff;
        --correction: #b42318;
        --page-max: 100rem;
        --gutter: clamp(1.25rem, 3.3vw, 3.75rem);
        --grid-gap: clamp(0.8rem, 1.6vw, 1.5rem);
        --sans: "Instrument Sans", "Helvetica Neue", Arial, sans-serif;
        --serif: "Source Serif 4", Georgia, serif;
        --mono: "IBM Plex Mono", "Courier New", monospace;
      }
      :global(*) { box-sizing: border-box; }
      :global(html) { background: var(--paper); color: var(--ink); font-family: var(--sans); font-synthesis: none; scroll-behavior: smooth; }
      :global(body) { margin: 0; min-width: 0; background: var(--paper); }
      :global(a) { color: inherit; }
      :global(a:focus-visible) { outline: 3px solid var(--accent); outline-offset: 4px; }
      :global(main:focus) { outline: none; }

      .skip-link {
        position: fixed;
        z-index: 20;
        top: 0.75rem;
        left: 0.75rem;
        padding: 0.65rem 0.8rem;
        background: var(--ink);
        color: var(--paper);
        font: 400 0.75rem/1 var(--mono);
        text-decoration: none;
        transform: translateY(-200%);
      }
      .skip-link:focus { transform: translateY(0); }

      .identity,
      .feature-section,
      .latest,
      .newsletter {
        width: min(100%, var(--page-max));
        margin-inline: auto;
      }

      .identity {
        padding: clamp(2.2rem, 4vw, 3.8rem) var(--gutter) clamp(2.6rem, 4.5vw, 4.5rem);
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
        align-items: start;
      }
      .identity__eyebrow {
        grid-column: 1 / 7;
        margin: 0;
        color: var(--accent);
        font: 400 0.67rem/1.4 var(--mono);
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }
      .identity__descriptor {
        grid-column: 7 / 13;
        max-width: 40rem;
        margin: 0;
        font: 400 clamp(1.15rem, 1.45vw, 1.4rem) / 1.5 var(--serif);
      }

      .feature-section,
      .latest,
      .newsletter { padding-inline: var(--gutter); }

      .section-head {
        padding: 0.7rem 0 0.65rem;
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
        border-top: 1px solid var(--ink);
        border-bottom: 1px solid var(--line);
        color: var(--muted);
        font: 400 0.64rem/1.4 var(--mono);
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }
      .section-head p { margin: 0; }
      .section-head p:first-child { grid-column: 1 / 5; color: var(--ink); }
      .section-head p:nth-child(2) { grid-column: 7 / 10; }
      .section-head p:last-child { grid-column: 10 / 13; text-align: right; }

      .feature {
        padding: clamp(2.8rem, 5vw, 5.8rem) 0 clamp(4rem, 7vw, 7rem);
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
      }
      .feature__copy { grid-column: 1 / 9; min-width: 0; padding-right: clamp(0rem, 2vw, 2rem); }
      .story-label {
        margin: 0 0 1.25rem;
        color: var(--accent);
        font: 400 0.68rem/1.4 var(--mono);
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }
      .feature h1 {
        max-width: 17ch;
        margin: 0;
        font: 500 clamp(3.35rem, 6vw, 6.5rem) / 0.93 var(--sans);
        letter-spacing: -0.06em;
        text-wrap: balance;
        overflow-wrap: break-word;
      }
      .feature h1 a,
      .latest-story h2 a {
        text-decoration: none;
      }
      .feature h1 a:hover,
      .latest-story h2 a:hover { color: var(--accent); }
      .feature__dek {
        max-width: 40rem;
        margin: clamp(2rem, 3.4vw, 3.25rem) 0 0;
        font: 400 clamp(1.2rem, 1.55vw, 1.5rem) / 1.5 var(--serif);
      }
      .feature__meta {
        max-width: 42rem;
        margin: clamp(2.4rem, 4vw, 4rem) 0 0;
        padding-top: 0.9rem;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
        border-top: 1px solid var(--line);
        font: 400 0.67rem/1.5 var(--mono);
      }
      .feature__meta dt {
        margin-bottom: 0.3rem;
        color: var(--muted);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .feature__meta dd { margin: 0; }
      .feature__action {
        display: inline-block;
        margin-top: 2rem;
        padding: 0.7rem 0;
        border-bottom: 1px solid var(--ink);
        font: 500 0.9rem/1.2 var(--sans);
        text-decoration: none;
      }
      .feature__action span { color: var(--accent); }
      .feature__action:hover { color: var(--accent); border-bottom-color: var(--accent); }

      .feature-panel {
        grid-column: 9 / 13;
        min-width: 0;
        min-height: 35rem;
        padding: clamp(1.25rem, 2vw, 2rem);
        display: flex;
        flex-direction: column;
        background: var(--ink);
        color: var(--paper);
      }
      .feature-panel__topline {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        color: var(--accent-on-ink);
        font: 400 0.62rem/1.4 var(--mono);
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }
      .feature-panel__topic {
        margin: auto 0;
        color: var(--accent-on-ink);
        font: 500 clamp(4.8rem, 8vw, 8rem) / 0.8 var(--sans);
        letter-spacing: -0.08em;
        text-transform: lowercase;
        overflow-wrap: anywhere;
      }
      .feature-panel__bottom {
        padding-top: 1rem;
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        border-top: 1px solid #55524d;
        font: 400 0.65rem/1.45 var(--mono);
      }
      .feature-panel__bottom p { margin: 0; }
      .feature-panel__bottom a { color: var(--paper); text-decoration: none; }
      .feature-panel__bottom a span { color: var(--accent-on-ink); }
      .feature-panel__bottom a:hover { color: var(--accent-on-ink); }

      .latest { padding-bottom: clamp(5rem, 8vw, 8rem); scroll-margin-top: 1rem; }
      .latest__list { border-bottom: 1px solid var(--line); }
      .latest-story {
        padding: clamp(2rem, 3.2vw, 3.25rem) 0;
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
        border-top: 1px solid var(--line);
      }
      .latest-story:first-child { border-top: 0; }
      .latest-story__index {
        grid-column: 1 / 3;
        color: var(--accent);
        font: 400 clamp(1.2rem, 2vw, 1.8rem) / 1 var(--mono);
      }
      .latest-story__content { grid-column: 4 / 13; min-width: 0; }
      .latest-story__meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem;
        margin-bottom: 1rem;
        color: var(--muted);
        font: 400 0.62rem/1.4 var(--mono);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .latest-story__meta span + span::before {
        content: "/";
        margin-right: 0.55rem;
        color: var(--accent);
      }
      .latest-story h2 {
        max-width: 21ch;
        margin: 0;
        font: 500 clamp(2.25rem, 3.8vw, 4rem) / 0.98 var(--sans);
        letter-spacing: -0.045em;
        overflow-wrap: break-word;
      }
      .latest-story__content > p {
        max-width: 47rem;
        margin: 1.25rem 0 0;
        color: var(--muted);
        font: 400 clamp(1.02rem, 1.25vw, 1.16rem) / 1.58 var(--serif);
      }
      .latest-story__footer {
        max-width: 47rem;
        margin-top: 1.5rem;
        padding-top: 0.8rem;
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        border-top: 1px solid var(--line);
        font: 400 0.66rem/1.4 var(--mono);
      }
      .latest-story__footer a { text-decoration: none; }
      .latest-story__footer a span { color: var(--accent); }
      .latest-story__footer a:hover { color: var(--accent); }

      .institution {
        width: 100%;
        padding: clamp(4rem, 7vw, 7.5rem) max(var(--gutter), calc((100vw - var(--page-max)) / 2 + var(--gutter)));
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
        background: var(--ink);
        color: var(--paper);
      }
      .institution__index {
        grid-column: 1 / 3;
        margin: 0;
        color: var(--accent-on-ink);
        font: 400 0.64rem/1.4 var(--mono);
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }
      .institution__statement { grid-column: 4 / 10; }
      .institution h2 {
        max-width: 15ch;
        margin: 0;
        font: 500 clamp(2.9rem, 5.3vw, 5.5rem) / 0.94 var(--sans);
        letter-spacing: -0.06em;
        text-wrap: balance;
      }
      .institution__statement > p {
        max-width: 42rem;
        margin: clamp(2rem, 3.5vw, 3.5rem) 0 0;
        color: #d7d2c9;
        font: 400 clamp(1.15rem, 1.45vw, 1.4rem) / 1.58 var(--serif);
      }
      .institution__action {
        grid-column: 11 / 13;
        align-self: end;
        padding: 0.85rem 0 0.7rem;
        border-top: 3px solid var(--accent-on-ink);
        border-bottom: 1px solid #55524d;
        font: 500 clamp(1rem, 1.3vw, 1.2rem) / 1.2 var(--sans);
        text-decoration: none;
      }
      .institution__action span { color: var(--accent-on-ink); }
      .institution__action:hover { color: var(--accent-on-ink); }

      .newsletter {
        padding-top: clamp(4rem, 7vw, 7rem);
        padding-bottom: clamp(4rem, 7vw, 7rem);
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
        border-bottom: 1px solid var(--ink);
      }
      .newsletter__label {
        grid-column: 1 / 4;
        padding-top: 0.7rem;
        border-top: 1px solid var(--ink);
        font: 400 0.64rem/1.5 var(--mono);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .newsletter__label p { margin: 0 0 0.45rem; }
      .newsletter__label p:last-child { color: var(--muted); }
      .newsletter__copy { grid-column: 5 / 11; }
      .newsletter h2 {
        max-width: 13ch;
        margin: 0;
        font: 500 clamp(3rem, 5.6vw, 5.8rem) / 0.92 var(--sans);
        letter-spacing: -0.06em;
      }
      .newsletter__copy > p {
        max-width: 39rem;
        margin: clamp(1.8rem, 3vw, 2.8rem) 0 0;
        font: 400 clamp(1.12rem, 1.4vw, 1.35rem) / 1.58 var(--serif);
      }
      .newsletter__action {
        grid-column: 11 / 13;
        align-self: end;
        padding: 0.9rem 0 0.7rem;
        border-top: 3px solid var(--accent);
        border-bottom: 1px solid var(--ink);
        font: 500 clamp(1.1rem, 1.5vw, 1.35rem) / 1.15 var(--sans);
        text-decoration: none;
      }
      .newsletter__action span { color: var(--accent); }
      .newsletter__action:hover { color: var(--accent); }

      @media (max-width: 64rem) {
        .feature__copy { grid-column: 1 / 8; }
        .feature-panel { grid-column: 8 / 13; }
        .institution__statement { grid-column: 3 / 10; }
        .institution__action { grid-column: 10 / 13; }
        .newsletter__copy { grid-column: 4 / 10; }
        .newsletter__action { grid-column: 10 / 13; }
      }

      @media (max-width: 50rem) {
        .identity {
          display: block;
          padding-top: 2.5rem;
          padding-bottom: 3.5rem;
        }
        .identity__descriptor { max-width: 34rem; margin-top: 1.25rem; font-size: 1.2rem; }

        .section-head { grid-template-columns: 1fr auto; gap: 0.5rem 1rem; }
        .section-head p:first-child,
        .section-head p:nth-child(2),
        .section-head p:last-child { grid-column: auto; }
        .section-head p:nth-child(2):not(.section-count) { display: none; }
        .section-head p:last-child { text-align: right; }

        .feature { display: block; padding-top: 2.7rem; padding-bottom: 4.25rem; }
        .feature__copy { padding-right: 0; }
        .feature h1 { max-width: none; font-size: clamp(2.85rem, 11vw, 4.6rem); line-height: 0.94; text-wrap: pretty; }
        .feature__dek { font-size: 1.2rem; }
        .feature__meta { grid-template-columns: 1fr 1fr; gap: 1rem; }
        .feature__meta div:last-child { grid-column: 1 / -1; }
        .feature-panel { min-height: 22rem; margin-top: 3rem; }
        .feature-panel__topic { font-size: clamp(4.8rem, 19vw, 7rem); }

        .latest { padding-bottom: 4.75rem; }
        .latest-story { display: block; }
        .latest-story__index { margin-bottom: 1.4rem; }
        .latest-story h2 { max-width: none; font-size: clamp(2.15rem, 8.5vw, 3.35rem); }
        .latest-story__footer { flex-wrap: wrap; }

        .institution { display: block; padding-top: 4rem; padding-bottom: 4.25rem; }
        .institution__index { margin-bottom: 2.1rem; }
        .institution h2 { max-width: none; font-size: clamp(2.8rem, 11vw, 4.5rem); }
        .institution__statement > p { font-size: 1.15rem; }
        .institution__action { display: block; max-width: 16rem; margin-top: 3rem; }

        .newsletter { display: block; padding-top: 4rem; padding-bottom: 4.5rem; }
        .newsletter__label { max-width: 24rem; margin-bottom: 2.5rem; }
        .newsletter h2 { max-width: none; font-size: clamp(3rem, 12vw, 4.8rem); }
        .newsletter__copy > p { font-size: 1.15rem; }
        .newsletter__action { display: block; max-width: 18rem; margin-top: 2.8rem; }
      }

      @media (max-width: 30rem) {
        .feature h1 { font-size: clamp(2.65rem, 12vw, 3.8rem); }
        .feature-panel { min-height: 19rem; }
      }

      @media (prefers-reduced-motion: reduce) {
        :global(html) { scroll-behavior: auto; }
      }
    </style>
  </body>
</html>
