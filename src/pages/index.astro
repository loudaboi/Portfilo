---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import SiteHead from "../components/SiteHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";

const publishedArticles = await getCollection(
  "articles",
  ({ data }) => data.status === "published",
);

const journalEntries = publishedArticles
  .filter(({ data }) => data.section === "journal")
  .sort(
    (a, b) =>
      (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0),
  );

const hustleEntries = publishedArticles
  .filter(({ data }) => data.section === "hustle")
  .sort(
    (a, b) =>
      (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0),
  );

const selectedWork = (
  await getCollection("work", ({ data }) => data.status === "published")
)
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    return b.data.year - a.data.year;
  })
  .slice(0, 3);

const featuredHustle =
  hustleEntries.find(({ data }) => data.featured) ?? hustleEntries[0];
const journalPreview = journalEntries.slice(0, 3);

const capabilities = [
  "Custom Software",
  "Automation",
  "AI Integration",
  "Digital Products",
] as const;

const dateFormatter = new Intl.DateTimeFormat("en-PH", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});

const formatDate = (date?: Date) => (date ? dateFormatter.format(date) : "");
const formatLabel = (value: string) => value.replaceAll("-", " ");

// Keep the homepage Contact section absent until /contact provides a real public contact path.
const contactReady = false;
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      title="Portfilo"
      description="Portfilo designs and develops software around business needs and constraints, from internal systems and automation to practical AI integrations and customer-facing products."
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader />

    <main id="main-content" tabindex="-1" data-homepage>
      <section class="hero" aria-labelledby="home-hero-title">
        <div class="hero__grid home-shell">
          <h1 id="home-hero-title" class="hero__headline">
            <span class="hero__line-mask"><span class="hero__line-inner" data-hero-line>Software built</span></span>{" "}
            <span class="hero__line-mask"><span class="hero__line-inner" data-hero-line>around the problem.</span></span>
          </h1>

          <p class="hero__support" data-hero-support>
            Portfilo designs and develops software around business needs and constraints,
            from internal systems and automation to practical AI integrations and
            customer-facing products.
          </p>
        </div>
      </section>

      {
        selectedWork.length > 0 && (
          <section class="work-section home-section" aria-labelledby="selected-work-title">
            <div class="home-shell">
              <header class="section-heading section-heading--work" data-home-reveal>
                <h2 id="selected-work-title">Selected Work</h2>
                <a href="/work">All Work <span aria-hidden="true">↗</span></a>
              </header>

              <div class="work-list">
                {selectedWork.map((project, index) => (
                  <article class="work-project" data-home-reveal>
                    <div class="work-project__heading">
                      <p class="work-project__index">{String(index + 1).padStart(2, "0")}</p>
                      <div>
                        <h3><a href={`/work/${project.id}`}>{project.data.title}</a></h3>
                        <p class="work-project__cue">{project.data.outcome ?? project.data.dek}</p>
                      </div>
                      <div class="work-project__meta">
                        {project.data.client && <span>{project.data.client}</span>}
                        <span>{project.data.year}</span>
                      </div>
                    </div>

                    {project.data.cover && (
                      <a
                        class="work-project__media"
                        href={`/work/${project.id}`}
                        aria-label={`View ${project.data.title} case study`}
                      >
                        <Image
                          class="work-project__image"
                          src={project.data.cover.src}
                          alt={project.data.cover.alt}
                        />
                      </a>
                    )}
                  </article>
                ))}
              </div>
            </div>
          </section>
        )
      }

      <section class="services-section home-section" aria-labelledby="services-title">
        <div class="home-shell">
          <div class="services-intro" data-home-reveal>
            <div class="services-intro__heading">
              <p class="section-kicker">Services</p>
              <h2 id="services-title">What we solve</h2>
            </div>
            <p class="services-intro__copy">
              Manual work, disconnected systems, repetitive workflows, software that no
              longer fits, and new product needs.
            </p>
          </div>

          <div class="capabilities" data-home-reveal>
            <div class="capabilities__label">
              <p>Capabilities</p>
              <a href="/services">Services <span aria-hidden="true">↗</span></a>
            </div>
            <ol>
              {capabilities.map((capability, index) => (
                <li>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <strong>{capability}</strong>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>

      {
        featuredHustle && (
          <section class="hustle-section home-section" aria-labelledby="hustle-title">
            <div class="home-shell">
              <header class="editorial-heading" data-home-reveal>
                <div>
                  <p class="section-kicker">Hustle</p>
                  <h2 id="hustle-title">Hustle</h2>
                </div>
                <p>Stories about people building, operating, and shaping businesses and technology.</p>
              </header>

              <article
                class:list={[
                  "hustle-feature",
                  !featuredHustle.data.image && "hustle-feature--text",
                ]}
                data-home-reveal
              >
                {featuredHustle.data.image && (
                  <a
                    class="hustle-feature__media"
                    href={`/hustle/${featuredHustle.id}`}
                    aria-label={`Read ${featuredHustle.data.title}`}
                  >
                    <Image
                      src={featuredHustle.data.image.src}
                      alt={featuredHustle.data.image.alt}
                    />
                  </a>
                )}

                <div class="hustle-feature__copy">
                  <p class="editorial-meta">
                    <span>{featuredHustle.data.subject?.name ?? formatLabel(featuredHustle.data.topic)}</span>
                    <span>{formatDate(featuredHustle.data.publishedAt)}</span>
                  </p>
                  <h3>
                    <a href={`/hustle/${featuredHustle.id}`}>{featuredHustle.data.title}</a>
                  </h3>
                  <p>{featuredHustle.data.dek}</p>
                  <a class="text-link" href={`/hustle/${featuredHustle.id}`}>
                    Read story <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </article>
            </div>
          </section>
        )
      }

      {
        journalPreview.length > 0 && (
          <section class="journal-section home-section" aria-labelledby="journal-title">
            <div class="home-shell">
              <header class="editorial-heading" data-home-reveal>
                <div>
                  <p class="section-kicker">Journal</p>
                  <h2 id="journal-title">Journal</h2>
                </div>
                <p>Research and writing on software, AI, operations, products, and building businesses.</p>
              </header>

              <div class="journal-list">
                {journalPreview.map((story, index) => (
                  <article class="journal-row" data-home-reveal>
                    <p class="journal-row__index">{String(index + 1).padStart(2, "0")}</p>
                    <div class="journal-row__content">
                      <p class="editorial-meta">
                        <span>{formatLabel(story.data.topic)}</span>
                        <span>{formatDate(story.data.publishedAt)}</span>
                      </p>
                      <h3><a href={`/journal/${story.id}`}>{story.data.title}</a></h3>
                      <p>{story.data.dek}</p>
                    </div>
                    <a
                      class="journal-row__open"
                      href={`/journal/${story.id}`}
                      aria-label={`Read ${story.data.title}`}
                    >
                      ↗
                    </a>
                  </article>
                ))}
              </div>

              <a class="section-end-link" href="/journal" data-home-reveal>
                All Journal <span aria-hidden="true">↗</span>
              </a>
            </div>
          </section>
        )
      }

      <section class="newsletter-section" aria-labelledby="newsletter-title">
        <div class="newsletter-section__inner home-shell" data-home-reveal>
          <div class="newsletter-section__copy">
            <p class="section-kicker">Newsletter</p>
            <h2 id="newsletter-title">Portfilo, by email.</h2>
            <p>New work and writing from Portfilo.</p>
          </div>

          <div class="newsletter-section__form">
            <NewsletterSignup
              id="home-newsletter"
              variant="hero"
              showCopy={false}
              buttonLabel="Subscribe"
            />
          </div>
        </div>
      </section>

      {
        contactReady && (
          <section class="contact-section home-section" aria-labelledby="contact-title">
            <div class="home-shell" data-home-reveal>
              <h2 id="contact-title">What do you need to improve, replace, automate, or build?</h2>
              <a class="contact-section__link" href="/contact">
                Contact Portfilo <span aria-hidden="true">↗</span>
              </a>
            </div>
          </section>
        )
      }
    </main>

    <SiteFooter />

    <script>
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      let homepageContext: ReturnType<typeof gsap.context> | undefined;

      const cleanupHomepageMotion = () => {
        homepageContext?.revert();
        homepageContext = undefined;
      };

      const initHomepageMotion = () => {
        const root = document.querySelector("[data-homepage]");
        if (!(root instanceof HTMLElement) || root.dataset.motionBound === "true") return;

        root.dataset.motionBound = "true";
        cleanupHomepageMotion();

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        homepageContext = gsap.context(() => {
          const heroLines = gsap.utils.toArray<HTMLElement>("[data-hero-line]");
          const heroSupport = document.querySelector("[data-hero-support]");

          if (heroLines.length > 0) {
            gsap.from(heroLines, {
              yPercent: 115,
              duration: 0.62,
              stagger: 0.07,
              ease: "power3.out",
              clearProps: "transform",
            });
          }

          if (heroSupport instanceof HTMLElement) {
            gsap.from(heroSupport, {
              y: 18,
              opacity: 0,
              duration: 0.56,
              delay: 0.16,
              ease: "power3.out",
              clearProps: "transform,opacity",
            });
          }

          gsap.utils.toArray<HTMLElement>("[data-home-reveal]").forEach((element) => {
            gsap.from(element, {
              y: 28,
              opacity: 0,
              duration: 0.62,
              ease: "power3.out",
              clearProps: "transform,opacity",
              scrollTrigger: {
                trigger: element,
                start: "top 88%",
                once: true,
              },
            });
          });
        }, root);
      };

      initHomepageMotion();
      document.addEventListener("astro:page-load", initHomepageMotion);
      document.addEventListener("astro:before-swap", cleanupHomepageMotion);
    </script>

    <style>
      .home-shell {
        width: min(calc(100% - (2 * var(--shell-gutter))), var(--page-max));
        margin-inline: auto;
      }

      .hero {
        border-bottom: 1px solid var(--line);
      }

      .hero__grid {
        min-height: calc(68svh - 4.5rem);
        padding-block: clamp(5rem, 11vh, 8rem) clamp(4rem, 8vh, 7rem);
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
        align-content: end;
      }

      .hero__headline {
        grid-column: 1 / 11;
        margin: 0;
        color: var(--cold-white);
        font: 640 clamp(4.5rem, 9.6vw, 10rem) / 0.82 var(--sans);
        font-variation-settings: "wdth" 80, "wght" 640;
        letter-spacing: -0.078em;
        text-wrap: balance;
      }

      .hero__line-mask {
        display: block;
        overflow: hidden;
      }

      .hero__line-inner {
        display: block;
      }

      .hero__support {
        grid-column: 8 / 13;
        max-width: 35rem;
        margin: clamp(2.5rem, 5vw, 5rem) 0 0;
        color: var(--silver);
        font: 430 clamp(1rem, 0.92rem + 0.32vw, 1.25rem) / 1.55 var(--sans);
      }

      .home-section {
        border-bottom: 1px solid var(--line);
      }

      .home-section > .home-shell {
        padding-block: clamp(6rem, 10vw, 10rem);
      }

      .section-kicker,
      .work-project__index,
      .work-project__meta,
      .editorial-meta,
      .journal-row__index,
      .capabilities__label p {
        margin: 0;
        color: var(--muted-silver);
        font: 400 0.68rem/1.35 var(--mono);
        text-transform: uppercase;
      }

      .section-heading,
      .editorial-heading {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.42fr);
        gap: var(--grid-gap);
        align-items: end;
      }

      .section-heading h2,
      .editorial-heading h2 {
        margin: 0;
        color: var(--cold-white);
        font: 630 clamp(3rem, 6vw, 6.5rem) / 0.88 var(--sans);
        font-variation-settings: "wdth" 88, "wght" 630;
        letter-spacing: -0.068em;
      }

      .section-heading > a,
      .section-end-link,
      .text-link,
      .capabilities__label a {
        min-height: 2.75rem;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        color: var(--muted-silver);
        font: 500 0.78rem/1 var(--sans);
        text-decoration: none;
        transition: color var(--motion-micro) ease;
      }

      .section-heading > a {
        justify-self: end;
      }

      .section-heading > a:hover,
      .section-end-link:hover,
      .text-link:hover,
      .capabilities__label a:hover {
        color: var(--bright-white);
      }

      .work-list {
        margin-top: clamp(3rem, 6vw, 6rem);
        border-top: 1px solid var(--line);
      }

      .work-project {
        padding-block: clamp(2rem, 5vw, 5rem);
        border-bottom: 1px solid var(--line);
      }

      .work-project:last-child {
        border-bottom: 0;
        padding-bottom: 0;
      }

      .work-project__heading {
        display: grid;
        grid-template-columns: 3rem minmax(0, 1fr) minmax(8rem, auto);
        gap: var(--grid-gap);
        align-items: start;
      }

      .work-project h3 {
        max-width: 18ch;
        margin: 0;
        color: var(--cold-white);
        font: 620 clamp(2.5rem, 5vw, 5rem) / 0.92 var(--sans);
        font-variation-settings: "wdth" 90, "wght" 620;
        letter-spacing: -0.06em;
      }

      .work-project h3 a {
        color: inherit;
        text-decoration: none;
      }

      .work-project__cue {
        max-width: 52ch;
        margin: var(--space-4) 0 0;
        color: var(--muted-silver);
        font: 430 1rem/1.55 var(--sans);
      }

      .work-project__meta {
        display: grid;
        justify-items: end;
        gap: var(--space-2);
      }

      .work-project__media {
        margin-top: clamp(2rem, 4vw, 4rem);
        display: block;
        overflow: hidden;
        background: var(--graphite);
        line-height: 0;
      }

      .work-project__media :global(img) {
        width: 100%;
        height: auto;
        display: block;
      }

      .services-intro {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
        align-items: start;
      }

      .services-intro__heading {
        grid-column: 1 / 5;
      }

      .services-intro__heading h2 {
        max-width: 8ch;
        margin: var(--space-4) 0 0;
        color: var(--cold-white);
        font: 630 clamp(3rem, 5.5vw, 6rem) / 0.9 var(--sans);
        font-variation-settings: "wdth" 88, "wght" 630;
        letter-spacing: -0.065em;
      }

      .services-intro__copy {
        grid-column: 6 / 13;
        max-width: 52rem;
        margin: 0;
        color: var(--silver);
        font: 450 clamp(1.45rem, 2.3vw, 2.6rem) / 1.18 var(--sans);
        letter-spacing: -0.032em;
      }

      .capabilities {
        margin-top: clamp(5rem, 10vw, 10rem);
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
      }

      .capabilities__label {
        grid-column: 1 / 5;
        display: flex;
        gap: var(--space-4);
        align-items: flex-start;
        justify-content: space-between;
      }

      .capabilities__label a {
        min-height: 0;
      }

      .capabilities ol {
        grid-column: 6 / 13;
        margin: 0;
        padding: 0;
        list-style: none;
        border-top: 1px solid var(--line);
      }

      .capabilities li {
        min-height: clamp(4.5rem, 7vw, 7rem);
        display: grid;
        grid-template-columns: 3rem minmax(0, 1fr);
        gap: var(--grid-gap);
        align-items: center;
        border-bottom: 1px solid var(--line);
      }

      .capabilities li > span {
        color: var(--muted-silver);
        font: 400 0.68rem/1 var(--mono);
      }

      .capabilities li strong {
        color: var(--cold-white);
        font: 560 clamp(1.55rem, 2.7vw, 3rem) / 1 var(--sans);
        letter-spacing: -0.04em;
      }

      .editorial-heading {
        align-items: start;
      }

      .editorial-heading .section-kicker {
        margin-bottom: var(--space-4);
      }

      .editorial-heading > p {
        max-width: 34rem;
        margin: 0;
        color: var(--muted-silver);
        font: 430 1rem/1.55 var(--sans);
      }

      .hustle-feature {
        margin-top: clamp(3rem, 6vw, 6rem);
        padding-top: clamp(2rem, 4vw, 4rem);
        border-top: 1px solid var(--line);
        display: grid;
        grid-template-columns: 5fr 7fr;
        gap: clamp(1.5rem, 4vw, 4rem);
        align-items: start;
      }

      .hustle-feature--text {
        grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      }

      .hustle-feature--text .hustle-feature__copy {
        grid-column: 6 / 13;
      }

      .hustle-feature__media {
        display: block;
        overflow: hidden;
        background: var(--graphite);
        line-height: 0;
      }

      .hustle-feature__media :global(img) {
        width: 100%;
        height: auto;
        display: block;
      }

      .hustle-feature__copy {
        align-self: end;
      }

      .editorial-meta {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-4);
      }

      .hustle-feature h3 {
        max-width: 17ch;
        margin: var(--space-4) 0 0;
        color: var(--cold-white);
        font: 620 clamp(2.25rem, 4.7vw, 5rem) / 0.94 var(--sans);
        font-variation-settings: "wdth" 90, "wght" 620;
        letter-spacing: -0.06em;
      }

      .hustle-feature h3 a {
        color: inherit;
        text-decoration: none;
      }

      .hustle-feature__copy > p:not(.editorial-meta) {
        max-width: 56ch;
        margin: var(--space-5, 1.25rem) 0 0;
        color: var(--muted-silver);
        font: 430 1rem/1.58 var(--sans);
      }

      .text-link {
        margin-top: var(--space-6);
      }

      .journal-list {
        margin-top: clamp(3rem, 6vw, 6rem);
        border-top: 1px solid var(--line);
      }

      .journal-row {
        min-height: 11rem;
        padding-block: clamp(1.5rem, 3vw, 2.5rem);
        display: grid;
        grid-template-columns: 3rem minmax(0, 1fr) auto;
        gap: var(--grid-gap);
        border-bottom: 1px solid var(--line);
      }

      .journal-row__index {
        padding-top: 0.25rem;
      }

      .journal-row__content h3 {
        max-width: 26ch;
        margin: var(--space-3) 0 0;
        color: var(--cold-white);
        font: 610 clamp(1.7rem, 1.25rem + 1.6vw, 3.15rem) / 1 var(--sans);
        letter-spacing: -0.048em;
      }

      .journal-row__content h3 a,
      .journal-row__open {
        color: inherit;
        text-decoration: none;
      }

      .journal-row__content > p:not(.editorial-meta) {
        max-width: 62ch;
        margin: var(--space-4) 0 0;
        color: var(--muted-silver);
        font: 430 0.98rem/1.55 var(--sans);
      }

      .journal-row__open {
        align-self: start;
        color: var(--muted-silver);
        font-size: 1.2rem;
        transition: color var(--motion-micro) ease;
      }

      .journal-row:hover .journal-row__open {
        color: var(--bright-white);
      }

      .section-end-link {
        width: fit-content;
        margin-top: var(--space-8);
      }

      .newsletter-section {
        border-bottom: 1px solid var(--line);
        background: var(--deep-graphite);
      }

      .newsletter-section__inner {
        min-height: clamp(25rem, 42vw, 38rem);
        padding-block: clamp(5rem, 8vw, 8rem);
        display: grid;
        grid-template-columns: 5fr 7fr;
        gap: clamp(2rem, 5vw, 6rem);
        align-items: center;
      }

      .newsletter-section__copy h2 {
        max-width: 9ch;
        margin: var(--space-4) 0 0;
        color: var(--cold-white);
        font: 630 clamp(3rem, 5.5vw, 6rem) / 0.9 var(--sans);
        font-variation-settings: "wdth" 88, "wght" 630;
        letter-spacing: -0.065em;
      }

      .newsletter-section__copy > p:not(.section-kicker) {
        max-width: 30rem;
        margin: var(--space-6) 0 0;
        color: var(--muted-silver);
        font: 430 1rem/1.55 var(--sans);
      }

      .newsletter-section__form {
        align-self: center;
      }

      .contact-section > .home-shell {
        min-height: 54svh;
        display: grid;
        align-content: center;
      }

      .contact-section h2 {
        max-width: 14ch;
        margin: 0;
        color: var(--cold-white);
        font: 630 clamp(3.2rem, 6.5vw, 7rem) / 0.9 var(--sans);
        font-variation-settings: "wdth" 86, "wght" 630;
        letter-spacing: -0.068em;
      }

      .contact-section__link {
        width: fit-content;
        margin-top: clamp(2rem, 4vw, 4rem);
        padding-block: var(--space-4);
        border-bottom: 1px solid var(--line-strong);
        color: var(--cold-white);
        font: 520 clamp(1.2rem, 2vw, 1.7rem) / 1 var(--sans);
        text-decoration: none;
        transition:
          color var(--motion-micro) ease,
          border-color var(--motion-micro) ease;
      }

      .contact-section__link:hover {
        color: var(--bright-white);
        border-bottom-color: var(--bright-white);
