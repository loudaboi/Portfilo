---
import { getCollection } from "astro:content";
import SiteHead from "../components/SiteHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";

const publishedStories = await getCollection(
  "stories",
  ({ data }) => data.status === "published",
);

const storiesByDate = [...publishedStories].sort(
  (a, b) =>
    (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0),
);

const featureStory =
  storiesByDate.find(({ data }) => data.featured) ?? storiesByDate[0];

const formatLabel = (value: string) => value.replaceAll("-", " ");

const devNews = import.meta.env.DEV
  ? [
      {
        topic: "business",
        time: "12 min ago",
        title: "Development fixture: lead headline tests a two-line current story",
        dek: "Synthetic layout copy used only in local development to test the future News hierarchy.",
      },
      {
        topic: "technology",
        time: "28 min ago",
        title: "Development fixture: compact technology headline",
        dek: "Synthetic copy for testing a shorter supporting item.",
      },
      {
        topic: "startup",
        time: "46 min ago",
        title: "Development fixture: startup update with a medium-length headline",
        dek: "Synthetic copy for testing supporting-news density and mobile stacking.",
      },
      {
        topic: "ai",
        time: "1 hr ago",
        title: "Development fixture: fourth update for the chronological feed",
        dek: "Synthetic copy for testing the final supporting item.",
      },
    ]
  : [];

const tickerItems =
  devNews.length > 0
    ? devNews.map((item) => ({
        label: item.topic,
        title: item.title,
        href: undefined,
      }))
    : storiesByDate.map((story) => ({
        label: story.data.topic,
        title: story.data.title,
        href: `/stories/${story.id}`,
      }));
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      title="Portfilo | Business and Technology News"
      description="The latest news on companies, startups, products, markets, AI, and technology."
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader />

    <main id="main-content" tabindex="-1">
      <section class="newsletter-band" id="newsletter" aria-labelledby="newsletter-title">
        <div class="newsletter-band__inner">
          <div class="newsletter-band__copy">
            <h1 id="newsletter-title">Get ahead in business and tech in 7 minutes.</h1>
            <p>
              The latest news on companies, startups, products, markets, AI, and technology.
              Three times a week, straight to your inbox.
            </p>
          </div>

          <div class="newsletter-band__form">
            <NewsletterSignup
              id="home-hero-newsletter"
              variant="hero"
              showCopy={false}
              buttonLabel="Subscribe free"
            />
          </div>
        </div>
      </section>

      {
        tickerItems.length > 0 && (
          <section class="latest-strip" id="latest" aria-label="Latest from Portfilo">
            <div class="latest-strip__label">
              <strong>Latest</strong>
            </div>
            <div class="latest-strip__rail" tabindex="0" aria-label="Latest headlines">
              {tickerItems.map((item) =>
                item.href ? (
                  <a class="latest-strip__item" href={item.href}>
                    <span>{formatLabel(item.label)}</span>
                    <strong>{item.title}</strong>
                  </a>
                ) : (
                  <span class="latest-strip__item">
                    <span>{formatLabel(item.label)}</span>
                    <strong>{item.title}</strong>
                  </span>
                ),
              )}
            </div>
          </section>
        )
      }

      {
        featureStory && (
          <section class="featured-section" aria-label="Featured story">
            <div class="featured-pair">
              <article class="featured-story">
                <a
                  class="featured-story__media"
                  href={`/stories/${featureStory.id}`}
                  aria-label={`Read ${featureStory.data.title}`}
                >
                  <img
                    src="/images/homepage-feature-image.webp"
                    alt=""
                    loading="eager"
                    decoding="async"
                  />
                  <span class="featured-story__disclosure">AI-generated editorial image</span>
                </a>

                <div class="featured-story__copy">
                  <h2>
                    <a href={`/stories/${featureStory.id}`}>{featureStory.data.title}</a>
                  </h2>
                  <p>{featureStory.data.dek}</p>
                </div>
              </article>

              <aside class="feature-newsletter" aria-label="Subscribe to the Portfilo newsletter">
                <NewsletterSignup
                  id="home-feature-newsletter"
                  heading="There's more to it than the headline."
                  copy=""
                  variant="card"
                  buttonLabel="Send me the news"
                />
              </aside>
            </div>
          </section>
        )
      }

      {
        devNews.length > 0 && (
          <section class="news-section" aria-labelledby="news-section-title">
            <header class="news-section__heading">
              <h2 id="news-section-title">News</h2>
              <p class="fixture-warning">Development fixtures only. Not Portfilo reporting.</p>
            </header>

            <div class="news-grid">
              <article class="lead-news">
                <div class="news-image-placeholder" aria-hidden="true">
                  <span>News image</span>
                  <small>Development layout only</small>
                </div>
                <div class="news-meta">
                  <span>{devNews[0].topic}</span>
                  <span>{devNews[0].time}</span>
                </div>
                <h3>{devNews[0].title}</h3>
                <p>{devNews[0].dek}</p>
              </article>

              <div class="news-list">
                {devNews.slice(1).map((item) => (
                  <article class="news-list__item">
                    <div class="news-meta">
                      <span>{item.topic}</span>
                      <span>{item.time}</span>
                    </div>
                    <h3>{item.title}</h3>
                    <p>{item.dek}</p>
                  </article>
                ))}
              </div>
            </div>
          </section>
        )
      }

      <section class="footer-newsletter" aria-label="Subscribe to the Portfilo newsletter">
        <NewsletterSignup
          id="home-footer-newsletter"
          heading="Get ahead in business and tech in 7 minutes."
          copy="The latest news on companies, startups, products, markets, AI, and technology. Three times a week, straight to your inbox."
          variant="footer"
          buttonLabel="Send me the news"
        />
      </section>
    </main>

    <SiteFooter />

    <style>
      @font-face {
        font-family: "Instrument Sans";
        font-style: normal;
        font-display: swap;
        font-weight: 400 700;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/instrument-sans:vf@5.3.0/latin-wght-normal.woff2") format("woff2-variations");
      }

      @font-face {
        font-family: "Source Serif 4";
        font-style: normal;
        font-display: swap;
        font-weight: 200 900;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/source-serif-4:vf@5.3.0/latin-wght-normal.woff2") format("woff2-variations");
      }

      @font-face {
        font-family: "IBM Plex Mono";
        font-style: normal;
        font-display: swap;
        font-weight: 400;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/ibm-plex-mono@5.3.0/latin-400-normal.woff2") format("woff2");
      }

      :global(:root) {
        --paper: #f8f6f1;
        --paper-soft: #efebe3;
        --ink: #171614;
        --muted: #68645e;
        --line: #d4cfc6;
        --line-strong: #aaa39a;
        --accent: #0050a4;
        --correction: #b42318;
        --page-max: 100rem;
        --gutter: clamp(1.25rem, 3.3vw, 3.75rem);
        --grid-gap: clamp(1rem, 1.8vw, 1.75rem);
        --sans: "Instrument Sans", "Helvetica Neue", Arial, sans-serif;
        --serif: "Source Serif 4", Georgia, serif;
        --mono: "IBM Plex Mono", "Courier New", monospace;
      }

      :global(*) { box-sizing: border-box; }
      :global(html) {
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
        font-synthesis: none;
      }
      :global(body) { margin: 0; min-width: 0; background: var(--paper); }
      :global(a) { color: inherit; }
      :global(a:focus-visible) { outline: 3px solid var(--accent); outline-offset: 4px; }
      :global(main:focus) { outline: none; }

      .skip-link {
        position: fixed;
        z-index: 50;
        top: 0.75rem;
        left: 0.75rem;
        padding: 0.7rem 0.85rem;
        background: var(--ink);
        color: var(--paper);
        font: 550 0.75rem/1 var(--sans);
        text-decoration: none;
        transform: translateY(-200%);
      }
      .skip-link:focus { transform: translateY(0); }

      .newsletter-band {
        width: 100%;
        background: var(--paper);
        border-top: 3px solid var(--accent);
        border-bottom: 1px solid var(--line);
      }

      .newsletter-band__inner,
      .featured-section,
      .news-section {
        width: min(100%, var(--page-max));
        margin-inline: auto;
      }

      .newsletter-band__inner {
        padding: clamp(1.25rem, 1.9vw, 1.75rem) var(--gutter);
        display: grid;
        grid-template-columns: minmax(0, 1.08fr) minmax(24rem, 0.92fr);
        gap: clamp(2rem, 4.5vw, 4.5rem);
        align-items: center;
      }

      .newsletter-band__copy h1 {
        max-width: 17ch;
        margin: 0;
        font: 560 clamp(2.35rem, 2.9vw, 3rem) / 0.98 var(--serif);
        letter-spacing: -0.035em;
        text-wrap: balance;
      }

      .newsletter-band__copy p {
        max-width: 44rem;
        margin: 0.65rem 0 0;
        color: var(--muted);
        font: 440 clamp(0.9rem, 1vw, 1rem) / 1.45 var(--sans);
      }

      .newsletter-band__form {
        width: min(100%, 30rem);
        min-width: 0;
        justify-self: end;
      }

      .newsletter-band__form :global(.newsletter-signup__row) {
        grid-template-columns: 1fr;
        gap: 0.55rem;
        max-width: none;
      }

      .newsletter-band__form :global(.newsletter-signup input) {
        border: 1px solid var(--line-strong);
        background: #fff;
      }

      .newsletter-band__form :global(.newsletter-signup button) {
        width: 100%;
      }

      .latest-strip {
        width: 100%;
        min-height: 2.8rem;
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        background: var(--paper);
        color: var(--ink);
        border-bottom: 1px solid var(--line);
        overflow: hidden;
      }

      .latest-strip__label {
        display: flex;
        align-items: center;
        padding: 0.72rem clamp(1rem, 2.1vw, 1.6rem);
        background: var(--ink);
        color: #fff;
        font: 680 0.64rem/1 var(--sans);
        letter-spacing: 0.085em;
        text-transform: uppercase;
      }

      .latest-strip__rail {
        min-width: 0;
        display: flex;
        align-items: stretch;
        overflow-x: auto;
        overscroll-behavior-inline: contain;
        scrollbar-width: none;
      }
      .latest-strip__rail::-webkit-scrollbar { display: none; }
      .latest-strip__rail:focus-visible { outline-offset: -3px; }

      .latest-strip__item {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        gap: 0.65rem;
        padding: 0.7rem clamp(1rem, 1.8vw, 1.55rem);
        border-right: 1px solid var(--line);
        color: var(--ink);
        text-decoration: none;
        white-space: nowrap;
      }

      .latest-strip__item > span {
        color: var(--accent);
        font: 650 0.62rem/1 var(--sans);
        letter-spacing: 0.055em;
        text-transform: uppercase;
      }

      .latest-strip__item > strong {
        max-width: 34rem;
        overflow: hidden;
        font: 520 0.75rem/1.2 var(--sans);
        text-overflow: ellipsis;
      }

      a.latest-strip__item:hover strong {
        text-decoration: underline;
        text-underline-offset: 0.18em;
      }

      .featured-section {
        padding: clamp(1.4rem, 2.5vw, 2.35rem) var(--gutter) clamp(2.35rem, 4vw, 3.75rem);
      }

      .featured-pair {
        width: min(100%, 88rem);
        margin-inline: auto;
        display: grid;
        grid-template-columns: minmax(0, 1.7fr) minmax(19rem, 1fr);
        gap: clamp(2rem, 3vw, 3rem);
        align-items: start;
      }

      .featured-story {
        min-width: 0;
      }

      .featured-story__media {
        position: relative;
        display: block;
        overflow: hidden;
        background: var(--paper-soft);
        line-height: 0;
      }

      .featured-story__media img {
        display: block;
        width: 100%;
        height: auto;
        object-fit: contain;
        filter: grayscale(1);
      }

      .featured-story__disclosure {
        position: absolute;
        right: 0.65rem;
        bottom: 0.6rem;
        padding: 0.27rem 0.36rem;
        background: rgba(23, 22, 20, 0.78);
        color: #fff;
        font: 520 0.57rem/1 var(--sans);
        letter-spacing: 0.035em;
      }

      .featured-story__copy {
        padding-top: 0.78rem;
      }

      .featured-story__copy h2,
      .featured-story__copy p {
        margin: 0;
      }

      .featured-story__copy h2 {
        max-width: 24ch;
        font: 560 clamp(2.1rem, 2.7vw, 3rem) / 1 var(--serif);
        letter-spacing: -0.035em;
      }

      .featured-story__copy h2 a {
        text-decoration: none;
      }

      .featured-story__copy h2 a:hover {
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.14em;
      }

      .featured-story__copy p {
        max-width: 48rem;
        margin-top: 0.5rem;
        color: var(--muted);
        font: 420 clamp(0.92rem, 1vw, 1rem) / 1.48 var(--serif);
      }

      .feature-newsletter {
        min-width: 0;
        padding: clamp(1.35rem, 2.2vw, 1.9rem);
        background: var(--accent);
        color: #fff;
      }

      .feature-newsletter :global(.newsletter-signup__copy h2) {
        color: #fff;
      }

      .news-section {
        padding: clamp(2.5rem, 4.7vw, 4.7rem) var(--gutter) clamp(3.25rem, 6vw, 6rem);
        border-top: 1px solid var(--line);
      }

      .news-section__heading {
        padding-bottom: 0.8rem;
        display: flex;
        justify-content: space-between;
        gap: 2rem;
        align-items: end;
        border-bottom: 1px solid var(--ink);
      }

      .news-section__heading h2,
      .fixture-warning {
        margin: 0;
      }

      .news-section__heading h2 {
        font: 680 clamp(2rem, 3.1vw, 3.35rem) / 0.96 var(--sans);
        letter-spacing: -0.045em;
      }

      .fixture-warning {
        max-width: 19rem;
        color: var(--muted);
        font: 520 0.7rem/1.35 var(--sans);
        text-align: right;
      }

      .news-grid {
        padding-top: clamp(1.25rem, 2.4vw, 2.2rem);
        display: grid;
        grid-template-columns: minmax(0, 1.7fr) minmax(18rem, 0.8fr);
        gap: clamp(1.5rem, 3.5vw, 3.5rem);
        align-items: start;
      }

      .lead-news h3,
      .news-list__item h3,
      .lead-news p,
      .news-list__item p,
      .news-meta {
        margin: 0;
      }

      .news-image-placeholder {
        aspect-ratio: 16 / 8.6;
        margin-bottom: 1rem;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        background: var(--paper-soft);
        border-top: 3px solid var(--accent);
        color: var(--muted);
      }

      .news-image-placeholder span {
        color: var(--ink);
        font: 620 clamp(1.3rem, 2vw, 2rem) / 1 var(--sans);
        letter-spacing: -0.025em;
      }

      .news-image-placeholder small {
        font: 540 0.65rem/1.2 var(--sans);
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .news-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem 0.8rem;
        color: var(--muted);
        font: 550 0.64rem/1.2 var(--sans);
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      .news-meta span:first-child {
        color: var(--accent);
      }

      .lead-news h3 {
        max-width: 20ch;
        margin-top: 0.55rem;
        font: 670 clamp(2rem, 3.3vw, 3.55rem) / 0.98 var(--sans);
        letter-spacing: -0.048em;
      }

      .lead-news > p {
        max-width: 48rem;
        margin-top: 0.75rem;
        color: var(--muted);
        font: 420 clamp(0.95rem, 1.1vw, 1.06rem) / 1.55 var(--sans);
      }

      .news-list {
        border-top: 1px solid var(--line);
      }

      .news-list__item {
        padding: 1rem 0 1.15rem;
        border-bottom: 1px solid var(--line);
      }

      .news-list__item h3 {
        max-width: 28ch;
        margin-top: 0.45rem;
        font: 650 clamp(1.2rem, 1.55vw, 1.55rem) / 1.08 var(--sans);
        letter-spacing: -0.03em;
      }

      .news-list__item p {
        margin-top: 0.55rem;
        color: var(--muted);
        font: 420 0.84rem/1.5 var(--sans);
      }

      .footer-newsletter {
        width: 100%;
        padding: clamp(2.2rem, 4vw, 3.8rem) max(var(--gutter), calc((100vw - var(--page-max)) / 2 + var(--gutter)));
        background: var(--ink);
        color: #fff;
        border-bottom: 1px solid rgba(255, 255, 255, 0.14);
      }

      .footer-newsletter :global(.newsletter-signup__copy h2) {
        color: #fff;
      }

      .footer-newsletter :global(.newsletter-signup__copy p),
      .footer-newsletter :global(.newsletter-signup__note),
      .footer-newsletter :global(.newsletter-signup__status) {
        color: rgba(255, 255, 255, 0.68);
      }

      .footer-newsletter :global(.newsletter-signup input) {
        border-color: rgba(255, 255, 255, 0.45);
        background: rgba(255, 255, 255, 0.07);
        color: #fff;
      }

      .footer-newsletter :global(.newsletter-signup input::placeholder) {
        color: rgba(255, 255, 255, 0.55);
      }

      .footer-newsletter :global(.newsletter-signup__status[data-state="success"]) {
        color: #8fc7ff;
      }

      .footer-newsletter :global(.newsletter-signup__status[data-state="error"]) {
        color: #ffc2b8;
      }

      @media (max-width: 64rem) {
        .newsletter-band__inner {
          grid-template-columns: minmax(0, 1fr) minmax(19rem, 0.85fr);
          gap: 2rem;
        }

        .featured-pair {
          grid-template-columns: minmax(0, 1.45fr) minmax(18rem, 0.8fr);
        }
      }

      @media (max-width: 48rem) {
        .newsletter-band__inner,
        .featured-pair,
        .news-grid {
          grid-template-columns: 1fr;
        }

        .newsletter-band__inner {
          gap: 1.2rem;
        }

        .newsletter-band__form {
          width: 100%;
          justify-self: stretch;
        }

        .feature-newsletter {
          min-height: 0;
        }

        .fixture-warning {
          max-width: 14rem;
        }

        .news-image-placeholder {
          aspect-ratio: 16 / 9;
        }
      }

      @media (max-width: 36rem) {
        .newsletter-band__inner,
        .featured-section,
        .news-section {
          --gutter: 1.1rem;
        }

        .newsletter-band__inner {
          padding-top: 1.15rem;
          padding-bottom: 1.2rem;
        }

        .newsletter-band__copy h1 {
          max-width: 18ch;
          font-size: clamp(2rem, 10vw, 2.6rem);
        }

        .latest-strip__label {
          padding-inline: 0.82rem;
        }

        .latest-strip__item {
          max-width: 84vw;
          padding-inline: 0.9rem;
        }

        .latest-strip__item > strong {
          max-width: 62vw;
        }

        .featured-section {
          padding-top: 1.1rem;
          padding-bottom: 2rem;
        }

        .featured-story__copy h2 {
          font-size: clamp(2rem, 9vw, 2.65rem);
        }

        .news-section__heading {
          align-items: start;
        }

        .fixture-warning {
          font-size: 0.62rem;
        }

        .footer-newsletter {
          --gutter: 1.1rem;
          padding-inline: var(--gutter);
        }
      }

      @media (max-width: 23rem) {
        .newsletter-band__inner,
        .featured-section,
        .news-section,
        .footer-newsletter {
          --gutter: 1rem;
        }
      }
    </style>
  </body>
</html>