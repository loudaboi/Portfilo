---
import { getCollection } from "astro:content";
import SiteHead from "../components/SiteHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";

const publishedStories = await getCollection(
  "stories",
  ({ data }) => data.status === "published",
);

const storiesByDate = [...publishedStories].sort(
  (a, b) =>
    (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0),
);

const featureStory =
  storiesByDate.find(({ data }) => data.featured) ?? storiesByDate[0];

const formatLabel = (value: string) => value.replaceAll("-", " ");

const devNews = import.meta.env.DEV
  ? [
      {
        topic: "business",
        time: "8 min ago",
        title: "A payments platform introduces same-day settlement for small merchants",
        dek: "Synthetic layout copy used only in local development to test the lead News treatment and longer business copy.",
      },
      {
        topic: "technology",
        time: "21 min ago",
        title: "A local telco expands 5G coverage across more provincial cities",
        dek: "Synthetic technology copy for testing headline wrapping and supporting-item density.",
      },
      {
        topic: "startup",
        time: "34 min ago",
        title: "A logistics startup adds cold-chain delivery for neighborhood retailers",
        dek: "Synthetic startup copy for testing a medium-length supporting update.",
      },
      {
        topic: "ai",
        time: "47 min ago",
        title: "A BPO operator pilots AI-assisted support across two service teams",
        dek: "Synthetic AI copy for testing a compact current-news treatment.",
      },
      {
        topic: "business",
        time: "1 hr ago",
        title: "A major bank rolls out a new digital credit product for small businesses",
        dek: "Synthetic business copy for testing the final News slot.",
      },
    ]
  : [];

const devStory = import.meta.env.DEV
  ? {
      title: "AI was supposed to kill Philippine BPO. So why is it still growing?",
      dek: "Development-only story teaser used to test the deeper Stories rail and headline hierarchy.",
    }
  : undefined;

const leadDevNews = devNews[0];

const tickerItems =
  devNews.length > 0
    ? devNews.map((item) => ({
        label: item.topic,
        title: item.title,
        href: undefined,
      }))
    : storiesByDate.map((story) => ({
        label: story.data.topic,
        title: story.data.title,
        href: `/stories/${story.id}`,
      }));

const railStory =
  devStory ??
  storiesByDate
    .filter((story) => story.id !== featureStory?.id)
    .map((story) => ({
      title: story.data.title,
      dek: story.data.dek,
    }))[0];
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      title="Portfilo | Business and Technology News"
      description="The latest news on companies, startups, products, markets, AI, and technology."
    />
  </head>
  <body class="home-page">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader />

    <main id="main-content" tabindex="-1">
      <section class="newsletter-band" id="newsletter" aria-labelledby="newsletter-title">
        <div class="newsletter-band__inner">
          <div class="newsletter-band__copy">
            <h1 id="newsletter-title">Get ahead in business and tech in 7 minutes.</h1>
            <p>
              The latest news on companies, startups, products, markets, AI, and technology.
              Three times a week, straight to your inbox.
            </p>
          </div>

          <div class="newsletter-band__form">
            <NewsletterSignup
              id="home-hero-newsletter"
              variant="hero"
              showCopy={false}
              buttonLabel="Send me the news"
            />
          </div>
        </div>
      </section>

      {
        tickerItems.length > 0 && (
          <section class="latest-strip" id="latest" aria-label="Latest news from Portfilo">
            <div class="latest-strip__label">
              <strong>Latest news</strong>
            </div>
            <div class="latest-strip__rail" tabindex="0" aria-label="Latest news headlines">
              {tickerItems.map((item) =>
                item.href ? (
                  <a class="latest-strip__item" href={item.href}>
                    <span>{formatLabel(item.label)}</span>
                    <strong>{item.title}</strong>
                  </a>
                ) : (
                  <span class="latest-strip__item">
                    <span>{formatLabel(item.label)}</span>
                    <strong>{item.title}</strong>
                  </span>
                ),
              )}
            </div>
          </section>
        )
      }

      {
        featureStory && (
          <section class="featured-section" aria-label="Featured story">
            <div class="featured-pair">
              <article class="featured-story">
                <a
                  class="featured-story__media"
                  href={`/stories/${featureStory.id}`}
                  aria-label={`Read ${featureStory.data.title}`}
                >
                  <img
                    src="/images/homepage-feature-16x9.png"
                    width="1672"
                    height="941"
                    alt=""
                    loading="eager"
                    decoding="async"
                  />
                  <span class="featured-story__disclosure">AI-generated editorial image</span>
                </a>

                <div class="featured-story__copy">
                  <h2>
                    <a href={`/stories/${featureStory.id}`}>{featureStory.data.title}</a>
                  </h2>
                  <p>{featureStory.data.dek}</p>
                </div>
              </article>

              <aside class="feature-rail" aria-label="Portfilo newsletter and stories">
                <div class="feature-rail__signup">
                  <NewsletterSignup
                    id="home-feature-newsletter"
                    heading="There's more to it than the headline."
                    copy="The latest news on companies, startups, products, markets, AI, and technology. Three times a week, straight to your inbox."
                    variant="card"
                    buttonLabel="Subscribe"
                  />
                </div>

                <div class="feature-rail__latest">
                  <p class="feature-rail__latest-label">Stories</p>
                  {
                    railStory ? (
                      <>
                        <h3>{railStory.title}</h3>
                        <p>{railStory.dek}</p>
                      </>
                    ) : (
                      <p class="feature-rail__latest-empty">No additional stories published yet.</p>
                    )
                  }
                  <a href="/stories">Read more stories <span aria-hidden="true">→</span></a>
                </div>
              </aside>
            </div>
          </section>
        )
      }

      <section class="news-section" id="news" aria-labelledby="news-section-title">
        <header class="news-section__heading">
          <h2 id="news-section-title">News</h2>
          {leadDevNews && (
            <p class="fixture-warning">Development fixtures only. Not Portfilo reporting.</p>
          )}
        </header>

        {
          leadDevNews ? (
            <div class="news-grid">
              <article class="lead-news">
                <div class="news-image-placeholder" aria-hidden="true">
                  <span>News image</span>
                  <small>Development layout only</small>
                </div>
                <div class="news-meta">
                  <span>{leadDevNews.topic}</span>
                  <span>{leadDevNews.time}</span>
                </div>
                <h3>{leadDevNews.title}</h3>
                <p>{leadDevNews.dek}</p>
              </article>

              <div class="news-list">
                {devNews.slice(1).map((item) => (
                  <article class="news-list__item">
                    <div class="news-meta">
                      <span>{item.topic}</span>
                      <span>{item.time}</span>
                    </div>
                    <h3>{item.title}</h3>
                    <p>{item.dek}</p>
                  </article>
                ))}
              </div>
            </div>
          ) : (
            <p class="news-empty">No published News items yet.</p>
          )
        }
      </section>

      <section class="footer-newsletter" aria-label="Subscribe to the Portfilo newsletter">
        <div class="footer-newsletter__inner">
          <NewsletterSignup
            id="home-footer-newsletter"
            heading="Get ahead in business and tech in 7 minutes."
            copy="The latest news on companies, startups, products, markets, AI, and technology. Three times a week, straight to your inbox."
            variant="footer"
            buttonLabel="Send me the news"
          />
        </div>
      </section>
    </main>

    <SiteFooter />

    <style>
      @font-face {
        font-family: "Instrument Sans";
        font-style: normal;
        font-display: swap;
        font-weight: 400 700;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/instrument-sans:vf@5.3.0/latin-wght-normal.woff2") format("woff2-variations");
      }

      @font-face {
        font-family: "Source Serif 4";
        font-style: normal;
        font-display: swap;
        font-weight: 200 900;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/source-serif-4:vf@5.3.0/latin-wght-normal.woff2") format("woff2-variations");
      }

      @font-face {
        font-family: "IBM Plex Mono";
        font-style: normal;
        font-display: swap;
        font-weight: 400;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/ibm-plex-mono@5.3.0/latin-400-normal.woff2") format("woff2");
      }

      :global(:root) {
        --paper: #f8f6f1;
        --paper-soft: #efebe3;
        --ink: #171614;
        --muted: #68645e;
        --line: #d4cfc6;
        --line-strong: #aaa39a;
        --accent: #0050a4;
        --correction: #b42318;
        --page-max: 100rem;
        --content-max: 84rem;
        --shell-gutter: clamp(1.25rem, 2.6vw, 2rem);
        --gutter: var(--shell-gutter);
        --grid-gap: clamp(1rem, 1.8vw, 1.75rem);
        --signup-control-max: 28rem;
        --sans: "Instrument Sans", "Helvetica Neue", Arial, sans-serif;
        --serif: "Source Serif 4", Georgia, serif;
        --mono: "IBM Plex Mono", "Courier New", monospace;
      }

      :global(*) { box-sizing: border-box; }
      :global(html) {
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
        font-synthesis: none;
      }
      :global(body) { margin: 0; min-width: 0; background: var(--paper); }
      :global(a) { color: inherit; }
      :global(a:focus-visible) { outline: 3px solid var(--accent); outline-offset: 4px; }
      :global(main:focus) { outline: none; }

      .skip-link {
        position: fixed;
        z-index: 50;
        top: 0.75rem;
        left: 0.75rem;
        padding: 0.7rem 0.85rem;
        background: var(--ink);
        color: var(--paper);
        font: 550 0.75rem/1 var(--sans);
        text-decoration: none;
        transform: translateY(-200%);
      }
      .skip-link:focus { transform: translateY(0); }

      .newsletter-band {
        width: 100%;
        background: var(--accent);
        color: #fff;
      }

      .newsletter-band__inner,
      .featured-section,
      .news-section,
      .footer-newsletter__inner {
        width: min(calc(100% - (2 * var(--shell-gutter))), var(--content-max));
        margin-inline: auto;
      }

      .newsletter-band__inner {
        padding: clamp(1.45rem, 2vw, 1.85rem) 0;
        display: grid;
        grid-template-columns: minmax(0, 1.08fr) minmax(22rem, 0.92fr);
        gap: clamp(2.5rem, 3.2vw, 3.5rem);
        align-items: center;
      }

      .newsletter-band__copy h1 {
        max-width: 17ch;
        margin: 0;
        color: #fff;
        font: 680 clamp(2.15rem, 2.65vw, 2.8rem) / 0.98 var(--sans);
        letter-spacing: -0.045em;
        text-wrap: balance;
      }

      .newsletter-band__copy p {
        max-width: 43rem;
        margin: 0.65rem 0 0;
        color: rgba(255, 255, 255, 0.8);
        font: 440 clamp(0.9rem, 1vw, 1rem) / 1.45 var(--sans);
      }

      .newsletter-band__form {
        width: min(100%, var(--signup-control-max));
        min-width: 0;
        justify-self: end;
      }

      .newsletter-band__form :global(.newsletter-signup__row) {
        grid-template-columns: 1fr;
        gap: 0.55rem;
        max-width: none;
      }

      .newsletter-band__form :global(.newsletter-signup input) {
        border: 1px solid rgba(255, 255, 255, 0.42);
        background: rgba(255, 255, 255, 0.08);
        color: #fff;
      }

      .newsletter-band__form :global(.newsletter-signup input::placeholder) {
        color: rgba(255, 255, 255, 0.68);
      }

      .newsletter-band__form :global(.newsletter-signup button) {
        width: 100%;
        border-color: var(--paper);
        background: var(--paper);
        color: var(--accent);
      }

      .newsletter-band__form :global(.newsletter-signup button:hover) {
        filter: none;
        background: rgba(248, 246, 241, 0.9);
      }

      .newsletter-band__form :global(.newsletter-signup__note),
      .newsletter-band__form :global(.newsletter-signup__status) {
        color: rgba(255, 255, 255, 0.72);
      }

      .newsletter-band__form :global(.newsletter-signup__status[data-state="success"]) {
        color: #fff;
      }

      .newsletter-band__form :global(.newsletter-signup__status[data-state="error"]) {
        color: #ffe1dc;
      }

      .latest-strip {
        width: 100%;
        min-height: 2.35rem;
        margin: 0 0 1rem;
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        background: var(--paper);
        color: var(--ink);
        border-bottom: 1px solid var(--line);
        overflow: hidden;
      }

      .latest-strip__label {
        display: flex;
        align-items: center;
        padding: 0.56rem clamp(0.9rem, 1.9vw, 1.35rem);
        background: var(--ink);
        color: #fff;
        font: 680 0.61rem/1 var(--sans);
        letter-spacing: 0.075em;
        text-transform: uppercase;
      }

      .latest-strip__rail {
        min-width: 0;
        display: flex;
        align-items: stretch;
        overflow-x: auto;
        overscroll-behavior-inline: contain;
        scrollbar-width: none;
      }
      .latest-strip__rail::-webkit-scrollbar { display: none; }
      .latest-strip__rail:focus-visible { outline-offset: -3px; }

      .latest-strip__item {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.54rem clamp(0.9rem, 1.6vw, 1.35rem);
        border-right: 1px solid var(--line);
        color: var(--ink);
        text-decoration: none;
        white-space: nowrap;
      }

      .latest-strip__item > span {
        color: var(--accent);
        font: 650 0.59rem/1 var(--sans);
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      .latest-strip__item > strong {
        max-width: 34rem;
        overflow: hidden;
        font: 520 0.72rem/1.2 var(--sans);
        text-overflow: ellipsis;
      }

      a.latest-strip__item:hover strong {
        text-decoration: underline;
        text-underline-offset: 0.18em;
      }

      .featured-section {
        padding: 0 0 clamp(2.4rem, 4vw, 3.75rem);
      }

      .featured-pair {
        display: grid;
        grid-template-columns: minmax(0, 52rem) minmax(19rem, 1fr);
        gap: clamp(2rem, 2.7vw, 2.5rem);
        align-items: stretch;
      }

      .featured-story {
        min-width: 0;
      }

      .featured-story__media {
        position: relative;
        display: block;
        width: 100%;
        max-width: 52rem;
        overflow: hidden;
        border-top: 3px solid var(--accent);
        background: var(--paper-soft);
        line-height: 0;
      }

      .featured-story__media img {
        display: block;
        width: 100%;
        height: auto;
        filter: grayscale(1);
      }

      .featured-story__disclosure {
        position: absolute;
        right: 0.65rem;
        bottom: 0.6rem;
        padding: 0.27rem 0.36rem;
        background: rgba(23, 22, 20, 0.78);
        color: #fff;
        font: 520 0.57rem/1 var(--sans);
        letter-spacing: 0.035em;
      }

      .featured-story__copy {
        padding-top: 0.78rem;
      }

      .featured-story__copy h2,
      .featured-story__copy p {
        margin: 0;
      }

      .featured-story__copy h2 {
        max-width: 24ch;
        font: 660 clamp(2rem, 2.45vw, 2.75rem) / 1 var(--sans);
        letter-spacing: -0.04em;
      }

      .featured-story__copy h2 a {
        text-decoration: none;
      }

      .featured-story__copy h2 a:hover {
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.14em;
      }

      .featured-story__copy p {
        max-width: 48rem;
        margin-top: 0.5rem;
        color: var(--muted);
        font: 420 clamp(0.92rem, 1vw, 1rem) / 1.48 var(--sans);
      }

      .feature-rail {
        min-width: 0;
        min-height: 100%;
        padding: clamp(1.35rem, 2vw, 1.8rem);
        display: flex;
        flex-direction: column;
        background: var(--accent);
        color: #fff;
      }

      .feature-rail__signup {
        min-width: 0;
      }

      .feature-rail :global(.newsletter-signup__copy h2) {
        color: #fff;
      }

      .feature-rail__latest {
        margin-top: clamp(1.35rem, 2vw, 1.8rem);
        padding-top: clamp(1.35rem, 2vw, 1.8rem);
        border-top: 1px solid rgba(255, 255, 255, 0.34);
      }

      .feature-rail__latest-label,
      .feature-rail__latest h3,
      .feature-rail__latest p {
        margin: 0;
      }

      .feature-rail__latest-label {
        color: rgba(255, 255, 255, 0.72);
        font: 650 0.66rem/1 var(--sans);
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .feature-rail__latest h3 {
        max-width: 24ch;
        margin-top: 0.55rem;
        font: 650 clamp(1.2rem, 1.45vw, 1.5rem) / 1.08 var(--sans);
        letter-spacing: -0.025em;
      }

      .feature-rail__latest > p:not(.feature-rail__latest-label) {
        max-width: 34rem;
        margin-top: 0.55rem;
        color: rgba(255, 255, 255, 0.76);
        font: 420 0.84rem/1.48 var(--sans);
      }

      .feature-rail__latest a {
        display: inline-flex;
        gap: 0.35rem;
        margin-top: 0.9rem;
        color: #fff;
        font: 620 0.8rem/1.2 var(--sans);
        text-decoration: none;
      }

      .feature-rail__latest a:hover {
        text-decoration: underline;
        text-underline-offset: 0.18em;
      }

      .news-section {
        padding: clamp(2.5rem, 4.7vw, 4.7rem) 0 clamp(3.25rem, 6vw, 6rem);
        border-top: 1px solid var(--line);
      }

      .news-section__heading {
        padding-bottom: 0.8rem;
        display: flex;
        justify-content: space-between;
        gap: 2rem;
        align-items: end;
        border-bottom: 1px solid var(--ink);
      }

      .news-section__heading h2,
      .fixture-warning {
        margin: 0;
      }

      .news-section__heading h2 {
        font: 680 clamp(2rem, 3.1vw, 3.35rem) / 0.96 var(--sans);
        letter-spacing: -0.045em;
      }

      .fixture-warning {
        max-width: 19rem;
        color: var(--muted);
        font: 520 0.7rem/1.35 var(--sans);
        text-align: right;
      }

      .news-grid {
        padding-top: clamp(1.25rem, 2.4vw, 2.2rem);
        display: grid;
        grid-template-columns: minmax(0, 1.7fr) minmax(18rem, 0.8fr);
        gap: clamp(1.5rem, 3.5vw, 3.5rem);
        align-items: start;
      }

      .news-empty {
        margin: 0;
        padding-top: clamp(1.25rem, 2.4vw, 2.2rem);
        color: var(--muted);
        font: 420 0.9rem/1.5 var(--sans);
      }

      .lead-news h3,
      .news-list__item h3,
      .lead-news p,
      .news-list__item p,
      .news-meta {
        margin: 0;
      }

      .news-image-placeholder {
        aspect-ratio: 16 / 8.6;
        margin-bottom: 1rem;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        background: var(--paper-soft);
        border-top: 3px solid var(--accent);
        color: var(--muted);
      }

      .news-image-placeholder span {
        color: var(--ink);
        font: 620 clamp(1.3rem, 2vw, 2rem) / 1 var(--sans);
        letter-spacing: -0.025em;
      }

      .news-image-placeholder small {
        font: 540 0.65rem/1.2 var(--sans);
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .news-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem 0.8rem;
        color: var(--muted);
        font: 550 0.64rem/1.2 var(--sans);
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      .news-meta span:first-child {
        color: var(--accent);
      }

      .lead-news h3 {
        max-width: 20ch;
        margin-top: 0.55rem;
        font: 670 clamp(2rem, 3.3vw, 3.55rem) / 0.98 var(--sans);
        letter-spacing: -0.048em;
      }

      .lead-news > p {
        max-width: 48rem;
        margin-top: 0.75rem;
        color: var(--muted);
        font: 420 clamp(0.95rem, 1.1vw, 1.06rem) / 1.55 var(--sans);
      }

      .news-list {
        border-top: 1px solid var(--line);
      }

      .news-list__item {
        padding: 1rem 0 1.15rem;
        border-bottom: 1px solid var(--line);
      }

      .news-list__item h3 {
        max-width: 28ch;
        margin-top: 0.45rem;
        font: 650 clamp(1.2rem, 1.55vw, 1.55rem) / 1.08 var(--sans);
        letter-spacing: -0.03em;
      }

      .news-list__item p {
        margin-top: 0.55rem;
        color: var(--muted);
        font: 420 0.84rem/1.5 var(--sans);
      }

      .footer-newsletter {
        width: 100%;
        background: var(--ink);
        color: #fff;
        border-bottom: 1px solid rgba(255, 255, 255, 0.14);
      }

      .footer-newsletter__inner {
        padding: clamp(2.2rem, 4vw, 3.8rem) 0;
      }

      .footer-newsletter :global(.newsletter-signup__copy h2) {
        color: #fff;
      }

      .footer-newsletter :global(.newsletter-signup__copy p),
      .footer-newsletter :global(.newsletter-signup__note),
      .footer-newsletter :global(.newsletter-signup__status) {
        color: rgba(255, 255, 255, 0.68);
      }

      .footer-newsletter :global(.newsletter-signup input) {
        border-color: rgba(255, 255, 255, 0.45);
        background: rgba(255, 255, 255, 0.07);
        color: #fff;
      }

      .footer-newsletter :global(.newsletter-signup input::placeholder) {
        color: rgba(255, 255, 255, 0.55);
      }

      .footer-newsletter :global(.newsletter-signup__status[data-state="success"]) {
        color: #8fc7ff;
      }

      .footer-newsletter :global(.newsletter-signup__status[data-state="error"]) {
        color: #ffc2b8;
      }

      @media (max-width: 64rem) {
        .newsletter-band__inner {
          grid-template-columns: minmax(0, 1fr) minmax(19rem, 0.85fr);
          gap: 2rem;
        }

        .newsletter-band__copy h1 {
