        .latest-story--lead, .latest-story--compact { padding-right: 0; padding-bottom: 2.5rem; border-bottom: 1px solid var(--line); }
        .latest-story--lead h2 { max-width: none; font-size: clamp(2.3rem, 9vw, 3.35rem); }
        .latest-story--compact h2 { font-size: clamp(1.75rem, 7vw, 2.4rem); }

        .institution { display: block; padding-top: 4rem; padding-bottom: 4.25rem; }
