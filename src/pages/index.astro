---
import { getCollection } from "astro:content";
import SiteHead from "../components/SiteHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
import { DEV_NEWS_FIXTURES } from "../data/devNewsFixtures";

const publishedEntries = await getCollection(
  "stories",
  ({ data }) => data.status === "published",
);

const storiesByDate = publishedEntries
  .filter(({ data }) => data.section === "stories")
  .sort(
    (a, b) =>
      (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0),
  );

const newsByDate = publishedEntries
  .filter(({ data }) => data.section === "news")
  .sort(
    (a, b) =>
      (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0),
  );

const featureStory =
  storiesByDate.find(({ data }) => data.featured) ?? storiesByDate[0];

const formatLabel = (value: string) => value.replaceAll("-", " ");
const dateFormatter = new Intl.DateTimeFormat("en-PH", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});
const formatDate = (date?: Date) => (date ? dateFormatter.format(date) : "");

const realNews = newsByDate.map((story) => ({
  topic: story.data.topic,
  time: formatDate(story.data.publishedAt),
  title: story.data.title,
  dek: story.data.dek,
  href: `/news/${story.id}`,
  image: story.data.image,
  fixture: false as const,
}));

const devNews = import.meta.env.DEV && realNews.length === 0
  ? DEV_NEWS_FIXTURES.map((item) => ({
      ...item,
      href: undefined,
      fixture: true as const,
    }))
  : [];

const newsItems = realNews.length > 0 ? realNews : devNews;
const leadNews = newsItems[0];
const usingDevNews = devNews.length > 0;

const tickerItems = newsItems.map((item) => ({
  label: item.topic,
  title: item.title,
  href: item.href,
}));

const devStory = import.meta.env.DEV
  ? {
      title: "AI was supposed to kill Philippine BPO. So why is it still growing?",
      dek: "Development-only story teaser used to test the deeper Stories rail and headline hierarchy.",
    }
  : undefined;

const railStory =
  devStory ??
  storiesByDate
    .filter((story) => story.id !== featureStory?.id)
    .map((story) => ({
      title: story.data.title,
      dek: story.data.dek,
    }))[0];
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      title="Portfilo | Business and Technology News"
      description="The latest news on companies, startups, products, markets, AI, and technology."
    />
  </head>
  <body class="home-page">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader />

    <main id="main-content" tabindex="-1">
      <section class="newsletter-band" id="newsletter" aria-labelledby="newsletter-title">
        <div class="newsletter-band__inner">
          <div class="newsletter-band__copy">
            <h1 id="newsletter-title">Get ahead in business and tech in 7 minutes.</h1>
            <p>
              The latest news on companies, startups, products, markets, AI, and technology.
              Three times a week, straight to your inbox.
            </p>
          </div>

          <div class="newsletter-band__form">
            <NewsletterSignup
              id="home-hero-newsletter"
              variant="hero"
              showCopy={false}
              buttonLabel="Send me the news"
            />
          </div>
        </div>
      </section>

      {
        tickerItems.length > 0 && (
          <section class="latest-strip" id="latest" aria-label="Latest news from Portfilo">
            <div class="latest-strip__label">
              <strong>Latest news</strong>
            </div>
            <div
              class="latest-strip__rail"
              tabindex="0"
              aria-label="Latest news headlines"
              data-latest-rail
              data-auto-ticker={tickerItems.length > 1 ? "true" : "false"}
            >
              <div class="latest-strip__track" data-latest-track>
                <div class="latest-strip__group" data-latest-group>
                  {tickerItems.map((item) =>
                    item.href ? (
                      <a class="latest-strip__item" href={item.href}>
                        <span>{formatLabel(item.label)}</span>
                        <strong>{item.title}</strong>
                      </a>
                    ) : (
                      <span class="latest-strip__item">
                        <span>{formatLabel(item.label)}</span>
                        <strong>{item.title}</strong>
                      </span>
                    ),
                  )}
                </div>

                {tickerItems.length > 1 && (
                  <div class="latest-strip__group latest-strip__group--duplicate" aria-hidden="true">
                    {tickerItems.map((item) =>
                      item.href ? (
                        <a class="latest-strip__item" href={item.href} tabindex="-1">
                          <span>{formatLabel(item.label)}</span>
                          <strong>{item.title}</strong>
                        </a>
                      ) : (
                        <span class="latest-strip__item">
                          <span>{formatLabel(item.label)}</span>
                          <strong>{item.title}</strong>
                        </span>
                      ),
                    )}
                  </div>
                )}
              </div>
            </div>
          </section>
        )
      }

      {
        featureStory && (
          <section class="featured-section" aria-label="Featured story">
            <div class="featured-pair">
              <article class="featured-story">
                {featureStory.data.image && (
                  <a
                    class="featured-story__media"
                    href={`/stories/${featureStory.id}`}
                    aria-label={`Read ${featureStory.data.title}`}
                  >
                    <img
                      src={featureStory.data.image.src}
                      width="1600"
                      height="900"
                      alt={featureStory.data.image.alt}
                      loading="eager"
                      decoding="async"
                    />
                    {featureStory.data.image.generated && (
                      <span class="featured-story__disclosure">AI-generated editorial image</span>
                    )}
                  </a>
                )}

                <div class="featured-story__copy">
                  <h2>
                    <a href={`/stories/${featureStory.id}`}>{featureStory.data.title}</a>
                  </h2>
                  <p>{featureStory.data.dek}</p>
                </div>
              </article>

              <aside class="feature-rail" aria-label="Portfilo newsletter and stories">
                <div class="feature-rail__signup">
                  <NewsletterSignup
                    id="home-feature-newsletter"
                    heading="There's more to it than the headline."
                    copy="Who made the move, what changed, and the details behind it."
                    variant="card"
                    buttonLabel="Subscribe"
                  />
                </div>

                <div class="feature-rail__latest">
                  <p class="feature-rail__latest-label">Stories</p>
                  {
                    railStory ? (
                      <>
                        <h3>{railStory.title}</h3>
                        <p>{railStory.dek}</p>
                      </>
                    ) : (
                      <p class="feature-rail__latest-empty">No additional stories published yet.</p>
                    )
                  }
                  <a href="/stories">Read more stories <span aria-hidden="true">→</span></a>
                </div>
              </aside>
            </div>
          </section>
        )
      }

      <section class="news-section" id="news" aria-labelledby="news-section-title">
        <header class="news-section__heading">
          <h2 id="news-section-title">News</h2>
          {usingDevNews && (
            <p class="fixture-warning">Development fixtures only. Not Portfilo reporting.</p>
          )}
        </header>

        {
          leadNews ? (
            <div class="news-grid">
              <article class="lead-news">
                {leadNews.image && (
                  leadNews.href ? (
                    <a class="news-image" href={leadNews.href} aria-label={`Read ${leadNews.title}`}>
                      <img
                        src={leadNews.image.src}
                        alt={leadNews.image.alt}
                        width="1600"
                        height="900"
                        loading="lazy"
                        decoding="async"
                      />
                      {leadNews.image.generated && (
                        <span class="news-image__disclosure">AI-generated editorial image</span>
                      )}
                    </a>
                  ) : (
                    <div class="news-image">
                      <img
                        src={leadNews.image.src}
                        alt={leadNews.image.alt}
                        width="1600"
                        height="900"
                        loading="lazy"
                        decoding="async"
                      />
                      {leadNews.image.generated && (
                        <span class="news-image__disclosure">AI-generated editorial image</span>
                      )}
                    </div>
                  )
                )}
                <div class="news-meta">
                  <span>{leadNews.topic}</span>
                  <span>{leadNews.time}</span>
                </div>
                <h3>{leadNews.href ? <a href={leadNews.href}>{leadNews.title}</a> : leadNews.title}</h3>
                <p>{leadNews.dek}</p>
              </article>

              <div class="news-list">
                {newsItems.slice(1, 5).map((item) => (
                  <article class="news-list__item">
                    <div class="news-meta">
                      <span>{item.topic}</span>
                      <span>{item.time}</span>
                    </div>
                    <h3>{item.href ? <a href={item.href}>{item.title}</a> : item.title}</h3>
                    <p>{item.dek}</p>
                  </article>
                ))}
              </div>
            </div>
          ) : (
            <p class="news-empty">No published News items yet.</p>
          )
        }
      </section>
    </main>

    <SiteFooter />

    <script is:inline>
      (() => {
        const rail = document.querySelector("[data-latest-rail]");
        const track = rail?.querySelector("[data-latest-track]");
        const group = rail?.querySelector("[data-latest-group]");

        if (
          !(rail instanceof HTMLElement) ||
          !(track instanceof HTMLElement) ||
          !(group instanceof HTMLElement)
        ) return;

        const SPEED_PX_PER_SECOND = 30;
        const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
        const canRequestLoop = rail.dataset.autoTicker === "true";

        let tickerAnimation = null;
        let resumeTimer = 0;
        let resizeFrame = 0;
        let isHovering = false;
        let isFocused = false;
        let isPointerDown = false;

        const clearResumeTimer = () => {
          if (resumeTimer) window.clearTimeout(resumeTimer);
          resumeTimer = 0;
        };

        const getAnimationDuration = () => {
          const timing = tickerAnimation?.effect?.getComputedTiming?.();
          return typeof timing?.duration === "number" ? timing.duration : 0;
        };

        const getVisualOffset = () => {
          const width = group.scrollWidth;
          const duration = getAnimationDuration();
          const currentTime = Number(tickerAnimation?.currentTime ?? 0);

          if (!tickerAnimation || width <= 0 || duration <= 0) {
            return rail.scrollLeft;
          }

          const phase = ((currentTime % duration) / duration) * width;
          return phase + rail.scrollLeft;
        };

        const pauseTicker = () => {
          tickerAnimation?.pause();
        };

        const normalizeAndPlay = () => {
          if (
            !tickerAnimation ||
            motionQuery.matches ||
            isHovering ||
            isFocused ||
            isPointerDown
          ) return;

          const width = group.scrollWidth;
          const duration = getAnimationDuration();
          if (width <= 0 || duration <= 0) return;

          const offset = ((getVisualOffset() % width) + width) % width;
          tickerAnimation.pause();
          rail.scrollLeft = 0;
          tickerAnimation.currentTime = (offset / width) * duration;
          tickerAnimation.play();
        };

        const scheduleResume = (delay = 900) => {
          clearResumeTimer();
          resumeTimer = window.setTimeout(() => {
            resumeTimer = 0;
            normalizeAndPlay();
          }, delay);
        };

        const setupTicker = () => {
          clearResumeTimer();
          const previousOffset = getVisualOffset();

          tickerAnimation?.cancel();
          tickerAnimation = null;
          rail.classList.remove("is-looping");
          track.style.transform = "";

          const width = group.scrollWidth;
          const canLoop =
            canRequestLoop &&
            !motionQuery.matches &&
            width > rail.clientWidth;

          if (!canLoop) {
            rail.scrollLeft = 0;
            return;
          }

          rail.classList.add("is-looping");
          const duration = Math.max(1, (width / SPEED_PX_PER_SECOND) * 1000);
          const offset = ((previousOffset % width) + width) % width;

          tickerAnimation = track.animate(
            [
              { transform: "translate3d(0, 0, 0)" },
              { transform: `translate3d(-${width}px, 0, 0)` },
            ],
            {
              duration,
              iterations: Infinity,
              easing: "linear",
            },
          );

          rail.scrollLeft = 0;
          tickerAnimation.currentTime = (offset / width) * duration;

          if (isHovering || isFocused || isPointerDown) {
            tickerAnimation.pause();
          }
        };

        rail.addEventListener("mouseenter", () => {
          isHovering = true;
          clearResumeTimer();
          pauseTicker();
        });

        rail.addEventListener("mouseleave", () => {
          isHovering = false;
          scheduleResume(350);
        });

        rail.addEventListener("focusin", () => {
          isFocused = true;
          clearResumeTimer();
          pauseTicker();
        });

        rail.addEventListener("focusout", () => {
          requestAnimationFrame(() => {
            isFocused = rail.contains(document.activeElement);
            if (!isFocused) scheduleResume(500);
          });
        });

        rail.addEventListener("pointerdown", () => {
          isPointerDown = true;
          clearResumeTimer();
          pauseTicker();
        });

        const releasePointer = () => {
          isPointerDown = false;
          scheduleResume(1400);
        };

        rail.addEventListener("pointerup", releasePointer);
        rail.addEventListener("pointercancel", releasePointer);
        rail.addEventListener(
          "wheel",
          () => {
            pauseTicker();
            scheduleResume(1400);
          },
          { passive: true },
        );
        rail.addEventListener(
          "scroll",
          () => {
            if (
              tickerAnimation?.playState === "paused" &&
              !isHovering &&
              !isFocused &&
              !isPointerDown
            ) {
              scheduleResume(900);
            }
          },
          { passive: true },
        );

        window.addEventListener("resize", () => {
          cancelAnimationFrame(resizeFrame);
          resizeFrame = requestAnimationFrame(setupTicker);
        });
        motionQuery.addEventListener?.("change", setupTicker);

        setupTicker();

        window.addEventListener(
          "pagehide",
          () => {
            clearResumeTimer();
            cancelAnimationFrame(resizeFrame);
            tickerAnimation?.cancel();
          },
          { once: true },
        );
      })();
    </script>

    <style>
      @font-face {
        font-family: "Instrument Sans";
        font-style: normal;
        font-display: swap;
        font-weight: 400 700;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/instrument-sans:vf@5.3.0/latin-wght-normal.woff2") format("woff2-variations");
      }

      @font-face {
        font-family: "Source Serif 4";
        font-style: normal;
        font-display: swap;
        font-weight: 200 900;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/source-serif-4:vf@5.3.0/latin-wght-normal.woff2") format("woff2-variations");
      }

      @font-face {
        font-family: "IBM Plex Mono";
        font-style: normal;
        font-display: swap;
        font-weight: 400;
        src: url("https://cdn.jsdelivr.net/fontsource/fonts/ibm-plex-mono@5.3.0/latin-400-normal.woff2") format("woff2");
      }

      :global(:root) {
        --paper: #f8f6f1;
        --paper-soft: #efebe3;
        --ink: #171614;
        --muted: #68645e;
        --line: #d4cfc6;
        --line-strong: #aaa39a;
        --accent: #0050a4;
        --correction: #b42318;
        --page-max: 100rem;
        --content-max: 84rem;
        --shell-gutter: clamp(1.25rem, 2.6vw, 2rem);
        --gutter: var(--shell-gutter);
        --grid-gap: clamp(1rem, 1.8vw, 1.75rem);
        --signup-control-max: 28rem;
        --home-editorial-headline-size: clamp(2rem, 2.45vw, 2.75rem);
        --sans: "Instrument Sans", "Helvetica Neue", Arial, sans-serif;
        --serif: "Source Serif 4", Georgia, serif;
        --mono: "IBM Plex Mono", "Courier New", monospace;
      }

      :global(*) { box-sizing: border-box; }
      :global(html) {
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
        font-synthesis: none;
      }
      :global(body) { margin: 0; min-width: 0; background: var(--paper); }
      :global(a) { color: inherit; }
      :global(a:focus-visible) { outline: 3px solid var(--accent); outline-offset: 4px; }
      :global(main:focus) { outline: none; }

      .skip-link {
        position: fixed;
        z-index: 50;
        top: 0.75rem;
        left: 0.75rem;
        padding: 0.7rem 0.85rem;
        background: var(--ink);
        color: var(--paper);
        font: 550 0.75rem/1 var(--sans);
        text-decoration: none;
        transform: translateY(-200%);
      }
      .skip-link:focus { transform: translateY(0); }

      .newsletter-band {
        width: 100%;
        background: var(--accent);
        color: #fff;
      }

      .newsletter-band__inner,
      .featured-section,
      .news-section {
        width: min(calc(100% - (2 * var(--shell-gutter))), var(--content-max));
        margin-inline: auto;
      }

      .newsletter-band__inner {
        padding: clamp(1.45rem, 2vw, 1.85rem) 0;
        display: grid;
        grid-template-columns: minmax(0, 52rem) minmax(19rem, 1fr);
        gap: clamp(2rem, 2.7vw, 2.5rem);
        align-items: center;
      }

      .newsletter-band__copy h1 {
        max-width: 17ch;
        margin: 0;
        color: #fff;
        font: 680 clamp(2.15rem, 2.65vw, 2.8rem) / 0.98 var(--sans);
        letter-spacing: -0.045em;
        text-wrap: balance;
      }

      .newsletter-band__copy p {
        max-width: 43rem;
        margin: 0.65rem 0 0;
        color: rgba(255, 255, 255, 0.8);
        font: 440 clamp(0.9rem, 1vw, 1rem) / 1.45 var(--sans);
      }

      .newsletter-band__form {
        width: 100%;
        max-width: none;
        min-width: 0;
        justify-self: stretch;
      }

      .newsletter-band__form :global(.newsletter-signup__row) {
        grid-template-columns: 1fr;
        gap: 0.55rem;
        max-width: none;
      }

      .newsletter-band__form :global(.newsletter-signup input) {
        border: 1px solid rgba(255, 255, 255, 0.42);
        background: rgba(255, 255, 255, 0.08);
        color: #fff;
      }

      .newsletter-band__form :global(.newsletter-signup input::placeholder) {
        color: rgba(255, 255, 255, 0.68);
      }

      .newsletter-band__form :global(.newsletter-signup button) {
        width: 100%;
        border-color: var(--paper);
        background: var(--paper);
        color: var(--accent);
      }

      .newsletter-band__form :global(.newsletter-signup button:hover) {
        filter: none;
        background: rgba(248, 246, 241, 0.9);
      }

      .newsletter-band__form :global(.newsletter-signup input:focus-visible),
      .newsletter-band__form :global(.newsletter-signup button:focus-visible),
      .feature-rail :global(.newsletter-signup input:focus-visible),
      .feature-rail :global(.newsletter-signup button:focus-visible) {
        outline-color: #fff;
      }

      .newsletter-band__form :global(.newsletter-signup__note),
      .newsletter-band__form :global(.newsletter-signup__status) {
        color: rgba(255, 255, 255, 0.72);
      }

      .newsletter-band__form :global(.newsletter-signup__status[data-state="success"]) {
        color: #fff;
      }

      .newsletter-band__form :global(.newsletter-signup__status[data-state="error"]) {
        color: #ffe1dc;
      }

      .latest-strip {
        width: 100%;
        min-height: 2.35rem;
        margin: 0 0 1rem;
        display: flex;
        background: var(--paper);
        color: var(--ink);
        border-bottom: 1px solid var(--line);
        overflow: hidden;
      }

      .latest-strip__label {
        position: relative;
        z-index: 2;
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        padding: 0.56rem clamp(0.9rem, 1.9vw, 1.35rem);
        background: var(--ink);
        color: #fff;
        font: 680 0.61rem/1 var(--sans);
        letter-spacing: 0.075em;
        text-transform: uppercase;
        white-space: nowrap;
      }

      .latest-strip__rail {
        flex: 1 1 auto;
        min-width: 0;
        overflow-x: auto;
        overscroll-behavior-inline: contain;
        scrollbar-width: none;
        scroll-behavior: auto;
      }
      .latest-strip__rail::-webkit-scrollbar { display: none; }
      .latest-strip__rail:focus-visible { outline-offset: -3px; }

      .latest-strip__track {
        width: max-content;
        min-width: 100%;
        display: flex;
        align-items: stretch;
        transform: translate3d(0, 0, 0);
      }

      .latest-strip__rail.is-looping .latest-strip__track {
        will-change: transform;
      }

      .latest-strip__group {
        flex: 0 0 auto;
        display: flex;
        align-items: stretch;
      }

      .latest-strip__group--duplicate {
        display: none;
      }

      .latest-strip__rail.is-looping .latest-strip__group--duplicate {
        display: flex;
      }

      .latest-strip__item {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.54rem clamp(0.9rem, 1.6vw, 1.35rem);
        border-right: 1px solid var(--line);
        color: var(--ink);
        text-decoration: none;
        white-space: nowrap;
      }

      .latest-strip__item > span {
        color: var(--accent);
        font: 650 0.59rem/1 var(--sans);
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      .latest-strip__item > strong {
        max-width: 34rem;
        overflow: hidden;
        font: 520 0.72rem/1.2 var(--sans);
        text-overflow: ellipsis;
      }

      a.latest-strip__item:hover strong {
        text-decoration: underline;
        text-underline-offset: 0.18em;
      }

      .featured-section {
        padding: 0 0 clamp(1.5rem, 2.5vw, 2.25rem);
      }

      .featured-pair {
        display: grid;
        grid-template-columns: minmax(0, 52rem) minmax(19rem, 1fr);
        gap: clamp(2rem, 2.7vw, 2.5rem);
        align-items: stretch;
      }

      .featured-story { min-width: 0; }

      .featured-story__media {
        position: relative;
        display: block;
        width: 100%;
        max-width: 52rem;
        overflow: hidden;
        border-top: 3px solid var(--accent);
        background: var(--paper-soft);
        line-height: 0;
      }

      .featured-story__media img {
        display: block;
        width: 100%;
        height: auto;
        filter: grayscale(1);
      }

      .featured-story__disclosure,
      .news-image__disclosure {
        position: absolute;
        right: 0.65rem;
        bottom: 0.6rem;
        padding: 0.27rem 0.36rem;
        background: rgba(23, 22, 20, 0.78);
        color: #fff;
        font: 520 0.57rem/1 var(--sans);
        letter-spacing: 0.035em;
      }

      .featured-story__copy { padding-top: 0.78rem; }

      .featured-story__copy h2,
      .featured-story__copy p { margin: 0; }

      .featured-story__copy h2 {
        max-width: 24ch;
        font: 660 var(--home-editorial-headline-size) / 1 var(--sans);
        letter-spacing: -0.04em;
      }

      .featured-story__copy h2 a { text-decoration: none; }

      .featured-story__copy h2 a:hover {
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.14em;
      }

      .featured-story__copy p {
        max-width: 48rem;
        margin-top: 0.5rem;
        color: var(--muted);
        font: 420 clamp(0.92rem, 1vw, 1rem) / 1.48 var(--sans);
      }

      .feature-rail {
        min-width: 0;
        min-height: 100%;
        padding: clamp(1.35rem, 2vw, 1.8rem);
        display: flex;
        flex-direction: column;
        background: var(--accent);
        color: #fff;
      }

      .feature-rail__signup { min-width: 0; }
      .feature-rail :global(.newsletter-signup__copy h2) { color: #fff; }

      .feature-rail__latest {
        margin-top: clamp(1.35rem, 2vw, 1.8rem);
        padding-top: clamp(1.35rem, 2vw, 1.8rem);
        border-top: 1px solid rgba(255, 255, 255, 0.34);
      }

      .feature-rail__latest-label,
      .feature-rail__latest h3,
      .feature-rail__latest p { margin: 0; }

      .feature-rail__latest-label {
        color: rgba(255, 255, 255, 0.72);
        font: 650 0.66rem/1 var(--sans);
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .feature-rail__latest h3 {
        max-width: 24ch;
        margin-top: 0.55rem;
        font: 650 clamp(1.2rem, 1.45vw, 1.5rem) / 1.08 var(--sans);
        letter-spacing: -0.025em;
      }

      .feature-rail__latest > p:not(.feature-rail__latest-label) {
        max-width: 34rem;
        margin-top: 0.55rem;
        color: rgba(255, 255, 255, 0.76);
        font: 420 0.84rem/1.48 var(--sans);
      }

      .feature-rail__latest a {
        display: inline-flex;
        gap: 0.35rem;
        margin-top: 0.9rem;
        color: #fff;
        font: 620 0.8rem/1.2 var(--sans);
        text-decoration: none;
      }

      .feature-rail__latest a:hover {
        text-decoration: underline;
        text-underline-offset: 0.18em;
      }

      .news-section {
        padding: clamp(2.5rem, 4.7vw, 4.7rem) 0 clamp(3.25rem, 6vw, 6rem);
        border-top: 1px solid var(--line);
      }

      .news-section__heading {
        padding-bottom: 0.8rem;
        display: flex;
        justify-content: space-between;
        gap: 2rem;
        align-items: end;
        border-bottom: 1px solid var(--ink);
      }

      .news-section__heading h2,
      .fixture-warning { margin: 0; }

      .news-section__heading h2 {
        font: 680 var(--home-editorial-headline-size) / 1 var(--sans);
        letter-spacing: -0.04em;
      }

      .fixture-warning {
        max-width: 19rem;
        color: var(--muted);
        font: 520 0.7rem/1.35 var(--sans);
        text-align: right;
      }

      .news-grid {
        padding-top: clamp(1.25rem, 2.4vw, 2.2rem);
        display: grid;
        grid-template-columns: minmax(0, 52rem) minmax(19rem, 1fr);
        gap: clamp(2rem, 2.7vw, 2.5rem);
        align-items: start;
      }

      .news-empty {
        margin: 0;
        padding-top: clamp(1.25rem, 2.4vw, 2.2rem);
        color: var(--muted);
        font: 420 0.9rem/1.5 var(--sans);
      }

      .lead-news h3,
      .news-list__item h3,
      .lead-news p,
      .news-list__item p,
      .news-meta { margin: 0; }

      .news-image {
        position: relative;
        aspect-ratio: 16 / 9;
        margin-bottom: 1rem;
        display: block;
        overflow: hidden;
        background: var(--paper-soft);
        border-top: 3px solid var(--accent);
        line-height: 0;
      }

      .news-image img {
        display: block;
        width: 100%;
        height: auto;
      }

      .news-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem 0.8rem;
        color: var(--muted);
        font: 550 0.64rem/1.2 var(--sans);
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      .news-meta span:first-child { color: var(--accent); }

      .lead-news h3 {
        max-width: 24ch;
        margin-top: 0.55rem;
        font: 660 var(--home-editorial-headline-size) / 1 var(--sans);
        letter-spacing: -0.04em;
      }

      .lead-news h3 a,
      .news-list__item h3 a { text-decoration: none; }

      .lead-news h3 a:hover,
      .news-list__item h3 a:hover {
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.14em;
      }

      .lead-news > p {
        max-width: 48rem;
        margin-top: 0.75rem;
        color: var(--muted);
        font: 420 clamp(0.95rem, 1.1vw, 1.06rem) / 1.55 var(--sans);
      }

      .news-list { border-top: 1px solid var(--line); }

      .news-list__item {
        padding: 1rem 0 1.15rem;
        border-bottom: 1px solid var(--line);
      }

      .news-list__item h3 {
        max-width: 28ch;
        margin-top: 0.45rem;
        font: 650 clamp(1.2rem, 1.55vw, 1.55rem) / 1.08 var(--sans);
        letter-spacing: -0.03em;
      }

      .news-list__item p {
        margin-top: 0.55rem;
        color: var(--muted);
        font: 420 0.84rem/1.5 var(--sans);
      }

      @media (max-width: 64rem) {
        .newsletter-band__inner {
          grid-template-columns: 1fr;
          gap: 1.2rem;
        }

        .newsletter-band__copy h1 {
          font-size: clamp(1.95rem, 3.6vw, 2.3rem);
        }

        .newsletter-band__form {
          width: 100%;
          justify-self: stretch;
        }

        .featured-pair,
        .news-grid {
          grid-template-columns: 1fr;
        }

        .feature-rail { min-height: 0; }

        .feature-rail__latest {
          margin-top: clamp(1.5rem, 4vw, 2rem);
        }
      }

      @media (max-width: 52rem) {
        .fixture-warning { max-width: 14rem; }
      }

      @media (max-width: 48rem) {
        .newsletter-band__copy h1 {
          font-size: clamp(1.85rem, 5.4vw, 2.05rem);
        }

        .newsletter-band__copy p {
          font-size: clamp(0.85rem, 2.1vw, 0.9rem);
        }
      }

      @media (max-width: 36rem) {
        :global(:root) { --shell-gutter: 1.1rem; }

        .newsletter-band__inner {
          padding-top: 1.25rem;
          padding-bottom: 1.35rem;
        }

        .newsletter-band__copy h1 {
          max-width: 18ch;
          font-size: clamp(1.75rem, 7.7vw, 2rem);
        }

        .latest-strip { margin-bottom: 0.75rem; }
        .latest-strip__label { padding-inline: 0.76rem; }

        .latest-strip__item {
          max-width: 84vw;
          padding-inline: 0.82rem;
        }

        .latest-strip__item > strong { max-width: 62vw; }

        .featured-section { padding-top: 0; }
        .feature-rail { padding: 1.25rem; }
        .news-section__heading { align-items: start; }
        .fixture-warning { font-size: 0.62rem; }
      }

      @media (max-width: 23rem) {
        :global(:root) { --shell-gutter: 1rem; }
      }
    </style>
  </body>
</html>
