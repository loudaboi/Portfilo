---
import { getCollection, render } from "astro:content";
import SiteHead from "../../components/SiteHead.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import EditorialArticle from "../../components/EditorialArticle.astro";
import { DEV_EDITORIAL_IMAGE } from "../../data/devEditorialImage";

export async function getStaticPaths() {
  const news = await getCollection(
    "stories",
    ({ data }) =>
      data.section === "news" && (data.status === "published" || import.meta.env.DEV),
  );

  return news.map((story) => ({
    params: { slug: story.id },
    props: { story },
  }));
}

const { story } = Astro.props;
const {
  title,
  dek,
  metaDescription,
  topic,
  author,
  publishedAt,
  updatedAt,
  image,
  methodology,
  correction,
  status,
} = story.data;
const { Content } = await render(story);

const dateFormatter = new Intl.DateTimeFormat("en-PH", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});

const formatDate = (date: Date) => dateFormatter.format(date);
const formatLabel = (value: string) => value.replaceAll("-", " ");
const authorHref = author === "Louda Tuppal" ? "/about#louda-tuppal" : undefined;
const pageDescription = metaDescription ?? dek;
const displayImage = image ?? (import.meta.env.DEV ? DEV_EDITORIAL_IMAGE : undefined);

const classification = [
  "News",
  formatLabel(topic),
  ...(publishedAt ? [formatDate(publishedAt)] : []),
  ...(import.meta.env.DEV && status === "draft" ? ["Draft"] : []),
];

const metadata = [
  { label: "Author", value: author, href: authorHref },
  ...(updatedAt ? [{ label: "Updated", value: formatDate(updatedAt) }] : []),
];

const normalizedCorrection = correction
  ? {
      dateLabel: formatDate(correction.correctedAt),
      iso: correction.correctedAt.toISOString(),
      note: correction.note,
    }
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      title={`${title} | Portfilo`}
      description={pageDescription}
      article={{ author, authorUrl: authorHref, publishedAt, updatedAt }}
    />
  </head>
  <body class="editorial-page">
    <a class="skip-link" href="#article-body">Skip to news</a>
    <SiteHeader current="news" />

    <EditorialArticle
      mode="news"
      title={title}
      dek={dek}
      classification={classification}
      metadata={metadata}
      image={displayImage}
      methodology={methodology}
      correction={normalizedCorrection}
    >
      <Content />
    </EditorialArticle>

    <SiteFooter />
  </body>
</html>
