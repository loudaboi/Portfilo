---
import { getCollection, render } from "astro:content";
import SiteHead from "../../components/SiteHead.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import NewsletterSignup from "../../components/NewsletterSignup.astro";
import { DEV_EDITORIAL_IMAGE } from "../../data/devEditorialImage";

export async function getStaticPaths() {
  const news = await getCollection(
    "stories",
    ({ data }) =>
      data.section === "news" && (data.status === "published" || import.meta.env.DEV),
  );

  return news.map((story) => ({
    params: { slug: story.id },
    props: { story },
  }));
}

const { story } = Astro.props;
const {
  title,
  dek,
  metaDescription,
  topic,
  author,
  publishedAt,
  updatedAt,
  image,
  methodology,
  correction,
  status,
} = story.data;
const { Content } = await render(story);

const dateFormatter = new Intl.DateTimeFormat("en-PH", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});

const formatDate = (date: Date) => dateFormatter.format(date);
const formatLabel = (value: string) => value.replaceAll("-", " ");
const authorHref = author === "Louda Tuppal" ? "/about#louda-tuppal" : undefined;
const pageDescription = metaDescription ?? dek;
const displayImage = image ?? (import.meta.env.DEV ? DEV_EDITORIAL_IMAGE : undefined);
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      title={`${title} | Portfilo`}
      description={pageDescription}
      article={{ author, authorUrl: authorHref, publishedAt, updatedAt }}
    />
  </head>
  <body class="editorial-page">
    <a class="skip-link" href="#news-body">Skip to news</a>
    <SiteHeader current="news" />

    <main id="main-content">
      <article>
        <header class="news-header">
          <p class="news-classification">
            <span>{formatLabel(topic)}</span>
            {publishedAt && <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>}
            {import.meta.env.DEV && status === "draft" && <span>Draft</span>}
          </p>

          <h1>{title}</h1>
          <p class="news-dek">{dek}</p>

          <dl class="news-byline">
            <div>
              <dt>Author</dt>
              <dd>{authorHref ? <a href={authorHref}>{author}</a> : author}</dd>
            </div>
            {updatedAt && (
              <div>
                <dt>Updated</dt>
                <dd><time datetime={updatedAt.toISOString()}>{formatDate(updatedAt)}</time></dd>
              </div>
            )}
          </dl>
        </header>

        {displayImage && (
          <figure class="news-hero">
            <div class="news-hero__media">
              <img src={displayImage.src} alt={displayImage.alt} width="1600" height="900" decoding="async" />
              {displayImage.generated && <span class="image-disclosure">AI-generated editorial image</span>}
            </div>
            {displayImage.credit && <figcaption>{displayImage.credit}</figcaption>}
          </figure>
        )}

        <div class="news-body" id="news-body" tabindex="-1">
          <Content />
        </div>

        {(methodology || correction) && (
          <div class="news-notes">
            {methodology && (
              <section class="news-note" aria-labelledby="methodology-title">
                <h2 id="methodology-title">Methodology</h2>
                <p>{methodology}</p>
              </section>
            )}
            {correction && (
              <aside class="news-note news-note--correction" aria-labelledby="correction-title">
                <h2 id="correction-title">Correction</h2>
                <p>
                  <time datetime={correction.correctedAt.toISOString()}>{formatDate(correction.correctedAt)}</time>
                  <span aria-hidden="true"> · </span>
                  {correction.note}
                </p>
              </aside>
            )}
          </div>
        )}

        <section class="article-newsletter" aria-label="Subscribe to the Portfilo newsletter">
          <NewsletterSignup id={`news-${story.id}-newsletter`} variant="inline" />
        </section>
      </article>
    </main>

    <SiteFooter />

    <style>
      @font-face { font-family: "Instrument Sans"; font-style: normal; font-display: swap; font-weight: 400 700; src: url("https://cdn.jsdelivr.net/fontsource/fonts/instrument-sans:vf@5.3.0/latin-wght-normal.woff2") format("woff2-variations"); }
      @font-face { font-family: "Source Serif 4"; font-style: normal; font-display: swap; font-weight: 200 900; src: url("https://cdn.jsdelivr.net/fontsource/fonts/source-serif-4:vf@5.3.0/latin-wght-normal.woff2") format("woff2-variations"); }
      @font-face { font-family: "IBM Plex Mono"; font-style: normal; font-display: swap; font-weight: 400; src: url("https://cdn.jsdelivr.net/fontsource/fonts/ibm-plex-mono@5.3.0/latin-400-normal.woff2") format("woff2"); }

      :global(:root) {
        --paper: #f8f6f1;
        --paper-soft: #efebe3;
        --ink: #171614;
        --muted: #68645e;
        --line: #d4cfc6;
        --line-strong: #aaa39a;
        --accent: #0050a4;
        --correction: #b42318;
        --page-max: 84rem;
        --content-max: 84rem;
        --shell-gutter: clamp(1.25rem, 2.6vw, 2rem);
        --gutter: var(--shell-gutter);
        --sans: "Instrument Sans", "Helvetica Neue", Arial, sans-serif;
        --serif: "Source Serif 4", Georgia, serif;
        --mono: "IBM Plex Mono", "Courier New", monospace;
      }

      :global(*) { box-sizing: border-box; }
      :global(html) { background: var(--paper); color: var(--ink); font-family: var(--sans); font-synthesis: none; }
      :global(body) { margin: 0; min-width: 0; background: var(--paper); }
      :global(a) { color: inherit; }
      :global(a:focus-visible) { outline: 3px solid var(--accent); outline-offset: 4px; }
      :global(#news-body:focus) { outline: none; }

      .skip-link {
        position: fixed;
        z-index: 50;
        top: 0.75rem;
        left: 0.75rem;
        padding: 0.7rem 0.85rem;
        background: var(--ink);
        color: var(--paper);
        font: 550 0.75rem/1 var(--sans);
        text-decoration: none;
        transform: translateY(-200%);
      }
      .skip-link:focus { transform: translateY(0); }

      .news-header,
      .news-hero,
      .news-body,
      .news-notes,
      .article-newsletter {
        width: min(calc(100% - (2 * var(--shell-gutter))), var(--content-max));
        margin-inline: auto;
      }

      .news-header {
        padding: clamp(2.75rem, 5vw, 4.75rem) 0 clamp(1.8rem, 3.5vw, 3rem);
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: clamp(1rem, 1.8vw, 1.75rem);
      }

      .news-classification {
        grid-column: 1 / 3;
        align-self: start;
        margin: 0.35rem 0 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem 0.65rem;
        color: var(--muted);
        font: 570 0.65rem/1.3 var(--sans);
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      .news-classification span:first-child {
        color: var(--accent);
      }

      .news-classification > * + *::before {
        content: "/";
        margin-right: 0.65rem;
        color: var(--line-strong);
      }

      .news-header h1 {
        grid-column: 3 / 11;
        max-width: 19ch;
        margin: 0;
        font: 680 clamp(2.8rem, 5.6vw, 5.6rem) / 0.95 var(--sans);
        letter-spacing: -0.055em;
        text-wrap: balance;
        overflow-wrap: break-word;
      }

      .news-dek {
        grid-column: 4 / 10;
        max-width: 43rem;
        margin: clamp(1.2rem, 2.2vw, 1.9rem) 0 0;
        color: var(--muted);
        font: 440 clamp(1.05rem, 1.35vw, 1.25rem) / 1.5 var(--sans);
      }

      .news-byline {
        grid-column: 4 / 10;
        margin: clamp(1.4rem, 2.4vw, 2rem) 0 0;
        padding-top: 0.8rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.7rem clamp(1.25rem, 2.5vw, 2.4rem);
        border-top: 1px solid var(--line);
        font: 520 0.67rem/1.4 var(--sans);
      }

      .news-byline dt { color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; }
      .news-byline dd { margin: 0.18rem 0 0; }
      .news-byline a { text-underline-offset: 0.15em; }

      .news-hero {
        margin-bottom: clamp(2rem, 4vw, 3.5rem);
      }

      .news-hero__media {
        position: relative;
        width: min(100%, 60rem);
        margin-inline: auto;
        overflow: hidden;
        border-top: 3px solid var(--accent);
        background: var(--paper-soft);
        line-height: 0;
      }

      .news-hero img { display: block; width: 100%; height: auto; }

      .image-disclosure {
        position: absolute;
        right: 0.6rem;
        bottom: 0.55rem;
        padding: 0.27rem 0.36rem;
        background: rgba(23, 22, 20, 0.78);
        color: #fff;
        font: 520 0.57rem/1 var(--sans);
        letter-spacing: 0.035em;
      }

      .news-hero figcaption {
        width: min(100%, 60rem);
        margin: 0.5rem auto 0;
        color: var(--muted);
        font: 480 0.65rem/1.4 var(--sans);
      }

      .news-body {
        max-width: 42rem;
        padding-bottom: clamp(2.75rem, 5vw, 4.25rem);
        font: 430 clamp(1.08rem, 1.22vw, 1.18rem) / 1.62 var(--sans);
      }

      .news-body :global(p) { margin: 0 0 1.3em; }
      .news-body :global(h2) {
        margin: 2.7rem 0 0.9rem;
        font: 660 clamp(1.65rem, 2.1vw, 2.05rem) / 1.08 var(--sans);
        letter-spacing: -0.035em;
      }
      .news-body :global(h3) {
        margin: 2.1rem 0 0.75rem;
        font: 640 clamp(1.25rem, 1.55vw, 1.5rem) / 1.16 var(--sans);
        letter-spacing: -0.02em;
      }
      .news-body :global(a) { text-decoration-color: var(--accent); text-decoration-thickness: 0.08em; text-underline-offset: 0.15em; }
      .news-body :global(a:hover) { color: var(--accent); }
      .news-body :global(ul),
      .news-body :global(ol) { margin: 0 0 1.5rem; padding-left: 1.3rem; }
      .news-body :global(li) { margin: 0.45rem 0; }
      .news-body :global(blockquote) { margin: 2.1rem 0; padding-left: 1rem; border-left: 3px solid var(--accent); font-size: 1.05em; line-height: 1.58; }
      .news-body :global(img),
      .news-body :global(video),
      .news-body :global(svg) { display: block; max-width: 100%; height: auto; }
      .news-body :global(pre) { max-width: 100%; overflow-x: auto; padding: 1rem; background: var(--paper-soft); font: 400 0.82rem/1.6 var(--mono); }
      .news-body :global(code) { font-family: var(--mono); font-size: 0.82em; }

      .news-notes {
        max-width: 42rem;
        padding-bottom: clamp(2.25rem, 4vw, 3.75rem);
      }

      .news-note { padding: 1.15rem 0 0; border-top: 3px solid var(--accent); }
      .news-note + .news-note { margin-top: 1.8rem; }
      .news-note h2 { margin: 0; font: 650 0.76rem/1.3 var(--sans); letter-spacing: 0.05em; text-transform: uppercase; }
      .news-note p { margin: 0.6rem 0 0; color: var(--muted); font: 430 0.9rem/1.55 var(--sans); }
      .news-note--correction { border-top-color: var(--correction); }

      .article-newsletter {
        padding: clamp(1.5rem, 3vw, 2.25rem) 0 clamp(3.5rem, 6vw, 6rem);
        border-top: 3px solid var(--accent);
      }

      @media (max-width: 64rem) {
        .news-header h1 { grid-column: 3 / 13; }
        .news-dek, .news-byline { grid-column: 4 / 12; }
      }

      @media (max-width: 48rem) {
        .news-header { display: block; }
        .news-classification { margin: 0 0 0.9rem; }
        .news-header h1 { max-width: 23ch; }
        .news-dek { max-width: 39rem; }
        .news-byline { max-width: 40rem; }
        .news-hero__media { width: 100%; }
      }

      @media (max-width: 36rem) {
        :global(:root) { --shell-gutter: 1.1rem; }
        .news-header { padding-top: 2.4rem; }
        .news-header h1 { font-size: clamp(2.45rem, 11.5vw, 3.45rem); }
        .news-dek { font-size: 1rem; }
        .news-body { font-size: 1.06rem; line-height: 1.6; }
      }

      @media (max-width: 23rem) {
        :global(:root) { --shell-gutter: 1rem; }
      }
    </style>
  </body>
</html>
