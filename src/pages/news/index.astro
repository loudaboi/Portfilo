---
import { getCollection } from "astro:content";
import SiteHead from "../../components/SiteHead.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import EditorialArchive from "../../components/EditorialArchive.astro";
import { DEV_EDITORIAL_IMAGE } from "../../data/devEditorialImage";
import { DEV_NEWS_FIXTURES } from "../../data/devNewsFixtures";

const publishedNews = await getCollection(
  "articles",
  ({ data }) => data.section === "news" && data.status === "published",
);

const newsByDate = [...publishedNews].sort(
  (a, b) =>
    (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0),
);

const dateFormatter = new Intl.DateTimeFormat("en-PH", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});

const formatDate = (date?: Date) => (date ? dateFormatter.format(date) : "");
const formatLabel = (value: string) => value.replaceAll("-", " ");

const realItems = newsByDate.map((story) => ({
  href: `/news/${story.id}`,
  title: story.data.title,
  dek: story.data.dek,
  meta: [formatLabel(story.data.topic), formatDate(story.data.publishedAt)].filter(Boolean),
  accentMetaCount: 1,
  image: story.data.image ?? (import.meta.env.DEV ? DEV_EDITORIAL_IMAGE : undefined),
}));

const fixtureItems = realItems.length === 0
  ? DEV_NEWS_FIXTURES.map((item) => ({
      title: item.title,
      dek: item.dek,
      meta: [formatLabel(item.topic), item.time],
      accentMetaCount: 1,
      image: item.image,
    }))
  : [];

const items = realItems.length > 0 ? realItems : fixtureItems;
const usingFixtures = fixtureItems.length > 0;
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      title="News | Portfilo"
      description="The latest news on companies, startups, products, markets, AI, and technology."
    />
  </head>
  <body class="editorial-page">
    <a class="skip-link" href="#main-content">Skip to news</a>
    <SiteHeader current="news" />

    <EditorialArchive
      title="News"
      items={items}
      listId="news-list"
      leadAriaLabel={usingFixtures ? "Sample news" : "Latest news"}
      streamAriaLabel={usingFixtures ? "Sample news layout" : "News archive"}
      emptyText="No published News items yet."
      signupId="news-archive-newsletter"
      signupAriaLabel="Subscribe to Portfilo news"
      signupHeading="Stay on top of what’s changing."
      signupCopy="Current reporting on the developments moving companies, technology, work, and the digital economy."
      fixtureNotice={usingFixtures ? "Sample content for layout testing. Not Portfilo reporting." : undefined}
    />

    <SiteFooter />
  </body>
</html>
