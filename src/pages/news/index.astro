---
import { getCollection } from "astro:content";
import SiteHead from "../../components/SiteHead.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { DEV_NEWS_FIXTURES } from "../../data/devNewsFixtures";

const publishedNews = await getCollection(
  "stories",
  ({ data }) => data.section === "news" && data.status === "published",
);

const newsByDate = [...publishedNews].sort(
  (a, b) =>
    (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0),
);

const dateFormatter = new Intl.DateTimeFormat("en-PH", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});

const formatDate = (date?: Date) => (date ? dateFormatter.format(date) : "");
const formatLabel = (value: string) => value.replaceAll("-", " ");

const realItems = newsByDate.map((story) => ({
  id: story.id,
  topic: story.data.topic,
  time: formatDate(story.data.publishedAt),
  title: story.data.title,
  dek: story.data.dek,
  image: story.data.image,
  fixture: false as const,
}));

const fixtureItems = import.meta.env.DEV && realItems.length === 0
  ? DEV_NEWS_FIXTURES.map((item) => ({ ...item, id: undefined, image: undefined, fixture: true as const }))
  : [];

const items = realItems.length > 0 ? realItems : fixtureItems;
const leadItem = items[0];
const supportingItems = items.slice(1);
const usingFixtures = fixtureItems.length > 0;
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      title="News | Portfilo"
      description="The latest news on companies, startups, products, markets, AI, and technology."
    />
  </head>
  <body class="editorial-page">
    <a class="skip-link" href="#news-list">Skip to news</a>
    <SiteHeader current="news" />

    <main id="main-content">
      <header class="page-header">
        <h1>News</h1>
        {usingFixtures && <p>Development fixtures only. Not Portfilo reporting.</p>}
      </header>

      {
        leadItem ? (
          <>
            <section class="lead-news" aria-label="Latest news">
              {leadItem.image && leadItem.id && (
                <a class="lead-news__image" href={`/news/${leadItem.id}`} aria-label={`Read ${leadItem.title}`}>
                  <img
                    src={leadItem.image.src}
                    alt={leadItem.image.alt}
                    width="1600"
                    height="900"
                    loading="eager"
                    decoding="async"
                  />
                  {leadItem.image.generated && (
                    <span class="image-disclosure">AI-generated editorial image</span>
                  )}
                </a>
              )}

              <div class="lead-news__package">
                <p class="news-meta">
                  <span>{formatLabel(leadItem.topic)}</span>
                  <span>{leadItem.time}</span>
                </p>
                <h2>
                  {leadItem.id ? <a href={`/news/${leadItem.id}`}>{leadItem.title}</a> : leadItem.title}
                </h2>
                <p class="lead-news__dek">{leadItem.dek}</p>
              </div>
            </section>

            <section class="news-stream" id="news-list" tabindex="-1" aria-label="News archive">
              {supportingItems.map((item) => (
                <article class="news-row">
                  <p class="news-meta">
                    <span>{formatLabel(item.topic)}</span>
                    <span>{item.time}</span>
                  </p>
                  <div class="news-row__copy">
                    <h2>
                      {item.id ? <a href={`/news/${item.id}`}>{item.title}</a> : item.title}
                    </h2>
                    <p>{item.dek}</p>
                  </div>
                </article>
              ))}
            </section>
          </>
        ) : (
          <p class="empty-state" id="news-list">No published News items yet.</p>
        )
      }
    </main>

    <SiteFooter />

    <style>
      @font-face { font-family: "Instrument Sans"; font-style: normal; font-display: swap; font-weight: 400 700; src: url("https://cdn.jsdelivr.net/fontsource/fonts/instrument-sans:vf@5.3.0/latin-wght-normal.woff2") format("woff2-variations"); }
      @font-face { font-family: "Source Serif 4"; font-style: normal; font-display: swap; font-weight: 200 900; src: url("https://cdn.jsdelivr.net/fontsource/fonts/source-serif-4:vf@5.3.0/latin-wght-normal.woff2") format("woff2-variations"); }
      @font-face { font-family: "IBM Plex Mono"; font-style: normal; font-display: swap; font-weight: 400; src: url("https://cdn.jsdelivr.net/fontsource/fonts/ibm-plex-mono@5.3.0/latin-400-normal.woff2") format("woff2"); }

      :global(:root) {
        --paper: #f8f6f1;
        --paper-soft: #efebe3;
        --ink: #171614;
        --muted: #68645e;
        --line: #d4cfc6;
        --line-strong: #aaa39a;
        --accent: #0050a4;
        --correction: #b42318;
        --page-max: 84rem;
        --content-max: 84rem;
        --shell-gutter: clamp(1.25rem, 2.6vw, 2rem);
        --gutter: var(--shell-gutter);
        --sans: "Instrument Sans", "Helvetica Neue", Arial, sans-serif;
        --serif: "Source Serif 4", Georgia, serif;
        --mono: "IBM Plex Mono", "Courier New", monospace;
      }

      :global(*) { box-sizing: border-box; }
      :global(html) { background: var(--paper); color: var(--ink); font-family: var(--sans); font-synthesis: none; }
      :global(body) { margin: 0; min-width: 0; background: var(--paper); }
      :global(a) { color: inherit; }
      :global(a:focus-visible) { outline: 3px solid var(--accent); outline-offset: 4px; }
      :global(#news-list:focus) { outline: none; }

      .skip-link {
        position: fixed;
        z-index: 50;
        top: 0.75rem;
        left: 0.75rem;
        padding: 0.7rem 0.85rem;
        background: var(--ink);
        color: var(--paper);
        font: 550 0.75rem/1 var(--sans);
        text-decoration: none;
        transform: translateY(-200%);
      }
      .skip-link:focus { transform: translateY(0); }

      .page-header,
      .lead-news,
      .news-stream,
      .empty-state {
        width: min(calc(100% - (2 * var(--shell-gutter))), var(--content-max));
        margin-inline: auto;
      }

      .page-header {
        padding: clamp(3rem, 5.5vw, 5.2rem) 0 clamp(1.15rem, 2vw, 1.65rem);
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 2rem;
        border-bottom: 1px solid var(--ink);
      }

      .page-header h1,
      .page-header p {
        margin: 0;
      }

      .page-header h1 {
        font: 680 clamp(2.8rem, 5.4vw, 5rem) / 0.92 var(--sans);
        letter-spacing: -0.052em;
      }

      .page-header p {
        max-width: 19rem;
        color: var(--muted);
        font: 520 0.68rem/1.4 var(--sans);
        text-align: right;
      }

      .lead-news {
        padding: clamp(1.35rem, 2.5vw, 2rem) 0 clamp(2.4rem, 4vw, 3.75rem);
        display: grid;
        grid-template-columns: minmax(0, 1.3fr) minmax(20rem, 0.85fr);
        gap: clamp(1.5rem, 3vw, 3rem);
        align-items: start;
        border-bottom: 1px solid var(--line);
      }

      .lead-news:not(:has(.lead-news__image)) {
        grid-template-columns: minmax(0, 52rem) 1fr;
      }

      .lead-news:not(:has(.lead-news__image)) .lead-news__package {
        grid-column: 1;
      }

      .lead-news__image {
        position: relative;
        display: block;
        overflow: hidden;
        border-top: 3px solid var(--accent);
        background: var(--paper-soft);
        line-height: 0;
      }

      .lead-news__image img {
        display: block;
        width: 100%;
        height: auto;
      }

      .image-disclosure {
        position: absolute;
        right: 0.55rem;
        bottom: 0.5rem;
        padding: 0.27rem 0.36rem;
        background: rgba(23, 22, 20, 0.78);
        color: #fff;
        font: 520 0.57rem/1 var(--sans);
        letter-spacing: 0.035em;
      }

      .news-meta,
      .lead-news h2,
      .lead-news__dek,
      .news-row h2,
      .news-row__copy p {
        margin: 0;
      }

      .news-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem 0.75rem;
        color: var(--muted);
        font: 560 0.64rem/1.3 var(--sans);
        letter-spacing: 0.045em;
        text-transform: uppercase;
      }

      .news-meta span:first-child {
        color: var(--accent);
      }

      .news-meta span + span::before {
        content: "/";
        margin-right: 0.75rem;
        color: var(--line-strong);
      }

      .lead-news h2 {
        max-width: 19ch;
        margin-top: 0.6rem;
        font: 670 clamp(2rem, 3.2vw, 3.5rem) / 0.98 var(--sans);
        letter-spacing: -0.047em;
        text-wrap: balance;
      }

      h2 a { text-decoration: none; }
      h2 a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.14em; }

      .lead-news__dek {
        max-width: 42rem;
        margin-top: 0.7rem;
        color: var(--muted);
        font: 425 clamp(0.95rem, 1.1vw, 1.05rem) / 1.52 var(--sans);
      }

      .news-stream {
        padding-bottom: clamp(4rem, 7vw, 7rem);
      }

      .news-row {
        padding: clamp(1.25rem, 2.1vw, 1.8rem) 0;
        display: grid;
        grid-template-columns: minmax(9rem, 0.25fr) minmax(0, 1fr);
        gap: clamp(1.5rem, 3vw, 3rem);
        border-bottom: 1px solid var(--line);
      }

      .news-row__copy h2 {
        max-width: 30ch;
        font: 650 clamp(1.3rem, 1.9vw, 1.95rem) / 1.05 var(--sans);
        letter-spacing: -0.033em;
      }

      .news-row__copy p {
        max-width: 48rem;
        margin-top: 0.5rem;
        color: var(--muted);
        font: 420 0.9rem/1.5 var(--sans);
      }

      .empty-state {
        padding: 1.8rem 0 clamp(5rem, 8vw, 8rem);
        color: var(--muted);
        font: 430 0.95rem/1.55 var(--sans);
      }

      @media (max-width: 64rem) {
        .lead-news { grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr); }
      }

      @media (max-width: 48rem) {
        .page-header { align-items: start; }
        .lead-news,
        .lead-news:not(:has(.lead-news__image)),
        .news-row { grid-template-columns: 1fr; }
        .lead-news__image { order: 0; }
        .lead-news__package { order: 1; }
        .news-row { gap: 0.55rem; }
        .news-row__copy h2 { max-width: 34ch; }
      }

      @media (max-width: 36rem) {
        :global(:root) { --shell-gutter: 1.1rem; }
        .page-header { padding-top: 2.6rem; gap: 1rem; }
        .page-header h1 { font-size: clamp(2.7rem, 14vw, 4rem); }
        .page-header p { max-width: 12rem; font-size: 0.61rem; }
        .lead-news { padding-top: 1.1rem; }
        .lead-news h2 { font-size: clamp(2rem, 9vw, 2.7rem); }
        .news-row { padding-block: 1.2rem; }
      }

      @media (max-width: 23rem) {
        :global(:root) { --shell-gutter: 1rem; }
        .page-header { display: block; }
        .page-header p { max-width: 18rem; margin-top: 0.75rem; text-align: left; }
      }
    </style>
  </body>
</html>
