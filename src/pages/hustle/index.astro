---
import { getCollection } from "astro:content";
import SiteHead from "../../components/SiteHead.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";

const entries=(await getCollection("articles",({data})=>data.section==="hustle"&&data.status==="published"))
  .sort((a,b)=>(b.data.publishedAt?.getTime()??0)-(a.data.publishedAt?.getTime()??0));
const dateFormatter=new Intl.DateTimeFormat("en-PH",{day:"numeric",month:"short",year:"numeric",timeZone:"UTC"});
const formatDate=(date?:Date)=>date?dateFormatter.format(date):"";
---
<!doctype html><html lang="en"><head><SiteHead title="Hustle | Portfilo" description="Hustle | Portfilo"/></head><body>
<a class="skip-link" href="#main-content">Skip to Hustle</a><SiteHeader current="hustle"/>
<main id="main-content" tabindex="-1" class="hustle"><header><p>Hustle / {String(entries.length).padStart(2,"0")}</p><h1>Hustle</h1></header>
{entries.length===0?<p class="hustle__empty">No Hustle stories published yet.</p>:<div class="hustle__list">{entries.map((story,index)=><article><p>{String(index+1).padStart(2,"0")}</p><div><span>{story.data.subject?.name??formatDate(story.data.publishedAt)}</span><h2><a href={`/hustle/${story.id}`}>{story.data.title}</a></h2><p>{story.data.dek}</p></div></article>)}</div>}</main><SiteFooter/></body></html>
<style>
.hustle{width:min(calc(100% - (2 * var(--shell-gutter))),var(--page-max));min-height:60vh;margin-inline:auto;padding-block:clamp(4rem,8vw,8rem)}
.hustle header>p,.hustle__list article>p,.hustle__list span{margin:0;color:var(--muted-silver);font:400 .68rem/1.3 var(--mono);text-transform:uppercase}
.hustle header h1{margin:var(--space-4) 0 0;color:var(--cold-white);font:650 clamp(4rem,10vw,10rem)/.82 var(--sans);font-variation-settings:"wdth" 80,"wght" 650;letter-spacing:-.075em}
.hustle__empty{margin-top:clamp(4rem,10vw,10rem);color:var(--muted-silver);font:430 1rem/1.6 var(--sans)}
.hustle__list{margin-top:clamp(4rem,8vw,8rem);border-top:1px solid var(--line)}.hustle__list article{display:grid;grid-template-columns:3rem 1fr;gap:var(--grid-gap);padding-block:2rem;border-bottom:1px solid var(--line)}
.hustle__list h2{max-width:22ch;margin:var(--space-3) 0 0;font:610 clamp(2rem,4vw,4.5rem)/.95 var(--sans);letter-spacing:-.055em}.hustle__list h2 a{color:var(--cold-white);text-decoration:none}
.hustle__list div>p{max-width:58ch;margin:var(--space-4) 0 0;color:var(--muted-silver);font:430 .98rem/1.55 var(--sans)}
</style>
