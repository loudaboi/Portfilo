---
interface ArticleImage {
  src: string;
  alt: string;
  credit?: string;
  generated?: boolean;
}

interface ArticleMetaItem {
  label: string;
  value: string;
  href?: string;
}

interface ArticleCorrection {
  dateLabel: string;
  iso: string;
  note: string;
}

interface Props {
  mode: "news" | "stories";
  title: string;
  dek: string;
  classification: string[];
  metadata: ArticleMetaItem[];
  image?: ArticleImage;
  methodology?: string;
  correction?: ArticleCorrection;
  bodyId?: string;
}

const {
  mode,
  title,
  dek,
  classification,
  metadata,
  image,
  methodology,
  correction,
  bodyId = "article-body",
} = Astro.props;
---

<main id="main-content">
  <article class:list={["editorial-article", `editorial-article--${mode}`]}>
    <header class="article-header">
      <p class="article-classification">
        {classification.map((item) => <span>{item}</span>)}
      </p>

      <h1>{title}</h1>
      <p class="article-dek">{dek}</p>

      {metadata.length > 0 && (
        <dl class="article-meta">
          {metadata.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>{item.href ? <a href={item.href}>{item.value}</a> : item.value}</dd>
            </div>
          ))}
        </dl>
      )}
    </header>

    {image && (
      <figure class="article-hero">
        <div class="article-hero__media">
          <img
            src={image.src}
            alt={image.alt}
            width="1600"
            height="900"
            loading="eager"
            decoding="async"
          />
          {image.generated && (
            <span class="image-disclosure">AI-generated editorial image</span>
          )}
        </div>
        {image.credit && <figcaption>{image.credit}</figcaption>}
      </figure>
    )}

    <div class="article-body" id={bodyId} tabindex="-1">
      <slot />
    </div>

    {(methodology || correction) && (
      <div class="article-notes">
        {methodology && (
          <section class="article-note" aria-labelledby={`${bodyId}-methodology-title`}>
            <h2 id={`${bodyId}-methodology-title`}>Methodology</h2>
            <p>{methodology}</p>
          </section>
        )}

        {correction && (
          <aside
            class="article-note article-note--correction"
            aria-labelledby={`${bodyId}-correction-title`}
          >
            <h2 id={`${bodyId}-correction-title`}>Correction</h2>
            <p>
              <time datetime={correction.iso}>{correction.dateLabel}</time>
              <span aria-hidden="true"> · </span>
              {correction.note}
            </p>
          </aside>
        )}
      </div>
    )}
  </article>
</main>

<style>
  @font-face {
    font-family: "Instrument Sans";
    font-style: normal;
    font-display: swap;
    font-weight: 400 700;
    src: url("https://cdn.jsdelivr.net/fontsource/fonts/instrument-sans:vf@5.3.0/latin-wght-normal.woff2") format("woff2-variations");
  }

  @font-face {
    font-family: "Source Serif 4";
    font-style: normal;
    font-display: swap;
    font-weight: 200 900;
    src: url("https://cdn.jsdelivr.net/fontsource/fonts/source-serif-4:vf@5.3.0/latin-wght-normal.woff2") format("woff2-variations");
  }

  @font-face {
    font-family: "IBM Plex Mono";
    font-style: normal;
    font-display: swap;
    font-weight: 400;
    src: url("https://cdn.jsdelivr.net/fontsource/fonts/ibm-plex-mono@5.3.0/latin-400-normal.woff2") format("woff2");
  }

  :global(:root) {
    --paper: #f8f6f1;
    --paper-soft: #efebe3;
    --ink: #171614;
    --muted: #68645e;
    --line: #d4cfc6;
    --line-strong: #aaa39a;
    --accent: #0050a4;
    --correction: #b42318;
    --page-max: 84rem;
    --content-max: 84rem;
    --shell-gutter: clamp(1.25rem, 2.6vw, 2rem);
    --gutter: var(--shell-gutter);
    --sans: "Instrument Sans", "Helvetica Neue", Arial, sans-serif;
    --serif: "Source Serif 4", Georgia, serif;
    --mono: "IBM Plex Mono", "Courier New", monospace;
  }

  :global(*) { box-sizing: border-box; }

  :global(html) {
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-synthesis: none;
  }

  :global(body.editorial-page) {
    margin: 0;
    min-width: 0;
    background: var(--paper);
  }

  :global(body.editorial-page a) { color: inherit; }

  :global(body.editorial-page a:focus-visible) {
    outline: 3px solid var(--accent);
    outline-offset: 4px;
  }

  :global(body.editorial-page .skip-link) {
    position: fixed;
    z-index: 50;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.7rem 0.85rem;
    background: var(--ink);
    color: var(--paper);
    font: 550 0.75rem/1 var(--sans);
    text-decoration: none;
    transform: translateY(-200%);
  }

  :global(body.editorial-page .skip-link:focus) { transform: translateY(0); }

  .article-header,
  .article-hero,
  .article-body,
  .article-notes {
    width: min(calc(100% - (2 * var(--shell-gutter))), var(--content-max));
    margin-inline: auto;
  }

  .article-header {
    padding: clamp(3rem, 6vw, 5.75rem) 0 clamp(2.2rem, 4vw, 3.5rem);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 1.8vw, 1.75rem);
  }

  .article-classification,
  .article-header h1,
  .article-dek,
  .article-meta {
    grid-column-start: 2;
  }

  .article-classification {
    grid-column-end: 12;
    margin: 0 0 0.9rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.7rem;
    color: var(--muted);
    font: 570 0.65rem/1.3 var(--sans);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .article-classification span:first-child,
  .article-classification span:nth-child(2) {
    color: var(--accent);
  }

  .article-classification span + span::before {
    content: "/";
    margin-right: 0.7rem;
    color: var(--line-strong);
  }

  .article-header h1 {
    grid-column-end: 12;
    max-width: 18ch;
    margin: 0;
    font: 680 clamp(3rem, 6.2vw, 6.25rem) / 0.94 var(--sans);
    letter-spacing: -0.058em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  .article-dek {
    grid-column-end: 9;
    max-width: 46rem;
    margin: clamp(1.25rem, 2.4vw, 2rem) 0 0;
    color: var(--muted);
    font: 440 clamp(1.08rem, 1.45vw, 1.35rem) / 1.5 var(--sans);
  }

  .article-meta {
    grid-column-end: 11;
    margin: clamp(1.5rem, 2.7vw, 2.3rem) 0 0;
    padding-top: 0.85rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem clamp(1.25rem, 2.5vw, 2.4rem);
    border-top: 1px solid var(--line);
    font: 520 0.68rem/1.4 var(--sans);
  }

  .article-meta div { min-width: 0; }

  .article-meta dt {
    color: var(--muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .article-meta dd { margin: 0.18rem 0 0; }
  .article-meta a { text-underline-offset: 0.15em; }

  .article-hero {
    margin-bottom: clamp(2.5rem, 5vw, 4.75rem);
  }

  .article-hero__media {
    position: relative;
    width: min(100%, 64rem);
    aspect-ratio: 16 / 9;
    margin-inline: auto;
    overflow: hidden;
    border-top: 3px solid var(--accent);
    background: var(--paper-soft);
    line-height: 0;
  }

  .article-hero img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-disclosure {
    position: absolute;
    right: 0.6rem;
    bottom: 0.55rem;
    padding: 0.27rem 0.36rem;
    background: rgba(23, 22, 20, 0.78);
    color: #fff;
    font: 520 0.57rem/1 var(--sans);
    letter-spacing: 0.035em;
  }

  .article-hero figcaption {
    width: min(100%, 64rem);
    margin: 0.5rem auto 0;
    color: var(--muted);
    font: 480 0.65rem/1.4 var(--sans);
  }

  .article-body,
  .article-notes {
    max-width: 44rem;
  }

  .article-body {
    padding-bottom: clamp(3rem, 5vw, 4.75rem);
    font-size: clamp(1.12rem, 1.26vw, 1.22rem);
  }

  .editorial-article--news .article-body {
    font-family: var(--sans);
    font-weight: 430;
    line-height: 1.66;
  }

  .editorial-article--stories .article-body {
    font-family: var(--serif);
    font-weight: 400;
    line-height: 1.72;
  }

  .article-body:focus { outline: none; }
  .article-body :global(p) { margin: 0 0 1.45em; }

  .article-body :global(h2) {
    margin: 3rem 0 1rem;
    font: 660 clamp(1.75rem, 2.3vw, 2.25rem) / 1.08 var(--sans);
    letter-spacing: -0.04em;
  }

  .article-body :global(h3) {
    margin: 2.3rem 0 0.85rem;
    font: 640 clamp(1.3rem, 1.7vw, 1.6rem) / 1.16 var(--sans);
    letter-spacing: -0.025em;
  }

  .article-body :global(a) {
    text-decoration-color: var(--accent);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.15em;
  }

  .article-body :global(a:hover) { color: var(--accent); }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 0 0 1.6rem;
    padding-left: 1.35rem;
  }

  .article-body :global(li) { margin: 0.5rem 0; }

  .article-body :global(blockquote) {
    margin: 2.4rem 0;
    padding-left: 1.1rem;
    border-left: 3px solid var(--accent);
    font-size: 1.06em;
    line-height: 1.62;
  }

  .article-body :global(hr) {
    margin: 2.8rem 0;
    border: 0;
    border-top: 1px solid var(--line);
  }

  .article-body :global(img),
  .article-body :global(video),
  .article-body :global(svg) {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .article-body :global(pre) {
    max-width: 100%;
    overflow-x: auto;
    padding: 1rem;
    background: var(--paper-soft);
    font: 400 0.82rem/1.6 var(--mono);
  }

  .article-body :global(code) {
    font-family: var(--mono);
    font-size: 0.82em;
  }

  .article-notes {
    padding-bottom: clamp(3rem, 5vw, 4.75rem);
  }

  .article-note {
    padding-top: 1.2rem;
    border-top: 3px solid var(--accent);
  }

  .article-note + .article-note { margin-top: 2rem; }

  .article-note h2 {
    margin: 0;
    font: 650 0.78rem/1.3 var(--sans);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .article-note p {
    margin: 0.65rem 0 0;
    color: var(--muted);
    font: 430 0.93rem/1.58 var(--sans);
  }

  .article-note--correction { border-top-color: var(--correction); }

  @media (max-width: 64rem) {
    .article-header h1 { grid-column-end: 13; }
    .article-dek { grid-column-end: 10; }
    .article-meta { grid-column-end: 12; }
  }

  @media (max-width: 48rem) {
    .article-header { display: block; }
    .article-classification { margin-bottom: 0.9rem; }
    .article-header h1 { max-width: 22ch; }
    .article-dek { max-width: 42rem; }
    .article-meta { max-width: 44rem; }
    .article-hero__media { width: 100%; }
  }

  @media (max-width: 36rem) {
    :global(:root) { --shell-gutter: 1.1rem; }
    .article-header { padding-top: 2.6rem; }
    .article-header h1 { font-size: clamp(2.5rem, 12vw, 3.6rem); }
    .article-dek { font-size: 1.04rem; }
    .article-meta { gap: 0.7rem 1.2rem; }
    .article-body { font-size: 1.08rem; }
  }

  @media (max-width: 23rem) {
    :global(:root) { --shell-gutter: 1rem; }
  }
</style>
