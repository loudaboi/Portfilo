---
interface ArticleImage {
  src: string;
  alt: string;
  credit?: string;
  generated?: boolean;
}

interface ArticleMetaItem {
  label: string;
  value: string;
  href?: string;
}

interface ArticleCorrection {
  dateLabel: string;
  iso: string;
  note: string;
}

interface ArticleTocItem {
  slug: string;
  text: string;
}

interface Props {
  mode: "news" | "stories";
  title: string;
  dek: string;
  classification: string[];
  metadata: ArticleMetaItem[];
  image?: ArticleImage;
  methodology?: string;
  correction?: ArticleCorrection;
  tocItems?: ArticleTocItem[];
  bodyId?: string;
}

const {
  mode,
  title,
  dek,
  classification,
  metadata,
  image,
  methodology,
  correction,
  tocItems = [],
  bodyId = "article-body",
} = Astro.props;

const showToc = mode === "stories" && tocItems.length >= 3;
---

<main id="main-content">
  <article class:list={["editorial-article", `editorial-article--${mode}`]}>
    <header class:list={{ "article-header": true, "article-header--with-image": Boolean(image) }}>
      <p class="article-classification">
        {classification.map((item) => <span>{item}</span>)}
      </p>

      <h1>{title}</h1>
      <p class="article-dek">{dek}</p>

      {metadata.length > 0 && (
        <dl class="article-meta">
          {metadata.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>{item.href ? <a href={item.href}>{item.value}</a> : item.value}</dd>
            </div>
          ))}
        </dl>
      )}
    </header>

    {image && (
      <figure class="article-hero">
        <div class="article-hero__media">
          <img
            src={image.src}
            alt={image.alt}
            width="1600"
            height="900"
            loading="eager"
            decoding="async"
          />
          {image.generated && (
            <span class="image-disclosure">AI-generated editorial image</span>
          )}
        </div>
        {image.credit && <figcaption>{image.credit}</figcaption>}
      </figure>
    )}

    <div
      class:list={{
        "article-content": true,
        "article-content--with-toc": showToc,
      }}
    >
      {showToc && (
        <aside class="article-toc" aria-labelledby={`${bodyId}-toc-title`}>
          <div class="article-toc__inner">
            <p class="article-toc__title" id={`${bodyId}-toc-title`}>In this story</p>
            <nav aria-label="Story sections">
              <ol>
                {tocItems.map((item) => (
                  <li><a href={`#${item.slug}`}>{item.text}</a></li>
                ))}
              </ol>
            </nav>
          </div>
        </aside>
      )}

      <div class="article-reading">
        <div class="article-body" id={bodyId} tabindex="-1">
          <slot />
        </div>

        {(methodology || correction) && (
          <div class="article-notes">
            {methodology && (
              <section class="article-note" aria-labelledby={`${bodyId}-methodology-title`}>
                <h2 id={`${bodyId}-methodology-title`}>Methodology</h2>
                <p>{methodology}</p>
              </section>
            )}

            {correction && (
              <aside
                class="article-note article-note--correction"
                aria-labelledby={`${bodyId}-correction-title`}
              >
                <h2 id={`${bodyId}-correction-title`}>Correction</h2>
                <p>
                  <time datetime={correction.iso}>{correction.dateLabel}</time>
                  <span aria-hidden="true"> · </span>
                  {correction.note}
                </p>
              </aside>
            )}
          </div>
        )}
      </div>
    </div>
  </article>
</main>

<style>
  .editorial-article {
    --article-header-max: 54rem;
    --article-hero-max: 54rem;
    --article-reading-max: 41.5rem;
    --article-content-max: 61rem;
    --article-toc-max: 12rem;
  }

  .article-header,
  .article-hero,
  .article-content {
    width: calc(100% - (2 * var(--shell-gutter)));
    margin-inline: auto;
  }

  .article-header {
    max-width: var(--article-header-max);
    padding: clamp(2.8rem, 2rem + 2.3vw, 5rem) 0 clamp(2.1rem, 1.5rem + 1.5vw, 3.1rem);
    text-align: center;
  }

  .article-header--with-image {
    padding-bottom: clamp(1.5rem, 1rem + 1vw, 2.25rem);
  }

  .article-classification {
    margin: 0 0 0.9rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.45rem 0.7rem;
    color: var(--muted);
    font: 570 0.65rem/1.3 var(--sans);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .article-classification span:first-child,
  .article-classification span:nth-child(2) {
    color: var(--accent);
  }

  .article-classification span + span::before {
    content: "/";
    margin-right: 0.7rem;
    color: var(--line-strong);
  }

  .article-header h1 {
    max-width: 54rem;
    margin: 0 auto;
    font: 680 clamp(2.55rem, 0.95rem + 3.3vw, 4.35rem) / 0.96 var(--sans);
    letter-spacing: -0.055em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  .article-dek {
    max-width: 44rem;
    margin: clamp(1.1rem, 0.8rem + 0.8vw, 1.7rem) auto 0;
    color: var(--muted);
    font: 440 clamp(1rem, 0.86rem + 0.4vw, 1.28rem) / 1.5 var(--sans);
    text-wrap: balance;
  }

  .article-meta {
    width: 100%;
    margin: clamp(1.35rem, 1rem + 0.9vw, 2rem) auto 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem clamp(1.1rem, 2vw, 1.8rem);
    font: 520 0.68rem/1.4 var(--sans);
    text-align: left;
  }

  .article-meta div {
    min-width: 0;
  }

  .article-meta dt {
    color: var(--muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .article-meta dd {
    margin: 0.18rem 0 0;
  }

  .article-meta a {
    text-underline-offset: 0.15em;
  }

  .article-hero {
    max-width: var(--article-hero-max);
    margin-bottom: clamp(2.6rem, 2rem + 2vw, 4.3rem);
  }

  .article-hero__media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-top: 3px solid var(--accent);
    background: var(--paper-soft);
    line-height: 0;
  }

  .article-hero img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-disclosure {
    position: absolute;
    right: 0.6rem;
    bottom: 0.55rem;
    padding: 0.27rem 0.36rem;
    background: rgba(23, 22, 20, 0.78);
    color: #fff;
    font: 520 0.57rem/1 var(--sans);
    letter-spacing: 0.035em;
  }

  .article-hero figcaption {
    width: 100%;
    margin: 0.5rem 0 0;
    color: var(--muted);
    font: 480 0.65rem/1.4 var(--sans);
  }

  .article-content {
    max-width: var(--article-content-max);
  }

  .article-content--with-toc {
    display: grid;
    grid-template-columns: minmax(9rem, var(--article-toc-max)) minmax(0, var(--article-reading-max));
    justify-content: center;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
  }

  .article-reading {
    width: 100%;
    max-width: var(--article-reading-max);
    min-width: 0;
  }

  .article-content:not(.article-content--with-toc) .article-reading {
    margin-inline: auto;
  }

  .article-toc {
    min-width: 0;
    padding-top: 0.2rem;
    font-family: var(--sans);
  }

  .article-toc__inner {
    position: sticky;
    top: 2rem;
  }

  .article-toc__title {
    margin: 0 0 0.9rem;
    color: var(--ink);
    font: 650 0.68rem/1.3 var(--sans);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .article-toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .article-toc li + li {
    margin-top: 0.72rem;
  }

  .article-toc a {
    display: block;
    color: var(--muted);
    font: 470 0.72rem/1.42 var(--sans);
    text-decoration: none;
  }

  .article-toc a:hover {
    color: var(--ink);
  }

  .article-body {
    padding-bottom: clamp(3rem, 5vw, 4.5rem);
    font-size: clamp(1.07rem, 1.01rem + 0.18vw, 1.2rem);
  }

  .editorial-article--news .article-body {
    font-family: var(--sans);
    font-weight: 430;
    line-height: 1.66;
  }

  .editorial-article--stories .article-body {
    font-family: var(--serif);
    font-weight: 400;
    line-height: 1.72;
  }

  .article-body:focus {
    outline: none;
  }

  .article-body :global(p) {
    margin: 0 0 1.45em;
  }

  .article-body :global(h2) {
    margin: 3rem 0 1rem;
    font: 660 clamp(1.65rem, 1.25rem + 1.2vw, 2.25rem) / 1.08 var(--sans);
    letter-spacing: -0.04em;
    scroll-margin-top: 1.5rem;
  }

  .article-body :global(h3) {
    margin: 2.3rem 0 0.85rem;
    font: 640 clamp(1.28rem, 1.05rem + 0.65vw, 1.6rem) / 1.16 var(--sans);
    letter-spacing: -0.025em;
  }

  .article-body :global(a) {
    text-decoration-color: var(--accent);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.15em;
  }

  .article-body :global(a:hover) {
    color: var(--accent);
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 0 0 1.6rem;
    padding-left: 1.35rem;
  }

  .article-body :global(li) {
    margin: 0.5rem 0;
  }

  .article-body :global(blockquote) {
    margin: 2.4rem 0;
    padding-left: 1.1rem;
    border-left: 3px solid var(--accent);
    font-size: 1.06em;
    line-height: 1.62;
  }

  .article-body :global(hr) {
    margin: 2.8rem 0;
    border: 0;
    border-top: 1px solid var(--line);
  }

  .article-body :global(img),
  .article-body :global(video),
  .article-body :global(svg) {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .article-body :global(pre) {
    max-width: 100%;
    overflow-x: auto;
    padding: 1rem;
    background: var(--paper-soft);
    font: 400 0.82rem/1.6 var(--mono);
  }

  .article-body :global(code) {
    font-family: var(--mono);
    font-size: 0.82em;
  }

  .article-notes {
    padding-bottom: clamp(3rem, 5vw, 4.5rem);
  }

  .article-note {
    padding-top: 1.2rem;
    border-top: 3px solid var(--accent);
  }

  .article-note + .article-note {
    margin-top: 2rem;
  }

  .article-note h2 {
    margin: 0;
    font: 650 0.78rem/1.3 var(--sans);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .article-note p {
    margin: 0.65rem 0 0;
    color: var(--muted);
    font: 430 0.93rem/1.58 var(--sans);
  }

  .article-note--correction {
    border-top-color: var(--correction);
  }

  @media (max-width: 52rem) {
    .article-content--with-toc {
      display: block;
    }

    .article-content--with-toc .article-reading {
      margin-inline: auto;
    }

    .article-toc {
      display: none;
    }
  }

  @media (max-width: 40rem) {
    .article-header {
      padding-top: 2.45rem;
    }

    .article-header h1 {
      max-width: 18ch;
      font-size: clamp(2.2rem, 9vw, 2.9rem);
    }

    .article-dek {
      font-size: 1rem;
    }

    .article-meta {
      gap: 0.7rem 1.1rem;
    }

    .article-body {
      font-size: 1.06rem;
    }
  }
</style>
