---
import NewsletterSignup from "./NewsletterSignup.astro";

interface ArchiveImage {
  src: string;
  alt: string;
  generated?: boolean;
}

interface ArchiveItem {
  title: string;
  dek: string;
  href?: string;
  meta: string[];
  accentMetaCount?: number;
  image?: ArchiveImage;
}

interface Props {
  title: string;
  items: ArchiveItem[];
  listId: string;
  leadAriaLabel: string;
  streamAriaLabel: string;
  emptyText: string;
  signupId: string;
  signupAriaLabel: string;
  signupHeading: string;
  signupCopy: string;
  fixtureNotice?: string;
}

const {
  title,
  items,
  listId,
  leadAriaLabel,
  streamAriaLabel,
  emptyText,
  signupId,
  signupAriaLabel,
  signupHeading,
  signupCopy,
  fixtureNotice,
} = Astro.props;

const leadItem = items[0];
const supportingItems = items.slice(1);
---

<main id="main-content" tabindex="-1">
  <header class="page-header">
    <h1>{title}</h1>
  </header>

  {fixtureNotice && <p class="fixture-notice">{fixtureNotice}</p>}

  {
    leadItem ? (
      <section
        class:list={{ "lead-item": true, "lead-item--without-image": !leadItem.image }}
        aria-label={leadAriaLabel}
      >
        {leadItem.image && (
          leadItem.href ? (
            <a class="archive-image lead-item__image" href={leadItem.href} aria-label={`Read ${leadItem.title}`}>
              <img
                src={leadItem.image.src}
                alt={leadItem.image.alt}
                width="1600"
                height="900"
                loading="eager"
                decoding="async"
              />
              {leadItem.image.generated && (
                <span class="image-disclosure">AI-generated editorial image</span>
              )}
            </a>
          ) : (
            <div class="archive-image lead-item__image">
              <img
                src={leadItem.image.src}
                alt={leadItem.image.alt}
                width="1600"
                height="900"
                loading="eager"
                decoding="async"
              />
              {leadItem.image.generated && (
                <span class="image-disclosure">AI-generated editorial image</span>
              )}
            </div>
          )
        )}

        <div class="lead-item__package">
          <p class="archive-meta">
            {leadItem.meta.map((value, index) => (
              <span class={index < (leadItem.accentMetaCount ?? 1) ? "is-accent" : undefined}>{value}</span>
            ))}
          </p>
          <h2>{leadItem.href ? <a href={leadItem.href}>{leadItem.title}</a> : leadItem.title}</h2>
          <p class="lead-item__dek">{leadItem.dek}</p>
        </div>
      </section>
    ) : (
      <p class="empty-state" id={listId}>{emptyText}</p>
    )
  }

  <section class="archive-acquisition" aria-label={signupAriaLabel}>
    <div class="archive-acquisition__inner">
      <div class="archive-acquisition__copy">
        <h2>{signupHeading}</h2>
        <p>{signupCopy}</p>
      </div>

      <div class="archive-acquisition__form">
        <NewsletterSignup id={signupId} variant="hero" showCopy={false} />
      </div>
    </div>
  </section>

  {
    supportingItems.length > 0 && (
      <section class="archive-stream" id={listId} aria-label={streamAriaLabel}>
        {supportingItems.map((item) => (
          <article class:list={{ "archive-row": true, "archive-row--without-image": !item.image }}>
            <div class="archive-row__package">
              <p class="archive-meta">
                {item.meta.map((value, index) => (
                  <span class={index < (item.accentMetaCount ?? 1) ? "is-accent" : undefined}>{value}</span>
                ))}
              </p>
              <h2>{item.href ? <a href={item.href}>{item.title}</a> : item.title}</h2>
              <p class="archive-row__dek">{item.dek}</p>
            </div>

            {item.image && (
              item.href ? (
                <a class="archive-image archive-row__image" href={item.href} aria-label={`Read ${item.title}`}>
                  <img
                    src={item.image.src}
                    alt={item.image.alt}
                    width="1600"
                    height="900"
                    loading="lazy"
                    decoding="async"
                  />
                  {item.image.generated && (
                    <span class="image-disclosure">AI-generated editorial image</span>
                  )}
                </a>
              ) : (
                <div class="archive-image archive-row__image">
                  <img
                    src={item.image.src}
                    alt={item.image.alt}
                    width="1600"
                    height="900"
                    loading="lazy"
                    decoding="async"
                  />
                  {item.image.generated && (
                    <span class="image-disclosure">AI-generated editorial image</span>
                  )}
                </div>
              )
            )}
          </article>
        ))}
      </section>
    )
  }
</main>

<style>
  .page-header,
  .lead-item,
  .archive-stream,
  .empty-state,
  .fixture-notice {
    width: min(calc(100% - (2 * var(--shell-gutter))), var(--content-max));
    margin-inline: auto;
  }

  .page-header {
    padding: clamp(2.8rem, 2rem + 3vw, 5.6rem) 0 clamp(1.35rem, 1rem + 1.6vw, 2.2rem);
    border-bottom: 1px solid var(--ink);
  }

  .page-header h1 {
    margin: 0;
    font: 680 clamp(2.7rem, 1.2rem + 4vw, 5.4rem) / 0.92 var(--sans);
    letter-spacing: -0.055em;
  }

  .fixture-notice {
    margin-top: 0.75rem;
    margin-bottom: -0.5rem;
    color: var(--muted);
    font: 520 0.68rem/1.4 var(--sans);
    text-align: right;
  }

  .lead-item {
    padding: clamp(1.4rem, 1rem + 1.5vw, 2.5rem) 0 clamp(2.8rem, 2rem + 2.4vw, 4.7rem);
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(20rem, 0.8fr);
    gap: clamp(1.5rem, 2.7vw, 3rem);
    align-items: start;
    border-bottom: 1px solid var(--line);
  }

  .lead-item--without-image {
    grid-template-columns: 1fr;
  }

  .lead-item--without-image .lead-item__package {
    max-width: 54rem;
  }

  .archive-image {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--paper-soft);
    line-height: 0;
  }

  .archive-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-disclosure {
    position: absolute;
    right: 0.55rem;
    bottom: 0.5rem;
    padding: 0.27rem 0.36rem;
    background: rgba(23, 22, 20, 0.78);
    color: #fff;
    font: 520 0.57rem/1 var(--sans);
    letter-spacing: 0.035em;
  }

  .lead-item__package {
    padding-top: 0.1rem;
  }

  .archive-meta,
  .lead-item__dek,
  .archive-row__dek,
  .lead-item h2,
  .archive-row h2 {
    margin: 0;
  }

  .archive-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.75rem;
    color: var(--muted);
    font: 560 0.64rem/1.3 var(--sans);
    letter-spacing: 0.045em;
    text-transform: uppercase;
  }

  .archive-meta .is-accent {
    color: var(--accent);
  }

  .archive-meta > * + *::before {
    content: "/";
    margin-right: 0.75rem;
    color: var(--line-strong);
  }

  .lead-item h2 {
    max-width: 18ch;
    margin-top: 0.7rem;
    font: 670 clamp(2rem, 1.25rem + 2.2vw, 3.8rem) / 0.98 var(--sans);
    letter-spacing: -0.048em;
    text-wrap: balance;
  }

  h2 a {
    text-decoration: none;
  }

  h2 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.14em;
  }

  .lead-item__dek {
    max-width: 38rem;
    margin-top: 0.8rem;
    color: var(--muted);
    font: 430 clamp(0.96rem, 0.88rem + 0.25vw, 1.1rem) / 1.52 var(--sans);
  }

  .archive-acquisition {
    width: 100%;
    background: var(--accent);
    color: #fff;
  }

  .archive-acquisition__inner {
    width: min(calc(100% - (2 * var(--shell-gutter))), var(--content-max));
    margin-inline: auto;
    padding: clamp(1.8rem, 3vw, 2.6rem) 0;
    display: grid;
    grid-template-columns: minmax(0, 52rem) minmax(19rem, 1fr);
    gap: clamp(1.5rem, 2.7vw, 2.5rem);
    align-items: center;
  }

  .archive-acquisition__copy h2,
  .archive-acquisition__copy p {
    margin: 0;
  }

  .archive-acquisition__copy h2 {
    max-width: 17ch;
    color: #fff;
    font: 680 clamp(1.9rem, 1.15rem + 1.6vw, 2.8rem) / 0.98 var(--sans);
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .archive-acquisition__copy p {
    max-width: 43rem;
    margin-top: 0.65rem;
    color: rgba(255, 255, 255, 0.8);
    font: 440 clamp(0.9rem, 0.84rem + 0.2vw, 1rem) / 1.45 var(--sans);
  }

  .archive-acquisition__form {
    min-width: 0;
  }

  .archive-acquisition__form :global(.newsletter-signup__row) {
    grid-template-columns: 1fr;
    gap: 0.55rem;
    max-width: 32rem;
  }

  .archive-acquisition__form :global(.newsletter-signup input) {
    border: 1px solid rgba(255, 255, 255, 0.42);
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }

  .archive-acquisition__form :global(.newsletter-signup input::placeholder) {
    color: rgba(255, 255, 255, 0.68);
  }

  .archive-acquisition__form :global(.newsletter-signup button) {
    width: 100%;
    border-color: var(--paper);
    background: var(--paper);
    color: var(--accent);
  }

  .archive-acquisition__form :global(.newsletter-signup button:hover) {
    filter: none;
    background: rgba(244, 240, 232, 0.9);
  }

  .archive-acquisition__form :global(.newsletter-signup input:focus-visible),
  .archive-acquisition__form :global(.newsletter-signup button:focus-visible) {
    outline-color: #fff;
  }

  .archive-acquisition__form :global(.newsletter-signup__note),
  .archive-acquisition__form :global(.newsletter-signup__status) {
    color: rgba(255, 255, 255, 0.72);
  }

  .archive-acquisition__form :global(.newsletter-signup__status[data-state="success"]) {
    color: #fff;
  }

  .archive-acquisition__form :global(.newsletter-signup__status[data-state="error"]) {
    color: #ffe1dc;
  }

  .archive-stream {
    padding-bottom: clamp(4rem, 7vw, 7rem);
  }

  .archive-row {
    padding: clamp(1.65rem, 1.1rem + 1.5vw, 2.7rem) 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(13rem, 20rem);
    gap: clamp(1.4rem, 2.7vw, 3rem);
    align-items: start;
    border-bottom: 1px solid var(--line);
  }

  .archive-row--without-image {
    grid-template-columns: 1fr;
  }

  .archive-row--without-image .archive-row__package {
    max-width: 54rem;
  }

  .archive-row h2 {
    max-width: 25ch;
    margin-top: 0.55rem;
    font: 660 clamp(1.45rem, 1.05rem + 1.25vw, 2.45rem) / 1.02 var(--sans);
    letter-spacing: -0.04em;
  }

  .archive-row__dek {
    max-width: 43rem;
    margin-top: 0.65rem;
    color: var(--muted);
    font: 425 clamp(0.9rem, 0.84rem + 0.2vw, 1rem) / 1.52 var(--sans);
  }

  .empty-state {
    padding: 2rem 0;
    color: var(--muted);
    font: 430 0.95rem/1.55 var(--sans);
  }

  @media (max-width: 64rem) {
    .lead-item {
      grid-template-columns: minmax(0, 1.2fr) minmax(17rem, 0.8fr);
      gap: 1.5rem;
    }

    .lead-item--without-image {
      grid-template-columns: 1fr;
    }

    .archive-acquisition__inner {
      grid-template-columns: minmax(0, 1.2fr) minmax(17rem, 0.8fr);
      gap: 1.5rem;
    }

    .archive-row {
      grid-template-columns: minmax(0, 1fr) minmax(12rem, 17rem);
      gap: 1.5rem;
    }

    .archive-row--without-image {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 44rem) {
    .archive-acquisition__inner {
      grid-template-columns: 1fr;
      gap: 1.2rem;
    }

    .archive-acquisition__form {
      width: min(100%, 32rem);
    }
  }

  @media (max-width: 40rem) {
    .lead-item,
    .archive-row {
      grid-template-columns: 1fr;
    }

    .lead-item__image {
      order: 0;
    }

    .lead-item__package {
      order: 1;
    }

    .archive-row__image {
      order: -1;
      max-width: 36rem;
    }

    .lead-item h2 {
      max-width: 22ch;
    }

    .page-header {
      padding-top: 2.7rem;
    }

    .page-header h1 {
      font-size: clamp(2.55rem, 12vw, 3.5rem);
    }

    .fixture-notice {
      text-align: left;
    }

    .lead-item {
      padding-top: 1.15rem;
    }

    .lead-item h2 {
      font-size: clamp(1.9rem, 8.5vw, 2.7rem);
    }

    .archive-row {
      padding-block: 1.55rem;
    }

    .archive-row h2 {
      font-size: clamp(1.5rem, 6.8vw, 2rem);
    }
  }
</style>
