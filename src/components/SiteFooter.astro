---
interface Props {
  showAcquisition?: boolean;
}

Astro.props as Props;

const primaryLinks = [
  { label: "Work", href: "/work" },
  { label: "Services", href: "/services" },
  { label: "Hustle", href: "/hustle" },
  { label: "Journal", href: "/journal" },
  { label: "Contact", href: "/contact" },
] as const;
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <a class="site-footer__brand" href="/" aria-label="Portfilo home">
      <img src="/brand/portfilo-wordmark-v1.svg" alt="Portfilo" />
    </a>

    <nav class="site-footer__nav" aria-label="Footer">
      {primaryLinks.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="site-footer__utility">
      <a href="/privacy">Privacy</a>
      <p>© 2026 Portfilo</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    margin-top: auto;
    border-top: 1px solid var(--line);
    background: var(--obsidian);
    color: var(--cold-white);
  }

  .site-footer__inner {
    width: min(calc(100% - (2 * var(--shell-gutter))), var(--page-max));
    margin-inline: auto;
    padding-block: clamp(2rem, 4vw, 4rem);
    display: grid;
    grid-template-columns: minmax(8rem, 1fr) minmax(0, 2fr) auto;
    gap: var(--grid-gap);
    align-items: start;
  }

  .site-footer__brand {
    width: 6.15rem;
    display: block;
    line-height: 0;
  }

  .site-footer__brand img {
    display: block;
    width: 100%;
    height: auto;
  }

  .site-footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem clamp(1rem, 2vw, 2rem);
  }

  .site-footer__nav a,
  .site-footer__utility a {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    color: var(--muted-silver);
    font: 500 0.78rem/1 var(--sans);
    text-decoration: none;
    transition: color var(--motion-micro) ease;
  }

  .site-footer__nav a:hover,
  .site-footer__utility a:hover {
    color: var(--bright-white);
  }

  .site-footer__utility {
    justify-self: end;
    display: grid;
    justify-items: end;
  }

  .site-footer__utility p {
    margin: 0;
    color: var(--muted-silver);
    font: 400 0.68rem/1.4 var(--mono);
  }

  @media (max-width: 48rem) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .site-footer__nav {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0;
      border-top: 1px solid var(--line);
    }

    .site-footer__nav a {
      border-bottom: 1px solid var(--line);
    }

    .site-footer__utility {
      justify-self: stretch;
      justify-items: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer__nav a,
    .site-footer__utility a {
      transition: none;
    }
  }
</style>
