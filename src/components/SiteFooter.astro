---
import FooterAcquisition from "./FooterAcquisition.astro";

interface Props {
  showAcquisition?: boolean;
}

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const routeShowsAcquisition = !["/confirmed", "/404"].includes(pathname);
const { showAcquisition = routeShowsAcquisition } = Astro.props;
---

<div class="site-footer-stack">
  {showAcquisition && <FooterAcquisition />}

  <footer class="site-footer">
    <div class="site-footer__inner">
      <a class="site-footer__brand" href="/" aria-label="Portfilo home">
        <img src="/brand/portfilo-wordmark-light.svg" alt="Portfilo" />
      </a>

      <nav class="site-footer__nav" aria-label="Footer">
        <a href="/why">Why</a>
        <a href="/hustle">Hustle</a>
        <a href="/standards">Standards</a>
        <a href="/privacy">Privacy</a>
      </nav>

      <p class="site-footer__meta">© 2026 Portfilo</p>
    </div>
  </footer>
</div>

<style>
  .site-footer-stack {
    width: 100%;
    margin-top: auto;
  }

  .site-footer {
    width: 100%;
    background: var(--ink);
    color: #fff;
  }

  .site-footer__inner {
    width: min(calc(100% - (2 * var(--shell-gutter))), var(--content-max));
    margin-inline: auto;
    padding: 1.2rem 0 1.55rem;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: clamp(1.2rem, 3vw, 3rem);
    align-items: center;
  }

  .site-footer__brand {
    width: 5.8rem;
    display: block;
    line-height: 0;
  }

  .site-footer__brand img {
    display: block;
    width: 100%;
    height: auto;
  }

  .site-footer__nav {
    justify-self: center;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1.25rem;
    font: 500 0.72rem/1.2 var(--sans);
  }

  .site-footer__nav a {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    color: rgba(255, 255, 255, 0.78);
    text-decoration: none;
  }

  .site-footer__nav a:hover {
    color: #fff;
  }

  .site-footer__meta {
    margin: 0;
    justify-self: end;
    color: rgba(255, 255, 255, 0.5);
    font: 430 0.68rem/1.4 var(--sans);
    text-align: right;
  }

  .site-footer a:focus-visible {
    outline-color: var(--accent-light);
  }

  @media (max-width: 40rem) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 0.85rem;
    }

    .site-footer__nav,
    .site-footer__meta {
      justify-self: start;
      justify-content: flex-start;
      text-align: left;
    }
  }
</style>
