---
type CurrentPage = "stories" | "standards" | "about" | "subscribe";

interface Props {
  current?: CurrentPage;
}

const { current } = Astro.props;
const subscribeHref = current === "subscribe" ? "#signup-title" : "/#newsletter";
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label="Portfilo home">
    <img src="/brand/portfilo-wordmark-color.svg" alt="Portfilo" />
  </a>

  <p class="site-coverage" aria-label="Coverage: Business, Technology, Startup, AI">
    <span>Business</span>
    <span aria-hidden="true">/</span>
    <span>Technology</span>
    <span aria-hidden="true">/</span>
    <span>Startup</span>
    <span aria-hidden="true">/</span>
    <span>AI</span>
  </p>

  <nav class="site-nav" aria-label="Primary">
    <a class="site-nav__link" href="/#latest">Latest</a>
    <a class="site-nav__link" href="/stories" aria-current={current === "stories" ? "page" : undefined}>Features</a>
    <a class="site-nav__cta" href={subscribeHref} aria-current={current === "subscribe" ? "page" : undefined}>Subscribe free</a>
  </nav>
</header>

<style>
  .site-header {
    width: min(100%, var(--page-max));
    margin-inline: auto;
    padding: 0.68rem var(--gutter);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: clamp(1rem, 2.4vw, 2.6rem);
    align-items: center;
    border-bottom: 1px solid var(--line);
  }

  .wordmark {
    width: clamp(6rem, 7vw, 7.6rem);
    display: block;
    line-height: 0;
  }

  .wordmark img {
    display: block;
    width: 100%;
    height: auto;
  }

  .site-coverage {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--muted);
    font: 520 clamp(0.68rem, 0.72vw, 0.76rem) / 1 var(--sans);
    white-space: nowrap;
  }

  .site-coverage span[aria-hidden="true"] {
    color: var(--line-strong);
  }

  .site-nav {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 1.7vw, 1.55rem);
  }

  .site-nav__link,
  .site-nav__cta {
    font: 560 clamp(0.73rem, 0.8vw, 0.81rem) / 1 var(--sans);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav__link {
    position: relative;
    padding-block: 0.25rem;
  }

  .site-nav__link::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -0.18rem;
    left: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 140ms ease;
  }

  .site-nav__link:hover::after,
  .site-nav__link[aria-current="page"]::after {
    transform: scaleX(1);
    transform-origin: left center;
  }

  .site-nav__cta {
    padding: 0.62rem 0.86rem;
    border: 1px solid var(--accent);
    background: var(--accent);
    color: #fff;
  }

  .site-nav__cta:hover {
    filter: brightness(0.93);
  }

  .site-nav a:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav__link::after {
      transition: none;
    }
  }

  @media (max-width: 62rem) {
    .site-coverage {
      display: none;
    }

    .site-header {
      grid-template-columns: auto 1fr;
    }
  }

  @media (max-width: 38rem) {
    .site-header {
      gap: 0.85rem;
      padding-top: 0.64rem;
      padding-bottom: 0.64rem;
    }

    .wordmark {
      width: 5.7rem;
    }

    .site-nav {
      gap: 0.75rem;
    }

    .site-nav__link {
      display: none;
    }

    .site-nav__cta {
      padding: 0.6rem 0.76rem;
      font-size: 0.72rem;
    }
  }

  @media (max-width: 23rem) {
    .site-header { --gutter: 1rem; }
  }
</style>
