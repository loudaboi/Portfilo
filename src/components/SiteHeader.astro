---
type CurrentPage = "stories" | "standards" | "about" | "subscribe";

interface Props {
  current?: CurrentPage;
}

const { current } = Astro.props;
const subscribeHref = current === "subscribe" ? "#signup-title" : "/#newsletter";
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label="Portfilo home">
    <img src="/brand/portfilo-wordmark-color.svg" alt="Portfilo" />
  </a>

  <nav class="site-nav" aria-label="Primary">
    <a class="site-nav__link" href="/#latest">Latest</a>
    <a class="site-nav__link" href="/stories" aria-current={current === "stories" ? "page" : undefined}>Features</a>
    <a class="site-nav__cta" href={subscribeHref} aria-current={current === "subscribe" ? "page" : undefined}>Subscribe free</a>
  </nav>
</header>

<style>
  .site-header {
    width: min(100%, var(--page-max));
    margin-inline: auto;
    padding: 1rem var(--gutter);
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1.5rem, 3vw, 3.5rem);
    align-items: center;
    border-bottom: 1px solid var(--line);
  }

  .wordmark {
    width: clamp(7.2rem, 10vw, 10.25rem);
    display: block;
    line-height: 0;
  }

  .wordmark img {
    display: block;
    width: 100%;
    height: auto;
  }

  .site-nav {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 2rem);
  }

  .site-nav__link,
  .site-nav__cta {
    font: 550 clamp(0.78rem, 0.9vw, 0.88rem) / 1 var(--sans);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav__link {
    position: relative;
    padding-block: 0.3rem;
  }

  .site-nav__link::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -0.18rem;
    left: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 140ms ease;
  }

  .site-nav__link:hover::after,
  .site-nav__link[aria-current="page"]::after {
    transform: scaleX(1);
    transform-origin: left center;
  }

  .site-nav__cta {
    padding: 0.78rem 1rem;
    border: 1px solid var(--accent);
    background: var(--accent);
    color: #fff;
  }

  .site-nav__cta:hover {
    filter: brightness(0.93);
  }

  .site-nav a:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav__link::after {
      transition: none;
    }
  }

  @media (max-width: 38rem) {
    .site-header {
      grid-template-columns: auto 1fr;
      gap: 1rem;
      padding-top: 0.85rem;
      padding-bottom: 0.85rem;
    }

    .wordmark {
      width: 6.8rem;
    }

    .site-nav {
      gap: 0.85rem;
    }

    .site-nav__link {
      display: none;
    }

    .site-nav__cta {
      padding: 0.7rem 0.85rem;
      font-size: 0.75rem;
    }
  }

  @media (max-width: 23rem) {
    .site-header { --gutter: 1rem; }
  }
</style>
