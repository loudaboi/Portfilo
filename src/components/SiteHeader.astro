---
type CurrentPage = "news" | "stories" | "standards";

interface Props {
  current?: CurrentPage;
}

const { current } = Astro.props;
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label="Portfilo home">
    <img src="/brand/portfilo-wordmark-color.svg" alt="Portfilo" />
  </a>

  <nav class="site-nav" aria-label="Primary">
    <a class="site-nav__link" href="/news" aria-current={current === "news" ? "page" : undefined}>News</a>
    <a class="site-nav__link" href="/stories" aria-current={current === "stories" ? "page" : undefined}>Stories</a>
  </nav>
</header>

<style>
  .site-header {
    width: min(calc(100% - (2 * var(--shell-gutter))), var(--content-max));
    margin-inline: auto;
    padding-block: 0.72rem;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1rem, 2.4vw, 2.5rem);
    align-items: center;
    border-bottom: 1px solid var(--line);
  }

  .wordmark {
    width: 5.8rem;
    display: block;
    line-height: 0;
  }

  .wordmark img {
    display: block;
    width: 100%;
    height: auto;
  }

  .site-nav {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: clamp(0.7rem, 1.4vw, 1.2rem);
  }

  .site-nav__link {
    position: relative;
    min-height: 2.75rem;
    padding-inline: 0.15rem;
    display: inline-flex;
    align-items: center;
    color: inherit;
    font: 550 clamp(0.74rem, 0.72rem + 0.1vw, 0.82rem) / 1 var(--sans);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav__link::after {
    content: "";
    position: absolute;
    right: 0.15rem;
    bottom: 0.35rem;
    left: 0.15rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 140ms ease;
  }

  .site-nav__link:hover::after,
  .site-nav__link[aria-current="page"]::after {
    transform: scaleX(1);
    transform-origin: left center;
  }

  @media (max-width: 40rem) {
    .site-header {
      gap: 0.8rem;
      padding-block: 0.6rem;
    }

    .wordmark {
      width: 5.35rem;
    }

    .site-nav {
      gap: 0.65rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav__link::after {
      transition: none;
    }
  }
</style>
