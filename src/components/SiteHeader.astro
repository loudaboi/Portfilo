---
type CurrentPage = "stories" | "standards" | "about" | "subscribe";

interface Props {
  current?: CurrentPage;
}

const { current } = Astro.props;
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label="Portfilo home">
    <img src="/brand/portfilo-wordmark-color.svg" alt="Portfilo" />
  </a>

  <nav class="site-nav" aria-label="Primary">
    <a class="site-nav__link" href="/stories" aria-current={current === "stories" ? "page" : undefined}>Features</a>
  </nav>
</header>

<style>
  .site-header {
    width: min(100%, var(--page-max));
    margin-inline: auto;
    padding: 0.72rem var(--gutter);
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1.25rem, 2.5vw, 2.75rem);
    align-items: center;
    border-bottom: 1px solid var(--line);
  }

  .wordmark {
    width: clamp(6rem, 7.8vw, 8rem);
    display: block;
    line-height: 0;
  }

  .wordmark img {
    display: block;
    width: 100%;
    height: auto;
  }

  .site-nav {
    justify-self: end;
    display: flex;
    align-items: center;
  }

  .site-nav__link {
    position: relative;
    padding-block: 0.25rem;
    font: 550 clamp(0.74rem, 0.82vw, 0.82rem) / 1 var(--sans);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav__link::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -0.16rem;
    left: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 140ms ease;
  }

  .site-nav__link:hover::after,
  .site-nav__link[aria-current="page"]::after {
    transform: scaleX(1);
    transform-origin: left center;
  }

  .site-nav a:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav__link::after {
      transition: none;
    }
  }

  @media (max-width: 38rem) {
    .site-header {
      gap: 0.85rem;
      padding-top: 0.68rem;
      padding-bottom: 0.68rem;
    }

    .wordmark {
      width: 5.7rem;
    }

    .site-nav__link {
      font-size: 0.72rem;
    }
  }

  @media (max-width: 23rem) {
    .site-header { --gutter: 1rem; }
  }
</style>
