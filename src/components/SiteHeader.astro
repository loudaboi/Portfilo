---
type CurrentPage = "stories" | "standards" | "about" | "subscribe";

interface Props {
  current?: CurrentPage;
}

const { current } = Astro.props;
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label="Portfilo home">
    <img src="/brand/portfilo-wordmark-color.svg" alt="Portfilo" />
  </a>

  <p class="site-coverage" aria-label="Coverage: Business, Technology, Startup, AI">
    <span>Business</span>
    <span aria-hidden="true">/</span>
    <span>Technology</span>
    <span aria-hidden="true">/</span>
    <span>Startup</span>
    <span aria-hidden="true">/</span>
    <span>AI</span>
  </p>

  <nav class="site-nav" aria-label="Primary">
    <a class="site-nav__link" href="/stories" aria-current={current === "stories" ? "page" : undefined}>Features</a>
  </nav>
</header>

<style>
  .site-header {
    width: min(100%, var(--page-max));
    margin-inline: auto;
    padding: 0.52rem var(--gutter);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: clamp(0.9rem, 2vw, 2.2rem);
    align-items: center;
    border-bottom: 1px solid var(--line);
  }

  .wordmark {
    width: clamp(5.05rem, 5.8vw, 6.15rem);
    display: block;
    line-height: 0;
  }

  .wordmark img {
    display: block;
    width: 100%;
    height: auto;
  }

  .site-coverage {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.42rem;
    color: var(--muted);
    font: 520 clamp(0.66rem, 0.7vw, 0.74rem) / 1 var(--sans);
    white-space: nowrap;
  }

  .site-coverage span[aria-hidden="true"] {
    color: var(--line-strong);
  }

  .site-nav {
    justify-self: end;
    display: flex;
    align-items: center;
  }

  .site-nav__link {
    position: relative;
    padding-block: 0.24rem;
    font: 560 clamp(0.72rem, 0.78vw, 0.8rem) / 1 var(--sans);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav__link::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -0.15rem;
    left: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 140ms ease;
  }

  .site-nav__link:hover::after,
  .site-nav__link[aria-current="page"]::after {
    transform: scaleX(1);
    transform-origin: left center;
  }

  .site-nav a:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav__link::after {
      transition: none;
    }
  }

  @media (max-width: 52rem) {
    .site-coverage {
      display: none;
    }

    .site-header {
      grid-template-columns: auto 1fr;
    }
  }

  @media (max-width: 36rem) {
    .site-header {
      gap: 0.8rem;
      padding-top: 0.5rem;
      padding-bottom: 0.5rem;
    }

    .wordmark {
      width: 4.85rem;
    }

    .site-nav__link {
      font-size: 0.72rem;
    }
  }

  @media (max-width: 23rem) {
    .site-header { --gutter: 1rem; }
  }
</style>
