---
type CurrentPage = "news" | "stories" | "standards" | "about" | "subscribe";

interface Props {
  current?: CurrentPage;
}

const { current } = Astro.props;
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label="Portfilo home">
    <img src="/brand/portfilo-wordmark-color.svg" alt="Portfilo" />
  </a>

  <nav class="site-nav" aria-label="Primary">
    <a class="site-nav__link" href="/news" aria-current={current === "news" ? "page" : undefined}>News</a>
    <a class="site-nav__link" href="/stories" aria-current={current === "stories" ? "page" : undefined}>Stories</a>
    <a
      class="site-nav__link site-nav__cta"
      href="/subscribe"
      aria-current={current === "subscribe" ? "page" : undefined}
    >Subscribe free</a>
  </nav>
</header>

<style>
  .site-header {
    width: min(100%, var(--page-max));
    margin-inline: auto;
    padding: 0.72rem var(--gutter);
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1.25rem, 2.5vw, 2.75rem);
    align-items: center;
    border-bottom: 1px solid var(--line);
  }

  :global(body.home-page) .site-header,
  :global(body.editorial-page) .site-header {
    width: min(calc(100% - (2 * var(--shell-gutter))), var(--content-max));
    padding-inline: 0;
  }

  .wordmark {
    width: 5.8rem;
    display: block;
    line-height: 0;
  }

  .wordmark img {
    display: block;
    width: 100%;
    height: auto;
  }

  .site-nav {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: clamp(0.8rem, 1.45vw, 1.35rem);
  }

  .site-nav__link {
    position: relative;
    padding-block: 0.25rem;
    font: 550 clamp(0.74rem, 0.82vw, 0.82rem) / 1 var(--sans);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav__link::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -0.16rem;
    left: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 140ms ease;
  }

  .site-nav__link:hover::after,
  .site-nav__link[aria-current="page"]::after {
    transform: scaleX(1);
    transform-origin: left center;
  }

  .site-nav__cta {
    padding: 0.62rem 0.78rem;
    border: 1px solid var(--accent);
    background: var(--accent);
    color: #fff;
  }

  .site-nav__cta::after {
    display: none;
  }

  .site-nav__cta:hover {
    filter: brightness(0.93);
  }

  .site-nav a:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav__link::after {
      transition: none;
    }
  }

  @media (max-width: 38rem) {
    .site-header {
      gap: 0.75rem;
      padding-top: 0.68rem;
      padding-bottom: 0.68rem;
    }

    .site-nav {
      gap: 0.55rem;
    }

    .site-nav__link {
      font-size: 0.69rem;
    }

    .site-nav__cta {
      padding: 0.54rem 0.58rem;
    }
  }

  @media (max-width: 23rem) {
    .site-header { --gutter: 1rem; }
  }
</style>
