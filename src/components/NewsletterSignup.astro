---
interface Props {
  id: string;
  heading?: string;
  copy?: string;
  variant?: "hero" | "inline" | "card" | "footer";
  showCopy?: boolean;
}

const {
  id,
  heading = "Get ahead in business and tech in 7 minutes.",
  copy = "The latest news on companies, startups, products, markets, AI, and technology. Three times a week, straight to your inbox.",
  variant = "inline",
  showCopy = true,
} = Astro.props;

const emailId = `${id}-email`;
const statusId = `${id}-status`;
const honeypotId = `${id}-company`;
const titleId = `${id}-title`;
---

<section
  class:list={["newsletter-signup", `newsletter-signup--${variant}`]}
  aria-labelledby={showCopy ? titleId : undefined}
  aria-label={!showCopy ? "Subscribe to the Portfilo newsletter" : undefined}
>
  {
    showCopy && (
      <div class="newsletter-signup__copy">
        <h2 id={titleId}>{heading}</h2>
        {copy && <p>{copy}</p>}
      </div>
    )
  }

  <form class="newsletter-signup__form" action="/api/subscribe" method="post" novalidate data-newsletter-form>
    <div class="newsletter-signup__field">
      <label class="newsletter-signup__label" for={emailId}>Email address</label>
      <div class="newsletter-signup__row">
        <input
          id={emailId}
          name="email"
          type="email"
          inputmode="email"
          autocomplete="email"
          maxlength="320"
          placeholder="you@email.com"
          required
          aria-describedby={statusId}
          data-newsletter-email
        />
        <button type="submit" data-newsletter-submit>
          <span data-submit-label>Subscribe free</span>
        </button>
      </div>
      <p class="newsletter-signup__note">Free newsletter. Unsubscribe anytime.</p>
      <p
        class="newsletter-signup__status"
        id={statusId}
        role="status"
        aria-live="polite"
        data-newsletter-status
      ></p>
    </div>

    <div class="newsletter-signup__honeypot" aria-hidden="true">
      <label for={honeypotId}>Company</label>
      <input id={honeypotId} name="company" type="text" tabindex="-1" autocomplete="off" />
    </div>
  </form>
</section>

<script is:inline>
  document.querySelectorAll("[data-newsletter-form]").forEach((form) => {
    if (!(form instanceof HTMLFormElement) || form.dataset.newsletterBound) return;
    form.dataset.newsletterBound = "true";

    const emailInput = form.querySelector("[data-newsletter-email]");
    const statusMessage = form.querySelector("[data-newsletter-status]");
    const submitButton = form.querySelector("[data-newsletter-submit]");
    const submitLabel = form.querySelector("[data-submit-label]");

    const setStatus = (message, state = "") => {
      if (!(statusMessage instanceof HTMLElement)) return;
      statusMessage.textContent = message;
      statusMessage.dataset.state = state;
    };

    const setSubmitting = (isSubmitting) => {
      if (!(submitButton instanceof HTMLButtonElement) || !(submitLabel instanceof HTMLElement)) return;
      submitButton.disabled = isSubmitting;
      submitButton.setAttribute("aria-busy", String(isSubmitting));
      submitLabel.textContent = isSubmitting ? "Submitting…" : "Subscribe free";
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!(emailInput instanceof HTMLInputElement)) return;

      emailInput.removeAttribute("aria-invalid");
      setStatus("");

      if (!emailInput.value.trim() || !emailInput.checkValidity()) {
        emailInput.setAttribute("aria-invalid", "true");
        setStatus("Enter a valid email address.", "error");
        emailInput.focus();
        return;
      }

      const formData = new FormData(form);
      const payload = {
        email: String(formData.get("email") || "").trim(),
        company: String(formData.get("company") || "").trim(),
      };

      setSubmitting(true);

      try {
        const response = await fetch("/api/subscribe", {
          method: "POST",
          headers: {
            Accept: "application/json",
            "Content-Type": "application/json",
          },
          body: JSON.stringify(payload),
        });

        const result = await response.json().catch(() => null);

        if (!response.ok || !result?.ok) {
          throw new Error(result?.message || "We could not submit your email. Please try again.");
        }

        form.reset();
        setStatus("Check your inbox. Confirm your email to finish subscribing.", "success");
      } catch (error) {
        setStatus(
          error instanceof Error ? error.message : "We could not submit your email. Please try again.",
          "error",
        );
      } finally {
        setSubmitting(false);
      }
    });
  });
</script>

<style>
  .newsletter-signup {
    display: grid;
    gap: 1.15rem;
    min-width: 0;
  }

  .newsletter-signup__copy h2,
  .newsletter-signup__copy p,
  .newsletter-signup__note,
  .newsletter-signup__status {
    margin: 0;
  }

  .newsletter-signup__copy h2 {
    max-width: 18ch;
    font: 650 clamp(1.65rem, 2.15vw, 2.45rem) / 1 var(--sans);
    letter-spacing: -0.04em;
  }

  .newsletter-signup__copy p {
    max-width: 41rem;
    margin-top: 0.65rem;
    color: var(--muted);
    font: 430 clamp(0.92rem, 1vw, 1rem) / 1.5 var(--sans);
  }

  .newsletter-signup__form,
  .newsletter-signup__field {
    min-width: 0;
  }

  .newsletter-signup__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    width: 100%;
    max-width: 42rem;
  }

  .newsletter-signup__label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .newsletter-signup input,
  .newsletter-signup button {
    min-height: 3.15rem;
    border-radius: 0;
    font: 550 0.86rem/1 var(--sans);
  }

  .newsletter-signup input {
    min-width: 0;
    width: 100%;
    padding: 0.82rem 0.95rem;
    border: 1px solid var(--line-strong, #aaa39a);
    border-right: 0;
    background: transparent;
    color: var(--ink);
  }

  .newsletter-signup input::placeholder {
    color: var(--muted);
  }

  .newsletter-signup button {
    padding: 0.82rem clamp(0.95rem, 1.8vw, 1.35rem);
    border: 1px solid var(--accent);
    background: var(--accent);
    color: #fff;
    cursor: pointer;
    white-space: nowrap;
  }

  .newsletter-signup button:hover {
    filter: brightness(0.93);
  }

  .newsletter-signup button:disabled {
    cursor: wait;
    opacity: 0.68;
  }

  .newsletter-signup input:focus-visible,
  .newsletter-signup button:focus-visible {
    position: relative;
    z-index: 1;
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }

  .newsletter-signup__note,
  .newsletter-signup__status {
    margin-top: 0.45rem;
    color: var(--muted);
    font: 430 0.69rem/1.4 var(--sans);
  }

  .newsletter-signup__status {
    min-height: 1em;
  }

  .newsletter-signup__status[data-state="error"] {
    color: var(--correction);
  }

  .newsletter-signup__status[data-state="success"] {
    color: var(--accent);
  }

  .newsletter-signup__honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .newsletter-signup--hero {
    display: block;
  }

  .newsletter-signup--hero .newsletter-signup__row {
    max-width: none;
  }

  .newsletter-signup--inline {
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.9fr);
    align-items: end;
    gap: clamp(1.25rem, 2.8vw, 3rem);
  }

  .newsletter-signup--card {
    display: block;
  }

  .newsletter-signup--card .newsletter-signup__copy h2 {
    max-width: 14ch;
    font-size: clamp(1.7rem, 2.3vw, 2.35rem);
  }

  .newsletter-signup--card .newsletter-signup__copy p {
    color: rgba(255, 255, 255, 0.78);
  }

  .newsletter-signup--card .newsletter-signup__form {
    margin-top: clamp(1.25rem, 2.2vw, 2rem);
  }

  .newsletter-signup--card .newsletter-signup__row {
    grid-template-columns: 1fr;
    gap: 0.55rem;
    max-width: none;
  }

  .newsletter-signup--card input {
    border: 1px solid rgba(255, 255, 255, 0.42);
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }

  .newsletter-signup--card input::placeholder,
  .newsletter-signup--card .newsletter-signup__note,
  .newsletter-signup--card .newsletter-signup__status {
    color: rgba(255, 255, 255, 0.68);
  }

  .newsletter-signup--card button {
    border-color: #fff;
    background: #fff;
    color: var(--accent);
  }

  .newsletter-signup--card button:hover {
    filter: none;
    background: rgba(255, 255, 255, 0.9);
  }

  .newsletter-signup--card .newsletter-signup__status[data-state="success"] {
    color: #fff;
  }

  .newsletter-signup--card .newsletter-signup__status[data-state="error"] {
    color: #ffe1dc;
  }

  .newsletter-signup--footer {
    grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.9fr);
    align-items: center;
    gap: clamp(1.4rem, 3vw, 3.5rem);
  }

  .newsletter-signup--footer .newsletter-signup__copy h2 {
    font-size: clamp(1.55rem, 2vw, 2.15rem);
  }

  .newsletter-signup--footer .newsletter-signup__copy p {
    max-width: 44rem;
  }

  .newsletter-signup--footer .newsletter-signup__row {
    max-width: none;
  }

  @media (max-width: 48rem) {
    .newsletter-signup--inline,
    .newsletter-signup--footer {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }

  @media (max-width: 28rem) {
    .newsletter-signup__row {
      grid-template-columns: 1fr;
      gap: 0.55rem;
    }

    .newsletter-signup input {
      border-right: 1px solid var(--line-strong, #aaa39a);
    }
  }
</style>
