---
interface Props {
  id: string;
  heading?: string;
  copy?: string;
  variant?: "hero" | "inline";
  showCopy?: boolean;
  buttonLabel?: string;
}

const {
  id,
  heading = "Portfilo newsletter",
  copy = "",
  variant = "inline",
  showCopy = true,
  buttonLabel = "Subscribe",
} = Astro.props;

const emailId = `${id}-email`;
const statusId = `${id}-status`;
const honeypotId = `${id}-company`;
const titleId = `${id}-title`;
---

<section
  class:list={["newsletter-signup", `newsletter-signup--${variant}`]}
  aria-labelledby={showCopy ? titleId : undefined}
  aria-label={!showCopy ? "Subscribe to the Portfilo newsletter" : undefined}
>
  {showCopy && (
    <div class="newsletter-signup__copy">
      <h2 id={titleId}>{heading}</h2>
      {copy && <p>{copy}</p>}
    </div>
  )}

  <form class="newsletter-signup__form" action="/api/newsletter/subscribe" method="post" novalidate data-newsletter-form data-astro-reload>
    <div class="newsletter-signup__field">
      <label class="newsletter-signup__label" for={emailId}>Email address</label>
      <div class="newsletter-signup__row">
        <input id={emailId} name="email" type="email" inputmode="email" autocomplete="email" maxlength="320" placeholder="you@email.com" required aria-describedby={statusId} data-newsletter-email />
        <button type="submit" data-newsletter-submit data-default-label={buttonLabel}><span data-submit-label>{buttonLabel}</span></button>
      </div>
      <p class="newsletter-signup__note">Unsubscribe anytime.</p>
      <p class="newsletter-signup__status" id={statusId} role="status" aria-live="polite" data-newsletter-status></p>
    </div>
    <div class="newsletter-signup__honeypot" aria-hidden="true">
      <label for={honeypotId}>Company</label>
      <input id={honeypotId} name="company" type="text" tabindex="-1" autocomplete="off" />
    </div>
  </form>
</section>

<script>
  const bindNewsletterForms = () => {
    document.querySelectorAll("[data-newsletter-form]").forEach((form) => {
      if (!(form instanceof HTMLFormElement) || form.dataset.newsletterBound) return;
      form.dataset.newsletterBound = "true";
      const emailInput = form.querySelector("[data-newsletter-email]");
      const statusMessage = form.querySelector("[data-newsletter-status]");
      const submitButton = form.querySelector("[data-newsletter-submit]");
      const submitLabel = form.querySelector("[data-submit-label]");

      const setStatus = (message: string, state = "") => {
        if (!(statusMessage instanceof HTMLElement)) return;
        statusMessage.textContent = message;
        statusMessage.dataset.state = state;
      };

      const setSubmitting = (isSubmitting: boolean) => {
        if (!(submitButton instanceof HTMLButtonElement) || !(submitLabel instanceof HTMLElement)) return;
        const defaultLabel = submitButton.dataset.defaultLabel || "Subscribe";
        submitButton.disabled = isSubmitting;
        submitButton.setAttribute("aria-busy", String(isSubmitting));
        submitLabel.textContent = isSubmitting ? "Submitting…" : defaultLabel;
      };

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!(emailInput instanceof HTMLInputElement)) return;
        emailInput.removeAttribute("aria-invalid");
        setStatus("");

        if (!emailInput.value.trim() || !emailInput.checkValidity()) {
          emailInput.setAttribute("aria-invalid", "true");
          setStatus("Enter a valid email address.", "error");
          emailInput.focus();
          return;
        }

        const formData = new FormData(form);
        const payload = {
          email: String(formData.get("email") || "").trim(),
          company: String(formData.get("company") || "").trim(),
        };

        setSubmitting(true);
        try {
          const response = await fetch("/api/newsletter/subscribe", {
            method: "POST",
            headers: { Accept: "application/json", "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
          const result = await response.json().catch(() => null);
          if (!response.ok || !result?.ok) {
            throw new Error(result?.message || "We could not submit your email. Please try again.");
          }
          form.reset();
          setStatus("Check your inbox. Confirm your email to finish subscribing.", "success");
        } catch (error) {
          setStatus(error instanceof Error ? error.message : "We could not submit your email. Please try again.", "error");
        } finally {
          setSubmitting(false);
        }
      });
    });
  };

  bindNewsletterForms();
  document.addEventListener("astro:page-load", bindNewsletterForms);
</script>

<style>
  .newsletter-signup{min-width:0;display:grid;gap:var(--space-6)}
  .newsletter-signup__copy h2,.newsletter-signup__copy p,.newsletter-signup__note,.newsletter-signup__status{margin:0}
  .newsletter-signup__copy h2{color:var(--cold-white);font:620 clamp(1.6rem,1.1rem + 1.2vw,2.5rem)/1 var(--sans);font-variation-settings:"wdth" 92,"wght" 620;letter-spacing:-.045em}
  .newsletter-signup__copy p{max-width:42rem;margin-top:var(--space-3);color:var(--muted-silver);font:430 1rem/1.55 var(--sans)}
  .newsletter-signup__row{width:100%;max-width:42rem;display:grid;grid-template-columns:minmax(0,1fr) auto}
  .newsletter-signup__label{position:absolute;width:1px;height:1px;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}
  .newsletter-signup input,.newsletter-signup button{min-height:3.25rem;border-radius:0;font:520 .82rem/1 var(--sans)}
  .newsletter-signup input{min-width:0;padding:.85rem 1rem;border:1px solid var(--line-strong);border-right:0;background:transparent;color:var(--cold-white)}
  .newsletter-signup input::placeholder{color:var(--muted-silver)}
  .newsletter-signup button{padding:.85rem 1.15rem;border:1px solid var(--cold-white);background:var(--cold-white);color:var(--obsidian);cursor:pointer}
  .newsletter-signup button:hover{background:var(--bright-white)}.newsletter-signup button:disabled{opacity:.58;cursor:wait}
  .newsletter-signup__note,.newsletter-signup__status{margin-top:var(--space-2);color:var(--muted-silver);font:400 .68rem/1.45 var(--mono)}
  .newsletter-signup__status{min-height:1em}.newsletter-signup__status[data-state="error"]{color:var(--correction)}.newsletter-signup__status[data-state="success"]{color:var(--cold-white)}
  .newsletter-signup__honeypot{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
  .newsletter-signup--inline{grid-template-columns:minmax(0,1fr) minmax(18rem,.9fr);align-items:end;gap:clamp(1.5rem,3vw,3rem)}
  @media(max-width:44rem){.newsletter-signup--inline{grid-template-columns:1fr;align-items:start}}
  @media(max-width:28rem){.newsletter-signup__row{grid-template-columns:1fr;gap:var(--space-2)}.newsletter-signup input{border-right:1px solid var(--line-strong)}}
</style>
