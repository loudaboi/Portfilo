---
import NewsletterSignup from "./NewsletterSignup.astro";
---

<section class="footer-acquisition" aria-label="Subscribe to the Portfilo newsletter">
  <div class="footer-acquisition__inner">
    <div class="footer-acquisition__copy">
      <h2>Get ahead in business and tech.</h2>
      <p>
        Reporting on what changed, why it’s happening, and how companies are built and run.
        Three times a week, straight to your inbox.
      </p>
    </div>

    <div class="footer-acquisition__form">
      <NewsletterSignup
        id="site-footer-newsletter"
        variant="hero"
        showCopy={false}
        buttonLabel="Send me the news"
      />
    </div>
  </div>
</section>

<style>
  .footer-acquisition {
    width: 100%;
    background: var(--ink);
    color: #fff;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .footer-acquisition__inner {
    width: min(calc(100% - (2 * var(--shell-gutter))), var(--content-max));
    margin-inline: auto;
    padding: clamp(2.2rem, 4vw, 3.8rem) 0;
    display: grid;
    grid-template-columns: minmax(0, 52rem) minmax(19rem, 1fr);
    gap: clamp(1.5rem, 2.7vw, 2.5rem);
    align-items: center;
  }

  .footer-acquisition__copy h2,
  .footer-acquisition__copy p {
    margin: 0;
  }

  .footer-acquisition__copy h2 {
    max-width: 17ch;
    color: #fff;
    font: 650 clamp(1.5rem, 1.1rem + 0.9vw, 2.15rem) / 1 var(--sans);
    letter-spacing: -0.04em;
  }

  .footer-acquisition__copy p {
    max-width: 44rem;
    margin-top: 0.65rem;
    color: rgba(255, 255, 255, 0.68);
    font: 430 clamp(0.9rem, 0.84rem + 0.2vw, 1rem) / 1.5 var(--sans);
  }

  .footer-acquisition__form {
    min-width: 0;
  }

  .footer-acquisition__form :global(.newsletter-signup__row) {
    width: 100%;
    max-width: 32rem;
  }

  .footer-acquisition__form :global(.newsletter-signup input) {
    border-color: rgba(255, 255, 255, 0.45);
    background: rgba(255, 255, 255, 0.07);
    color: #fff;
  }

  .footer-acquisition__form :global(.newsletter-signup input::placeholder) {
    color: rgba(255, 255, 255, 0.55);
  }

  .footer-acquisition__form :global(.newsletter-signup__note),
  .footer-acquisition__form :global(.newsletter-signup__status) {
    color: rgba(255, 255, 255, 0.68);
  }

  .footer-acquisition__form :global(.newsletter-signup__status[data-state="success"]) {
    color: var(--accent-light);
  }

  .footer-acquisition__form :global(.newsletter-signup__status[data-state="error"]) {
    color: #ffc2b8;
  }

  .footer-acquisition__form :global(.newsletter-signup input:focus-visible),
  .footer-acquisition__form :global(.newsletter-signup button:focus-visible) {
    outline-color: var(--accent-light);
  }

  @media (max-width: 64rem) {
    .footer-acquisition__inner {
      grid-template-columns: minmax(0, 1.2fr) minmax(17rem, 0.8fr);
      gap: 1.5rem;
    }
  }

  @media (max-width: 44rem) {
    .footer-acquisition__inner {
      grid-template-columns: 1fr;
      gap: 1.35rem;
    }

    .footer-acquisition__form {
      width: min(100%, 32rem);
    }
  }
</style>
